	toy = { playMs = 8000, joyPerSec = 4, energyPerSec = 0.6, bringFirstAtMs = 90000, bringCooldownMs = 100000, bringWaitMs = 5000, bringGiveJoy = 25, bringGiveEnergy = 8, bringGiveSkillSec = 20, bringScoldJoy = -12 },
	chase = { durationMs = 6000, joyPerSec = 2.5, energyPerSec = 0.6 },
