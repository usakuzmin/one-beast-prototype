	growth = { bigEatPow = 0.4, bigEatMin = 0.9, bigEatMax = 1.25, normalMassK = 1.15, hungryBelow = 30, hungryPenalty = 0.12, hungryFull = 0.4, activeBonus = 0.06, activeFull = 0.3 },
	movement = { baseSpeed = 75, fatSlow = 1.4, muscleSlow = 0.25, minMul = 0.3, fatEnergyMul = 1.6, stageMul = { infant = 1, young = 1.15, adult = 1.2 } },

	training = {
