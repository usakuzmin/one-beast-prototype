          <string name="Name">Farm</string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Config</string>
            <string name="Source"><![CDATA[--!strict
-- Все числа фермы в одном месте. Перенос из farm_lab v0.3 (src/farm/config.ts) один в один:
-- посадил 1 — собрал 2, заказы платят больше лавки, постройки открываются по уровню фермы.
-- Координаты x, y — в пикселях веб-фермы (760×540); в мир Roblox их переводит FarmWorld.

local Config = {}

Config.ITEMS = {
	wheat = { name = "пшеница", icon = "🌾", sell = 2 },
	carrot = { name = "морковь", icon = "🥕", sell = 4 },
	strawberry = { name = "клубника", icon = "🍓", sell = 6 },
	pumpkin = { name = "тыква", icon = "🎃", sell = 14 },
	flour = { name = "мука", icon = "🥡", sell = 8 },
	egg = { name = "яйцо", icon = "🥚", sell = 7 },
	bread = { name = "хлеб", icon = "🍞", sell = 22 },
	soup = { name = "морковный суп", icon = "🍲", sell = 16 },
	omelet = { name = "омлет", icon = "🍳", sell = 20 },
	pie = { name = "ягодный пирог", icon = "🥧", sell = 30 },
	porridge = { name = "тыквенная каша", icon = "🥣", sell = 24 },
}

Config.CROP_LIST = { "wheat", "carrot", "strawberry", "pumpkin" }
Config.GOOD_LIST = { "flour", "egg", "bread" }
Config.DISH_LIST = { "soup", "omelet", "pie", "porridge" }
Config.ITEM_LIST = { "wheat", "carrot", "strawberry", "pumpkin", "flour", "egg", "bread", "soup", "omelet", "pie", "porridge" }

Config.CROPS = {
	wheat = { growMs = 60000, greenAt = 0.4, seedCost = 0, xp = 1, level = 1 },
	carrot = { growMs = 110000, greenAt = 0.35, seedCost = 1, xp = 2, level = 1 },
	strawberry = { growMs = 75000, greenAt = 0.4, seedCost = 4, xp = 3, level = 2 },
	pumpkin = { growMs = 220000, greenAt = 0.3, seedCost = 8, xp = 6, level = 3 },
}

-- Массивы cost и buildMs: индекс 1 — цена первого уровня постройки.
Config.BUILDINGS = {
	storage = { name = "Амбар", icon = "🏚", about = "Хранит урожай и продукты: 25 → 50 → 100 мест.", maxLevel = 3, cost = { 0, 60, 160 }, buildMs = { 0, 60000, 120000 }, level = 1, x = 105, y = 80 },
	fields = { name = "Новые грядки", icon = "🟫", about = "Ещё 3 грядки за уровень.", maxLevel = 2, cost = { 40, 100 }, buildMs = { 40000, 80000 }, level = 1, x = 0, y = 0 },
	well = { name = "Колодец", icon = "⛲", about = "Сам поливает грядки: раз в 60 с, на 2 уровне раз в 30 с.", maxLevel = 2, cost = { 50, 120 }, buildMs = { 60000, 90000 }, level = 2, x = 105, y = 200 },
	compost = { name = "Компостер", icon = "♻️", about = "Гнилой урожай превращается в удобрение. Предел удобрений 10 → 20.", maxLevel = 1, cost = { 35 }, buildMs = { 45000 }, level = 2, x = 105, y = 320 },
	coop = { name = "Курятник", icon = "🐔", about = "Яйцо раз в 50 с, если в амбаре есть пшеница на корм.", maxLevel = 1, cost = { 70 }, buildMs = { 80000 }, level = 2, x = 655, y = 400 },
	mill = { name = "Мельница", icon = "🌀", about = "3 пшеницы → 1 мука за 30 с.", maxLevel = 1, cost = { 80 }, buildMs = { 90000 }, level = 3, x = 655, y = 80 },
	bakery = { name = "Пекарня", icon = "🥖", about = "1 мука + 1 яйцо → 2 хлеба за 40 с. Хлеб сначала остывает на противне.", maxLevel = 1, cost = { 120 }, buildMs = { 120000 }, level = 4, x = 655, y = 220 },
	kitchen = { name = "Кухня", icon = "🍳", about = "Блюда из урожая: суп, омлет, пирог, каша.", maxLevel = 1, cost = { 90 }, buildMs = { 70000 }, level = 3, x = 105, y = 440 },
}

Config.BUILDING_LIST = { "fields", "storage", "well", "compost", "coop", "mill", "kitchen", "bakery" }

-- Порядок рецептов важен для заказов (как порядок ключей RECIPES в TS).
Config.RECIPE_ORDER = { "soup", "porridge", "omelet", "pie" }
Config.RECIPES = {
	soup = { name = "Морковный суп", icon = "🍲", needs = { carrot = 2 }, cookMs = 20000, level = 3 },
	porridge = { name = "Тыквенная каша", icon = "🥣", needs = { pumpkin = 1, wheat = 1 }, cookMs = 25000, level = 3 },
	omelet = { name = "Омлет", icon = "🍳", needs = { egg = 2 }, cookMs = 15000, level = 3 },
	pie = { name = "Ягодный пирог", icon = "🥧", needs = { strawberry = 2, flour = 1 }, cookMs = 30000, level = 4 },
}

Config.FARM = {
	stepMs = 250,
	saveVersion = 1,
	world = { width = 760, height = 540 },

	startCoins = 60,
	startXp = 0,
	-- Сколько опыта нужно для уровня 1, 2, 3, ... (индекс = уровень).
	levelXp = { 0, 15, 45, 100, 180, 300, 460 },

	basePlots = 6,
	plotsPerLevel = 3,
	plotGrid = { x0 = 296, y0 = 100, step = 84, cols = 3 },

	harvestYield = 2, -- посадил 1 — собрал 2
	fertBonus = 1, -- удобренная грядка даёт +1
	waterDecayPerSec = 1.4,
	wetMul = 1.6,
	dryMul = 0.5,
	fertMul = 1.5,
	rotAfterMs = 180000, -- зрелый урожай гниёт, если долго не собирать (только при игроке)
	wellEveryMs = { 60000, 30000 }, -- по уровню колодца
	fertCap = { 10, 20 }, -- без компостера / с ним
	startFertilizer = 1,

	storageCap = { 25, 50, 100 }, -- по уровню амбара
	orderCount = 3,
	orderBonus = 1.6,
	orderXpPerCoin = 0.3,
	buildXpPerCoin = 0.2,

	mill = { ms = 30000, wheat = 3 },
	bakery = { ms = 40000, bread = 2 },
	coop = { eggEveryMs = 50000 },
	trayCoolMs = 25000,

	-- Повреждения: меньше этой доли уцелевшего урожая — грядка уничтожена.
	destroyBelow = 0.05,

	offlineMaxMs = 8 * 3600000,
	logKeep = 300,
}

Config.CUSTOMERS = { "Трактирщик", "Мельничиха", "Старый рыбак", "Пекарь из города", "Соседка-травница", "Кузнец" }

return Config
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Contract</string>
            <string name="Source"><![CDATA[--!strict
-- Стык фермы с остальным миром (one_beast/claude_interface_farm_beast.md, версия стыка 2).
-- Перенос farm_lab v0.3 (src/farm/contract.ts).
--
-- Наружу: объекты с метками (objects) и журнал событий (drainEvents).
-- Внутрь: «что-то повредило / съело / унесло / помогло». Кто это сделал — зверь,
-- гоблин или град, — ферма не знает, только подпись cause.

local IS_ROBLOX = typeof(script) == "Instance"
local Config = if IS_ROBLOX then require(script.Parent.Config) else require("./Config")
local Farm = if IS_ROBLOX then require(script.Parent.Farm) else require("./Farm")

local FARM = Config.FARM
local ITEMS = Config.ITEMS
local BUILDINGS = Config.BUILDINGS

type FarmState = Farm.FarmState
type Plot = Farm.Plot

local Contract = {}

Contract.TAG = {
	plot = "plot",
	food = "food",
	unripe = "unripe",
	ripe = "ripe",
	rotten = "rotten",
	seedling = "seedling",
	dry = "dry",
	fertilized = "fertilized",
	damaged = "damaged",
	storage = "storage",
	hasFood = "has_food",
	full = "full",
	tray = "tray",
	hot = "hot",
	coop = "coop",
	chickens = "chickens",
	scared = "scared",
	building = "building",
	construction = "construction",
}
local TAG = Contract.TAG

local function cropTag(c: string): string
	return "crop:" .. c
end
local function itemTag(i: string): string
	return "item:" .. i
end
Contract.cropTag = cropTag
Contract.itemTag = itemTag

export type FarmObject = {
	id: string, -- plot3, storage, tray, coop, building:mill, construction
	x: number,
	y: number,
	tags: { string },
	value: number, -- сколько монет стоит то, что здесь можно потерять
	label: string, -- подпись для человека: «морковь, зелёная»
	ripeInMs: number?, -- только у растущей грядки
}

local STAGE_NAME = { empty = "пустая", seed = "росток", green = "зелёная", ripe = "спелая", rotten = "гнилая" }

local function plotObject(p: Plot): FarmObject
	local tags = { TAG.plot }
	local crop = p.crop
	if not crop or p.stage == "empty" then
		return { id = p.id, x = p.x, y = p.y, tags = tags, value = 0, label = "пустая грядка" }
	end
	table.insert(tags, cropTag(crop))
	if p.stage == "seed" then
		table.insert(tags, TAG.seedling)
	elseif p.stage == "green" then
		table.insert(tags, TAG.food)
		table.insert(tags, TAG.unripe)
	elseif p.stage == "ripe" then
		table.insert(tags, TAG.food)
		table.insert(tags, TAG.ripe)
	elseif p.stage == "rotten" then
		table.insert(tags, TAG.rotten)
	end
	if Farm.isGrowing(p) and p.water <= 0 then
		table.insert(tags, TAG.dry)
	end
	if p.fertilized then
		table.insert(tags, TAG.fertilized)
	end
	if p.health < 1 then
		table.insert(tags, TAG.damaged)
	end
	local value = if p.stage == "rotten" then 0 else math.round(Farm.expectedYield(p) * ITEMS[crop].sell)
	local o: FarmObject = { id = p.id, x = p.x, y = p.y, tags = tags, value = value, label = `{ITEMS[crop].name}, {STAGE_NAME[p.stage]}` }
	if Farm.isGrowing(p) then
		o.ripeInMs = Farm.ripeInMs(p)
	end
	return o
end

function Contract.objects(f: FarmState): { FarmObject }
	local out = {}
	for _, p in f.plots do
		table.insert(out, plotObject(p))
	end

	local s = BUILDINGS.storage
	local stTags = { TAG.storage, TAG.building }
	local has = {}
	local value = 0
	for _, i in Config.ITEM_LIST do
		if f.stock[i] > 0 then
			table.insert(has, i)
			value += f.stock[i] * ITEMS[i].sell
		end
	end
	if #has > 0 then
		table.insert(stTags, TAG.food)
		table.insert(stTags, TAG.hasFood)
		for _, i in has do
			table.insert(stTags, itemTag(i))
		end
	end
	if Farm.storedCount(f) >= Farm.storageCap(f) then
		table.insert(stTags, TAG.full)
	end
	table.insert(out, { id = "storage", x = s.x, y = s.y, tags = stTags, value = value, label = if #has > 0 then "амбар, есть еда" else "амбар, пусто" })

	if f.tray then
		local tx, ty = Farm.trayPos()
		table.insert(out, { id = "tray", x = tx, y = ty, tags = { TAG.tray, TAG.food, TAG.hot, itemTag("bread") }, value = f.tray.bread * ITEMS.bread.sell, label = `противень: {f.tray.bread} 🍞, горячий` })
	end

	if f.buildings.coop > 0 then
		local c = BUILDINGS.coop
		local tags = { TAG.coop, TAG.building, TAG.chickens }
		if f.tMs < f.coop.scaredUntilMs then
			table.insert(tags, TAG.scared)
		end
		table.insert(out, { id = "coop", x = c.x, y = c.y, tags = tags, value = 0, label = "курятник" })
	end

	for _, b in { "well", "compost", "mill", "bakery", "kitchen" } do
		if f.buildings[b] > 0 then
			table.insert(out, { id = "building:" .. b, x = BUILDINGS[b].x, y = BUILDINGS[b].y, tags = { TAG.building, "building:" .. b }, value = 0, label = string.lower(BUILDINGS[b].name) })
		end
	end

	local con = f.construction
	if con then
		local b = BUILDINGS[con.building]
		local x, y = b.x, b.y
		if con.building == "fields" then
			local g = FARM.plotGrid
			x, y = g.x0 + g.step, g.y0 + math.ceil(#f.plots / g.cols) * g.step
		end
		table.insert(out, { id = "construction", x = x, y = y, tags = { TAG.construction, "building:" .. con.building }, value = 0, label = "стройка: " .. b.name })
	end
	return out
end

-- ---------- Входы ----------

local function growingOrRipe(p: Plot): boolean
	return p.crop ~= nil and (p.stage == "seed" or p.stage == "green" or p.stage == "ripe")
end

-- Часть урожая на грядке пропала (растоптали, поклевали, побило градом).
-- share — доля от полного урожая (0..1). Возвращает, сколько реально потеряно.
function Contract.damagePlot(f: FarmState, plotId: string, share: number, cause: string): number
	local p = Farm.plotById(f, plotId)
	if not p or not growingOrRipe(p) or share <= 0 then
		return 0
	end
	local crop = p.crop
	local before = p.health
	p.health = math.max(0, p.health - math.min(1, share))
	local lost = before - p.health
	if p.health < FARM.destroyBelow then
		local stage = p.stage
		f.totals.destroyed += 1
		Farm.emit(f, { kind = "destroyed", plotId = p.id, crop = crop, stage = stage, cause = cause })
		Farm.clearPlot(p)
	else
		Farm.emit(f, { kind = "damaged", plotId = p.id, crop = crop, share = lost, health = p.health, cause = cause })
	end
	return lost
end

-- Урожай с грядки съеден или унесён целиком. По стадии внешний мир сам решает, что значит «съел зелёное».
function Contract.eatPlot(f: FarmState, plotId: string, cause: string): { crop: string, stage: string, n: number }?
	local p = Farm.plotById(f, plotId)
	if not p or not growingOrRipe(p) then
		return nil
	end
	local res = { crop = p.crop :: string, stage = p.stage, n = math.max(1, Farm.randRound(f, Farm.expectedYield(p))) }
	f.totals.destroyed += 1
	Farm.emit(f, { kind = "destroyed", plotId = p.id, crop = res.crop, stage = res.stage, cause = cause })
	Farm.clearPlot(p)
	return res
end

-- «Урожай повреждён на N%»: всё, что растёт, теряет долю share.
function Contract.damageCrops(f: FarmState, share: number, cause: string, only: ((Plot) -> boolean)?): number
	local lost = 0
	for _, p in table.clone(f.plots) do
		if growingOrRipe(p) and (not only or only(p)) then
			lost += Contract.damagePlot(f, p.id, share, cause)
		end
	end
	return lost
end

local BY_VALUE = table.clone(Config.ITEM_LIST)
table.sort(BY_VALUE, function(a, b)
	return ITEMS[a].sell > ITEMS[b].sell
end)

-- Взять из амбара. item = "any" — самое ценное первым (так выбирает вор).
function Contract.takeFromStorage(f: FarmState, item: string, n: number, cause: string): { [string]: number }
	local got: { [string]: number } = {}
	local order: { string } = {} -- в каком порядке брали (как в журнале веб-фермы)
	for _ = 1, n do
		local it: string? = nil
		if item == "any" then
			for _, x in BY_VALUE do
				if f.stock[x] > 0 then
					it = x
					break
				end
			end
		elseif (f.stock[item] or 0) > 0 then
			it = item
		end
		if not it then
			break
		end
		f.stock[it] -= 1
		if not got[it] then
			table.insert(order, it)
		end
		got[it] = (got[it] or 0) + 1
	end
	for _, it in order do
		f.totals.taken += got[it]
		Farm.emit(f, { kind = "taken", item = it, n = got[it], from = "storage", cause = cause })
	end
	return got
end

-- Стащить хлеб с противня, пока остывает.
function Contract.takeFromTray(f: FarmState, n: number, cause: string): number
	local tray = f.tray
	if not tray then
		return 0
	end
	local k = math.min(n, tray.bread)
	tray.bread -= k
	if tray.bread <= 0 then
		f.tray = nil
	end
	if k > 0 then
		f.totals.taken += k
		Farm.emit(f, { kind = "taken", item = "bread", n = k, from = "tray", cause = cause })
	end
	return k
end

-- Навоз и другие внешние удобрения. Компостер удваивает.
function Contract.addFertilizer(f: FarmState, n: number, source: string): number
	local add = Farm.addFertilizerRaw(f, if f.buildings.compost > 0 then n * 2 else n)
	if add > 0 then
		Farm.emit(f, { kind = "fertilizer", n = add, source = source })
	end
	return add
end

-- Кто-то носит камни на стройку: оставшееся время меньше на ms.
function Contract.helpConstruction(f: FarmState, ms: number, cause: string): number
	local c = f.construction
	if not c or ms <= 0 then
		return 0
	end
	local d = math.min(ms, c.remainingMs)
	c.remainingMs -= d
	Farm.emit(f, { kind = "build_helped", ms = d, cause = cause })
	if c.remainingMs <= 0 then
		Farm.finishConstruction(f)
	end
	return d
end

-- Дождь полил всё, что растёт. Возвращает число политых грядок.
function Contract.waterAll(f: FarmState, cause: string): number
	local n = 0
	for _, p in f.plots do
		if Farm.isGrowing(p) and p.water < 100 then
			p.water = 100
			n += 1
		end
	end
	if n > 0 then
		Farm.emit(f, { kind = "watered", n = n, cause = cause })
	end
	return n
end

-- Кур напугали: яиц не будет ms.
function Contract.scareChickens(f: FarmState, ms: number, cause: string)
	if f.buildings.coop == 0 then
		return
	end
	f.coop.scaredUntilMs = math.max(f.coop.scaredUntilMs, f.tMs + ms)
	f.coop.nextEggAtMs = math.max(f.coop.nextEggAtMs, f.coop.scaredUntilMs)
	Farm.emit(f, { kind = "chickens_scared", ms = ms, cause = cause })
end

-- Забрать новые события. Каждое отдаётся один раз.
function Contract.drainEvents(f: FarmState): { Farm.LoggedEvent }
	local out = f.outbox
	f.outbox = {}
	return out
end

return Contract
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Farm</string>
            <string name="Source"><![CDATA[--!strict
-- Ядро фермы: состояние, ход времени и команды игрока. Без зверя, без гоблинов.
-- Перенос farm_lab v0.3 (src/farm/farm.ts). Модуль не трогает Roblox API:
-- его гоняют тесты в Lune, а на сервере Roblox он живёт как обычный ModuleScript.

local Config = if typeof(script) == "Instance" then require(script.Parent.Config) else require("./Config")

local FARM = Config.FARM
local CROPS = Config.CROPS
local ITEMS = Config.ITEMS
local BUILDINGS = Config.BUILDINGS
local RECIPES = Config.RECIPES

export type Plot = {
	id: string,
	x: number,
	y: number,
	crop: string?,
	stage: string, -- empty | seed | green | ripe | rotten
	growth: number, -- 0..1
	water: number, -- 0..100
	fertilized: boolean,
	health: number, -- 0..1: доля урожая, уцелевшая после повреждений
	ripeSeenMs: number, -- сколько зрелое пролежало при игроке (гниль считается только по нему)
}

export type Timer = { doneAtMs: number, totalMs: number, dish: string? }

export type Event = { [string]: any } -- { kind = "planted", plotId = ..., ... }, поля как в types.ts
export type LoggedEvent = { tMs: number, e: Event }

export type FarmState = {
	version: number,
	seed: number,
	rng: number,
	tMs: number,
	savedAtWallMs: number,
	nextId: number,
	coins: number,
	xp: number,
	level: number,
	plots: { Plot },
	stock: { [string]: number },
	fertilizer: number,
	buildings: { [string]: number },
	construction: { building: string, level: number, remainingMs: number, totalMs: number }?,
	orders: { { id: string, customer: string, items: { [string]: number }, coins: number, xp: number } },
	ordersDone: number,
	mill: Timer?,
	bakery: Timer?,
	kitchen: Timer?,
	tray: { bread: number, coolUntilMs: number }?,
	coop: { nextEggAtMs: number, scaredUntilMs: number },
	wellNextAtMs: number,
	totals: { [string]: number },
	log: { LoggedEvent },
	outbox: { LoggedEvent },
	hint: string?,
}

local Farm = {}

-- ---------- Случайность с сидом (mulberry32, как в TS: те же числа при том же сиде) ----------

local function u32(x: number): number
	return x % 4294967296
end

-- Нижние 32 бита произведения (Math.imul), без потери точности double.
local function imul(a: number, b: number): number
	local ah, al = bit32.rshift(a, 16), bit32.band(a, 0xffff)
	local bh, bl = bit32.rshift(b, 16), bit32.band(b, 0xffff)
	local mid = bit32.band(ah * bl + al * bh, 0xffff)
	return u32(al * bl + mid * 65536)
end

function Farm.rand(f: FarmState): number
	f.rng = u32(f.rng + 0x6d2b79f5)
	local t = f.rng
	t = imul(bit32.bxor(t, bit32.rshift(t, 15)), bit32.bor(t, 1))
	t = bit32.bxor(t, u32(t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(t, 61))))
	return bit32.bxor(t, bit32.rshift(t, 14)) / 4294967296
end

-- Дробное количество превращается в целое честно: 1,4 — это 1 или 2 с шансом 40%.
function Farm.randRound(f: FarmState, x: number): number
	local base = math.floor(x)
	return base + (if Farm.rand(f) < x - base then 1 else 0)
end

-- ---------- Журнал ----------

local function trim(list: { LoggedEvent })
	local extra = #list - FARM.logKeep
	if extra > 0 then
		table.move(list, extra + 1, #list, 1)
		for i = #list, #list - extra + 1, -1 do
			list[i] = nil
		end
	end
end

function Farm.emit(f: FarmState, e: Event)
	local le = { tMs = f.tMs, e = e }
	table.insert(f.log, le)
	trim(f.log)
	table.insert(f.outbox, le)
	trim(f.outbox)
end

-- ---------- Создание ----------

-- i считается с нуля, как в вебе: plot0, plot1, ...
function Farm.plotPosition(i: number): (number, number)
	local g = FARM.plotGrid
	return g.x0 + (i % g.cols) * g.step, g.y0 + math.floor(i / g.cols) * g.step
end

local function makePlot(i: number): Plot
	local x, y = Farm.plotPosition(i)
	return { id = "plot" .. i, x = x, y = y, crop = nil, stage = "empty", growth = 0, water = 0, fertilized = false, health = 1, ripeSeenMs = 0 }
end

function Farm.emptyStock(): { [string]: number }
	local s = {}
	for _, it in Config.ITEM_LIST do
		s[it] = 0
	end
	return s
end

function Farm.stageFor(crop: string, growth: number): string
	if growth >= 1 then
		return "ripe"
	end
	return if growth >= CROPS[crop].greenAt then "green" else "seed"
end

function Farm.create(seed: number): FarmState
	local plots = {}
	for i = 0, FARM.basePlots - 1 do
		table.insert(plots, makePlot(i))
	end
	local stock = Farm.emptyStock()
	stock.wheat = 3
	stock.carrot = 2
	local f: FarmState = {
		version = FARM.saveVersion,
		seed = seed,
		rng = u32(seed),
		tMs = 0,
		savedAtWallMs = 0,
		nextId = 1,
		coins = FARM.startCoins,
		xp = FARM.startXp,
		level = 1,
		plots = plots,
		stock = stock,
		fertilizer = FARM.startFertilizer,
		buildings = { storage = 1, fields = 0, well = 0, compost = 0, coop = 0, mill = 0, bakery = 0, kitchen = 0 },
		construction = nil,
		orders = {},
		ordersDone = 0,
		mill = nil,
		bakery = nil,
		kitchen = nil,
		tray = nil,
		coop = { nextEggAtMs = 0, scaredUntilMs = 0 },
		wellNextAtMs = 0,
		totals = { harvested = 0, lostToDamage = 0, destroyed = 0, taken = 0, rotten = 0, sold = 0, earned = 0 },
		log = {},
		outbox = {},
		hint = nil,
	}
	-- Стартовые грядки: что-то уже растёт, одна морковь почти зелёная.
	for _, s in { { 1, "wheat", 0.6 }, { 2, "carrot", 0.3 }, { 3, "carrot", 0.95 } } do
		local p = f.plots[s[1]]
		p.crop = s[2]
		p.growth = s[3]
		p.water = 60
		p.stage = Farm.stageFor(s[2], s[3])
	end
	for _ = 1, FARM.orderCount do
		table.insert(f.orders, Farm.makeOrder(f))
	end
	return f
end

function Farm.plotById(f: FarmState, id: string): Plot?
	for _, p in f.plots do
		if p.id == id then
			return p
		end
	end
	return nil
end

function Farm.clearPlot(p: Plot)
	p.crop = nil
	p.stage = "empty"
	p.growth = 0
	p.water = 0
	p.fertilized = false
	p.health = 1
	p.ripeSeenMs = 0
end

local function isGrowing(p: Plot): boolean
	return p.crop ~= nil and (p.stage == "seed" or p.stage == "green")
end
Farm.isGrowing = isGrowing

-- ---------- Уровень и опыт ----------

function Farm.xpForLevel(level: number): number
	local t = FARM.levelXp
	return t[level] or (t[#t] + (level - #t) * 200)
end

function Farm.addXp(f: FarmState, n: number)
	f.xp += math.max(0, math.round(n))
	while f.xp >= Farm.xpForLevel(f.level + 1) do
		f.level += 1
		Farm.emit(f, { kind = "level_up", level = f.level })
		f.hint = `⭐ Уровень фермы {f.level}!`
	end
end

-- ---------- Амбар ----------

function Farm.storageCap(f: FarmState): number
	return FARM.storageCap[f.buildings.storage] or 25
end

function Farm.storedCount(f: FarmState): number
	local s = 0
	for _, it in Config.ITEM_LIST do
		s += f.stock[it]
	end
	return s
end

function Farm.addItem(f: FarmState, item: string, n: number): number
	local put = math.max(0, math.min(Farm.storageCap(f) - Farm.storedCount(f), n))
	f.stock[item] += put
	if put < n then
		f.hint = "Амбар полон! Продай что-нибудь или улучши амбар"
		Farm.emit(f, { kind = "storage_full", item = item, n = n - put })
	end
	return put
end

local function hasItems(f: FarmState, needs: { [string]: number }): boolean
	for it, n in needs do
		if f.stock[it] < n then
			return false
		end
	end
	return true
end
Farm.hasItems = hasItems

local function takeItems(f: FarmState, needs: { [string]: number }): boolean
	if not hasItems(f, needs) then
		return false
	end
	for it, n in needs do
		f.stock[it] -= n
	end
	return true
end

function Farm.fertCap(f: FarmState): number
	return FARM.fertCap[if f.buildings.compost > 0 then 2 else 1]
end

function Farm.addFertilizerRaw(f: FarmState, n: number): number
	local add = math.max(0, math.min(n, Farm.fertCap(f) - f.fertilizer))
	f.fertilizer += add
	return add
end

-- ---------- Урожай ----------

-- Сколько даст грядка, если собрать сейчас (до округления).
function Farm.expectedYield(p: Plot): number
	if not p.crop then
		return 0
	end
	return (FARM.harvestYield + (if p.fertilized then FARM.fertBonus else 0)) * p.health
end

-- Сколько осталось до спелости: пока есть вода — быстро, потом медленно (как в tick).
function Farm.ripeInMs(p: Plot): number
	if not isGrowing(p) then
		return 0
	end
	local fert = if p.fertilized then FARM.fertMul else 1
	local left = (1 - p.growth) * CROPS[p.crop :: string].growMs -- мс при множителе 1
	local wetMs = (p.water / FARM.waterDecayPerSec) * 1000
	local wetGain = wetMs * FARM.wetMul * fert
	if wetGain >= left then
		return math.ceil(left / (FARM.wetMul * fert))
	end
	return math.ceil(wetMs + (left - wetGain) / (FARM.dryMul * fert))
end

function Farm.harvest(f: FarmState, p: Plot): number
	if p.stage ~= "ripe" or not p.crop then
		return 0
	end
	local crop = p.crop :: string
	local full = FARM.harvestYield + (if p.fertilized then FARM.fertBonus else 0)
	local want = Farm.randRound(f, full * p.health)
	local n = if want > 0 then Farm.addItem(f, crop, want) else 0
	if want > 0 and n == 0 then
		return 0 -- амбар полон — урожай ждёт на грядке
	end
	f.totals.harvested += n
	f.totals.lostToDamage += full - want
	Farm.addXp(f, CROPS[crop].xp)
	Farm.emit(f, { kind = "harvested", plotId = p.id, crop = crop, n = n, lost = full - want })
	Farm.clearPlot(p)
	return n
end

-- ---------- Заказы ----------

local function orderableItems(f: FarmState): { string }
	local list = { "wheat", "carrot" }
	if f.level >= CROPS.strawberry.level then
		table.insert(list, "strawberry")
	end
	if f.level >= CROPS.pumpkin.level then
		table.insert(list, "pumpkin")
	end
	if f.buildings.mill > 0 then
		table.insert(list, "flour")
	end
	if f.buildings.coop > 0 then
		table.insert(list, "egg")
	end
	if f.buildings.bakery > 0 then
		table.insert(list, "bread")
	end
	if f.buildings.kitchen > 0 then
		for _, d in Config.RECIPE_ORDER do
			if f.level >= RECIPES[d].level then
				table.insert(list, d)
			end
		end
	end
	return list
end

function Farm.makeOrder(f: FarmState)
	local items = orderableItems(f)
	local kinds = 1 + math.floor(Farm.rand(f) * math.min(3, #items))
	local chosen: { [string]: number } = {}
	local value = 0
	for _ = 1, kinds do
		local it = items[1 + math.floor(Farm.rand(f) * #items)]
		local big = ITEMS[it].sell >= 14
		local amt = 1 + math.floor(Farm.rand(f) * (if big then 2 else 4))
		chosen[it] = (chosen[it] or 0) + amt
		value += amt * ITEMS[it].sell
	end
	local coins = math.round(value * FARM.orderBonus + 3)
	local id = "o" .. f.nextId
	f.nextId += 1
	local customer = Config.CUSTOMERS[1 + math.floor(Farm.rand(f) * #Config.CUSTOMERS)]
	return { id = id, customer = customer, items = chosen, coins = coins, xp = math.max(1, math.round(coins * FARM.orderXpPerCoin)) }
end

function Farm.canComplete(f: FarmState, o): boolean
	return hasItems(f, o.items)
end

-- ---------- Стройка ----------

-- Возвращает ok, а дальше либо (cost, level), либо причину отказа.
function Farm.canBuild(f: FarmState, b: string): (boolean, any, number?)
	local info = BUILDINGS[b]
	local lvl = f.buildings[b]
	if lvl >= info.maxLevel then
		return false, "уже максимум"
	end
	if f.level < info.level then
		return false, `откроется на уровне {info.level}`
	end
	if f.construction then
		return false, "уже идёт стройка"
	end
	if b == "bakery" and (f.buildings.mill == 0 or f.buildings.coop == 0) then
		return false, "сначала мельница и курятник"
	end
	local cost = info.cost[lvl + 1] or info.cost[#info.cost]
	if f.coins < cost then
		return false, `нужно {cost} 💰`
	end
	return true, cost, lvl + 1
end

function Farm.finishConstruction(f: FarmState)
	local c = f.construction
	if not c then
		return
	end
	f.construction = nil
	f.buildings[c.building] = c.level
	if c.building == "fields" then
		local start = #f.plots
		for i = start, start + FARM.plotsPerLevel - 1 do
			table.insert(f.plots, makePlot(i))
		end
	end
	if c.building == "coop" then
		f.coop.nextEggAtMs = f.tMs + FARM.coop.eggEveryMs
	end
	if c.building == "well" then
		f.wellNextAtMs = f.tMs
	end
	Farm.addXp(f, (BUILDINGS[c.building].cost[c.level] or 0) * FARM.buildXpPerCoin)
	Farm.emit(f, { kind = "built", building = c.building, level = c.level })
	f.hint = `🏗 {BUILDINGS[c.building].name} готово!`
end

-- ---------- Кухня ----------

function Farm.canCook(f: FarmState, d: string): (boolean, string)
	local r = RECIPES[d]
	if f.buildings.kitchen == 0 then
		return false, "нужна кухня"
	end
	if f.level < r.level then
		return false, `откроется на уровне {r.level}`
	end
	if f.kitchen then
		return false, "плита занята"
	end
	for it, n in r.needs do
		if f.stock[it] < n then
			return false, `не хватает: {ITEMS[it].icon}`
		end
	end
	return true, ""
end

function Farm.trayPos(): (number, number)
	return BUILDINGS.bakery.x - 90, BUILDINGS.bakery.y + 10
end

local function moveTrayToStorage(f: FarmState)
	local tray = f.tray
	if not tray then
		return
	end
	local put = Farm.addItem(f, "bread", tray.bread)
	if put > 0 then
		Farm.emit(f, { kind = "produced", item = "bread", n = put, by = "bakery" })
	end
	tray.bread -= put
	if tray.bread <= 0 then
		f.tray = nil
	else
		tray.coolUntilMs = f.tMs + 5000 -- амбар полон — подождём
	end
end

-- ---------- Ход времени ----------

-- offline = игрока нет: всё растёт и производится, но зрелое не гниёт.
-- Гниёт только то, что созрело при игроке и было брошено.
function Farm.tick(f: FarmState, dtMs: number, offline: boolean?)
	f.tMs += dtMs
	local t = f.tMs
	local sec = dtMs / 1000

	for _, p in f.plots do
		local crop = p.crop
		if not crop or p.stage == "empty" or p.stage == "rotten" then
			continue
		end
		if p.stage == "ripe" then
			if offline then
				continue
			end
			p.ripeSeenMs += dtMs
			if p.ripeSeenMs >= FARM.rotAfterMs then
				p.stage = "rotten"
				f.totals.rotten += 1
				Farm.emit(f, { kind = "rotten", plotId = p.id, crop = crop })
			end
			continue
		end
		local mul = (if p.water > 0 then FARM.wetMul else FARM.dryMul) * (if p.fertilized then FARM.fertMul else 1)
		p.growth = math.min(1, p.growth + (dtMs * mul) / CROPS[crop].growMs)
		p.water = math.max(0, p.water - FARM.waterDecayPerSec * sec)
		local st = Farm.stageFor(crop, p.growth)
		if st ~= p.stage then
			p.stage = st
			if st == "ripe" then
				p.ripeSeenMs = 0
				Farm.emit(f, { kind = "ripe", plotId = p.id, crop = crop })
			end
		end
	end

	local c = f.construction
	if c then
		c.remainingMs -= dtMs
		if c.remainingMs <= 0 then
			Farm.finishConstruction(f)
		end
	end

	-- Готовая мука ждёт на мельнице, если амбар полон.
	if f.mill and t >= f.mill.doneAtMs and Farm.addItem(f, "flour", 1) == 1 then
		f.mill = nil
		Farm.emit(f, { kind = "produced", item = "flour", n = 1, by = "mill" })
	end
	if f.bakery and t >= f.bakery.doneAtMs then
		f.bakery = nil
		f.tray = { bread = (if f.tray then f.tray.bread else 0) + FARM.bakery.bread, coolUntilMs = t + FARM.trayCoolMs }
	end
	if f.tray and t >= f.tray.coolUntilMs then
		moveTrayToStorage(f)
	end
	local k = f.kitchen
	if k and t >= k.doneAtMs and Farm.addItem(f, k.dish :: string, 1) == 1 then
		Farm.emit(f, { kind = "produced", item = k.dish, n = 1, by = "kitchen" })
		f.kitchen = nil
	end

	-- Курятник: яйцо, если есть пшеница на корм и куры не напуганы.
	if f.buildings.coop > 0 and t >= f.coop.nextEggAtMs and t >= f.coop.scaredUntilMs then
		f.coop.nextEggAtMs = t + FARM.coop.eggEveryMs
		if f.stock.wheat > 0 and Farm.addItem(f, "egg", 1) == 1 then
			f.stock.wheat -= 1
			Farm.emit(f, { kind = "produced", item = "egg", n = 1, by = "coop" })
		end
	end

	local wl = f.buildings.well
	if wl > 0 and t >= f.wellNextAtMs then
		f.wellNextAtMs = t + FARM.wellEveryMs[wl]
		for _, p in f.plots do
			if isGrowing(p) then
				p.water = 100
			end
		end
	end
end

-- Офлайн: шагами по секунде, не дольше предела. Зрелое за это время не гниёт.
function Farm.advance(f: FarmState, ms: number)
	local left = math.min(ms, FARM.offlineMaxMs)
	while left > 0 do
		local d = math.min(1000, left)
		Farm.tick(f, d, true)
		left -= d
	end
end

-- ---------- Команды игрока ----------
-- Команда — таблица { type = "plant", plotId = "plot3", crop = "carrot" } и т.п., как FarmCommand в TS.
-- Сервер Roblox проверяет форму команды до вызова (FarmService), здесь — правила игры.

local function no(f: FarmState, why: string): boolean
	f.hint = why
	return false
end

local handlers: { [string]: (FarmState, any) -> boolean } = {}

handlers.plant = function(f, c)
	local p = Farm.plotById(f, c.plotId)
	if not p or p.stage ~= "empty" then
		return false
	end
	local info = CROPS[c.crop]
	if f.level < info.level then
		return no(f, `{ITEMS[c.crop].name}: откроется на уровне {info.level}`)
	end
	local bag = (f :: any).seeds -- мешок семян (Roblox-версия с лавкой); в вебе его нет
	if bag and info.seedCost > 0 then
		if (bag[c.crop] or 0) <= 0 then
			return no(f, `нет семян: {ITEMS[c.crop].name}. Купи в лавке семян`)
		end
		bag[c.crop] -= 1
	else
		if f.coins < info.seedCost then
			return no(f, `семена стоят {info.seedCost} 💰`)
		end
		f.coins -= info.seedCost
	end
	Farm.clearPlot(p)
	p.crop = c.crop
	p.stage = "seed"
	Farm.emit(f, { kind = "planted", plotId = p.id, crop = c.crop })
	return true
end

handlers.water = function(f, c)
	local p = Farm.plotById(f, c.plotId)
	if not p or not isGrowing(p) then
		return false
	end
	p.water = 100
	return true
end

handlers.water_all = function(f, _c)
	local n = 0
	for _, p in f.plots do
		if isGrowing(p) then
			p.water = 100
			n += 1
		end
	end
	return n > 0
end

handlers.fertilize = function(f, c)
	local p = Farm.plotById(f, c.plotId)
	if not p or p.fertilized or not isGrowing(p) then
		return false
	end
	if f.fertilizer <= 0 then
		return no(f, "нет удобрения")
	end
	f.fertilizer -= 1
	p.fertilized = true
	return true
end

handlers.harvest = function(f, c)
	local p = Farm.plotById(f, c.plotId)
	return p ~= nil and Farm.harvest(f, p) > 0
end

handlers.harvest_all = function(f, _c)
	local n = 0
	for _, p in f.plots do
		if p.stage == "ripe" then
			n += Farm.harvest(f, p)
		end
	end
	return n > 0
end

handlers.clear = function(f, c)
	local p = Farm.plotById(f, c.plotId)
	if not p or p.stage ~= "rotten" then
		return false
	end
	Farm.clearPlot(p)
	if f.buildings.compost > 0 then
		local n = Farm.addFertilizerRaw(f, 1)
		if n > 0 then
			Farm.emit(f, { kind = "fertilizer", n = n, source = "компостер" })
		end
	end
	return true
end

handlers.sell = function(f, c)
	local n = math.min(c.count, f.stock[c.item])
	if n <= 0 then
		return false
	end
	f.stock[c.item] -= n
	local coins = n * ITEMS[c.item].sell
	f.coins += coins
	f.totals.sold += n
	f.totals.earned += coins
	Farm.emit(f, { kind = "sold", item = c.item, n = n, coins = coins })
	return true
end

local function replaceOrder(f: FarmState, id: string)
	for i, o in f.orders do
		if o.id == id then
			f.orders[i] = Farm.makeOrder(f)
		end
	end
end

handlers.complete_order = function(f, c)
	local o
	for _, x in f.orders do
		if x.id == c.orderId then
			o = x
		end
	end
	if not o then
		return false
	end
	if not takeItems(f, o.items) then
		return no(f, "не хватает продуктов")
	end
	f.coins += o.coins
	f.totals.earned += o.coins
	f.ordersDone += 1
	Farm.addXp(f, o.xp)
	Farm.emit(f, { kind = "order_done", customer = o.customer, coins = o.coins })
	replaceOrder(f, o.id)
	f.hint = `+{o.coins} 💰`
	return true
end

handlers.skip_order = function(f, c)
	replaceOrder(f, c.orderId)
	return true
end

handlers.build = function(f, c)
	local ok, costOrWhy, level = Farm.canBuild(f, c.building)
	if not ok then
		return no(f, costOrWhy)
	end
	f.coins -= costOrWhy
	local ms = BUILDINGS[c.building].buildMs[level :: number] or 60000
	f.construction = { building = c.building, level = level :: number, remainingMs = ms, totalMs = ms }
	Farm.emit(f, { kind = "build_started", building = c.building, level = level })
	if ms <= 0 then
		Farm.finishConstruction(f)
	end
	return true
end

handlers.start_mill = function(f, _c)
	if f.buildings.mill == 0 or f.mill then
		return false
	end
	if not takeItems(f, { wheat = FARM.mill.wheat }) then
		return no(f, `нужно {FARM.mill.wheat} 🌾`)
	end
	f.mill = { doneAtMs = f.tMs + FARM.mill.ms, totalMs = FARM.mill.ms }
	return true
end

handlers.start_bakery = function(f, _c)
	if f.buildings.bakery == 0 or f.bakery then
		return false
	end
	if not takeItems(f, { flour = 1, egg = 1 }) then
		return no(f, "нужны 🥡 мука и 🥚 яйцо")
	end
	f.bakery = { doneAtMs = f.tMs + FARM.bakery.ms, totalMs = FARM.bakery.ms }
	return true
end

handlers.cook = function(f, c)
	local ok, why = Farm.canCook(f, c.dish)
	if not ok then
		return no(f, why)
	end
	local r = RECIPES[c.dish]
	takeItems(f, r.needs)
	f.kitchen = { dish = c.dish, doneAtMs = f.tMs + r.cookMs, totalMs = r.cookMs }
	return true
end

handlers.take_tray = function(f, _c)
	if not f.tray then
		return false
	end
	moveTrayToStorage(f)
	return true
end

function Farm.command(f: FarmState, c: { [string]: any }): boolean
	local h = handlers[c.type]
	return if h then h(f, c) else false
end

return Farm
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Save</string>
            <string name="Source"><![CDATA[--!strict
-- Сохранение фермы в простую таблицу и обратно (перенос src/farm/save.ts).
-- Таблица без функций и Instance, её можно положить в DataStore как есть.
-- DataStore на сервере пока выключен (см. FarmService, USE_DATASTORE).

local IS_ROBLOX = typeof(script) == "Instance"
local Config = if IS_ROBLOX then require(script.Parent.Config) else require("./Config")
local Farm = if IS_ROBLOX then require(script.Parent.Farm) else require("./Farm")

local Save = {}

local function deepCopy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = deepCopy(x)
	end
	return out
end

-- wallSec — настоящее время (os.time() на сервере), чтобы при входе дожить офлайн.
function Save.toData(f: Farm.FarmState, wallSec: number): { [string]: any }
	local data = deepCopy(f)
	data.savedAtWallMs = wallSec * 1000
	data.outbox = {}
	data.log = {} -- журнал не храним: экономим место в DataStore
	return data
end

function Save.fromData(data: any): (Farm.FarmState?, string?)
	if type(data) ~= "table" then
		return nil, "нет данных"
	end
	if data.version ~= Config.FARM.saveVersion then
		return nil, `сохранение версии {data.version}, нужна {Config.FARM.saveVersion}`
	end
	local f = deepCopy(data)
	local stock = Farm.emptyStock()
	for k, n in (f.stock or {}) do
		if type(n) == "number" then
			stock[k] = n
		end
	end
	f.stock = stock
	for _, p in f.plots do
		if type(p.ripeSeenMs) ~= "number" then
			p.ripeSeenMs = 0
		end
	end
	f.log = f.log or {}
	f.outbox = {}
	return f, nil
end

-- Вход игрока: ферма доживает время, пока его не было (до 8 часов, зрелое не гниёт).
function Save.catchUp(f: Farm.FarmState, nowWallSec: number): number
	local awayMs = math.max(0, nowWallSec * 1000 - (f.savedAtWallMs or 0))
	if f.savedAtWallMs and f.savedAtWallMs > 0 and awayMs > 0 then
		Farm.advance(f, awayMs)
		return math.min(awayMs, Config.FARM.offlineMaxMs)
	end
	return 0
end

return Save
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[--!strict
-- Лавка семян как в Grow a Garden: запас обновляется каждые 5 минут и одинаков
-- на всех серверах. Номер интервала берётся из общего времени сервера
-- (workspace:GetServerTimeNow()), запас считается из него без связи между серверами.
-- Каждый игрок покупает из своей копии запаса. Пшеница всегда бесплатна и без лавки,
-- чтобы игрок никогда не застрял без семян.

local IS_ROBLOX = typeof(script) == "Instance"
local Config = if IS_ROBLOX then require(script.Parent.Config) else require("./Config")
local Farm = if IS_ROBLOX then require(script.Parent.Farm) else require("./Farm")

local Shop = {}

Shop.INTERVAL_SEC = 300
Shop.SALT = 0x5eed -- меняется — меняется весь будущий запас
Shop.CROPS = { "carrot", "strawberry", "pumpkin" }

-- Сколько пачек может выпасть: [мин, макс] и шанс, что культура вообще будет в лавке.
Shop.STOCK = {
	carrot = { min = 4, max = 9, chance = 1 },
	strawberry = { min = 2, max = 6, chance = 0.85 },
	pumpkin = { min = 1, max = 3, chance = 0.5 },
}

function Shop.interval(serverTimeSec: number): number
	return math.floor(serverTimeSec / Shop.INTERVAL_SEC)
end

function Shop.secondsLeft(serverTimeSec: number): number
	return Shop.INTERVAL_SEC - (serverTimeSec % Shop.INTERVAL_SEC)
end

-- Запас лавки на интервал n: одинаковый для всех серверов и игроков.
function Shop.stock(n: number): { [string]: number }
	local r = { rng = (n * 7919 + Shop.SALT) % 4294967296 } :: any
	local out = {}
	for _, c in Shop.CROPS do
		local s = Shop.STOCK[c]
		local roll = Farm.rand(r)
		local k = s.min + math.floor(Farm.rand(r) * (s.max - s.min + 1))
		out[c] = if roll < s.chance then k else 0
	end
	return out
end

-- У фермы появляются мешок семян и запись о покупках в текущем интервале.
function Shop.attach(f: Farm.FarmState)
	local x = f :: any
	x.seeds = x.seeds or { carrot = 2, strawberry = 0, pumpkin = 0 }
	x.shop = x.shop or { interval = -1, bought = {} }
end

-- Сколько ещё можно купить этому игроку сейчас.
function Shop.left(f: Farm.FarmState, serverTimeSec: number): { [string]: number }
	local x = f :: any
	local n = Shop.interval(serverTimeSec)
	if x.shop.interval ~= n then
		x.shop = { interval = n, bought = {} }
	end
	local out = {}
	for c, k in Shop.stock(n) do
		out[c] = math.max(0, k - (x.shop.bought[c] or 0))
	end
	return out
end

function Shop.buy(f: Farm.FarmState, crop: string, serverTimeSec: number): boolean
	local x = f :: any
	local info = Config.CROPS[crop]
	if not info or not Shop.STOCK[crop] then
		return false
	end
	if f.level < info.level then
		f.hint = `{Config.ITEMS[crop].name}: откроется на уровне {info.level}`
		return false
	end
	if (Shop.left(f, serverTimeSec)[crop] or 0) <= 0 then
		f.hint = "Распродано. Лавка обновится через " .. math.ceil(Shop.secondsLeft(serverTimeSec)) .. " с"
		return false
	end
	if f.coins < info.seedCost then
		f.hint = `семена стоят {info.seedCost} 💰`
		return false
	end
	f.coins -= info.seedCost
	x.seeds[crop] = (x.seeds[crop] or 0) + 1
	x.shop.bought[crop] = (x.shop.bought[crop] or 0) + 1
	return true
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Text</string>
            <string name="Source"><![CDATA[--!strict
-- События фермы человеческим языком: для журнала на экране. Перенос src/farm/text.ts.

local Config = if typeof(script) == "Instance" then require(script.Parent.Config) else require("./Config")

local ITEMS = Config.ITEMS
local BUILDINGS = Config.BUILDINGS

local STAGE_WORD = { seed = "росток", green = "зелёная", ripe = "спелая", rotten = "гнилая", empty = "пусто" }

local function pct(x: number): string
	return `{math.round(x * 100)}%`
end

local function it(i: string): string
	return `{ITEMS[i].icon} {ITEMS[i].name}`
end

local function lvl(level: number): string
	return if level > 1 then ` (ур. {level})` else ""
end

local TEXT: { [string]: (any) -> string } = {
	planted = function(e) return `🌱 Посажено: {it(e.crop)}` end,
	ripe = function(e) return `✅ Созрело: {it(e.crop)}` end,
	harvested = function(e)
		return `🧺 Собрано: {it(e.crop)} ×{e.n}` .. (if e.lost > 0 then ` (потеряно {e.lost} из-за повреждений)` else "")
	end,
	rotten = function(e) return `🤢 Сгнило на грядке: {it(e.crop)}` end,
	damaged = function(e) return `⚠ {e.cause}: {it(e.crop)} потеряла {pct(e.share)}, уцелело {pct(e.health)}` end,
	destroyed = function(e) return `💥 {e.cause}: {ITEMS[e.crop].name} ({STAGE_WORD[e.stage] or "?"}) уничтожена целиком` end,
	taken = function(e)
		return `👐 {e.cause}: взято {it(e.item)} ×{e.n} (` .. (if e.from == "tray" then "с противня" else "из амбара") .. ")"
	end,
	produced = function(e) return `🏭 {BUILDINGS[e.by].name}: {it(e.item)} ×{e.n}` end,
	storage_full = function(e) return `📦 Амбар полон: {it(e.item)} ×{e.n} не влезло` end,
	sold = function(e) return `💰 Продано: {it(e.item)} ×{e.n} за {e.coins}` end,
	order_done = function(e) return `📜 Заказ «{e.customer}» выполнен: +{e.coins} 💰` end,
	build_started = function(e) return `🔨 Стройка: {BUILDINGS[e.building].name}{lvl(e.level)}` end,
	built = function(e) return `🏗 Построено: {BUILDINGS[e.building].name}{lvl(e.level)}` end,
	build_helped = function(e) return `🧱 {e.cause}: стройка быстрее на {math.round(e.ms / 1000)} с` end,
	fertilizer = function(e) return `✨ Удобрение +{e.n} ({e.source})` end,
	level_up = function(e) return `⭐ Уровень фермы {e.level}` end,
	watered = function(e) return `🌧 {e.cause}: полито грядок {e.n}` end,
	chickens_scared = function(e) return `🐔 {e.cause}: куры напуганы на {math.round(e.ms / 1000)} с` end,
}

return function(e: { [string]: any }): string
	local f = TEXT[e.kind]
	return if f then f(e) else e.kind
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">View</string>
            <string name="Source"><![CDATA[--!strict
-- Снимок фермы для экрана игрока. Сервер считает его из состояния и шлёт клиенту,
-- клиент только рисует: правила игры живут на сервере.

local IS_ROBLOX = typeof(script) == "Instance"
local Config = if IS_ROBLOX then require(script.Parent.Config) else require("./Config")
local Farm = if IS_ROBLOX then require(script.Parent.Farm) else require("./Farm")

local ITEMS = Config.ITEMS
local BUILDINGS = Config.BUILDINGS
local RECIPES = Config.RECIPES
local CROPS = Config.CROPS

local View = {}

local function itemsList(f: Farm.FarmState, needs: { [string]: number })
	local out = {}
	for _, it in Config.ITEM_LIST do
		local n = needs[it]
		if n then
			table.insert(out, { id = it, icon = ITEMS[it].icon, n = n, have = f.stock[it] })
		end
	end
	return out
end

local function timer(f: Farm.FarmState, t: Farm.Timer?)
	if not t then
		return nil
	end
	return { leftMs = math.max(0, t.doneAtMs - f.tMs), totalMs = t.totalMs, dish = t.dish }
end

function View.snapshot(f: Farm.FarmState, extra: { [string]: any }?)
	local stock = {}
	for _, it in Config.ITEM_LIST do
		if f.stock[it] > 0 then
			table.insert(stock, { id = it, icon = ITEMS[it].icon, name = ITEMS[it].name, n = f.stock[it], sell = ITEMS[it].sell })
		end
	end

	local orders = {}
	for _, o in f.orders do
		table.insert(orders, { id = o.id, customer = o.customer, items = itemsList(f, o.items), coins = o.coins, xp = o.xp, can = Farm.canComplete(f, o) })
	end

	local buildings = {}
	for _, b in Config.BUILDING_LIST do
		local info = BUILDINGS[b]
		local ok, costOrWhy = Farm.canBuild(f, b)
		local lvl = f.buildings[b]
		table.insert(buildings, {
			id = b,
			name = info.name,
			icon = info.icon,
			about = info.about,
			level = lvl,
			maxLevel = info.maxLevel,
			cost = info.cost[lvl + 1],
			can = ok,
			why = if ok then nil else costOrWhy,
		})
	end

	local crops = {}
	for _, c in Config.CROP_LIST do
		table.insert(crops, { id = c, icon = ITEMS[c].icon, name = ITEMS[c].name, cost = CROPS[c].seedCost, unlocked = f.level >= CROPS[c].level, level = CROPS[c].level })
	end

	local recipes = {}
	for _, d in Config.RECIPE_ORDER do
		local ok, why = Farm.canCook(f, d)
		table.insert(recipes, { id = d, icon = RECIPES[d].icon, name = RECIPES[d].name, needs = itemsList(f, RECIPES[d].needs), can = ok, why = why })
	end

	local con = f.construction
	return {
		coins = f.coins,
		level = f.level,
		xp = f.xp,
		xpFrom = Farm.xpForLevel(f.level),
		xpTo = Farm.xpForLevel(f.level + 1),
		fertilizer = f.fertilizer,
		fertCap = Farm.fertCap(f),
		used = Farm.storedCount(f),
		cap = Farm.storageCap(f),
		stock = stock,
		orders = orders,
		buildings = buildings,
		crops = crops,
		recipes = recipes,
		construction = if con then { name = BUILDINGS[con.building].name, icon = BUILDINGS[con.building].icon, leftMs = con.remainingMs, totalMs = con.totalMs } else nil,
		has = { mill = f.buildings.mill > 0, bakery = f.buildings.bakery > 0, kitchen = f.buildings.kitchen > 0, coop = f.buildings.coop > 0 },
		mill = timer(f, f.mill),
		bakery = timer(f, f.bakery),
		kitchen = timer(f, f.kitchen),
		tray = if f.tray then { bread = f.tray.bread, leftMs = math.max(0, f.tray.coolUntilMs - f.tMs) } else nil,
		hint = f.hint,
		extra = extra,
	}
end

return View
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Погода на весь сервер: сухо, потом дождь, иногда гроза. Дождь поливает все грядки,
-- во дворе набирается лужа, смелый зверь в ней прыгает, осторожный прячется в будку.
-- Только логика, без Roblox API: сервер рисует дождь и сообщает домам. Гоняется тестами в Lune.

local Weather = {}

Weather.CONFIG = {
	firstDryMs = 150000, -- первый дождь через 2,5 минуты после старта сервера
	dryMinMs = 240000, -- потом сухо 4–7 минут
	dryMaxMs = 420000,
	rainMinMs = 60000, -- дождь 1–1,5 минуты
	rainMaxMs = 90000,
	stormChance = 0.3, -- каждый третий дождь — с грозой
	thunderMinMs = 9000, -- раскаты грома раз в 9–20 с
	thunderMaxMs = 20000,
	waterEveryMs = 30000, -- дождь поливает грядки сразу и потом раз в 30 с
}
local C = Weather.CONFIG

local function u32(x: number): number
	return x % 4294967296
end

-- Тот же mulberry32, что у гоблинов (Wild), своё состояние.
local function nextRandom(w): number
	local function imul(a, b)
		local ah, al = bit32.rshift(a, 16), bit32.band(a, 0xffff)
		local bh, bl = bit32.rshift(b, 16), bit32.band(b, 0xffff)
		local mid = bit32.band(ah * bl + al * bh, 0xffff)
		return u32(al * bl + mid * 65536)
	end
	local r = u32(w.rng + 0x6d2b79f5)
	w.rng = r
	local t = r
	t = imul(bit32.bxor(t, bit32.rshift(t, 15)), bit32.bor(t, 1))
	t = bit32.bxor(t, u32(t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(t, 61))))
	return bit32.bxor(t, bit32.rshift(t, 14)) / 4294967296
end

local function range(w, lo: number, hi: number): number
	return lo + (hi - lo) * nextRandom(w)
end

function Weather.create(seed: number)
	return {
		rng = u32(seed),
		tMs = 0,
		rain = false,
		storm = false,
		nextChangeMs = C.firstDryMs,
		nextThunderMs = 0,
		nextWaterMs = 0,
		rains = 0,
	}
end

-- События: { kind = "rain_start", storm } | { kind = "rain_end" } | { kind = "thunder" } | { kind = "water" }.
function Weather.step(w, dtMs: number)
	local events = {}
	w.tMs += dtMs
	local t = w.tMs
	if t >= w.nextChangeMs then
		if w.rain then
			w.rain = false
			w.storm = false
			w.nextChangeMs = t + range(w, C.dryMinMs, C.dryMaxMs)
			table.insert(events, { kind = "rain_end" })
		else
			w.rain = true
			local roll = nextRandom(w) < C.stormChance
			if w.forceStorm ~= nil then
				roll = w.forceStorm
				w.forceStorm = nil
			end
			w.storm = roll
			w.rains += 1
			w.nextChangeMs = t + range(w, C.rainMinMs, C.rainMaxMs)
			w.nextWaterMs = t
			w.nextThunderMs = t + range(w, 3000, 6000)
			table.insert(events, { kind = "rain_start", storm = w.storm })
		end
	end
	if w.rain then
		if t >= w.nextWaterMs then
			w.nextWaterMs = t + C.waterEveryMs
			table.insert(events, { kind = "water" })
		end
		if w.storm and t >= w.nextThunderMs then
			w.nextThunderMs = t + range(w, C.thunderMinMs, C.thunderMaxMs)
			table.insert(events, { kind = "thunder" })
		end
	end
	return events
end

-- Только для проверок и кнопок Studio: начать дождь (или грозу) сейчас.
function Weather.force(w, rain: boolean, storm: boolean?)
	if not rain and not w.rain then
		return -- и так сухо
	end
	w.nextChangeMs = w.tMs
	w.rain = not rain -- следующий шаг переключит
	if rain then
		w.forceStorm = storm == true
	end
end

-- Секунд до смены погоды.
function Weather.left(w): number
	return math.max(0, (w.nextChangeMs - w.tMs) / 1000)
end

return Weather
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Wild</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Дикие земли за кольцом участков: лагеря гоблинов в лесу. Чем дальше от деревни, тем сильнее гоблины
-- (уровень по расстоянию). Убитые возвращаются в лагерь не сразу, а через перезарядку лагеря.
-- Ночью гоблины злее (видят дальше) и ходят набегами на участки: топчут урожай, пока их не прогонят.
--
-- Только логика в мировых координатах (X, Z в стадах, центр деревни — 0, 0), без Roblox API:
-- сервер рисует гоблинов и переводит события в урон игрокам и ферме. Гоняется тестами в Lune.

local Wild = {}

Wild.CONFIG = {
	stepMs = 250,
	forestInner = 245, -- край леса
	forestOuter = 640,
	levelStart = 270, -- отсюда начинается 1-й уровень
	levelEvery = 85, -- каждые 85 стадов дальше — на уровень сильнее
	maxLevel = 5,
	camps = 10,
	campMin = 290,
	campMax = 610,
	perCamp = { 2, 3 }, -- гоблинов в лагере
	hpBase = 20,
	hpPerLevel = 14,
	damageBase = 4,
	damagePerLevel = 3,
	speedBase = 9, -- стадов в секунду (игрок бегает 16)
	speedPerLevel = 0.8,
	aggroBase = 16,
	aggroPerLevel = 3,
	nightAggroMul = 1.6,
	leash = 75, -- дальше от лагеря не гонится
	attackRange = 4.5,
	attackEveryMs = 1500,
	respawnBaseMs = 60000, -- перезарядка лагеря: 60 с + 20 с за уровень
	respawnPerLevelMs = 20000,
	wanderRadius = 18,
	-- Набеги ночью.
	raidEveryMs = 75000,
	raidFirstMs = 20000, -- после начала ночи
	raidSize = 2,
	raidHitEveryMs = 5000, -- раз в 5 с топчет грядку
	raidCropShare = 0.15,
	-- Игрок бьёт гоблина кликом.
	hitDamage = 10,
	hitRange = 14,
	hitEveryMs = 450,
	rewardPerLevel = 3,
}
local C = Wild.CONFIG

local function u32(x: number): number
	return x % 4294967296
end

-- mulberry32 на bit32 (как Rng зверя), своё состояние.
local function nextRandom(w): number
	local function imul(a, b)
		local ah, al = bit32.rshift(a, 16), bit32.band(a, 0xffff)
		local bh, bl = bit32.rshift(b, 16), bit32.band(b, 0xffff)
		local mid = bit32.band(ah * bl + al * bh, 0xffff)
		return u32(al * bl + mid * 65536)
	end
	local r = u32(w.rng + 0x6d2b79f5)
	w.rng = r
	local t = r
	t = imul(bit32.bxor(t, bit32.rshift(t, 15)), bit32.bor(t, 1))
	t = bit32.bxor(t, u32(t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(t, 61))))
	return bit32.bxor(t, bit32.rshift(t, 14)) / 4294967296
end
Wild.random = nextRandom

local function range(w, lo: number, hi: number): number
	return lo + (hi - lo) * nextRandom(w)
end

function Wild.levelAt(x: number, z: number): number
	local d = math.sqrt(x * x + z * z)
	return math.clamp(1 + math.floor((d - C.levelStart) / C.levelEvery), 1, C.maxLevel)
end

local function dist(ax: number, az: number, bx: number, bz: number): number
	return math.sqrt((ax - bx) ^ 2 + (az - bz) ^ 2)
end

local function makeGoblin(w, level: number, x: number, z: number, campId: string?)
	local g = {
		id = `g{w.nextId}`,
		campId = campId,
		raidSlot = nil,
		level = level,
		maxHp = C.hpBase + C.hpPerLevel * (level - 1),
		hp = 0,
		x = x,
		z = z,
		homeX = x,
		homeZ = z,
		state = "idle",
		target = nil,
		nextAttackMs = 0,
		nextHitMs = 0,
		wanderX = x,
		wanderZ = z,
		wanderAtMs = 0,
		yaw = 0,
		moving = false,
	}
	g.hp = g.maxHp
	w.nextId += 1
	w.goblins[g.id] = g
	return g
end

-- slots: { { slot = 1, x = …, z = … } } — центры участков (куда идти набегом).
function Wild.create(seed: number)
	local w = {
		rng = u32(seed),
		tMs = 0,
		nextId = 1,
		camps = {},
		goblins = {},
		night = false,
		nightStartedMs = 0,
		nextRaidMs = 0,
		raids = 0,
		kills = 0,
	}
	for i = 1, C.camps do
		local a = (i - 1) / C.camps * math.pi * 2 + range(w, -0.25, 0.25)
		local d = C.campMin + (C.campMax - C.campMin) * ((i * 7) % C.camps) / (C.camps - 1)
		local x, z = math.sin(a) * d, math.cos(a) * d
		local camp = { id = `camp{i}`, x = x, z = z, level = Wild.levelAt(x, z), size = 0, respawnAtMs = 0, alive = {} }
		camp.size = C.perCamp[1] + math.floor(nextRandom(w) * (C.perCamp[2] - C.perCamp[1] + 1))
		w.camps[i] = camp
		for _ = 1, camp.size do
			local g = makeGoblin(w, camp.level, x + range(w, -6, 6), z + range(w, -6, 6), camp.id)
			camp.alive[g.id] = true
		end
	end
	return w
end

local function campById(w, id: string)
	for _, c in w.camps do
		if c.id == id then
			return c
		end
	end
	return nil
end

local function moveToward(g, tx: number, tz: number, speed: number, dtMs: number): boolean
	local dx, dz = tx - g.x, tz - g.z
	local d = math.sqrt(dx * dx + dz * dz)
	local stepLen = speed * dtMs / 1000
	if d <= stepLen or d < 0.01 then
		g.x, g.z = tx, tz
		g.moving = d > 0.01
		return true
	end
	g.x += dx / d * stepLen
	g.z += dz / d * stepLen
	g.yaw = math.atan2(-dx, -dz)
	g.moving = true
	return false
end

local function remove(w, g)
	w.goblins[g.id] = nil
	if g.campId then
		local camp = campById(w, g.campId)
		if camp then
			camp.alive[g.id] = nil
			if next(camp.alive) == nil and camp.respawnAtMs == 0 then
				camp.respawnAtMs = w.tMs + C.respawnBaseMs + C.respawnPerLevelMs * (camp.level - 1)
			end
		end
	end
end

-- Игрок ударил гоблина. Возвращает { killed, reward, level } или nil, если удар не засчитан.
function Wild.hit(w, goblinId: string, playerId: string, px: number, pz: number, lastHitMs: number?)
	local g = w.goblins[goblinId]
	if not g then
		return nil
	end
	if dist(px, pz, g.x, g.z) > C.hitRange then
		return nil
	end
	g.hp -= C.hitDamage
	-- Ударили — злится на этого игрока, даже днём и издалека.
	g.target = playerId
	if g.state ~= "raid" then
		g.state = "chase"
	end
	if g.hp <= 0 then
		remove(w, g)
		w.kills += 1
		return { killed = true, reward = C.rewardPerLevel * g.level, level = g.level, raid = g.raidSlot ~= nil }
	end
	return { killed = false, reward = 0, level = g.level }
end

-- players: { { id = "123", x, z, alive = true } }; slots: { { slot, x, z, occupied } }.
-- Возвращает события: { kind = "attack", playerId, damage, goblinId } | { kind = "raid_start", slot }
--   | { kind = "raid_hit", slot, goblinId } | { kind = "respawn", campId } | { kind = "night" } | { kind = "day" }.
function Wild.step(w, dtMs: number, players, night: boolean, slots)
	local events = {}
	w.tMs += dtMs
	local t = w.tMs
	if night ~= w.night then
		w.night = night
		if night then
			w.nightStartedMs = t
			w.nextRaidMs = t + C.raidFirstMs
			table.insert(events, { kind = "night" })
		else
			-- Рассвет: набеги уходят в лес.
			for _, g in w.goblins do
				if g.raidSlot then
					g.state = "flee"
				end
			end
			table.insert(events, { kind = "day" })
		end
	end

	-- Перезарядка лагерей.
	for _, camp in w.camps do
		if camp.respawnAtMs > 0 and t >= camp.respawnAtMs then
			camp.respawnAtMs = 0
			for _ = 1, camp.size do
				local g = makeGoblin(w, camp.level, camp.x + range(w, -6, 6), camp.z + range(w, -6, 6), camp.id)
				camp.alive[g.id] = true
			end
			table.insert(events, { kind = "respawn", campId = camp.id })
		end
	end

	-- Ночной набег на занятый участок.
	if night and t >= w.nextRaidMs then
		w.nextRaidMs = t + C.raidEveryMs
		local occupied = {}
		for _, s in slots or {} do
			if s.occupied then
				table.insert(occupied, s)
			end
		end
		if #occupied > 0 then
			local s = occupied[math.floor(nextRandom(w) * #occupied) + 1]
			local d = math.sqrt(s.x * s.x + s.z * s.z)
			local ex, ez = s.x / d * C.forestInner, s.z / d * C.forestInner
			for i = 1, C.raidSize do
				local g = makeGoblin(w, if i == 1 then 1 else 2, ex + range(w, -8, 8), ez + range(w, -8, 8), nil)
				g.raidSlot = s.slot
				g.raidX, g.raidZ = s.x, s.z
				g.state = "raid"
			end
			w.raids += 1
			table.insert(events, { kind = "raid_start", slot = s.slot })
		end
	end

	for _, g in w.goblins do
		local speed = C.speedBase + C.speedPerLevel * (g.level - 1)
		local aggro = (C.aggroBase + C.aggroPerLevel * (g.level - 1)) * (if night then C.nightAggroMul else 1)
		-- Ближайший живой игрок.
		local near, nearD = nil, math.huge
		for _, p in players do
			if p.alive then
				local d = dist(p.x, p.z, g.x, g.z)
				if d < nearD then
					near, nearD = p, d
				end
			end
		end
		local target = nil
		if g.target then
			for _, p in players do
				if p.id == g.target and p.alive then
					target = p
				end
			end
			if not target then
				g.target = nil
			end
		end
		if not target and near and nearD <= aggro then
			target = near
			g.target = near.id
		end

		if g.state == "flee" then
			local d = math.sqrt(g.x * g.x + g.z * g.z)
			if d >= C.forestInner + 30 then
				w.goblins[g.id] = nil
			else
				moveToward(g, g.x / math.max(d, 1) * (C.forestInner + 40), g.z / math.max(d, 1) * (C.forestInner + 40), speed, dtMs)
			end
		elseif target then
			-- Гонится, пока не убежал дальше привязи от лагеря (у набега привязки нет).
			local fromHome = dist(g.x, g.z, g.homeX, g.homeZ)
			if not g.raidSlot and fromHome > C.leash then
				g.target = nil
				g.state = "return"
			else
				g.state = if g.raidSlot then "raid" else "chase"
				local d = dist(target.x, target.z, g.x, g.z)
				if d > C.attackRange then
					moveToward(g, target.x, target.z, speed, dtMs)
				else
					g.moving = false
					g.yaw = math.atan2(-(target.x - g.x), -(target.z - g.z))
					if t >= g.nextAttackMs then
						g.nextAttackMs = t + C.attackEveryMs
						table.insert(events, { kind = "attack", playerId = target.id, damage = C.damageBase + C.damagePerLevel * (g.level - 1), goblinId = g.id })
					end
				end
			end
		elseif g.raidSlot then
			-- Идёт к участку и топчет урожай.
			if dist(g.x, g.z, g.raidX, g.raidZ) >= 25 then
				moveToward(g, g.raidX, g.raidZ, speed, dtMs)
			else
				g.moving = false
				if t >= g.nextHitMs then
					g.nextHitMs = t + C.raidHitEveryMs
					table.insert(events, { kind = "raid_hit", slot = g.raidSlot, goblinId = g.id })
				end
			end
		elseif g.state == "return" then
			if moveToward(g, g.homeX, g.homeZ, speed, dtMs) then
				g.state = "idle"
				g.hp = g.maxHp -- отдохнул у костра
			end
		else
			-- Бродит у лагеря.
			if t >= g.wanderAtMs then
				g.wanderAtMs = t + range(w, 3000, 7000)
				g.wanderX = g.homeX + range(w, -C.wanderRadius, C.wanderRadius)
				g.wanderZ = g.homeZ + range(w, -C.wanderRadius, C.wanderRadius)
			end
			moveToward(g, g.wanderX, g.wanderZ, speed * 0.4, dtMs)
		end
	end
	return events
end

-- Сколько гоблинов сейчас (для проверок и подсказок).
function Wild.count(w): number
	local n = 0
	for _ in w.goblins do
		n += 1
	end
	return n
end

return Wild
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="33">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="34">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">BeastModel</string>
          <string name="Source"><![CDATA[--!strict
-- Тело зверя из деталей (путь A плана производства): эллипсоиды и бруски, без костей.
-- Каждая деталь — отдельная часть, поэтому зверь растёт, толстеет и меняет мордочку кодом:
-- глаза, брови и рот двигаются по настроению. Вид по 8 видам из Data.SPECIES (цвета, уши, хвост, панцирь).
-- Модуль только рисует: где зверь и что он чувствует, решает мозг (ReplicatedStorage.Shared.Beast).

local BeastModel = {}

-- Размеры в стадах: рост зверя в сантиметрах делится на это число (взрослый медведь 80 см ≈ 5 стадов).
local CM_PER_STUD = 16

local function hex(s: string): Color3
	local h = string.gsub(s, "#", "")
	return Color3.fromRGB(tonumber(string.sub(h, 1, 2), 16) or 0, tonumber(string.sub(h, 3, 4), 16) or 0, tonumber(string.sub(h, 5, 6), 16) or 0)
end

-- Лицо по настроению: k — изгиб рта (+1 улыбка, −1 грусть), open — рот открыт,
-- eye — насколько открыты глаза, pupil — размер зрачков, brow — наклон бровей (+ домиком, − сердито),
-- browUp — брови выше, look — взгляд вниз (виноват).
type Face = { k: number, open: boolean, eye: number, pupil: number, brow: number, browUp: number, look: number }
local FACES: { [string]: Face } = {
	calm = { k = 0.35, open = false, eye = 1, pupil = 1, brow = 0, browUp = 0, look = 0 },
	happy = { k = 1, open = false, eye = 1, pupil = 1.1, brow = 0.15, browUp = 0.4, look = 0 },
	proud = { k = 1, open = false, eye = 0.55, pupil = 1, brow = -0.1, browUp = 0.2, look = 0 },
	guilty = { k = -0.6, open = false, eye = 0.85, pupil = 1, brow = 0.6, browUp = 0, look = 1 },
	sad = { k = -1, open = false, eye = 0.85, pupil = 1, brow = 0.7, browUp = 0, look = 0.4 },
	scared = { k = 0, open = true, eye = 1.3, pupil = 0.6, brow = 0.5, browUp = 1, look = 0 },
	sick = { k = -0.6, open = false, eye = 0.5, pupil = 0.9, brow = 0.4, browUp = 0, look = 0.3 },
	sleepy = { k = 0, open = false, eye = 0.12, pupil = 0, brow = 0, browUp = -0.2, look = 0 },
	curious = { k = 0.2, open = false, eye = 1.15, pupil = 1.3, brow = 0.2, browUp = 0.7, look = 0 },
	hurt = { k = -1, open = true, eye = 0.45, pupil = 1, brow = -0.6, browUp = 0, look = 0 },
}

local function ellipsoid(name: string, color: Color3, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = true
	p.CastShadow = true
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = color
	p.Size = Vector3.new(1, 1, 1)
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	p.Parent = parent
	return p
end

local function block(name: string, color: Color3, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = color
	p.Size = Vector3.new(1, 1, 1)
	p.Parent = parent
	return p
end

export type Pose = {
	pos: Vector3, -- точка на земле под зверем (мир)
	yaw: number,
	heightCm: number,
	fat: number, -- доля жира 0..1
	muscle: number,
	mood: string,
	moving: boolean,
	sleeping: boolean,
	happyTail: boolean,
	dirty: boolean?, -- после лужи: грязные пятна на шерсти
	t: number, -- секунды, для покачивания
}

export type Model = {
	model: Model,
	body: Part,
	billboard: BillboardGui,
	status: TextLabel,
	bubble: TextLabel,
	name: TextLabel,
	float: TextLabel,
	parts: { [string]: Part },
	look: any,
	pose: (self: Model, p: Pose) -> (),
	destroy: (self: Model) -> (),
}

-- species — запись из Data.SPECIES (colors, look).
function BeastModel.new(species: any, parent: Instance, ownerName: string): Model
	local colors = species.colors
	local look = species.look
	local body, belly, spot, outline = hex(colors.body), hex(colors.belly), hex(colors.spot), hex(colors.outline)
	local white, black, ink = Color3.fromRGB(250, 250, 250), Color3.fromRGB(25, 25, 30), Color3.fromRGB(60, 30, 30)

	local model = Instance.new("Model")
	model.Name = "Beast"
	local parts: { [string]: Part } = {}
	local function E(name: string, c: Color3)
		parts[name] = ellipsoid(name, c, model)
	end
	local function B(name: string, c: Color3)
		parts[name] = block(name, c, model)
	end
	E("Body", body)
	E("Belly", belly)
	E("Head", body)
	for _, f in { "FootFL", "FootFR", "FootBL", "FootBR" } do
		E(f, outline)
	end
	if look.shell then
		E("Shell", spot)
	end
	if look.face == "snout" then
		E("Snout", belly)
		E("NoseL", ink)
		E("NoseR", ink)
	else
		E("Nose", ink)
	end
	if look.face == "mask" then
		B("Mask", spot)
	end
	if look.ears ~= "none" then
		E("EarL", if look.ears == "horns" then outline else body)
		E("EarR", if look.ears == "horns" then outline else body)
	end
	if look.tail ~= "none" then
		E("Tail", if look.tail == "spiky" or look.tail == "ringed" then spot else body)
	end
	E("EyeL", white)
	E("EyeR", white)
	E("PupilL", black)
	E("PupilR", black)
	E("GlintL", white)
	E("GlintR", white)
	B("BrowL", outline)
	B("BrowR", outline)
	B("MouthL", ink)
	B("MouthM", ink)
	B("MouthR", ink)
	E("MouthO", ink)
	-- Грязь после лужи: пятна на боках, спине, голове и лапах.
	local mud = Color3.fromRGB(62, 48, 36)
	for _, n in { "MudA", "MudB", "MudC", "MudD", "MudE" } do
		E(n, mud)
	end
	model.PrimaryPart = parts.Body
	model.Parent = parent

	-- Над головой: иконка нужды как в Sims, пузырёк поступка, имя. Видно всем, и гостям тоже.
	local gui = Instance.new("BillboardGui")
	gui.Name = "Over"
	gui.Size = UDim2.fromScale(9, 3.6)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 1.2, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = parts.Head
	gui.Parent = parts.Head
	local function text(name: string, y: number, h: number, size: number?): TextLabel
		local t = Instance.new("TextLabel")
		t.Name = name
		t.Size = UDim2.fromScale(1, h)
		t.Position = UDim2.fromScale(0, y)
		t.BackgroundTransparency = 1
		t.TextScaled = true
		t.Font = Enum.Font.FredokaOne
		t.TextColor3 = Color3.new(1, 1, 1)
		t.TextStrokeTransparency = 0
		t.TextStrokeColor3 = Color3.fromRGB(40, 30, 20)
		t.Text = ""
		t.Parent = gui
		return t
	end
	local status = text("Status", 0, 0.38)
	local float = text("Float", 0, 0.38)
	float.Position = UDim2.fromScale(0.3, 0)
	float.Size = UDim2.fromScale(0.4, 0.38)
	local bubble = text("Bubble", 0.4, 0.3)
	bubble.TextColor3 = Color3.fromRGB(255, 248, 226)
	local name = text("Name", 0.72, 0.26)
	name.TextColor3 = Color3.fromRGB(250, 196, 40)
	name.Text = ownerName

	local self = {
		model = model,
		body = parts.Body,
		billboard = gui,
		status = status,
		bubble = bubble,
		name = name,
		float = float,
		parts = parts,
		look = look,
	} :: any

	function self.pose(m: Model, p: Pose)
		local P = m.parts
		local u = math.max(1, p.heightCm / CM_PER_STUD)
		local fat = math.clamp(p.fat, 0, 0.6)
		local face = FACES[p.mood] or FACES.calm
		if p.sleeping then
			face = FACES.sleepy
		end
		local t = p.t
		local root = CFrame.new(p.pos) * CFrame.Angles(0, p.yaw, 0)
		local cfs: { [string]: CFrame } = {}
		local sizes: { [string]: Vector3 } = {}
		local hidden: { [string]: boolean } = {}

		-- Шаг: подпрыгивает при ходьбе; во сне ниже и дышит медленно.
		local bob = if p.moving then math.abs(math.sin(t * 9)) * 0.12 * u else 0
		local squash = if p.sleeping then 0.8 else 1
		local bw = u * 0.62 * (1 + fat * 0.9 + p.muscle * 0.25)
		local bh = u * 0.55 * squash
		local bd = u * 0.62 * (1 + fat * 0.6)
		local by = u * 0.1 + bh / 2 + bob
		sizes.Body = Vector3.new(bw, bh, bd)
		cfs.Body = CFrame.new(0, by, 0)
		sizes.Belly = Vector3.new(bw * 0.72, bh * 0.72, bd * 0.32)
		cfs.Belly = CFrame.new(0, by - bh * 0.06, -bd * 0.36)
		if P.Shell then
			sizes.Shell = Vector3.new(bw * 1.08, bh * 0.8, bd * 1.06)
			cfs.Shell = CFrame.new(0, by + bh * 0.18, bd * 0.04)
		end

		local step = if p.moving then math.sin(t * 9) * 0.07 * u else 0
		for i, f in { "FootFL", "FootFR", "FootBL", "FootBR" } do
			local sx = if i % 2 == 1 then -1 else 1
			local sz = if i <= 2 then -1 else 1
			local lift = if (i == 1 or i == 4) then math.max(0, step) else math.max(0, -step)
			sizes[f] = Vector3.new(u * 0.17, u * 0.12, u * 0.22)
			cfs[f] = CFrame.new(sx * bw * 0.3, u * 0.06 + lift, sz * bd * 0.28)
		end

		-- Голова большая, как у мультяшного существа; во сне опущена.
		local hs = u * 0.52
		local hy = by + bh * 0.42 + hs * 0.32 - (if p.sleeping then hs * 0.12 else 0)
		local hz = -bd * 0.12
		local head = CFrame.new(0, hy, hz)
		sizes.Head = Vector3.new(hs * 1.1, hs, hs)
		cfs.Head = head
		local front = -hs * 0.47
		-- Точка на передней поверхности головы-эллипсоида (полуоси 0,55·hs, 0,5·hs, 0,5·hs).
		local function surf(dx: number, dy: number): number
			local q = 1 - (dx / (hs * 0.55)) ^ 2 - (dy / (hs * 0.5)) ^ 2
			return -hs * 0.5 * math.sqrt(math.max(0.05, q))
		end

		-- Большие мультяшные глаза с бликом.
		local eyeY = hs * 0.08
		local ex = hs * 0.2
		local ew, eh = u * 0.16, u * 0.19 * face.eye
		for _, side in { -1, 1 } do
			local s = if side < 0 then "L" else "R"
			local ez = surf(ex, eyeY)
			sizes["Eye" .. s] = Vector3.new(ew, math.max(0.02, eh), u * 0.07)
			cfs["Eye" .. s] = head * CFrame.new(side * ex, eyeY, ez + u * 0.012)
			local pw = u * 0.085 * face.pupil
			local py = eyeY - face.look * u * 0.04
			sizes["Pupil" .. s] = Vector3.new(math.max(0.02, pw), math.max(0.02, pw * math.min(1.2, face.eye) * 1.15), u * 0.04)
			cfs["Pupil" .. s] = head * CFrame.new(side * ex, py, ez - u * 0.012)
			hidden["Pupil" .. s] = face.pupil <= 0 or face.eye < 0.2
			sizes["Glint" .. s] = Vector3.new(u * 0.03, u * 0.03, u * 0.02)
			cfs["Glint" .. s] = head * CFrame.new(side * ex + u * 0.022, py + u * 0.025, ez - u * 0.03)
			hidden["Glint" .. s] = hidden["Pupil" .. s] or face.pupil < 0.8
			-- Брови: + домиком (внутренние концы вверх), − сердито.
			local by_ = eyeY + u * 0.14 + face.browUp * u * 0.035
			sizes["Brow" .. s] = Vector3.new(u * 0.14, u * 0.035, u * 0.03)
			cfs["Brow" .. s] = head * CFrame.new(side * ex, by_, surf(ex, by_) + u * 0.005) * CFrame.Angles(0, 0, side * -face.brow * 0.5)
		end

		-- Нос и мордочка.
		local noseY = -hs * 0.06
		if P.Snout then
			sizes.Snout = Vector3.new(hs * 0.42, hs * 0.3, hs * 0.3)
			cfs.Snout = head * CFrame.new(0, noseY, front - hs * 0.06)
			for _, side in { -1, 1 } do
				local s = if side < 0 then "NoseL" else "NoseR"
				sizes[s] = Vector3.new(u * 0.035, u * 0.05, u * 0.02)
				cfs[s] = head * CFrame.new(side * hs * 0.07, noseY, front - hs * 0.21)
			end
		else
			sizes.Nose = Vector3.new(u * 0.08, u * 0.06, u * 0.05)
			cfs.Nose = head * CFrame.new(0, noseY, surf(0, noseY) - u * 0.005)
		end
		if P.Mask then
			sizes.Mask = Vector3.new(hs * 0.72, hs * 0.22, u * 0.02)
			cfs.Mask = head * CFrame.new(0, eyeY, surf(hs * 0.3, eyeY))
		end

		-- Рот из трёх отрезков: концы вверх — улыбка, вниз — грусть; открыт — кружок.
		local my = -hs * 0.2 - (if P.Snout then hs * 0.06 else 0)
		local mz = surf(0, my) - u * 0.008
		local seg = u * 0.09
		local th = u * 0.032
		local k = face.k
		sizes.MouthM = Vector3.new(seg, th, th)
		cfs.MouthM = head * CFrame.new(0, my, mz)
		for _, side in { -1, 1 } do
			local s = if side < 0 then "MouthL" else "MouthR"
			local a = side * k * 0.6
			sizes[s] = Vector3.new(seg, th, th)
			cfs[s] = head * CFrame.new(side * seg * 0.95, my + k * seg * 0.28, surf(seg, my) - u * 0.004) * CFrame.Angles(0, 0, a)
		end
		sizes.MouthO = Vector3.new(u * 0.1, u * 0.11, u * 0.03)
		cfs.MouthO = head * CFrame.new(0, my, mz)
		hidden.MouthO = not face.open
		hidden.MouthM = face.open
		hidden.MouthL = face.open
		hidden.MouthR = face.open

		-- Уши и рожки.
		local ears = m.look.ears
		if P.EarL then
			for _, side in { -1, 1 } do
				local s = if side < 0 then "EarL" else "EarR"
				local droop = if face.brow > 0.4 then 0.35 else 0 -- грусть и вина: уши прижаты
				if ears == "round" then
					sizes[s] = Vector3.new(hs * 0.32, hs * 0.32, hs * 0.14)
					cfs[s] = head * CFrame.new(side * hs * 0.4, hs * 0.42 - droop * hs * 0.1, 0) * CFrame.Angles(0, 0, side * -droop)
				elseif ears == "pointy" then
					sizes[s] = Vector3.new(hs * 0.22, hs * 0.48, hs * 0.12)
					cfs[s] = head * CFrame.new(side * hs * 0.32, hs * 0.5, 0) * CFrame.Angles(0, 0, side * -(0.25 + droop))
				elseif ears == "long" then
					sizes[s] = Vector3.new(hs * 0.2, hs * 0.85, hs * 0.12)
					cfs[s] = head * CFrame.new(side * hs * 0.2, hs * 0.75 - droop * hs * 0.3, hs * 0.05) * CFrame.Angles(-droop, 0, side * -(0.12 + droop))
				else -- horns
					sizes[s] = Vector3.new(hs * 0.13, hs * 0.4, hs * 0.13)
					cfs[s] = head * CFrame.new(side * hs * 0.28, hs * 0.52, hs * 0.08) * CFrame.Angles(0.35, 0, side * -0.3)
				end
			end
		end

		-- Хвост: виляет, когда зверь доволен.
		if P.Tail then
			local tail = m.look.tail
			local wag = if p.happyTail then math.sin(t * 14) * 0.5 else 0
			local base = CFrame.new(0, by + bh * 0.05, bd * 0.48) * CFrame.Angles(0, wag, 0)
			if tail == "stub" then
				sizes.Tail = Vector3.new(u * 0.17, u * 0.17, u * 0.17)
				cfs.Tail = base
			elseif tail == "bushy" then
				sizes.Tail = Vector3.new(u * 0.22, u * 0.22, u * 0.5)
				cfs.Tail = base * CFrame.Angles(0.6, 0, 0) * CFrame.new(0, 0, u * 0.2)
			elseif tail == "spiky" then
				sizes.Tail = Vector3.new(u * 0.1, u * 0.1, u * 0.5)
				cfs.Tail = base * CFrame.Angles(0.25, 0, 0) * CFrame.new(0, 0, u * 0.2)
			elseif tail == "ringed" then
				sizes.Tail = Vector3.new(u * 0.15, u * 0.15, u * 0.55)
				cfs.Tail = base * CFrame.Angles(0.45, 0, 0) * CFrame.new(0, 0, u * 0.22)
			else -- curly
				sizes.Tail = Vector3.new(u * 0.14, u * 0.14, u * 0.14)
				cfs.Tail = base * CFrame.new(0, u * 0.08, 0)
			end
		end

		-- Грязные пятна (видны, только если зверь грязный).
		local MUD = {
			{ "MudA", 0.45, 0.15, -0.1, 0.4 },
			{ "MudB", -0.42, -0.05, 0.2, 0.36 },
			{ "MudC", 0.05, 0.48, 0.15, 0.3 },
			{ "MudD", -0.2, -0.3, -0.42, 0.22 },
		}
		for _, m_ in MUD do
			local n, fx, fy, fz, r = m_[1], m_[2], m_[3], m_[4], m_[5]
			sizes[n] = Vector3.new(bw * r, bh * r * 0.7, bd * r)
			cfs[n] = CFrame.new(fx * bw, by + fy * bh, fz * bd)
			hidden[n] = not p.dirty
		end
		sizes.MudE = Vector3.new(hs * 0.3, hs * 0.18, hs * 0.3)
		cfs.MudE = head * CFrame.new(hs * 0.25, hs * 0.35, -hs * 0.1)
		hidden.MudE = not p.dirty

		for name, part in P do
			local cf = cfs[name]
			if cf then
				-- Пишем только изменившееся: каждое свойство детали уходит по сети всем игрокам.
				local size = sizes[name]
				if part.Size ~= size then
					part.Size = size
				end
				part.CFrame = root * cf
				local tr = if hidden[name] then 1 else 0
				if part.Transparency ~= tr then
					part.Transparency = tr
				end
			end
		end
		m.billboard.StudsOffsetWorldSpace = Vector3.new(0, hs * 0.5 + 1.6, 0)
	end

	function self.destroy(m: Model)
		m.model:Destroy()
	end

	return self :: Model
end

return BeastModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">BeastService</string>
          <string name="Source"><![CDATA[--!strict
-- Сервер зверя: у каждого игрока на участке живёт свой зверь (мозг — Shared.Beast, дом — Shared.Beast.Home).
-- Сервер главный: двигает время вместе с фермой, проверяет каждую команду и рисует тело зверя.
-- Экран хозяина получает снимок через BeastRemotes.State и шлёт просьбы через BeastRemotes.Command.
--
-- Кнопки без таймера (обсуждение v0.4): Похвалить, Отругать, Погладить, Позвать — всегда на экране.
-- Сразу после поступка реакция меняет привычку; без повода — сердечко и настроение.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BeastPkg = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Beast")
local Home = require(BeastPkg:WaitForChild("Home"))
local Data = require(BeastPkg:WaitForChild("Data"))
local Body = require(BeastPkg:WaitForChild("Body"))
local Character = require(BeastPkg:WaitForChild("Character"))
local Village = require(script.Parent:WaitForChild("Village"))
local BeastModel = require(script.Parent:WaitForChild("BeastModel"))
local HomeWorld = require(script.Parent:WaitForChild("HomeWorld"))
local DayNight = require(script.Parent:WaitForChild("DayNight"))
local Pen = require(script.Parent:WaitForChild("Pen"))
local WeatherService = require(script.Parent:WaitForChild("WeatherService"))

local BeastService = {}

local GUEST_DISTANCE = 22 -- стадов: гость рядом со зверем может угостить, поиграть или накричать
local SPECIES_BY_DEFAULT = "bear"
local TRAVEL_SPEED = 14 -- стадов в секунду: зверь бежит в вольер и обратно
local PEN_SPEED = 7 -- в вольере бегает медленнее
local FRIEND_DIST = 12 -- ближе этого — играют вместе
local HOME_LAYOUT = Home.LAYOUT

type Entry = {
	player: Player,
	slot: number,
	home: any,
	body: BeastModel.Model,
	world: HomeWorld.World,
	renderPos: Vector3?,
	yaw: number,
	clock: number,
	poseIn: number,
	poseKey: string,
	worldIn: number,
	cardOpen: boolean,
	budget: number,
	mode: string?, -- nil дома | "toPen" | "pen" | "toHome"
	path: { Vector3 },
	penPos: Vector3?,
	penGoal: Vector3?,
	penGoalIn: number,
}

-- Звери-воспитанники детского сада: живут в вольере, чтобы при одном игроке там было с кем играть.
type Npc = {
	name: string,
	species: string,
	heightCm: number,
	body: BeastModel.Model,
	pos: Vector3,
	goal: Vector3,
	goalIn: number,
	yaw: number,
	clock: number,
	poseIn: number,
}
local NPCS = {
	{ name = "Пятнашка", species = "fox", heightCm = 30 },
	{ name = "Снежок", species = "bunny", heightCm = 26 },
}
local npcs: { Npc } = {}

local entries: { [Player]: Entry } = {}
local remotes: Folder
local commandRemote: RemoteEvent
local stateRemote: RemoteEvent
local openRemote: RemoteEvent

local function nowMs(): number
	return os.clock() * 1000
end

-- Мир → пиксели фермы (обратное к Village.toWorld).
local function toFarm(slot: number, p: Vector3): { x: number, y: number }
	return Village.toFarm(slot, p)
end

local function rootOf(player: Player): BasePart?
	local ch = player.Character
	if not ch then
		return nil
	end
	local r = ch:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local function beastWorldPos(e: Entry): Vector3
	if e.mode and e.penPos then
		return e.penPos
	end
	local b = e.home.sim.beast
	return Village.toWorld(e.slot, b.pos.x, b.pos.y, 0)
end

-- ---------- Команды ----------

local REACTIONS = { praise = true, scold = true, give = true }
local GUEST_ACTS = { feed = true, play = true, scold = true }

local function onCommand(player: Player, c: any)
	if type(c) ~= "table" or type(c.type) ~= "string" then
		return
	end
	local mine = entries[player]
	if mine then
		if mine.budget <= 0 then
			return
		end
		mine.budget -= 1
	end
	local ty = c.type
	if ty == "guest" then
		-- Гость у чужого зверя: только если стоит рядом.
		if type(c.owner) ~= "number" or not GUEST_ACTS[c.act] then
			return
		end
		local owner = Players:GetPlayerByUserId(c.owner)
		local e = owner and entries[owner]
		local r = rootOf(player)
		if not e or owner == player or not r or (r.CFrame.Position - beastWorldPos(e)).Magnitude > GUEST_DISTANCE then
			return
		end
		Home.visitorAct(e.home, tostring(player.UserId), player.DisplayName, c.act)
		return
	end
	if not mine then
		return
	end
	local home = mine.home
	local farm = BeastService.farmOf and BeastService.farmOf(player)
	if ty == "react" then
		if REACTIONS[c.reaction] then
			Home.input(home, farm, { type = "react", reaction = c.reaction }, nowMs())
		end
	elseif ty == "pen" or (ty == "call" and mine.mode ~= nil) then
		-- В вольер и обратно (позвать из вольера — тоже домой).
		BeastService.togglePen(player)
	elseif mine.mode ~= nil then
		return -- зверя нет дома: миска, мытьё и остальное подождут
	elseif ty == "call" or ty == "command_carry" or ty == "fill_bowl" or ty == "shoo_spider" or ty == "wash" then
		Home.input(home, farm, { type = ty }, nowMs())
	elseif ty == "clean_pile" then
		if type(c.pileId) == "string" and #c.pileId < 20 then
			Home.input(home, farm, { type = "clean_pile", pileId = c.pileId }, nowMs())
		end
	elseif ty == "card" then
		mine.cardOpen = c.open == true
	end
	BeastService.send(player)
end

-- ---------- Вход и выход ----------

function BeastService.init(farmOf: (Player) -> any)
	BeastService.farmOf = farmOf
	remotes = Instance.new("Folder")
	remotes.Name = "BeastRemotes"
	commandRemote = Instance.new("RemoteEvent")
	commandRemote.Name = "Command"
	commandRemote.Parent = remotes
	stateRemote = Instance.new("RemoteEvent")
	stateRemote.Name = "State"
	stateRemote.Parent = remotes
	openRemote = Instance.new("RemoteEvent")
	openRemote.Name = "Open"
	openRemote.Parent = remotes
	remotes.Parent = ReplicatedStorage
	commandRemote.OnServerEvent:Connect(onCommand)
	local penFolder = Pen.build(workspace)
	for i, n in NPCS do
		local body = BeastModel.new(Data.SPECIES[n.species], penFolder, n.name)
		body.model.Name = "Npc" .. i
		body.name.Text = n.name .. " · из сада"
		local a = i * 2.1
		local pos = Vector3.new(math.sin(a) * 12, 0, math.cos(a) * 12)
		table.insert(npcs, { name = n.name, species = n.species, heightCm = n.heightCm, body = body, pos = pos, goal = pos, goalIn = 0, yaw = 0, clock = 0, poseIn = 0 })
	end
end

local function penPoint(): Vector3
	local a = math.random() * math.pi * 2
	local r = math.sqrt(math.random()) * Pen.INNER
	return Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
end

local function homePoint(e: Entry): Vector3
	return Village.toWorld(e.slot, HOME_LAYOUT.gate.x, HOME_LAYOUT.gate.y - 30, 0)
end

local function goHome(e: Entry)
	local outside = Village.toWorld(e.slot, HOME_LAYOUT.gate.x, HOME_LAYOUT.gate.y + 20, 0)
	if e.mode == "toPen" then
		e.path = { outside, homePoint(e) }
	else
		e.path = { Pen.gate(e.slot, Pen.RADIUS + 2), outside, homePoint(e) }
	end
	e.mode = "toHome"
end

-- Кнопка «В вольер» / «Домой».
function BeastService.togglePen(player: Player)
	local e = entries[player]
	if not e then
		return
	end
	if e.mode == nil then
		if not Home.goPen(e.home) then
			return
		end
		e.penPos = e.renderPos or beastWorldPos(e)
		e.path = { Village.toWorld(e.slot, HOME_LAYOUT.gate.x, HOME_LAYOUT.gate.y + 20, 0), Pen.gate(e.slot, Pen.RADIUS + 2), Pen.gate(e.slot, Pen.INNER - 4) }
		e.mode = "toPen"
	elseif e.mode == "pen" or e.mode == "toPen" then
		goHome(e)
	end
end

-- Дома всех зверей (для погоды).
function BeastService.homes(): { any }
	local out = {}
	for _, e in entries do
		table.insert(out, e.home)
	end
	return out
end

-- Вид зверя выбирается по игроку (пока выбора нет): так у друзей разные звери.
local function speciesFor(player: Player): string
	local list = Data.SPECIES_LIST
	return list[(player.UserId % #list) + 1] or SPECIES_BY_DEFAULT
end

function BeastService.join(player: Player, slot: number, slotModel: Model)
	local seed = player.UserId % 2147483647
	local home = Home.create(seed, speciesFor(player))
	local e: Entry
	local function onHomeClick(who: Player, kind: string, id: string)
		if who ~= player then
			return
		end
		local farm = BeastService.farmOf and BeastService.farmOf(player)
		if kind == "bowl" then
			Home.input(home, farm, { type = "fill_bowl" }, nowMs())
		elseif kind == "pile" then
			Home.input(home, farm, { type = "clean_pile", pileId = id }, nowMs())
		elseif kind == "spider" then
			Home.input(home, farm, { type = "shoo_spider" }, nowMs())
		end
		BeastService.send(player)
	end
	local body = BeastModel.new(Data.SPECIES[home.sim.beast.species], slotModel, home.sim.beast.name)
	-- Клик по зверю: хозяину — карточка, гостю — кнопки гостя.
	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 60
	cd.Parent = body.body
	cd.MouseClick:Connect(function(who: Player)
		openRemote:FireClient(who, if who == player then "card" else "guest", player.UserId)
	end)
	e = {
		player = player,
		slot = slot,
		home = home,
		body = body,
		world = HomeWorld.new(slot, slotModel, home, onHomeClick),
		renderPos = nil,
		yaw = math.pi,
		clock = 0,
		poseIn = 0,
		poseKey = "",
		worldIn = 0,
		cardOpen = false,
		budget = 20,
		mode = nil,
		path = {},
		penPos = nil,
		penGoal = nil,
		penGoalIn = 0,
	}
	entries[player] = e
	WeatherService.attach(home)
	BeastService.frame(0)
end

function BeastService.leave(player: Player)
	local e = entries[player]
	if not e then
		return
	end
	e.body:destroy()
	e.world:destroy()
	entries[player] = nil
end

function BeastService.homeOf(player: Player): any
	local e = entries[player]
	return e and e.home
end

-- ---------- Время ----------

-- Один шаг фермы (250 мс): кто на участке, затем шаг зверя. Зовётся сразу после Farm.tick.
function BeastService.step(player: Player, farm: any, dtMs: number)
	local e = entries[player]
	if not e then
		return
	end
	e.budget = math.min(20, e.budget + 1)
	if e.mode == "pen" then
		-- В вольере: кто рядом из зверей (других игроков и воспитанников сада).
		local friends = {}
		local here = e.penPos or Vector3.zero
		for _, oe in entries do
			if oe ~= e and oe.mode == "pen" and oe.penPos and (oe.penPos - here).Magnitude < FRIEND_DIST then
				table.insert(friends, oe.home.sim.beast.name)
			end
		end
		for _, n in npcs do
			if (n.pos - here).Magnitude < FRIEND_DIST then
				table.insert(friends, n.name)
			end
		end
		if Home.penStep(e.home, dtMs, friends, nowMs()) == "home" then
			goHome(e)
		end
		return
	elseif e.mode then
		return -- бежит в вольер или обратно
	end
	local r = rootOf(player)
	Home.setOwner(e.home, if r then toFarm(e.slot, r.CFrame.Position) else nil)
	local guests = {}
	for other, _ in entries do
		if other ~= player then
			local or_ = rootOf(other)
			if or_ then
				table.insert(guests, { id = tostring(other.UserId), name = other.DisplayName, pos = toFarm(e.slot, or_.CFrame.Position) })
			end
		end
	end
	for _, other in Players:GetPlayers() do
		if other ~= player and not entries[other] then
			local or_ = rootOf(other)
			if or_ then
				table.insert(guests, { id = tostring(other.UserId), name = other.DisplayName, pos = toFarm(e.slot, or_.CFrame.Position) })
			end
		end
	end
	Home.setVisitors(e.home, guests)
	Home.tick(e.home, farm, dtMs, nowMs())
end

-- Зверь в пути или в вольере: двигаем точку e.penPos (мир). true — дошёл до дома.
local function moveAway(e: Entry, dt: number)
	local pos = e.penPos or beastWorldPos(e)
	if e.mode == "pen" then
		e.penGoalIn -= dt
		local pen = e.home.pen
		local shy = pen ~= nil and pen.shyUntilMs > e.home.sim.tMs
		if shy then
			e.penGoal = Pen.gate(e.slot, Pen.INNER) -- жмётся к забору у своего прохода
		elseif e.penGoalIn <= 0 or not e.penGoal then
			e.penGoalIn = 2 + math.random() * 3
			-- Рядом кто-то есть — бежит к нему играть (догонялки), иначе в случайное место.
			local best, bestD = nil, 24
			for _, oe in entries do
				if oe ~= e and oe.mode == "pen" and oe.penPos then
					local d = (oe.penPos - pos).Magnitude
					if d < bestD then
						best, bestD = oe.penPos, d
					end
				end
			end
			for _, n in npcs do
				local d = (n.pos - pos).Magnitude
				if d < bestD then
					best, bestD = n.pos, d
				end
			end
			if best and math.random() < 0.7 then
				local a = math.random() * math.pi * 2
				e.penGoal = best + Vector3.new(math.sin(a) * 4, 0, math.cos(a) * 4)
			else
				e.penGoal = penPoint()
			end
		end
		local goal = e.penGoal :: Vector3
		local d = goal - pos
		local stepLen = PEN_SPEED * dt
		e.penPos = if d.Magnitude <= stepLen then goal else pos + d.Unit * stepLen
		return false
	end
	local goal = e.path[1]
	if not goal then
		return false
	end
	local d = goal - pos
	local stepLen = TRAVEL_SPEED * dt
	if d.Magnitude <= stepLen then
		e.penPos = goal
		table.remove(e.path, 1)
		if #e.path == 0 then
			if e.mode == "toPen" then
				e.mode = "pen"
				e.penGoal = nil
			else
				return true
			end
		end
	else
		e.penPos = pos + d.Unit * stepLen
	end
	return false
end

-- Воспитанники сада бегают по вольеру и играют с теми, кто пришёл.
local function frameNpcs(dt: number)
	for _, n in npcs do
		n.clock += dt
		n.goalIn -= dt
		local near = nil
		for _, e in entries do
			if e.mode == "pen" and e.penPos and (e.penPos - n.pos).Magnitude < 24 then
				near = e.penPos
			end
		end
		if n.goalIn <= 0 then
			n.goalIn = 2 + math.random() * 3
			if near and math.random() < 0.6 then
				local a = math.random() * math.pi * 2
				n.goal = near + Vector3.new(math.sin(a) * 4, 0, math.cos(a) * 4)
			else
				n.goal = penPoint()
			end
		end
		local d = n.goal - n.pos
		local stepLen = 6 * dt
		local moving = d.Magnitude > 0.05
		if moving then
			n.pos = if d.Magnitude <= stepLen then n.goal else n.pos + d.Unit * stepLen
			n.yaw = math.atan2(-d.X, -d.Z)
		end
		n.poseIn -= dt
		if n.poseIn <= 0 then
			n.poseIn = 1 / 10
			n.body:pose({
				pos = n.pos,
				yaw = n.yaw,
				heightCm = n.heightCm,
				fat = 0.2,
				muscle = 0.2,
				mood = if near then "happy" else "calm",
				moving = moving,
				sleeping = false,
				happyTail = near ~= nil,
				t = n.clock,
			})
		end
	end
end

-- Каждый кадр: плавно двигаем тело к точке, где зверь в мозге, и рисуем мордочку.
function BeastService.frame(dt: number)
	for player, e in entries do
		e.clock += dt
		local sim = e.home.sim
		local b = sim.beast
		if e.mode then
			if moveAway(e, dt) then
				-- Дошёл до дома: дом снова видит зверя.
				if e.home.pen then
					Home.backHome(e.home)
				end
				e.mode = nil
				e.penPos = nil
				e.path = {}
			end
		end
		local target = beastWorldPos(e)
		local cur = e.renderPos or target
		if (target - cur).Magnitude > 25 then
			cur = target
		end
		local k = math.min(1, dt * 8)
		local nextPos = cur:Lerp(target, k)
		local delta = nextPos - cur
		local moving = delta.Magnitude > 0.02
		if moving then
			local want = math.atan2(-delta.X, -delta.Z)
			local diff = (want - e.yaw + math.pi) % (2 * math.pi) - math.pi
			e.yaw += diff * math.min(1, dt * 10)
		else
			-- Стоит: поворачивается к хозяину, если тот рядом.
			local r = rootOf(player)
			if r and (r.CFrame.Position - nextPos).Magnitude < 20 then
				local d = r.CFrame.Position - nextPos
				local want = math.atan2(-d.X, -d.Z)
				local diff = (want - e.yaw + math.pi) % (2 * math.pi) - math.pi
				e.yaw += diff * math.min(1, dt * 3)
			end
		end
		e.renderPos = nextPos
		local mood = Character.faceMood(sim)
		local sleeping = b.current ~= nil and b.current.behavior == "sleep" and b.current.phase == "doing"
		local happyTail = mood == "happy" or mood == "proud" or b.needs.joy > 70
		-- Тело двигаем 15 раз в секунду и только если что-то поменялось: это экономит сеть.
		e.poseIn -= dt
		local key = string.format("%.2f %.2f %.2f %s %s %.1f %.2f %.2f %s", nextPos.X, nextPos.Z, e.yaw, mood, tostring(sleeping), b.body.height, Body.fatRatio(b), Body.muscleRatio(b), tostring(e.home.dirty))
		local animate = moving or happyTail
		if e.poseIn <= 0 and (animate or key ~= e.poseKey) then
			e.poseIn = 1 / 15
			e.poseKey = key
			e.body:pose({
				pos = nextPos,
				yaw = e.yaw,
				heightCm = b.body.height,
				fat = Body.fatRatio(b),
				muscle = Body.muscleRatio(b),
				mood = mood,
				moving = moving,
				sleeping = sleeping,
				happyTail = happyTail,
				dirty = e.home.dirty,
				t = e.clock,
			})
		end
		local icon = Home.statusIcon(e.home) or ""
		if e.body.status.Text ~= icon then
			e.body.status.Text = icon
		end
		local bubble = if b.bubble ~= "" and b.bubble ~= nil then b.bubble else ""
		if e.body.bubble.Text ~= bubble then
			e.body.bubble.Text = bubble
		end
		if e.body.name.Text ~= b.name then
			e.body.name.Text = b.name
		end
		-- Короткая надпись над зверем (❤️, «?», «−1 урожай») — самая свежая из живых.
		local float = ""
		for i = #sim.floats, 1, -1 do
			local f = sim.floats[i]
			if f.untilMs > sim.tMs then
				float = f.text
				break
			end
		end
		e.body.float.Text = float
		e.body.status.Visible = float == ""
		-- Вещи дома — 10 раз в секунду (бабочке хватает).
		e.worldIn -= dt
		if e.worldIn <= 0 then
			e.worldIn = 0.1
			e.world:update(e.home, BeastService.farmOf and BeastService.farmOf(player), e.clock)
		end
	end
	frameNpcs(dt)
end

-- ---------- Снимок для экрана ----------

-- Хозяину — портрет и кнопки (и карточка, если открыта); любому игроку — чужой зверь рядом для кнопок гостя.
function BeastService.send(player: Player)
	local snap: any = {}
	local ws = WeatherService.state()
	snap.world = { night = DayNight.isNight(), left = math.floor(DayNight.left()), rain = ws.rain, storm = ws.storm, flash = ws.flash }
	local e = entries[player]
	if e then
		snap.own = Home.view(e.home, e.cardOpen)
		local farm = BeastService.farmOf and BeastService.farmOf(player)
		snap.own.canCarry = farm ~= nil and farm.construction ~= nil and e.mode == nil
		snap.own.away = e.mode ~= nil
	end
	local r = rootOf(player)
	if r then
		local best, bestD = nil, GUEST_DISTANCE
		for other, oe in entries do
			if other ~= player then
				local d = (r.CFrame.Position - beastWorldPos(oe)).Magnitude
				if d < bestD then
					best, bestD = oe, d
				end
			end
		end
		if best then
			local rel = best.home.sim.beast.relations[tostring(player.UserId)]
			snap.near = {
				owner = best.player.UserId,
				ownerName = best.player.DisplayName,
				name = best.home.sim.beast.name,
				species = Data.SPECIES[best.home.sim.beast.species].title,
				trust = if rel then math.floor(rel.trust + 0.5) else 0,
			}
		end
	end
	stateRemote:FireClient(player, snap)
end

return BeastService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">DayNight</string>
          <string name="Source"><![CDATA[--!strict
-- День и ночь: полный круг 10 минут (7 минут день, 3 минуты ночь). Ночью темно,
-- гоблины видят дальше и ходят набегами на участки (Shared.World.Wild).

local Lighting = game:GetService("Lighting")

local DayNight = {}

DayNight.DAY_SEC = 7 * 60
DayNight.NIGHT_SEC = 3 * 60
local CYCLE = DayNight.DAY_SEC + DayNight.NIGHT_SEC

local t = 30 -- игра начинается утром
local raining = false

-- В дождь пасмурно: свет тусклее и серее.
function DayNight.setRain(on: boolean)
	raining = on
end

-- Время суток по кругу: день 7:00 → 19:00, ночь 19:00 → 7:00.
local function clockAt(s: number): number
	if s < DayNight.DAY_SEC then
		return 7 + 12 * s / DayNight.DAY_SEC
	end
	return (19 + 12 * (s - DayNight.DAY_SEC) / DayNight.NIGHT_SEC) % 24
end

function DayNight.isNight(): boolean
	return t % CYCLE >= DayNight.DAY_SEC
end

-- Секунд до смены дня и ночи.
function DayNight.left(): number
	local s = t % CYCLE
	return if s < DayNight.DAY_SEC then DayNight.DAY_SEC - s else CYCLE - s
end

function DayNight.step(dt: number)
	t += dt
	local clock = clockAt(t % CYCLE)
	-- Свойство света уходит по сети всем: пишем, только когда время заметно сдвинулось.
	if math.abs(Lighting.ClockTime - clock) > 0.02 then
		Lighting.ClockTime = clock
	end
	-- Ночью лунный голубоватый свет, а не чёрная темнота: детям должно быть видно, куда идти.
	local night = DayNight.isNight()
	local ambient = if night then Color3.fromRGB(70, 80, 120) else Color3.fromRGB(77, 77, 82)
	local outdoor = if night then Color3.fromRGB(90, 100, 150) else Color3.fromRGB(128, 128, 133)
	if raining then
		ambient = ambient:Lerp(Color3.fromRGB(60, 64, 72), 0.5)
		outdoor = outdoor:Lerp(Color3.fromRGB(96, 100, 110), 0.5)
	end
	if Lighting.Ambient ~= ambient then
		Lighting.Ambient = ambient
	end
	if Lighting.OutdoorAmbient ~= outdoor then
		Lighting.OutdoorAmbient = outdoor
	end
end

-- Только для проверок: перемотать время (секунды от начала дня).
function DayNight.set(seconds: number)
	t = seconds
end

return DayNight
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="38">
        <Properties>
          <string name="Name">FarmService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Сервер фермы. Сервер главный: он хранит фермы, двигает время и проверяет каждую
-- команду игрока. Клиент только рисует экран и шлёт просьбы через FarmRemotes.Command.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")

local FarmPkg = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Farm")
local Config = require(FarmPkg:WaitForChild("Config"))
local Farm = require(FarmPkg:WaitForChild("Farm"))
local Contract = require(FarmPkg:WaitForChild("Contract"))
local Save = require(FarmPkg:WaitForChild("Save"))
local Text = require(FarmPkg:WaitForChild("Text"))
local View = require(FarmPkg:WaitForChild("View"))
local Shop = require(FarmPkg:WaitForChild("Shop"))
local Village = require(script.Parent:WaitForChild("Village"))
local FarmWorld = require(script.Parent:WaitForChild("FarmWorld"))
local Sky = require(script.Parent:WaitForChild("Sky"))
local BeastService = require(script.Parent:WaitForChild("BeastService"))
local DayNight = require(script.Parent:WaitForChild("DayNight"))
local ThreatService = require(script.Parent:WaitForChild("ThreatService"))
local WeatherService = require(script.Parent:WaitForChild("WeatherService"))

-- Сохранение в DataStore выключено, пока проверяем механику. Чтобы включить:
-- опубликовать место, в Studio включить Game Settings → Security → Enable Studio Access to API Services
-- и поставить true. Ферма тогда сохраняется при выходе и раз в минуту, а при входе доживает офлайн.
local USE_DATASTORE = false
local STORE_KEY = "farm_v1_"
local SEND_EVERY = 0.5 -- секунд между снимками для экрана
local DEBUG = RunService:IsStudio() -- кнопки отладки и «Внешний мир» только в Studio

local remotes = Instance.new("Folder")
remotes.Name = "FarmRemotes"
local commandRemote = Instance.new("RemoteEvent")
commandRemote.Name = "Command"
commandRemote.Parent = remotes
local stateRemote = Instance.new("RemoteEvent")
stateRemote.Name = "State"
stateRemote.Parent = remotes
local openRemote = Instance.new("RemoteEvent")
openRemote.Name = "Open"
openRemote.Parent = remotes
remotes.Parent = ReplicatedStorage

local villageFolder = Instance.new("Folder")
villageFolder.Name = "Village"
villageFolder.Parent = workspace
Sky.build(workspace)

type Session = {
	player: Player,
	slot: number,
	farm: Farm.FarmState,
	world: FarmWorld.World,
	sign: TextLabel,
	slotModel: Model,
	crop: string, -- что сажать по клику на пустую грядку
	tool: string, -- "auto" | "fertilize"
	log: { string }, -- новые строки журнала, ещё не отправленные на экран
	budget: number, -- ограничение частоты команд
	sendIn: number,
}

local sessions: { [Player]: Session } = {}
local slotModels: { [number]: { model: Model, sign: TextLabel } } = {}

for i = 1, Village.SLOTS do
	local model, sign = FarmWorld.buildSlot(i, villageFolder)
	slotModels[i] = { model = model, sign = sign }
end

-- Зверь живёт на участке рядом с фермой и меняет её через стык (Shared.Beast.Home).
BeastService.init(function(p: Player)
	local s = sessions[p]
	return s and s.farm
end)

-- Погода на весь сервер: дождь поливает все фермы и сообщает зверям (лужа, будка).
WeatherService.init({
	homes = BeastService.homes,
	farms = function()
		local list = {}
		for _, s in sessions do
			table.insert(list, s.farm)
		end
		return list
	end,
	notify = function(text: string)
		for _, s in sessions do
			s.farm.hint = text
		end
	end,
})

-- Лес и гоблины за кольцом: бьют игроков и ночью топчут урожай через стык фермы.
ThreatService.init(function(slot: number)
	local p = Village.owner(slot)
	local s = p and sessions[p]
	return s and s.farm
end, function(p: Player, text: string)
	local s = sessions[p]
	if s then
		s.farm.hint = text
	end
end)

local store = if USE_DATASTORE then DataStoreService:GetDataStore("OneBeastFarm") else nil

-- ---------- Проверка команд от клиента ----------
-- Клиенту не верим: каждое поле проверяется по списку разрешённых значений.

local function isString(v: any, set: { [string]: any }?): boolean
	return type(v) == "string" and #v < 40 and (set == nil or set[v] ~= nil)
end

local function ownPlot(s: Session, id: any): boolean
	return isString(id) and Farm.plotById(s.farm, id) ~= nil
end

local VALID: { [string]: (Session, any) -> boolean } = {
	plant = function(s, c) return ownPlot(s, c.plotId) and isString(c.crop, Config.CROPS) end,
	water = function(s, c) return ownPlot(s, c.plotId) end,
	water_all = function() return true end,
	fertilize = function(s, c) return ownPlot(s, c.plotId) end,
	harvest = function(s, c) return ownPlot(s, c.plotId) end,
	harvest_all = function() return true end,
	clear = function(s, c) return ownPlot(s, c.plotId) end,
	sell = function(_, c) return isString(c.item, Config.ITEMS) and type(c.count) == "number" and c.count >= 1 and c.count <= 999 and c.count % 1 == 0 end,
	complete_order = function(_, c) return isString(c.orderId) end,
	skip_order = function(_, c) return isString(c.orderId) end,
	build = function(_, c) return isString(c.building, Config.BUILDINGS) end,
	start_mill = function() return true end,
	start_bakery = function() return true end,
	cook = function(_, c) return isString(c.dish, Config.RECIPES) end,
	take_tray = function() return true end,
}

-- Только в Studio: кнопки вкладки «Внешний мир», чтобы проверить стык без зверя.
local DEBUG_ACTIONS: { [string]: (Farm.FarmState) -> () } = {
	coins = function(f) f.coins += 100 end,
	skip = function(f) for _ = 1, 60000 / Config.FARM.stepMs do Farm.tick(f, Config.FARM.stepMs) end end,
	offline = function(f) Farm.advance(f, 3600000) end,
	hail = function(f) Contract.damageCrops(f, 0.3, "Град") end,
	trample = function(f)
		for _, p in f.plots do
			if p.crop and p.stage ~= "rotten" then
				Contract.damagePlot(f, p.id, 0.3, "Зверь потоптал")
				return
			end
		end
	end,
	eat_green = function(f)
		for _, p in f.plots do
			if p.stage == "green" then
				Contract.eatPlot(f, p.id, "Зверь")
				return
			end
		end
	end,
	thief = function(f) Contract.takeFromStorage(f, "any", 2, "Вор") end,
	tray = function(f) Contract.takeFromTray(f, 1, "Зверь") end,
	manure = function(f) Contract.addFertilizer(f, 1, "Зверь") end,
	stones = function(f) Contract.helpConstruction(f, 12000, "Зверь") end,
	chickens = function(f) Contract.scareChickens(f, 20000, "Зверь") end,
	rain = function() WeatherService.force(true, false) end,
	storm = function() WeatherService.force(true, true) end,
	dry = function() WeatherService.force(false) end,
	night = function() DayNight.set(DayNight.DAY_SEC - 2) end,
	day = function() DayNight.set(0) end,
}

-- Общее время всех серверов: по нему лавка семян обновляется одновременно везде.
local function serverTime(): number
	return workspace:GetServerTimeNow()
end

-- Табличка над участком: видно соседям, как идут дела.
local function updateSign(s: Session)
	local text = `Ферма {s.player.DisplayName} · ⭐{s.farm.level} · 💰{s.farm.coins}`
	if s.sign.Text ~= text then
		s.sign.Text = text
	end
end

local function sendState(s: Session)
	updateSign(s)
	local objects = {}
	if DEBUG then
		for _, o in Contract.objects(s.farm) do
			table.insert(objects, `{o.id}: {o.label} [{table.concat(o.tags, ", ")}]`)
		end
	end
	local now = serverTime()
	local shop = { left = Shop.left(s.farm, now), secondsLeft = Shop.secondsLeft(now), seeds = (s.farm :: any).seeds }
	local snap = View.snapshot(s.farm, { crop = s.crop, tool = s.tool, debug = DEBUG, objects = objects, shop = shop })
	snap.log = s.log
	s.log = {}
	stateRemote:FireClient(s.player, snap)
	BeastService.send(s.player)
	s.farm.hint = nil
	s.sendIn = SEND_EVERY
end

local function collectLog(s: Session)
	for _, le in Contract.drainEvents(s.farm) do
		table.insert(s.log, Text(le.e))
	end
	-- Здесь позже сборка «Деревня» отдаст события зверю (стык, раздел 3).
end

local function onCommand(player: Player, c: any)
	local s = sessions[player]
	if not s or type(c) ~= "table" or type(c.type) ~= "string" then
		return
	end
	if s.budget <= 0 then
		return -- слишком часто
	end
	s.budget -= 1

	if c.type == "select_crop" then
		if isString(c.crop, Config.CROPS) then
			s.crop = c.crop
			s.tool = "auto"
		end
	elseif c.type == "buy_seed" then
		if isString(c.crop, Shop.STOCK) then
			Shop.buy(s.farm, c.crop, serverTime())
		end
	elseif c.type == "tool" then
		if c.tool == "auto" or c.tool == "fertilize" then
			s.tool = c.tool
		end
	elseif c.type == "debug" then
		local fn = DEBUG_ACTIONS[c.action]
		if DEBUG and isString(c.action) and fn then
			fn(s.farm)
		end
	else
		local valid = VALID[c.type]
		if not valid or not valid(s, c) then
			return
		end
		-- Пересобираем команду из проверенных полей, лишнее не пропускаем.
		Farm.command(s.farm, { type = c.type, plotId = c.plotId, crop = c.crop, item = c.item, count = c.count, orderId = c.orderId, building = c.building, dish = c.dish })
	end
	collectLog(s)
	s.world:update(s.farm)
	sendState(s)
end

-- Клик по грядке в мире: одно действие по смыслу (посадить, полить, собрать, убрать).
local function onPlotClick(s: Session, plotId: string)
	local f = s.farm
	local p = Farm.plotById(f, plotId)
	if not p then
		return
	end
	if s.tool == "fertilize" and Farm.isGrowing(p) then
		Farm.command(f, { type = "fertilize", plotId = plotId })
		s.tool = "auto"
	elseif p.stage == "empty" then
		Farm.command(f, { type = "plant", plotId = plotId, crop = s.crop })
	elseif Farm.isGrowing(p) then
		Farm.command(f, { type = "water", plotId = plotId })
	elseif p.stage == "ripe" then
		Farm.command(f, { type = "harvest", plotId = plotId })
	elseif p.stage == "rotten" then
		Farm.command(f, { type = "clear", plotId = plotId })
	end
end

local BUILDING_TAB = { storage = "storage", well = "build", compost = "build", coop = "workshop", mill = "workshop", bakery = "workshop", kitchen = "workshop" }

local function onWorldClick(player: Player, kind: string, id: string)
	local s = sessions[player]
	if not s or not s.world then
		return
	end
	if kind == "plot" then
		onPlotClick(s, id)
	elseif kind == "tray" then
		Farm.command(s.farm, { type = "take_tray" })
	elseif kind == "building" then
		local tab = if s.farm.buildings[id] > 0 then BUILDING_TAB[id] else "build"
		openRemote:FireClient(player, tab)
	end
	collectLog(s)
	s.world:update(s.farm)
	sendState(s)
end

-- ---------- Вход и выход ----------

local function loadFarm(player: Player): Farm.FarmState
	if store then
		local ok, data = pcall(function()
			return store:GetAsync(STORE_KEY .. player.UserId)
		end)
		if ok and data then
			local f = Save.fromData(data)
			if f then
				Save.catchUp(f, os.time())
				return f
			end
		end
	end
	return Farm.create(player.UserId % 2147483647)
end

local function saveFarm(s: Session)
	if not store then
		return
	end
	local data = Save.toData(s.farm, os.time())
	pcall(function()
		store:SetAsync(STORE_KEY .. s.player.UserId, data)
	end)
end

local function placeCharacter(s: Session, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 5) :: BasePart?
	task.wait(0.2) -- иначе точка появления может перебить наш перенос
	if root and root.Parent then
		root.CFrame = Village.cframe(s.slot, 380, 500, 4) -- перед грядками, лицом к ферме
	end
end

local function onPlayerAdded(player: Player)
	local slot = Village.claim(player)
	if not slot then
		player:Kick("На этом сервере все участки заняты. Зайди на другой сервер.")
		return
	end
	local f = loadFarm(player)
	Shop.attach(f)
	if not player.Parent then
		Village.release(player) -- ушёл, пока ферма загружалась
		return
	end
	local s: Session = {
		player = player,
		slot = slot,
		farm = f,
		-- Клик по чужой ферме пока ничего не делает: гости — следующий шаг.
		world = FarmWorld.new(slot, slotModels[slot].model, function(who, kind, id)
			if who == player then
				onWorldClick(who, kind, id)
			end
		end),
		sign = slotModels[slot].sign,
		slotModel = slotModels[slot].model,
		crop = "wheat",
		tool = "auto",
		log = {},
		budget = 20,
		sendIn = 0,
	}
	sessions[player] = s
	BeastService.join(player, slot, slotModels[slot].model)
	updateSign(s)
	s.world:update(f)
	if player.Character then
		task.spawn(placeCharacter, s, player.Character)
	end
	player.CharacterAdded:Connect(function(ch)
		placeCharacter(s, ch)
	end)
end

local function onPlayerRemoving(player: Player)
	local s = sessions[player]
	if not s then
		Village.release(player)
		return
	end
	saveFarm(s)
	BeastService.leave(player)
	ThreatService.leave(player)
	s.world:destroy()
	s.sign.Text = "Свободный участок"
	sessions[player] = nil
	Village.release(player)
end

commandRemote.OnServerEvent:Connect(onCommand)
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, p in Players:GetPlayers() do
	task.spawn(onPlayerAdded, p)
end

game:BindToClose(function()
	for _, s in sessions do
		saveFarm(s)
	end
end)

-- ---------- Время ----------
-- Ровные шаги по 250 мс, как в вебе: одинаковые правила и одинаковые числа.

local acc = 0
local saveIn = 60
RunService.Heartbeat:Connect(function(dt)
	acc += math.min(dt, 1)
	local stepSec = Config.FARM.stepMs / 1000
	local stepped = false
	DayNight.step(math.min(dt, 1))
	while acc >= stepSec do
		acc -= stepSec
		stepped = true
		ThreatService.step(Config.FARM.stepMs)
		WeatherService.step(Config.FARM.stepMs)
		for _, s in sessions do
			Farm.tick(s.farm, Config.FARM.stepMs)
			BeastService.step(s.player, s.farm, Config.FARM.stepMs)
			s.budget = math.min(20, s.budget + 2)
		end
	end
	BeastService.frame(math.min(dt, 0.25))
	ThreatService.frame(dt)
	saveIn -= dt
	for _, s in sessions do
		if stepped then
			collectLog(s)
			s.world:update(s.farm)
		end
		s.sendIn -= dt
		if s.sendIn <= 0 then
			sendState(s)
		end
		if saveIn <= 0 then
			task.spawn(saveFarm, s)
		end
	end
	if saveIn <= 0 then
		saveIn = 60
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">FarmWorld</string>
          <string name="Source"><![CDATA[--!strict
-- 3D-вид одной фермы на участке: грядки, постройки, противень. Только рисует состояние
-- и ловит клики (ClickDetector работает и мышью, и пальцем на телефоне).
-- Графика серая и блочная нарочно: это проверка механики, не внешнего вида.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FarmPkg = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Farm")
local Config = require(FarmPkg:WaitForChild("Config"))
local Farm = require(FarmPkg:WaitForChild("Farm"))
local Village = require(script.Parent:WaitForChild("Village"))
local PlantModels = require(script.Parent:WaitForChild("PlantModels"))

local ITEMS = Config.ITEMS
local BUILDINGS = Config.BUILDINGS
local S = Village.SCALE

-- Лего-вид как в Grow a Garden: пластик с пупырышками (Studs), сочные цвета.
local SOIL = {
	empty = Color3.fromRGB(150, 88, 52),
	wet = Color3.fromRGB(100, 56, 32),
	dry = Color3.fromRGB(180, 128, 82),
}
local GRASS = Color3.fromRGB(75, 151, 75)
local WOOD = Color3.fromRGB(112, 72, 44)
local STUDS = Enum.SurfaceType.Studs

local BUILDING_LOOK = {
	storage = { size = Vector3.new(12, 9, 12), color = Color3.fromRGB(150, 90, 50) },
	well = { size = Vector3.new(6, 4, 6), color = Color3.fromRGB(120, 120, 140) },
	compost = { size = Vector3.new(7, 4, 7), color = Color3.fromRGB(90, 120, 60) },
	coop = { size = Vector3.new(10, 6, 9), color = Color3.fromRGB(200, 170, 120) },
	mill = { size = Vector3.new(8, 12, 8), color = Color3.fromRGB(220, 220, 200) },
	bakery = { size = Vector3.new(10, 7, 9), color = Color3.fromRGB(210, 140, 90) },
	kitchen = { size = Vector3.new(10, 7, 9), color = Color3.fromRGB(200, 200, 210) },
}

local function mmss(ms: number): string
	local s = math.max(0, math.ceil(ms / 1000))
	return string.format("%d:%02d", s // 60, s % 60)
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

-- size — в стадах (а не пикселях): издалека подпись мельче и не налезает на соседние.
local function label(parent: Instance, offsetY: number, size: Vector2?, maxDistance: number?): TextLabel
	local sz = size or Vector2.new(8, 1.8)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(sz.X, sz.Y)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = maxDistance or 160
	gui.LightInfluence = 0
	gui.Parent = parent
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 0.35
	t.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextScaled = true
	t.Font = Enum.Font.GothamBold
	t.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.25, 0)
	corner.Parent = t
	return t
end

local function clickable(p: Instance, onClick: (Player) -> ())
	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 80
	cd.Parent = p
	cd.MouseClick:Connect(onClick)
end

export type World = {
	update: (self: World, f: Farm.FarmState) -> (),
	destroy: (self: World) -> (),
}

local FarmWorld = {}

-- Пустой участок деревни: земля и табличка. Строится для всех участков при старте сервера.
function FarmWorld.buildSlot(slot: number, parent: Instance): (Model, TextLabel)
	local model = Instance.new("Model")
	model.Name = "Slot" .. slot
	local w, h = Config.FARM.world.width * S + 8, Config.FARM.world.height * S + 8
	local frame = Village.frame(slot)
	local ground = part({ Name = "Ground", Size = Vector3.new(w, 1, h), CFrame = frame * CFrame.new(0, -0.5, 0), Color = GRASS, Material = Enum.Material.Plastic, TopSurface = STUDS, Parent = model })

	-- Забор из столбиков и двух жердей, спереди проход (как участки в Grow a Garden).
	local fence = Instance.new("Model")
	fence.Name = "Fence"
	fence.Parent = model
	local function rail(a: Vector3, b: Vector3)
		local mid, len = (a + b) / 2, (b - a).Magnitude
		for _, y in { 1.2, 2.4 } do
			part({ Size = Vector3.new(0.4, 0.4, len), CFrame = CFrame.new(mid + Vector3.new(0, y, 0)) * CFrame.Angles(0, math.atan2(-(b - a).X, -(b - a).Z), 0), Color = WOOD, Material = Enum.Material.Plastic, Parent = fence })
		end
		local n = math.max(1, math.floor(len / 6))
		for i = 0, n do
			local pos = a:Lerp(b, i / n)
			part({ Size = Vector3.new(0.8, 3.2, 0.8), Position = pos + Vector3.new(0, 1.6, 0), Color = WOOD, Material = Enum.Material.Plastic, TopSurface = STUDS, Parent = fence })
		end
	end
	local hw, hh = w / 2 - 0.5, h / 2 - 0.5
	local function L(x: number, z: number): Vector3
		return frame * Vector3.new(x, 0, z)
	end
	local gap = 6
	rail(L(-hw, -hh), L(hw, -hh))
	rail(L(-hw, -hh), L(-hw, hh))
	rail(L(hw, -hh), L(hw, hh))
	rail(L(-hw, hh), L(-gap, hh))
	rail(L(gap, hh), L(hw, hh))
	-- Дорожка от прохода к грядкам.
	part({ Name = "Path", Size = Vector3.new(2 * gap - 2, 0.1, hh), CFrame = frame * CFrame.new(0, 0.05, hh / 2), Color = Color3.fromRGB(226, 200, 150), Material = Enum.Material.Plastic, TopSurface = STUDS, Parent = model })
	local sign = part({ Name = "Sign", Size = Vector3.new(6, 4, 0.5), CFrame = Village.cframe(slot, 380, 560, 2), Color = WOOD, Material = Enum.Material.Plastic, TopSurface = STUDS, Parent = model })
	local text = label(sign, 4, Vector2.new(24, 2.6))
	text.Text = "Свободный участок"
	model.PrimaryPart = ground
	model.Parent = parent
	return model, text
end

-- Ферма игрока на участке slot. onClick(кто кликнул, kind, id): kind = "plot" | "building" | "tray".
function FarmWorld.new(slot: number, parent: Instance, onClick: (Player, string, string) -> ()): World
	local folder = Instance.new("Folder")
	folder.Name = "Farm"
	folder.Parent = parent

	local plotViews: { [string]: { soil: Part, plant: Model?, plantKey: string, text: TextLabel, key: string } } = {}
	local buildingViews: { [string]: { body: Part, text: TextLabel, key: string } } = {}
	local tray: Part? = nil
	local fieldsSign: Part? = nil

	local function plotView(p: Farm.Plot)
		local v = plotViews[p.id]
		if v then
			return v
		end
		local base = Village.cframe(slot, p.x, p.y)
		local size = 70 * S
		local soil = part({ Name = p.id, Size = Vector3.new(size, 0.6, size), CFrame = base * CFrame.new(0, 0.3, 0), Material = Enum.Material.Plastic, TopSurface = STUDS, Color = SOIL.empty, Parent = folder })
		-- Тёмный бортик вокруг грядки (как в Grow a Garden и Hay Day).
		for _, side in { Vector3.new(0, 0, 1), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0) } do
			local along = if side.X ~= 0 then Vector3.new(0.4, 0.9, size + 0.8) else Vector3.new(size + 0.8, 0.9, 0.4)
			part({ Name = "Border", Size = along, CFrame = base * CFrame.new(side * (size / 2 + 0.2) + Vector3.new(0, 0.45, 0)), Color = Color3.fromRGB(80, 44, 24), Material = Enum.Material.Plastic, TopSurface = STUDS, Parent = soil })
		end
		-- Подпись видна только вблизи, как цена над растением в Grow a Garden.
		local text = label(soil, 4.2, Vector2.new(7, 1.6), 45)
		clickable(soil, function(who) onClick(who, "plot", p.id) end)
		v = { soil = soil, plant = nil :: Model?, plantKey = "", text = text, key = "" }
		plotViews[p.id] = v
		return v
	end

	local function updatePlot(p: Farm.Plot)
		local v = plotView(p)
		local growing = Farm.isGrowing(p)
		local crop = p.crop
		local ripeIn = if growing then Farm.ripeInMs(p) else 0
		-- Перерисовываем, только если что-то видимое поменялось.
		local key = table.concat({ p.stage, crop or "", tostring(p.water > 0), tostring(p.fertilized), tostring(math.round(p.health * 100)), tostring(math.ceil(ripeIn / 1000)) }, "|")
		if key == v.key then
			return
		end
		v.key = key

		v.soil.Color = if not growing then SOIL.empty elseif p.water > 0 then SOIL.wet else SOIL.dry

		-- Растение пересобирается при смене стадии и каждые 10% роста: растёт на глазах.
		local plantKey = if crop and p.stage ~= "empty" then `{crop}|{p.stage}|{math.floor(p.growth * 10)}` else ""
		if plantKey ~= v.plantKey then
			v.plantKey = plantKey
			if v.plant then
				v.plant:Destroy()
				v.plant = nil
			end
			if plantKey ~= "" then
				local base = v.soil.CFrame * CFrame.new(0, 0.3, 0)
				local m = PlantModels.build(crop :: string, p.stage, p.growth, base)
				clickable(m, function(who) onClick(who, "plot", p.id) end)
				m.Parent = v.soil
				v.plant = m
			end
		end

		local icon = if crop then ITEMS[crop].icon else ""
		local extra = (if p.fertilized then " ✨" else "") .. (if p.health < 1 then ` ⚠{math.round(p.health * 100)}%` else "")
		if p.stage == "empty" then
			v.text.Text = "＋"
		elseif growing then
			v.text.Text = `{icon} {mmss(ripeIn)}` .. (if p.water <= 0 then " 💧?" else "") .. extra
		elseif p.stage == "ripe" then
			v.text.Text = `{icon} собрать!` .. extra
		else
			v.text.Text = "🤢 убрать"
		end
	end

	local function buildingView(id: string)
		local v = buildingViews[id]
		if v then
			return v
		end
		local info = BUILDINGS[id]
		local look = BUILDING_LOOK[id]
		local body = part({ Name = id, Size = look.size, CFrame = Village.cframe(slot, info.x, info.y, look.size.Y / 2), Color = look.color, Material = Enum.Material.Plastic, TopSurface = STUDS, Parent = folder })
		local text = label(body, look.size.Y / 2 + 1.8, Vector2.new(11, 2), 90)
		clickable(body, function(who) onClick(who, "building", id) end)
		v = { body = body, text = text, key = "" }
		buildingViews[id] = v
		return v
	end

	local function updateBuilding(f: Farm.FarmState, id: string)
		local v = buildingView(id)
		local info = BUILDINGS[id]
		local lvl = f.buildings[id]
		local con = f.construction
		local text
		if con and con.building == id then
			text = `🔨 {info.name} {mmss(con.remainingMs)}`
		elseif lvl == 0 then
			text = if f.level < info.level then `🔒 {info.name} (ур. {info.level})` else `🔨 {info.name}: {info.cost[1]} 💰`
		else
			text = `{info.icon} {info.name}` .. (if info.maxLevel > 1 then ` {lvl}` else "")
			local t: Farm.Timer? = if id == "mill" then f.mill elseif id == "bakery" then f.bakery elseif id == "kitchen" then f.kitchen else nil
			if t then
				text ..= ` · {mmss(t.doneAtMs - f.tMs)}`
			end
			if id == "storage" then
				text ..= ` · {Farm.storedCount(f)}/{Farm.storageCap(f)}`
			end
			if id == "coop" and f.tMs < f.coop.scaredUntilMs then
				text ..= " · 😱"
			end
		end
		local key = text .. tostring(lvl)
		if key == v.key then
			return
		end
		v.key = key
		v.text.Text = text
		-- Не построено: вместо призрачного куба площадка под стройку (песочный пятачок).
		local look = BUILDING_LOOK[id]
		local up = lvl > 0 or (con ~= nil and con.building == id)
		local h = if up then look.size.Y else 0.4
		v.body.Size = Vector3.new(look.size.X, h, look.size.Z)
		v.body.CFrame = Village.cframe(slot, info.x, info.y, h / 2)
		v.body.Color = if up then look.color else Color3.fromRGB(214, 186, 136)
		v.body.Transparency = 0
		local gui = v.text.Parent :: BillboardGui
		gui.StudsOffset = Vector3.new(0, h / 2 + 1.8, 0)
	end

	local self = {} :: any

	function self.update(_: World, f: Farm.FarmState)
		for _, p in f.plots do
			updatePlot(p)
		end
		for id in BUILDING_LOOK do
			updateBuilding(f, id)
		end

		-- Противень у пекарни: горячий хлеб остывает, его можно забрать сразу.
		if f.tray then
			if not tray then
				local x, y = Farm.trayPos()
				local t = part({ Name = "Tray", Size = Vector3.new(4, 1, 3), CFrame = Village.cframe(slot, x, y, 0.5), Color = Color3.fromRGB(180, 180, 180), Material = Enum.Material.Metal, Parent = folder })
				label(t, 2.5, Vector2.new(6, 1.6))
				clickable(t, function(who) onClick(who, "tray", "tray") end)
				tray = t
			end
			local lbl = (tray :: Part):FindFirstChildOfClass("BillboardGui"):FindFirstChildOfClass("TextLabel") :: TextLabel
			lbl.Text = `🍞×{f.tray.bread} {mmss(f.tray.coolUntilMs - f.tMs)}`
		elseif tray then
			tray:Destroy()
			tray = nil
		end

		-- Стройка новых грядок: табличка под сеткой грядок.
		local con = f.construction
		if con and con.building == "fields" then
			if not fieldsSign then
				local g = Config.FARM.plotGrid
				local s = part({ Name = "FieldsWork", Size = Vector3.new(6, 2, 1), CFrame = Village.cframe(slot, g.x0 + g.step, g.y0 + math.ceil(#f.plots / g.cols) * g.step, 1), Color = Color3.fromRGB(200, 170, 60), Parent = folder })
				label(s, 2.5, Vector2.new(10, 1.8))
				fieldsSign = s
			end
			local lbl = (fieldsSign :: Part):FindFirstChildOfClass("BillboardGui"):FindFirstChildOfClass("TextLabel") :: TextLabel
			lbl.Text = `🔨 Новые грядки {mmss(con.remainingMs)}`
		elseif fieldsSign then
			fieldsSign:Destroy()
			fieldsSign = nil
		end
	end

	function self.destroy(_: World)
		folder:Destroy()
	end

	return self :: World
end

return FarmWorld
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">Forest</string>
          <string name="Source"><![CDATA[--!strict
-- Мир вокруг кольца участков: площадь в центре, луг, лес до горизонта и лагеря гоблинов в лесу.
-- Только рисует; где лагеря и какой у них уровень, решает Shared.World.Wild.

local Village = require(script.Parent:WaitForChild("Village"))

local Forest = {}

local STUDS = Enum.SurfaceType.Studs

local function part(props: { [string]: any }): BasePart
	local class = props.ClassName or "Part"
	props.ClassName = nil
	local p = Instance.new(class) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth;
	(p :: any).Material = Enum.Material.Plastic
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

-- Плоский круг (цилиндр, лежащий на боку).
local function disc(name: string, radius: number, y: number, color: Color3, parent: Instance): BasePart
	return part({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, radius * 2, radius * 2),
		CFrame = CFrame.new(0, y, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		CanCollide = false,
		Parent = parent,
	})
end

-- Простая детерминированная случайность: лес одинаковый на всех серверах.
local seed = 12345
local function rand(): number
	seed = (seed * 1103515245 + 12345) % 2147483648
	return seed / 2147483648
end

local TRUNK = Color3.fromRGB(112, 72, 44)
local LEAVES = { Color3.fromRGB(56, 120, 56), Color3.fromRGB(70, 140, 60), Color3.fromRGB(44, 100, 52), Color3.fromRGB(88, 150, 70) }

local function tree(parent: Instance, x: number, z: number, scale: number)
	local m = Instance.new("Model")
	m.Name = "Tree"
	local h = (6 + rand() * 4) * scale
	part({ Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 1.6 * scale, 1.6 * scale), CFrame = CFrame.new(x, h / 2, z) * CFrame.Angles(0, 0, math.pi / 2), Color = TRUNK, Parent = m })
	local n = 2 + math.floor(rand() * 2)
	for i = 1, n do
		local s = (6 + rand() * 4) * scale
		local ox, oz = (rand() - 0.5) * 3 * scale, (rand() - 0.5) * 3 * scale
		part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.new(s, s, s), CFrame = CFrame.new(x + ox, h + (i - 1) * 2.2 * scale, z + oz), Color = LEAVES[1 + math.floor(rand() * #LEAVES)], CanCollide = false, Parent = m })
	end
	m.Parent = parent
end

local function campView(parent: Instance, camp: any)
	local m = Instance.new("Model")
	m.Name = camp.id
	local cx, cz = camp.x, camp.z
	-- Шалаш из двух скатов и костёр со светом (видно ночью издалека).
	local yaw = math.atan2(-cx, -cz)
	local base = CFrame.new(cx, 0, cz) * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, -8) -- шалаш за костром, если смотреть из деревни
	local tentColor = Color3.fromRGB(120, 100, 70)
	part({ ClassName = "WedgePart", Name = "TentL", Size = Vector3.new(7, 5, 2.5), CFrame = base * CFrame.new(-1.25, 2.5, 0) * CFrame.Angles(0, math.pi / 2, 0), Color = tentColor, Parent = m })
	part({ ClassName = "WedgePart", Name = "TentR", Size = Vector3.new(7, 5, 2.5), CFrame = base * CFrame.new(1.25, 2.5, 0) * CFrame.Angles(0, -math.pi / 2, 0), Color = tentColor, Parent = m })
	local fire = part({ Name = "Fire", Size = Vector3.new(2, 1.2, 2), CFrame = CFrame.new(cx, 0.6, cz), Color = Color3.fromRGB(255, 140, 40), Material = Enum.Material.Neon, CanCollide = false, Parent = m })
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		part({ Name = "Log", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 0.6, 0.6), CFrame = CFrame.new(cx, 0.3, cz) * CFrame.Angles(0, a, 0) * CFrame.new(1, 0, 0), Color = TRUNK, Parent = m })
	end
	local light = Instance.new("PointLight")
	light.Range = 22
	light.Brightness = 2
	light.Color = Color3.fromRGB(255, 160, 80)
	light.Parent = fire
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(10, 2.2)
	gui.StudsOffset = Vector3.new(0, 7, 0)
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	gui.Parent = fire
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = Color3.fromRGB(255, 220, 160)
	t.TextStrokeTransparency = 0
	t.Text = `👺 Лагерь гоблинов · ур. {camp.level}`
	t.Parent = gui
	m.Parent = parent
end

-- camps: лагеря из Wild (id, x, z, level); inner/outer — края леса.
function Forest.build(parent: Instance, camps: { any }, inner: number, outer: number)
	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = parent

	-- Земля: тёмный лес, светлый луг вокруг деревни, площадь в центре.
	disc("ForestFloor", outer + 40, -0.13, Color3.fromRGB(52, 110, 52), world)
	disc("Meadow", inner - 10, -0.11, Color3.fromRGB(80, 156, 80), world)
	local plaza = disc("Plaza", Village.PLAZA, -0.09, Color3.fromRGB(214, 196, 160), world)
	plaza.TopSurface = STUDS
	-- Знак на площади.
	-- Знак на площади между участками 1 и 2, у вольера (вольер в центре — Pen.luau).
	local sx, sz = math.sin(math.pi / 6) * 42, math.cos(math.pi / 6) * 42
	local sign = part({ Name = "PlazaSign", Size = Vector3.new(8, 5, 0.6), CFrame = CFrame.new(sx, 4, sz) * CFrame.Angles(0, math.pi / 6, 0), Color = Color3.fromRGB(150, 98, 58), Parent = world })
	part({ Name = "Post", Size = Vector3.new(0.8, 4, 0.8), CFrame = CFrame.new(sx, 1.5, sz), Color = TRUNK, Parent = world })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(16, 3)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.MaxDistance = 200
	gui.LightInfluence = 0
	gui.Parent = sign
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0
	t.Text = "🏡 Деревня · 🌲 за кольцом лес: чем дальше, тем сильнее гоблины"
	t.Parent = gui

	-- Лес: кольцами, у края гуще, вглубь реже и выше. Вокруг лагерей поляны.
	local trees = Instance.new("Folder")
	trees.Name = "Trees"
	trees.Parent = world
	local r = inner + 6
	while r < outer do
		local k = (r - inner) / (outer - inner)
		local spacing = 24 + 26 * k
		local n = math.floor(2 * math.pi * r / spacing)
		local shift = rand() * math.pi * 2
		for i = 1, n do
			local a = shift + (i + (rand() - 0.5) * 0.6) / n * math.pi * 2
			local rr = r + (rand() - 0.5) * 12
			local x, z = math.sin(a) * rr, math.cos(a) * rr
			local clear = false
			for _, c in camps do
				if (Vector3.new(x, 0, z) - Vector3.new(c.x, 0, c.z)).Magnitude < 26 then
					clear = true
				end
			end
			if not clear then
				tree(trees, x, z, 1 + k * 0.7)
			end
		end
		r += 30
	end

	local campFolder = Instance.new("Folder")
	campFolder.Name = "Camps"
	campFolder.Parent = world
	for _, c in camps do
		campView(campFolder, c)
	end
	return world
end

return Forest
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">HomeWorld</string>
          <string name="Source"><![CDATA[--!strict
-- Вещи зверя на участке в 3D: миска, лежанка, туалет, игрушка, колючий куст, ягодные кусты,
-- камни у стройки, кучки, бабочка и паук. Только рисует состояние дома (Shared.Beast.Home)
-- и ловит клики хозяина: миска — насыпать корм, кучка — убрать, паук — прогнать.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BeastPkg = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Beast")
local Home = require(BeastPkg:WaitForChild("Home"))
local Data = require(BeastPkg:WaitForChild("Data"))
local Village = require(script.Parent:WaitForChild("Village"))

local LAYOUT = Home.LAYOUT
local STUDS = Enum.SurfaceType.Studs

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.Plastic
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

local function ball(props: { [string]: any }): Part
	props.Shape = Enum.PartType.Ball
	return part(props)
end

-- Короткая подпись-значок над вещью: видно вблизи, чтобы было понятно, что это.
local function tag(parent: BasePart, text: string, y: number): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(2.2, 1.6)
	gui.StudsOffset = Vector3.new(0, y, 0)
	gui.MaxDistance = 40
	gui.LightInfluence = 0
	gui.Parent = parent
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0
	t.Text = text
	t.Parent = gui
	return t
end

local function clickable(p: Instance, onClick: (Player) -> ())
	local cd = Instance.new("ClickDetector")
	cd.MaxActivationDistance = 60
	cd.Parent = p
	cd.MouseClick:Connect(onClick)
end

export type World = {
	update: (self: World, home: any, farm: any, t: number) -> (),
	destroy: (self: World) -> (),
}

local HomeWorld = {}

-- onClick(player, kind, id): kind = "bowl" | "pile" | "spider"
function HomeWorld.new(slot: number, parent: Instance, home: any, onClick: (Player, string, string) -> ()): World
	local folder = Instance.new("Folder")
	folder.Name = "Home"
	folder.Parent = parent
	local function at(p: { x: number, y: number }, h: number?): Vector3
		return Village.toWorld(slot, p.x, p.y, h)
	end
	local function atCf(p: { x: number, y: number }, h: number?): CFrame
		return Village.cframe(slot, p.x, p.y, h)
	end

	-- Миска: клик насыпает корм.
	local bowl = part({ Name = "Bowl", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 3, 3), CFrame = CFrame.new(at(LAYOUT.bowl, 0.4)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(70, 130, 220), Parent = folder })
	local food = part({ Name = "Food", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 2.4, 2.4), CFrame = CFrame.new(at(LAYOUT.bowl, 0.85)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(170, 110, 60), Parent = folder })
	local bowlTag = tag(bowl, "🥣", 2)
	clickable(bowl, function(who) onClick(who, "bowl", "bowl") end)
	clickable(food, function(who) onClick(who, "bowl", "bowl") end)

	-- Будка с лежанкой внутри: тут зверь спит и прячется от дождя. Вход смотрит к воротам.
	local bed = part({ Name = "Bed", Size = Vector3.new(6, 0.8, 4.5), CFrame = atCf(LAYOUT.bed, 0.4), Color = Color3.fromRGB(150, 98, 58), TopSurface = STUDS, Parent = folder })
	part({ Name = "Cushion", Size = Vector3.new(5, 0.6, 3.6), CFrame = atCf(LAYOUT.bed, 1.0), Color = Color3.fromRGB(220, 90, 90), Parent = bed })
	local kennel = Instance.new("Model")
	kennel.Name = "Kennel"
	local wood = Color3.fromRGB(196, 140, 84)
	local roofColor = Color3.fromRGB(196, 60, 50)
	local base = atCf(LAYOUT.bed, 0)
	part({ Name = "BackWall", Size = Vector3.new(7.4, 4.5, 0.4), CFrame = base * CFrame.new(0, 2.25, -2.9), Color = wood, Parent = kennel })
	part({ Name = "LeftWall", Size = Vector3.new(0.4, 4.5, 6.2), CFrame = base * CFrame.new(-3.5, 2.25, 0), Color = wood, Parent = kennel })
	part({ Name = "RightWall", Size = Vector3.new(0.4, 4.5, 6.2), CFrame = base * CFrame.new(3.5, 2.25, 0), Color = wood, Parent = kennel })
	part({ Name = "Lintel", Size = Vector3.new(7.4, 1, 0.4), CFrame = base * CFrame.new(0, 4, 2.9), Color = wood, Parent = kennel })
	part({ Name = "RoofL", Size = Vector3.new(4.8, 0.45, 7.2), CFrame = base * CFrame.new(-1.9, 5.7, 0) * CFrame.Angles(0, 0, math.rad(35)), Color = roofColor, Parent = kennel })
	part({ Name = "RoofR", Size = Vector3.new(4.8, 0.45, 7.2), CFrame = base * CFrame.new(1.9, 5.7, 0) * CFrame.Angles(0, 0, math.rad(-35)), Color = roofColor, Parent = kennel })
	local gableBack = Instance.new("WedgePart")
	for _, side in { -1, 1 } do
		-- Треугольник задней стенки под крышей: два клина.
		local g = side == -1 and gableBack or Instance.new("WedgePart")
		g.Name = "Gable"
		g.Anchored = true
		g.CanCollide = false
		g.TopSurface = Enum.SurfaceType.Smooth
		g.BottomSurface = Enum.SurfaceType.Smooth
		g.Material = Enum.Material.Plastic
		g.Color = wood
		g.Size = Vector3.new(0.4, 2.5, 3.7)
		g.CFrame = base * CFrame.new(side * 1.85, 5.75, -2.9) * CFrame.Angles(0, -side * math.pi / 2, 0)
		g.Parent = kennel
	end
	kennel.Parent = folder
	tag(bed, "🏠", 7.5)

	-- Лужа после дождя: растёт, пока идёт дождь, потом высыхает.
	local puddle = part({ Name = "Puddle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 1, 1), CFrame = CFrame.new(at(LAYOUT.puddle, 0.06)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(96, 128, 170), Material = Enum.Material.SmoothPlastic, Transparency = 1, Parent = folder })
	local puddleTag = tag(puddle, "💦", 1.5)
	puddleTag.Visible = false
	local puddleSize = -1

	-- Туалет: ящик с песком.
	local toilet = part({ Name = "Toilet", Size = Vector3.new(4, 0.8, 4), CFrame = atCf(LAYOUT.toilet, 0.4), Color = Color3.fromRGB(120, 120, 140), TopSurface = STUDS, Parent = folder })
	part({ Name = "Sand", Size = Vector3.new(3.4, 0.2, 3.4), CFrame = atCf(LAYOUT.toilet, 0.85), Color = Color3.fromRGB(230, 210, 160), Parent = toilet })
	tag(toilet, "🚽", 2.2)

	-- Колючий куст: шар с шипами.
	local thorns = ball({ Name = "Thorns", Size = Vector3.new(3.4, 3.4, 3.4), CFrame = atCf(LAYOUT.thorns, 1.6), Color = Color3.fromRGB(60, 110, 60), Parent = folder })
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		part({ Name = "Spike", Size = Vector3.new(0.25, 0.25, 1.2), CFrame = CFrame.new(at(LAYOUT.thorns, 1.6 + (i % 2) * 0.6)) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -1.8), Color = Color3.fromRGB(230, 220, 170), Parent = thorns })
	end
	tag(thorns, "🌵", 3)

	-- Ягодные кусты: ягоды видны, пока не съедены.
	local berries: { [string]: { Part } } = {}
	for _, k in { "wolfberry", "raspberry" } do
		local bush = ball({ Name = k, Size = Vector3.new(3, 2.6, 3), CFrame = atCf(LAYOUT[k], 1.3), Color = Color3.fromRGB(70, 140, 70), Parent = folder })
		local list = {}
		local color = if k == "wolfberry" then Color3.fromRGB(60, 50, 120) else Color3.fromRGB(220, 40, 60)
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			table.insert(list, ball({ Name = "Berry", Size = Vector3.new(0.6, 0.6, 0.6), CFrame = CFrame.new(at(LAYOUT[k], 1.5 + (i % 2) * 0.6)) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -1.3), Color = color, Parent = bush }))
		end
		berries[k] = list
	end

	-- Игрушка: двигается, когда зверь её носит.
	local toyId = home.sim.beast.favoriteToy
	local toyInfo = Data.TOYS[toyId]
	local toyColors = { ball = Color3.fromRGB(240, 70, 60), stick = Color3.fromRGB(160, 110, 60), plush = Color3.fromRGB(230, 200, 220), rope = Color3.fromRGB(220, 190, 120), cone = Color3.fromRGB(130, 90, 50) }
	local toy = if toyId == "stick" or toyId == "rope"
		then part({ Name = "Toy", Size = Vector3.new(0.5, 0.5, 2.6), Color = toyColors[toyId], Parent = folder })
		else ball({ Name = "Toy", Size = Vector3.new(1.3, 1.3, 1.3), Color = toyColors[toyId] or Color3.new(1, 0, 0), Parent = folder })
	tag(toy, toyInfo.icon, 1.6)

	-- Камни у стройки (только пока на ферме что-то строится).
	local stones = Instance.new("Model")
	stones.Name = "Stones"
	for i = 0, 2 do
		ball({ Name = "Stone", Size = Vector3.new(1.4, 1.4, 1.4), CFrame = atCf(LAYOUT.stones, 0.6) * CFrame.new((i - 1) * 1.2, (i % 2) * 0.6, (i % 2) * 0.7), Color = Color3.fromRGB(140, 140, 150), Parent = stones })
	end

	-- Бабочка и паук.
	local butterfly = part({ Name = "Butterfly", Size = Vector3.new(1.2, 0.1, 0.8), Color = Color3.fromRGB(250, 180, 40), Transparency = 1, Parent = folder })
	local spider = ball({ Name = "Spider", Size = Vector3.new(0.9, 0.9, 0.9), Color = Color3.fromRGB(30, 30, 30), Transparency = 1, Parent = folder })
	local spiderTag = tag(spider, "🕷", 1.2)
	spiderTag.Visible = false
	clickable(spider, function(who) onClick(who, "spider", "spider") end)

	local piles: { [string]: Part } = {}

	local self = {} :: any

	function self.update(w: World, h: any, farm: any, t: number)
		local ps = math.floor(h.puddle * 20 + 0.5) / 20
		if ps ~= puddleSize then
			puddleSize = ps
			local d = 2 + 7 * ps
			puddle.Size = Vector3.new(0.12, d, d * 0.8)
			puddle.Transparency = if ps <= 0 then 1 else 0.2
			puddleTag.Visible = ps >= Home.LAYOUT.puddleMin
		end
		food.Transparency = if h.bowl.food then 0 else 1
		bowlTag.Text = if h.bowl.food then "🥣" else "🥣 пусто"
		for k, list in berries do
			for _, b in list do
				b.Transparency = if h.berries[k].ripe then 0 else 1
			end
		end
		local toyCf = CFrame.new(at(h.toy, 0.7))
		if toy.CFrame ~= toyCf then
			toy.CFrame = toyCf
		end
		stones.Parent = if farm and farm.construction then folder else nil
		local bf = h.butterfly
		if bf.active then
			butterfly.Transparency = 0
			local flap = math.sin(t * 20) * 0.6
			butterfly.CFrame = CFrame.new(at({ x = bf.x, y = bf.y }, 3.5 + math.sin(t * 3) * 0.6)) * CFrame.Angles(0, math.atan2(-bf.vx, -bf.vy), flap)
		else
			butterfly.Transparency = 1
		end
		if h.spider then
			spider.Transparency = 0
			spider.CFrame = CFrame.new(at({ x = h.spider.x, y = h.spider.y }, 0.45))
			spiderTag.Visible = true
		else
			spider.Transparency = 1
			spiderTag.Visible = false
		end
		local seen = {}
		for _, p in h.piles do
			seen[p.id] = true
			if not piles[p.id] then
				local pile = ball({ Name = p.id, Size = Vector3.new(1.2, 1.2, 1.2), CFrame = atCf({ x = p.x, y = p.y }, 0.4), Color = if p.watery then Color3.fromRGB(150, 110, 50) else Color3.fromRGB(110, 70, 35), Parent = folder })
				ball({ Name = "Top", Size = Vector3.new(0.7, 0.7, 0.7), CFrame = atCf({ x = p.x, y = p.y }, 1.0), Color = pile.Color, Parent = pile })
				tag(pile, "💩", 1.6)
				local id = p.id
				clickable(pile, function(who) onClick(who, "pile", id) end)
				piles[p.id] = pile
			end
		end
		for id, pile in piles do
			if not seen[id] then
				pile:Destroy()
				piles[id] = nil
			end
		end
	end

	function self.destroy(w: World)
		stones:Destroy()
		folder:Destroy()
	end

	return self :: World
end

return HomeWorld
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Pen</string>
          <string name="Source"><![CDATA[--!strict
-- Вольер в центре деревни: круглый забор на площади, в нём зелёная лужайка.
-- В заборе проход напротив каждого участка, чтобы зверь шёл из дома прямо.
-- Только рисует; кто в вольере и что там делает, решает BeastService (и Shared.Beast.Home).

local Village = require(script.Parent:WaitForChild("Village"))

local Pen = {}

Pen.RADIUS = 30
Pen.INNER = 24 -- куда зверь может бежать внутри (не впритык к забору)
local GAP = 0.16 -- половина прохода в радианах (около 5 стадов)

local WOOD = Color3.fromRGB(150, 98, 58)

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.Plastic
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

-- Направление на участок i от центра (как в Village.frame).
local function slotAngle(i: number): number
	return (i - 1) / Village.SLOTS * math.pi * 2
end

-- Проход в заборе напротив участка: точка на окружности радиуса r.
function Pen.gate(slot: number, r: number?): Vector3
	local a = slotAngle(slot)
	local rr = r or Pen.RADIUS
	return Vector3.new(math.sin(a) * rr, 0, math.cos(a) * rr)
end

local function inGap(a: number): boolean
	for i = 1, Village.SLOTS do
		local d = (a - slotAngle(i) + math.pi) % (2 * math.pi) - math.pi
		if math.abs(d) < GAP then
			return true
		end
	end
	return false
end

function Pen.build(parent: Instance): Folder
	local folder = Instance.new("Folder")
	folder.Name = "Pen"
	part({
		Name = "Lawn",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, Pen.RADIUS * 2, Pen.RADIUS * 2),
		CFrame = CFrame.new(0, -0.07, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(96, 170, 84),
		TopSurface = Enum.SurfaceType.Studs,
		Parent = folder,
	})
	-- Столбики и две перекладины между ними, кроме проходов.
	local N = 48
	local prev: Vector3? = nil
	local prevA = 0
	for k = 0, N do
		local a = k / N * math.pi * 2
		local p = Vector3.new(math.sin(a) * Pen.RADIUS, 0, math.cos(a) * Pen.RADIUS)
		local gap = inGap(a)
		if not gap and k < N then
			part({ Name = "Post", Size = Vector3.new(0.6, 3.2, 0.6), CFrame = CFrame.new(p + Vector3.new(0, 1.6, 0)), Color = WOOD, Parent = folder })
		end
		if prev and not gap and not inGap(prevA) then
			local mid = (prev + p) / 2
			local len = (p - prev).Magnitude
			local yaw = math.atan2(p.X - prev.X, p.Z - prev.Z)
			for _, y in { 1.1, 2.4 } do
				part({ Name = "Rail", Size = Vector3.new(0.3, 0.35, len), CFrame = CFrame.new(mid.X, y, mid.Z) * CFrame.Angles(0, yaw, 0), Color = WOOD, Parent = folder })
			end
		end
		prev = p
		prevA = a
	end
	-- Табличка над вольером.
	local signPost = part({ Name = "PenSign", Size = Vector3.new(0.6, 6, 0.6), CFrame = CFrame.new(0, 3, 0), Color = WOOD, Parent = folder })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(14, 2.6)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.MaxDistance = 160
	gui.LightInfluence = 0
	gui.Parent = signPost
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0
	t.Text = "🐾 Вольер: звери играют вместе"
	t.Parent = gui
	folder.Parent = parent
	return folder
end

return Pen
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">PlantModels</string>
          <string name="Source"><![CDATA[--!strict
-- Растения из простых деталей, как в Grow a Garden: кустик растёт на глазах,
-- у спелого видно плоды. Без покупных моделей: только Part и их формы.
-- build(crop, stage, growth, base) → Model; base — центр верха грядки.

local PlantModels = {}

local C = {
	stem = Color3.fromRGB(50, 150, 50),
	leaf = Color3.fromRGB(60, 180, 60),
	leafDark = Color3.fromRGB(30, 120, 50),
	sprout = Color3.fromRGB(150, 220, 110),
	wheatGreen = Color3.fromRGB(150, 196, 90),
	wheatGold = Color3.fromRGB(250, 200, 40),
	carrot = Color3.fromRGB(245, 130, 40),
	berry = Color3.fromRGB(225, 40, 60),
	berryUnripe = Color3.fromRGB(235, 235, 200),
	pumpkin = Color3.fromRGB(245, 140, 30),
	pumpkinGreen = Color3.fromRGB(120, 160, 70),
	rotten = Color3.fromRGB(110, 95, 60),
	rottenLeaf = Color3.fromRGB(120, 110, 70),
}

-- Растения крупнее грядочной клетки не выходят, но видны с середины участка (v0.5: ×1.5).
local K = 1.5
local origin = CFrame.new()

local function piece(model: Model, size: Vector3, cf: CFrame, color: Color3, shape: Enum.PartType?): Part
	-- Масштаб вокруг основания растения: и размер, и смещение деталей.
	local rel = origin:ToObjectSpace(cf)
	cf = origin * (CFrame.new(rel.Position * K) * rel.Rotation)
	size *= K
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CastShadow = true
	-- Лего-пластик: у кубиков сверху пупырышки, как в Grow a Garden.
	p.Material = Enum.Material.Plastic
	p.TopSurface = if shape == nil then Enum.SurfaceType.Studs else Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Parent = model
	return p
end

local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder

-- Листик: плоская пластинка, наклонённая наружу под углом.
local function leaf(m: Model, base: CFrame, angle: number, len: number, color: Color3)
	local cf = base * CFrame.Angles(0, angle, 0) * CFrame.new(0, len * 0.35, -len * 0.3) * CFrame.Angles(math.rad(-35), 0, 0)
	piece(m, Vector3.new(len * 0.45, 0.08, len), cf, color)
end

-- Стебель вертикально: цилиндр в Roblox лежит вдоль X, поворачиваем.
local function stem(m: Model, base: CFrame, h: number, w: number, color: Color3, tilt: number?, turn: number?)
	local cf = base * CFrame.Angles(0, turn or 0, tilt or 0) * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
	piece(m, Vector3.new(h, w, w), cf, color, CYL)
end

local function sprout(m: Model, base: CFrame, s: number)
	stem(m, base, 0.8 * s, 0.18, C.stem)
	leaf(m, base * CFrame.new(0, 0.6 * s, 0), 0, 0.7 * s, C.sprout)
	leaf(m, base * CFrame.new(0, 0.6 * s, 0), math.pi, 0.7 * s, C.sprout)
end

local BUILD: { [string]: (Model, CFrame, string, number) -> () } = {}

-- Пшеница: пучок колосьев, зелёных пока растут, золотых когда спелые.
BUILD.wheat = function(m, base, stage, s)
	local ripe = stage == "ripe"
	local color = if ripe then C.wheatGold else C.wheatGreen
	local h = (if ripe then 3.4 else 1.2 + 2.2 * s)
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		local r = if i == 0 then 0 else 1.1
		local b = base * CFrame.new(math.cos(a) * r, 0, math.sin(a) * r)
		local tilt = math.rad(if i == 0 then 0 else 8)
		stem(m, b, h, 0.14, color, tilt, a)
		if ripe or s > 0.7 then
			local top = b * CFrame.Angles(0, a, tilt) * CFrame.new(0, h + 0.35, 0)
			piece(m, Vector3.new(0.35, 0.8, 0.35), top, color)
		end
	end
end

-- Морковь: ботва пучком, у спелой из земли торчит оранжевый корень.
BUILD.carrot = function(m, base, stage, s)
	local ripe = stage == "ripe"
	local len = if ripe then 2 else 0.9 + 1.2 * s
	for i = 0, 4 do
		leaf(m, base * CFrame.new(0, 0.2, 0), i / 5 * math.pi * 2, len, if i % 2 == 0 then C.leaf else C.leafDark)
	end
	stem(m, base, len * 0.8, 0.16, C.stem)
	if ripe then
		piece(m, Vector3.new(1.1, 1.3, 1.1), base * CFrame.new(0, 0.1, 0), C.carrot, BALL)
	end
end

-- Клубника: круглый кустик, ягоды сначала белые, потом красные.
BUILD.strawberry = function(m, base, stage, s)
	local ripe = stage == "ripe"
	local r = if ripe then 2.2 else 1 + 1.2 * s
	piece(m, Vector3.new(r * 1.4, r * 0.8, r * 1.4), base * CFrame.new(0, r * 0.35, 0), C.leaf, BALL)
	piece(m, Vector3.new(r, r * 0.7, r), base * CFrame.new(0.3, r * 0.6, -0.2), C.leafDark, BALL)
	if ripe or s > 0.6 then
		for i = 0, 4 do
			local a = i / 5 * math.pi * 2 + 0.4
			local pos = CFrame.new(math.cos(a) * r * 0.6, r * 0.25, math.sin(a) * r * 0.6)
			piece(m, Vector3.new(0.55, 0.65, 0.55), base * pos, if ripe then C.berry else C.berryUnripe, BALL)
		end
	end
end

-- Тыква: плети с широкими листьями, плод растёт из зелёного в оранжевый.
BUILD.pumpkin = function(m, base, stage, s)
	local ripe = stage == "ripe"
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + 0.6
		leaf(m, base * CFrame.new(0, 0.1, 0), a, 1.6 + 1.2 * s, C.leaf)
	end
	local d = if ripe then 3.2 else 0.8 + 1.6 * s
	local color = if ripe then C.pumpkin else C.pumpkinGreen
	local center = base * CFrame.new(0, d * 0.4, 0)
	-- Три шара рядом — тыква «с дольками».
	piece(m, Vector3.new(d, d * 0.8, d * 0.85), center, color, BALL)
	piece(m, Vector3.new(d * 0.7, d * 0.75, d * 0.95), center * CFrame.new(-d * 0.22, 0, 0), color, BALL)
	piece(m, Vector3.new(d * 0.7, d * 0.75, d * 0.95), center * CFrame.new(d * 0.22, 0, 0), color, BALL)
	stem(m, center * CFrame.new(0, d * 0.35, 0), 0.5, 0.25, C.stem)
end

-- Гнилое: бурое, поникшее, чуть приплюснутое.
local function rotten(m: Model, base: CFrame)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		local cf = base * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.15, -0.8) * CFrame.Angles(math.rad(-75), 0, 0)
		piece(m, Vector3.new(0.6, 0.08, 1.6), cf, C.rottenLeaf)
	end
	piece(m, Vector3.new(1.6, 0.6, 1.4), base * CFrame.new(0, 0.2, 0), C.rotten, BALL)
end

-- growth 0..1 — насколько выросло (у спелого и гнилого не важно).
function PlantModels.build(crop: string, stage: string, growth: number, base: CFrame): Model
	local m = Instance.new("Model")
	m.Name = "Plant"
	origin = base
	if stage == "seed" then
		sprout(m, base, 0.6 + growth)
	elseif stage == "rotten" then
		rotten(m, base)
	elseif BUILD[crop] then
		BUILD[crop](m, base, stage, math.clamp(growth, 0, 1))
	end
	if stage == "ripe" then
		-- Искорки над спелым: видно издалека, что пора собирать.
		local holder = piece(m, Vector3.new(2, 0.2, 2), base * CFrame.new(0, 2.5, 0), C.leaf)
		holder.Transparency = 1
		local fx = Instance.new("ParticleEmitter")
		fx.Rate = 4
		fx.Lifetime = NumberRange.new(0.8, 1.4)
		fx.Speed = NumberRange.new(0.5, 1.2)
		fx.Size = NumberSequence.new(0.25, 0)
		fx.LightEmission = 1
		fx.Color = ColorSequence.new(Color3.fromRGB(255, 240, 150))
		fx.Parent = holder
	end
	return m
end

return PlantModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">Sky</string>
          <string name="Source"><![CDATA[--!strict
-- Мультяшные облака по кругу вдали, как небо в Grow a Garden.
-- Картинку неба в Roblox надо загружать на сайт, поэтому облака собраны из белых шаров.

local Sky = {}

local function rng(seed: number): () -> number
	-- Свой простой генератор: облака всегда на тех же местах.
	local x = seed
	return function()
		x = (x * 1103515245 + 12345) % 2147483648
		return x / 2147483648
	end
end

function Sky.build(parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Clouds"
	local rand = rng(7)
	local COUNT = 18
	for i = 1, COUNT do
		local a = (i + rand() * 0.6) / COUNT * math.pi * 2
		-- Далеко у горизонта и невысоко: видно, когда камера смотрит вдоль земли.
		local dist = 1300 + rand() * 500
		local center = Vector3.new(math.cos(a) * dist, 60 + rand() * 120, math.sin(a) * dist)
		local cloud = Instance.new("Model")
		cloud.Name = "Cloud"
		local size = 140 + rand() * 120
		-- Пышка: широкое основание и несколько шаров сверху.
		local puffs = 4 + math.floor(rand() * 3)
		for j = 1, puffs do
			local p = Instance.new("Part")
			p.Shape = Enum.PartType.Ball
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.SmoothPlastic
			p.Color = if j == 1 then Color3.fromRGB(226, 238, 248) else Color3.fromRGB(250, 252, 255)
			local d = size * (0.6 + rand() * 0.5)
			p.Size = Vector3.new(d, d, d)
			local side = (j - (puffs + 1) / 2) * size * 0.45
			local tangent = Vector3.new(-math.sin(a), 0, math.cos(a))
			p.Position = center + tangent * side + Vector3.new(0, rand() * size * 0.25, 0)
			p.Parent = cloud
		end
		cloud.Parent = folder
	end
	folder.Parent = parent

	-- Земля до горизонта: вокруг основной плиты (2048×2048) ещё 8 таких же, без щелей и наложений.
	local ground = Instance.new("Folder")
	ground.Name = "FarGround"
	for gx = -1, 1 do
		for gz = -1, 1 do
			if gx ~= 0 or gz ~= 0 then
				local p = Instance.new("Part")
				p.Anchored = true
				p.Locked = true
				p.Material = Enum.Material.Plastic
				p.TopSurface = Enum.SurfaceType.Studs
				p.BottomSurface = Enum.SurfaceType.Smooth
				p.Color = Color3.fromRGB(75, 151, 75)
				p.Size = Vector3.new(2048, 1, 2048)
				p.Position = Vector3.new(gx * 2048, -1.1, gz * 2048)
				p.Parent = ground
			end
		end
	end
	ground.Parent = parent
	return folder
end

return Sky
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">ThreatService</string>
          <string name="Source"><![CDATA[--!strict
-- Угрозы за кольцом: лес с лагерями гоблинов и ночные набеги. Логика — Shared.World.Wild,
-- здесь только рисуем гоблинов, ловим клики игроков (удар) и переводим события в урон
-- игроку и ферме (через стык Contract, как град или зверь).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Wild = require(Shared:WaitForChild("World"):WaitForChild("Wild"))
local Farm = require(Shared:WaitForChild("Farm"):WaitForChild("Farm"))
local Contract = require(Shared:WaitForChild("Farm"):WaitForChild("Contract"))
local Village = require(script.Parent:WaitForChild("Village"))
local Forest = require(script.Parent:WaitForChild("Forest"))
local DayNight = require(script.Parent:WaitForChild("DayNight"))

local ThreatService = {}

local SEED = 20261002
local C = Wild.CONFIG

local wild: any
local folder: Folder
local farmOfSlot: (number) -> any
local notify: (Player, string) -> ()
local lastHit: { [Player]: number } = {}

type View = {
	model: Model,
	parts: { { part: BasePart, offset: CFrame } },
	hpLabel: TextLabel,
	hp: number,
	cf: CFrame?,
}
local views: { [string]: View } = {}

local GREEN = { Color3.fromRGB(110, 170, 70), Color3.fromRGB(90, 150, 60), Color3.fromRGB(80, 130, 60), Color3.fromRGB(70, 110, 70), Color3.fromRGB(100, 90, 60) }

local function nowMs(): number
	return os.clock() * 1000
end

local function newPart(props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.Plastic
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

-- Гоблин из деталей: тело-яйцо, голова с острыми ушами, жёлтые глаза, дубинка. Чем выше уровень, тем крупнее и темнее.
local function buildGoblin(g: any): View
	local m = Instance.new("Model")
	m.Name = g.id
	local s = 1 + (g.level - 1) * 0.15
	local skin = GREEN[math.clamp(g.level, 1, #GREEN)]
	local list = {}
	local function add(name: string, shape: Enum.PartType?, size: Vector3, offset: CFrame, color: Color3, mat: Enum.Material?)
		local p = newPart({ Name = name, Size = size * s, Color = color, Parent = m })
		if shape then
			p.Shape = shape
		end
		if mat then
			p.Material = mat
		end
		table.insert(list, { part = p, offset = CFrame.new(offset.Position * s) * offset.Rotation })
		return p
	end
	local body = add("Body", Enum.PartType.Ball, Vector3.new(2.4, 2.4, 2.4), CFrame.new(0, 1.7, 0), skin)
	add("Belt", nil, Vector3.new(2.3, 0.35, 2.3), CFrame.new(0, 1.4, 0), Color3.fromRGB(110, 70, 40))
	add("Head", Enum.PartType.Ball, Vector3.new(1.8, 1.8, 1.8), CFrame.new(0, 3.3, 0), skin)
	add("EarL", nil, Vector3.new(1.2, 0.3, 0.5), CFrame.new(-1.15, 3.5, 0) * CFrame.Angles(0, 0, 0.35), skin)
	add("EarR", nil, Vector3.new(1.2, 0.3, 0.5), CFrame.new(1.15, 3.5, 0) * CFrame.Angles(0, 0, -0.35), skin)
	add("EyeL", Enum.PartType.Ball, Vector3.new(0.4, 0.4, 0.4), CFrame.new(-0.35, 3.5, -0.8), Color3.fromRGB(255, 220, 40), Enum.Material.Neon)
	add("EyeR", Enum.PartType.Ball, Vector3.new(0.4, 0.4, 0.4), CFrame.new(0.35, 3.5, -0.8), Color3.fromRGB(255, 220, 40), Enum.Material.Neon)
	add("Nose", Enum.PartType.Ball, Vector3.new(0.45, 0.45, 0.6), CFrame.new(0, 3.2, -0.9), skin:Lerp(Color3.new(0, 0, 0), 0.2))
	add("LegL", nil, Vector3.new(0.6, 0.8, 0.6), CFrame.new(-0.6, 0.4, 0), skin:Lerp(Color3.new(0, 0, 0), 0.25))
	add("LegR", nil, Vector3.new(0.6, 0.8, 0.6), CFrame.new(0.6, 0.4, 0), skin:Lerp(Color3.new(0, 0, 0), 0.25))
	add("Club", nil, Vector3.new(0.4, 2.4, 0.4), CFrame.new(1.4, 2.0, -0.4) * CFrame.Angles(-0.5, 0, 0), Color3.fromRGB(120, 80, 45))
	add("ClubHead", Enum.PartType.Ball, Vector3.new(0.9, 0.9, 0.9), CFrame.new(1.4, 3.0, -1.0), Color3.fromRGB(100, 65, 35))

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(6, 1.4)
	gui.StudsOffset = Vector3.new(0, 3.2 * s, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Parent = body
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.fromRGB(255, 120, 100)
	label.TextStrokeTransparency = 0
	label.Parent = gui

	-- Клик по любой детали — удар (сервер проверит расстояние и частоту).
	local id = g.id
	for _, e in list do
		local cd = Instance.new("ClickDetector")
		cd.MaxActivationDistance = C.hitRange + 6
		cd.Parent = e.part
		cd.MouseClick:Connect(function(who)
			ThreatService.hit(who, id)
		end)
	end
	m.Parent = folder
	return { model = m, parts = list, hpLabel = label, hp = -1, cf = nil }
end

local function rootOf(player: Player): BasePart?
	local ch = player.Character
	return if ch then ch:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
end

local function humanoidOf(player: Player): Humanoid?
	local ch = player.Character
	return if ch then ch:FindFirstChildOfClass("Humanoid") else nil
end

-- farmOfSlot(slot) → ферма на участке (или nil); notify(player, text) — подсказка игроку.
function ThreatService.init(fos: (number) -> any, nt: (Player, string) -> ())
	farmOfSlot = fos
	notify = nt
	wild = Wild.create(SEED)
	Forest.build(workspace, wild.camps, C.forestInner, C.forestOuter)
	folder = Instance.new("Folder")
	folder.Name = "Goblins"
	folder.Parent = workspace:WaitForChild("World")
end

function ThreatService.wild(): any
	return wild
end

function ThreatService.hit(player: Player, goblinId: string)
	if type(goblinId) ~= "string" then
		return
	end
	local t = nowMs()
	if lastHit[player] and t - lastHit[player] < C.hitEveryMs then
		return
	end
	local r = rootOf(player)
	if not r then
		return
	end
	lastHit[player] = t
	local p = r.CFrame.Position
	local res = Wild.hit(wild, goblinId, tostring(player.UserId), p.X, p.Z)
	if not res then
		return
	end
	if res.killed then
		local slot = nil
		for i = 1, Village.SLOTS do
			if Village.owner(i) == player then
				slot = i
			end
		end
		local farm = slot and farmOfSlot(slot)
		if farm then
			farm.coins += res.reward
		end
		notify(player, `👺 Гоблин ур. {res.level} побеждён! +{res.reward} 💰`)
	end
end

local function randomGrowingPlot(farm: any): string?
	local list = {}
	for _, p in farm.plots do
		if p.crop and Farm.isGrowing(p) then
			table.insert(list, p.id)
		end
	end
	if #list == 0 then
		return nil
	end
	return list[math.floor(Wild.random(wild) * #list) + 1]
end

-- Шаг логики (раз в 250 мс, вместе с фермой).
function ThreatService.step(dtMs: number)
	local players = {}
	local byId: { [string]: Player } = {}
	for _, pl in Players:GetPlayers() do
		local r = rootOf(pl)
		local h = humanoidOf(pl)
		if r then
			local p = r.CFrame.Position
			local id = tostring(pl.UserId)
			byId[id] = pl
			table.insert(players, { id = id, x = p.X, z = p.Z, alive = h == nil or h.Health > 0 })
		end
	end
	local slots = {}
	for i = 1, Village.SLOTS do
		local c = Village.center(i)
		table.insert(slots, { slot = i, x = c.X, z = c.Z, occupied = Village.owner(i) ~= nil })
	end
	for _, ev in Wild.step(wild, dtMs, players, DayNight.isNight(), slots) do
		if ev.kind == "attack" then
			local pl = byId[ev.playerId]
			local h = pl and humanoidOf(pl)
			if h then
				pcall(function()
					h:TakeDamage(ev.damage)
				end)
			end
		elseif ev.kind == "raid_hit" then
			local farm = farmOfSlot(ev.slot)
			local id = farm and randomGrowingPlot(farm)
			if id then
				Contract.damagePlot(farm, id, C.raidCropShare, "Гоблин")
			end
		elseif ev.kind == "raid_start" then
			local owner = Village.owner(ev.slot)
			for _, pl in Players:GetPlayers() do
				notify(pl, if pl == owner then "👺 Гоблины идут на твою ферму! Прогони их, кликая по ним" else "👺 Гоблины напали на соседнюю ферму!")
			end
		elseif ev.kind == "night" then
			for _, pl in Players:GetPlayers() do
				notify(pl, "🌙 Ночь: гоблины видят дальше и ходят набегами")
			end
		elseif ev.kind == "day" then
			for _, pl in Players:GetPlayers() do
				notify(pl, "☀️ Утро: гоблины ушли в лес")
			end
		end
	end
end

-- Рисуем гоблинов: детали двигаем только если гоблин сдвинулся.
local frameAcc = 0
function ThreatService.frame(dt: number)
	frameAcc += dt
	if frameAcc < 0.1 then
		return -- 10 раз в секунду хватает и бережёт сеть
	end
	frameAcc = 0
	local seen = {}
	local t = os.clock()
	for id, g in wild.goblins do
		seen[id] = true
		local v = views[id]
		if not v then
			v = buildGoblin(g)
			views[id] = v
		end
		local bob = if g.moving then math.abs(math.sin(t * 10)) * 0.3 else 0
		local cf = CFrame.new(g.x, bob, g.z) * CFrame.Angles(0, g.yaw, 0)
		if v.cf ~= cf then
			v.cf = cf
			for _, e in v.parts do
				e.part.CFrame = cf * e.offset
			end
		end
		if v.hp ~= g.hp then
			v.hp = g.hp
			v.hpLabel.Text = `👺 ур. {g.level} · ❤ {math.max(0, g.hp)}/{g.maxHp}`
		end
	end
	for id, v in views do
		if not seen[id] then
			v.model:Destroy()
			views[id] = nil
		end
	end
end

function ThreatService.leave(player: Player)
	lastHit[player] = nil
end

-- Для экрана: день или ночь и сколько осталось.
function ThreatService.world(): { night: boolean, left: number }
	return { night = DayNight.isNight(), left = math.floor(DayNight.left()) }
end

return ThreatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Village</string>
          <string name="Source"><![CDATA[--!strict
-- Сервер-деревня: на одном сервере 4–8 участков, у каждого игрока свой.
-- Участки стоят кольцом вокруг площади, за кольцом лес с гоблинами (Wild).

local Village = {}

Village.SLOTS = 6 -- можно 4–8; столько же мест на сервере (Players.MaxPlayers ставится в Studio)
Village.RADIUS = 150 -- стадов от центра деревни до центра участка: участки стоят кольцом
Village.SCALE = 0.12 -- 1 пиксель веб-фермы = 0,12 стада (ферма 760×540 → 91×65 стадов)
Village.PLAZA = 105 -- радиус площади в центре кольца (позже — вольер и порталы)

-- Участки стоят кольцом вокруг площади, воротами к центру (как фермы в Grow a Garden вокруг лавок).
-- Рамка участка: начало в центре участка, локальная ось +Z смотрит на площадь (там ворота, y веба = 540).
function Village.frame(i: number): CFrame
	local a = (i - 1) / Village.SLOTS * math.pi * 2
	local c = Vector3.new(math.sin(a) * Village.RADIUS, 0, math.cos(a) * Village.RADIUS)
	return CFrame.new(c) * CFrame.Angles(0, a + math.pi, 0) -- смотрит наружу, значит +Z — к центру
end

function Village.center(i: number): Vector3
	return Village.frame(i).Position
end

-- Точка фермы (x, y в пикселях веба) → мир. Ось y веба идёт вдоль локальной Z участка.
function Village.cframe(i: number, x: number, y: number, height: number?): CFrame
	return Village.frame(i) * CFrame.new((x - 380) * Village.SCALE, height or 0, (y - 270) * Village.SCALE)
end

function Village.toWorld(i: number, x: number, y: number, height: number?): Vector3
	return Village.cframe(i, x, y, height).Position
end

-- Мир → пиксели фермы.
function Village.toFarm(i: number, p: Vector3): { x: number, y: number }
	local l = Village.frame(i):PointToObjectSpace(p)
	return { x = l.X / Village.SCALE + 380, y = l.Z / Village.SCALE + 270 }
end

local owners: { [number]: Player } = {}

function Village.claim(player: Player): number?
	for i = 1, Village.SLOTS do
		if not owners[i] then
			owners[i] = player
			return i
		end
	end
	return nil
end

function Village.release(player: Player)
	for i = 1, Village.SLOTS do
		if owners[i] == player then
			owners[i] = nil
		end
	end
end

function Village.owner(i: number): Player?
	return owners[i]
end

return Village
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">WeatherService</string>
          <string name="Source"><![CDATA[--!strict
-- Погода на весь сервер (логика — Shared.World.Weather): дождь поливает все грядки,
-- дома зверей узнают о дожде (лужа, будка), гроза гремит. Здесь же серые тучи вместо белых.
-- Капли рисует каждый клиент у себя вокруг камеры (BeastUI), чтобы не гонять детали по сети.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Weather = require(Shared:WaitForChild("World"):WaitForChild("Weather"))
local Contract = require(Shared:WaitForChild("Farm"):WaitForChild("Contract"))
local Home = require(Shared:WaitForChild("Beast"):WaitForChild("Home"))
local DayNight = require(script.Parent:WaitForChild("DayNight"))

local WeatherService = {}

local SEED = 20261003

type Hooks = {
	homes: () -> { any }, -- дома всех зверей на сервере
	farms: () -> { any }, -- все фермы
	notify: (string) -> (), -- подсказка всем игрокам
}

local w: any
local hooks: Hooks
local cloudColors: { [BasePart]: Color3 } = {}
local thunderAt = 0

local function tintClouds(rain: boolean)
	local clouds = workspace:FindFirstChild("Clouds")
	if not clouds then
		return
	end
	for _, p in clouds:GetDescendants() do
		if p:IsA("BasePart") then
			if not cloudColors[p] then
				cloudColors[p] = p.Color
			end
			p.Color = if rain then Color3.fromRGB(150, 156, 168) else cloudColors[p]
		end
	end
end

local function tellHomes()
	for _, home in hooks.homes() do
		Home.setWeather(home, w.rain, w.storm)
	end
end

function WeatherService.init(h: Hooks)
	hooks = h
	w = Weather.create(SEED)
end

-- Новый дом (игрок зашёл во время дождя) сразу знает погоду.
function WeatherService.attach(home: any)
	Home.setWeather(home, w.rain, w.storm)
end

function WeatherService.step(dtMs: number)
	for _, e in Weather.step(w, dtMs) do
		if e.kind == "rain_start" then
			tellHomes()
			tintClouds(true)
			DayNight.setRain(true)
			hooks.notify(if e.storm then "⛈ Гроза! Пугливые звери прячутся в будку" else "🌧 Пошёл дождь: грядки поливаются сами")
		elseif e.kind == "rain_end" then
			tellHomes()
			tintClouds(false)
			DayNight.setRain(false)
			hooks.notify("🌤 Дождь кончился. Во дворе лужа: кто в неё полезет?")
		elseif e.kind == "water" then
			for _, f in hooks.farms() do
				Contract.waterAll(f, "Дождь")
			end
		elseif e.kind == "thunder" then
			thunderAt = os.clock()
			for _, home in hooks.homes() do
				Home.thunder(home)
			end
		end
	end
end

-- Для экрана: идёт ли дождь, гроза, и была ли вспышка молнии только что.
function WeatherService.state(): { rain: boolean, storm: boolean, flash: boolean }
	return { rain = w.rain, storm = w.storm, flash = os.clock() - thunderAt < 0.6 }
end

-- Studio и проверки: дождь сейчас (или кончить дождь).
function WeatherService.force(rain: boolean, storm: boolean?)
	Weather.force(w, rain, storm)
	WeatherService.step(0)
end

return WeatherService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="48">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">70</float>
      <float name="CameraMinZoomDistance">6</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="49">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="50">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="51">
          <Properties>
            <string name="Name">BeastUI</string>
            <string name="Source"><![CDATA[--!strict
-- Экран зверя: портрет сбоку (мордочка, сытость, энергия, радость, доверие), кнопки без таймера
-- (Похвалить, Отругать, Погладить, Позвать) и карточка зверя. У чужого зверя рядом — кнопки гостя.
-- Только рисует снимок с сервера (BeastRemotes.State) и шлёт просьбы (BeastRemotes.Command).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("BeastRemotes")
local Command = remotes:WaitForChild("Command") :: RemoteEvent
local State = remotes:WaitForChild("State") :: RemoteEvent
local Open = remotes:WaitForChild("Open") :: RemoteEvent

local function send(c: { [string]: any })
	Command:FireServer(c)
end

-- ---------- Стиль как у фермы (FarmUI): лего-кнопки, круглый шрифт, светлые панели ----------

local COLORS = {
	panel = Color3.fromRGB(255, 248, 226),
	frame = Color3.fromRGB(110, 70, 40),
	ink = Color3.fromRGB(60, 45, 30),
	accent = Color3.fromRGB(250, 196, 40),
}
local FONT = Enum.Font.FredokaOne

local function make(class: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	for _, c in children or {} do
		c.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(r: number?): UICorner
	return make("UICorner", { CornerRadius = UDim.new(0, r or 8) })
end

local function darker(c: Color3, k: number): Color3
	return Color3.new(c.R * k, c.G * k, c.B * k)
end

local function rim(color: Color3, thickness: number?): UIStroke
	return make("UIStroke", { Color = darker(color, 0.55), Thickness = thickness or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function textLabel(props: { [string]: any }): TextLabel
	local base = { BackgroundTransparency = 1, TextColor3 = COLORS.ink, Font = FONT, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true }
	for k, v in props do
		base[k] = v
	end
	return make("TextLabel", base)
end

local function button(text: string, color: Color3, onClick: () -> (), props: { [string]: any }?): TextButton
	local base = {
		Text = text,
		AutoButtonColor = true,
		BackgroundColor3 = color,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
		TextStrokeColor3 = darker(color, 0.4),
		Font = FONT,
		TextSize = 17,
		Size = UDim2.new(0, 110, 0, 40),
	}
	for k, v in props or {} do
		base[k] = v
	end
	local b = make("TextButton", base, { corner(10), rim(color) })
	b.Activated:Connect(onClick)
	return b
end

local MOOD_FACE = { calm = "🙂", happy = "😄", proud = "😎", guilty = "😳", sad = "😢", scared = "😨", sick = "🤢", sleepy = "😴", curious = "🤔", hurt = "😣" }

-- ---------- Каркас ----------

local gui = make("ScreenGui", { Name = "BeastUI", ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") })

-- Портрет сбоку: только для хозяина.
local portrait = make("Frame", { Name = "Portrait", Size = UDim2.new(0, 230, 0, 122), Position = UDim2.new(0, 10, 0, 54), BackgroundColor3 = COLORS.panel, Visible = false, Parent = gui }, {
	corner(14),
	make("UIStroke", { Color = COLORS.frame, Thickness = 4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
})
local face = textLabel({ Name = "Face", Size = UDim2.new(0, 54, 0, 54), Position = UDim2.new(0, 6, 0, 6), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Parent = portrait })
local title = textLabel({ Name = "Title", Size = UDim2.new(1, -66, 0, 22), Position = UDim2.new(0, 62, 0, 6), TextSize = 17, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = portrait })
local moodText = textLabel({ Name = "Mood", Size = UDim2.new(1, -66, 0, 34), Position = UDim2.new(0, 62, 0, 28), TextSize = 13, TextColor3 = Color3.fromRGB(120, 100, 80), Parent = portrait })

local BARS = {
	{ key = "satiety", icon = "🍖", color = Color3.fromRGB(235, 140, 40) },
	{ key = "energy", icon = "⚡", color = Color3.fromRGB(60, 140, 225) },
	{ key = "joy", icon = "😊", color = Color3.fromRGB(70, 190, 70) },
}
local bars: { [string]: Frame } = {}
for i, b in BARS do
	local y = 62 + (i - 1) * 18
	textLabel({ Text = b.icon, Size = UDim2.new(0, 20, 0, 16), Position = UDim2.new(0, 8, 0, y), TextScaled = true, Parent = portrait })
	local back = make("Frame", { Size = UDim2.new(1, -78, 0, 12), Position = UDim2.new(0, 32, 0, y + 2), BackgroundColor3 = Color3.fromRGB(225, 215, 195), BorderSizePixel = 0, Parent = portrait }, { corner(6) })
	bars[b.key] = make("Frame", { Name = b.key, Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = b.color, BorderSizePixel = 0, Parent = back }, { corner(6) })
end
local trust = textLabel({ Name = "Trust", Size = UDim2.new(0, 44, 0, 50), Position = UDim2.new(1, -46, 0, 64), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Parent = portrait })

-- Последний поступок: пока зверь ждёт ответа, видно, за что хвалишь или ругаешь.
local lastAct = textLabel({ Name = "LastAct", Size = UDim2.new(0, 230, 0, 30), Position = UDim2.new(0, 10, 0, 180), BackgroundTransparency = 0, BackgroundColor3 = COLORS.accent, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, TextStrokeColor3 = darker(COLORS.accent, 0.4), Visible = false, Parent = gui })
corner(10).Parent = lastAct

-- Кнопки без таймера.
local actions = make("Frame", { Name = "Actions", Size = UDim2.new(0, 230, 0, 132), Position = UDim2.new(0, 10, 0, 214), BackgroundTransparency = 1, Visible = false, Parent = gui }, {
	make("UIGridLayout", { CellSize = UDim2.new(0, 111, 0, 40), CellPadding = UDim2.new(0, 8, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
})
button("👍 Похвалить", Color3.fromRGB(70, 190, 70), function() send({ type = "react", reaction = "praise" }) end, { LayoutOrder = 1, Parent = actions })
button("👎 Отругать", Color3.fromRGB(220, 80, 60), function() send({ type = "react", reaction = "scold" }) end, { LayoutOrder = 2, Parent = actions })
button("🤗 Погладить", Color3.fromRGB(235, 140, 40), function() send({ type = "react", reaction = "give" }) end, { LayoutOrder = 3, Parent = actions })
button("📣 Позвать", Color3.fromRGB(60, 140, 225), function() send({ type = "call" }) end, { LayoutOrder = 4, Parent = actions })
local penBtn = button("🐾 В вольер", Color3.fromRGB(150, 110, 200), function() send({ type = "pen" }) end, { Name = "PenButton", LayoutOrder = 5, Parent = actions })
local washBtn = button("🧽 Помыть", Color3.fromRGB(90, 170, 200), function() send({ type = "wash" }) end, { Name = "WashButton", LayoutOrder = 6, Visible = false, Parent = actions })

local cardOpen = false
local cardBtn = button("📋 Карточка", Color3.fromRGB(150, 98, 58), function() end, { Name = "CardButton", Size = UDim2.new(0, 230, 0, 32), Position = UDim2.new(0, 10, 0, 350), TextSize = 15, Visible = false, Parent = gui })
local carryBtn = button("🪨 Носить камни", Color3.fromRGB(140, 140, 150), function() send({ type = "command_carry" }) end, { Name = "CarryButton", Size = UDim2.new(0, 230, 0, 32), Position = UDim2.new(0, 10, 0, 386), TextSize = 15, Visible = false, Parent = gui })

local hint = textLabel({ Name = "Hint", Size = UDim2.new(0, 230, 0, 30), Position = UDim2.new(0, 10, 0, 422), BackgroundTransparency = 0.15, BackgroundColor3 = Color3.fromRGB(60, 45, 30), TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Visible = false, Parent = gui })
corner(10).Parent = hint

-- Дождь: капли рисует каждый экран у себя вокруг камеры (по сети ничего не гоняем).
local rainPart = Instance.new("Part")
rainPart.Name = "RainCloud"
rainPart.Anchored = true
rainPart.CanCollide = false
rainPart.CanQuery = false
rainPart.CanTouch = false
rainPart.Transparency = 1
rainPart.Size = Vector3.new(70, 1, 70)
local rainDrops = Instance.new("ParticleEmitter")
rainDrops.Name = "Drops"
rainDrops.Enabled = false
rainDrops.Rate = 450
rainDrops.Lifetime = NumberRange.new(0.7, 0.9)
rainDrops.Speed = NumberRange.new(55, 65)
rainDrops.EmissionDirection = Enum.NormalId.Bottom
rainDrops.Size = NumberSequence.new(0.12)
rainDrops.Squash = NumberSequence.new(3) -- вытянутые капли
rainDrops.Color = ColorSequence.new(Color3.fromRGB(190, 210, 240))
rainDrops.Transparency = NumberSequence.new(0.35)
rainDrops.LightEmission = 0.2
rainDrops.Parent = rainPart
rainPart.Parent = workspace
local raining = false
game:GetService("RunService").Heartbeat:Connect(function()
	local cam = workspace.CurrentCamera
	if raining and cam then
		rainPart.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, 30, 0))
	end
end)

-- Вспышка молнии: экран на миг белеет.
local flash = make("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 0, Parent = gui })

-- Часы мира: день или ночь и сколько осталось (ночью гоблины ходят набегами).
local clock = textLabel({ Name = "Clock", Size = UDim2.new(0, 220, 0, 30), Position = UDim2.new(0.5, -110, 0, 12), BackgroundTransparency = 0.1, BackgroundColor3 = Color3.fromRGB(250, 236, 200), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 15, Visible = false, Parent = gui })
corner(15).Parent = clock

-- Карточка зверя: характер, привычки, статы, дневник.
local card = make("ScrollingFrame", {
	Name = "Card",
	Size = UDim2.new(0, 340, 0.6, 0),
	Position = UDim2.new(0, 250, 0, 54),
	BackgroundColor3 = COLORS.panel,
	ScrollBarThickness = 6,
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	CanvasSize = UDim2.new(),
	Visible = false,
	Parent = gui,
}, {
	corner(14),
	make("UIStroke", { Color = COLORS.frame, Thickness = 4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
	make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
})

local function setCard(open: boolean)
	cardOpen = open
	card.Visible = open
	send({ type = "card", open = open })
end
cardBtn.Activated:Connect(function()
	setCard(not cardOpen)
end)

-- Гость у чужого зверя.
local guest = make("Frame", { Name = "Guest", Size = UDim2.new(0, 360, 0, 78), Position = UDim2.new(0.5, -180, 1, -150), BackgroundColor3 = COLORS.panel, Visible = false, Parent = gui }, {
	corner(14),
	make("UIStroke", { Color = COLORS.frame, Thickness = 4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
})
local guestText = textLabel({ Size = UDim2.new(1, -16, 0, 26), Position = UDim2.new(0, 8, 0, 4), TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = guest })
local guestRow = make("Frame", { Size = UDim2.new(1, -16, 0, 40), Position = UDim2.new(0, 8, 0, 32), BackgroundTransparency = 1, Parent = guest }, {
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }),
})
local guestOwner: number? = nil
for _, g in { { "🍪 Угостить", "feed", Color3.fromRGB(235, 140, 40) }, { "⚽ Поиграть", "play", Color3.fromRGB(70, 190, 70) }, { "😠 Накричать", "scold", Color3.fromRGB(220, 80, 60) } } do
	button(g[1], g[3], function()
		if guestOwner then
			send({ type = "guest", owner = guestOwner, act = g[2] })
		end
	end, { Size = UDim2.new(0, 108, 0, 38), TextSize = 15, Parent = guestRow })
end

-- Телефон: всё уже и ниже, карточка во всю ширину.
local function fitToScreen()
	local cam = workspace.CurrentCamera
	local w = if cam then cam.ViewportSize.X else 1000
	local narrow = w < 700
	local pw = if narrow then 180 else 230
	portrait.Size = UDim2.new(0, pw, 0, 122)
	lastAct.Size = UDim2.new(0, pw, 0, 30)
	actions.Size = UDim2.new(0, pw, 0, 132)
	local grid = actions:FindFirstChildOfClass("UIGridLayout")
	if grid then
		grid.CellSize = UDim2.new(0, (pw - 8) / 2, 0, 40)
	end
	for _, b in actions:GetChildren() do
		if b:IsA("TextButton") then
			b.TextSize = if narrow then 13 else 17
		end
	end
	cardBtn.Size = UDim2.new(0, pw, 0, 32)
	carryBtn.Size = UDim2.new(0, pw, 0, 32)
	hint.Size = UDim2.new(0, pw, 0, 30)
	if narrow then
		card.Size = UDim2.new(0, w - 20, 0.5, 0)
		card.Position = UDim2.new(0, 10, 0, 104)
	else
		card.Size = UDim2.new(0, 340, 0.6, 0)
		card.Position = UDim2.new(0, 250, 0, 54)
	end
	guest.Size = UDim2.new(0, math.min(360, w - 20), 0, 78)
	guest.Position = UDim2.new(0.5, -math.min(360, w - 20) / 2, 1, -150)
end
fitToScreen()
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitToScreen)
end

-- ---------- Рисуем снимок ----------

local function renderCard(v: any)
	for _, c in card:GetChildren() do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	local order = 0
	local function line(text: string, size: number?, color: Color3?)
		order += 1
		textLabel({ Text = text, TextSize = size or 14, TextColor3 = color or COLORS.ink, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = card })
	end
	line(`{v.name} · {v.species} · {v.stage}`, 18)
	for _, l in v.character or {} do
		line(l)
	end
	if v.story then
		line("📖 " .. v.story, 13, Color3.fromRGB(110, 80, 50))
	end
	local a = v.attributes
	if a then
		line(`💪 Сила {a.strength} · 🏃 Скорость {a.speed} · 🤸 Ловкость {a.agility}`, 14)
		line(`🫀 Выносливость {a.endurance} · 🧠 Ум {a.intelligence} · ⚖️ {a.weight} кг · 📏 {a.height} см`, 14)
		line(`Послушание {v.obedience} · Усидчивость {v.discipline} · Аппетит {v.traits.appetite} · Смелость {v.traits.bravery}`, 13, Color3.fromRGB(120, 100, 80))
	end
	line("Привычки", 16)
	for _, h in v.habits or {} do
		local mark = if h.good == true then "✅" elseif h.good == false then "⚠️" else "·"
		line(`{mark} {h.icon} {h.label}: {h.word} ({h.value})`, 13)
	end
	line("Дневник", 16)
	for _, d in v.diary or {} do
		line(d, 12, Color3.fromRGB(90, 75, 60))
	end
end

local hintUntil = 0

local function render(s: any)
	local wd = s.world
	clock.Visible = wd ~= nil
	if wd then
		local left = `{math.floor(wd.left / 60)}:{string.format("%02d", wd.left % 60)}`
		clock.Text = (if wd.night then `🌙 Ночь · утро через {left}` else `☀️ День · ночь через {left}`) .. (if wd.storm then " · ⛈" elseif wd.rain then " · 🌧" else "")
		if raining ~= (wd.rain == true) then
			raining = wd.rain == true
			rainDrops.Enabled = raining
		end
		flash.BackgroundTransparency = if wd.flash then 0.55 else 1
		clock.BackgroundColor3 = if wd.night then Color3.fromRGB(50, 60, 100) else Color3.fromRGB(250, 236, 200)
		clock.TextColor3 = if wd.night then Color3.fromRGB(230, 235, 255) else COLORS.ink
	end
	local v = s.own
	local has = v ~= nil
	portrait.Visible = has
	actions.Visible = has
	cardBtn.Visible = has
	if has then
		face.Text = MOOD_FACE[v.face] or "🙂"
		title.Text = `{v.name} · {v.stage}`
		local doing = if v.doing then ` · {v.doing}` else ""
		moodText.Text = `{v.mood}{doing}`
		for key, bar in bars do
			bar.Size = UDim2.fromScale(math.clamp((v.needs[key] or 0) / 100, 0, 1), 1)
		end
		trust.Text = `❤️\n{v.trust}`
		if v.lastAct then
			lastAct.Visible = true
			lastAct.Text = `{v.lastAct.icon} {v.lastAct.text} — твоя реакция?`
		else
			lastAct.Visible = false
		end
		carryBtn.Visible = v.canCarry == true
		penBtn.Text = if v.away then "🏡 Домой" else "🐾 В вольер"
		washBtn.Visible = v.dirty == true and not v.away
		if v.hint then
			hint.Text = v.hint
			hint.Visible = true
			hintUntil = os.clock() + 2.5
		elseif os.clock() > hintUntil then
			hint.Visible = false
		end
		if cardOpen and v.character then
			renderCard(v)
		end
	end
	local n = s.near
	guestOwner = if n then n.owner else nil
	guest.Visible = n ~= nil
	if n then
		guestText.Text = `🐾 {n.name} ({n.ownerName}) · доверие к тебе {n.trust}`
	end
end

State.OnClientEvent:Connect(render)

-- Клик по зверю в мире: свой — карточка, чужой — кнопки гостя уже видны рядом.
Open.OnClientEvent:Connect(function(kind: string)
	if kind == "card" then
		setCard(true)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="52">
          <Properties>
            <string name="Name">FarmUI</string>
            <string name="Source"><![CDATA[--!strict
-- Экран игрока. Только рисует снимок с сервера и шлёт просьбы; правил игры здесь нет.
-- Грядки и постройки в мире кликаются напрямую (ClickDetector на сервере).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("FarmRemotes")
local Command = remotes:WaitForChild("Command") :: RemoteEvent
local State = remotes:WaitForChild("State") :: RemoteEvent
local Open = remotes:WaitForChild("Open") :: RemoteEvent

local function send(c: { [string]: any })
	Command:FireServer(c)
end

local function mmss(ms: number): string
	local s = math.max(0, math.ceil(ms / 1000))
	return string.format("%d:%02d", s // 60, s % 60)
end

-- ---------- Маленький помощник для интерфейса ----------

-- Лего-стиль как в Grow a Garden: яркие кнопки с толстой тёмной обводкой и пупырышками,
-- круглый жирный шрифт, белые надписи с обводкой, светлые панели в коричневой рамке.
local COLORS = {
	panel = Color3.fromRGB(255, 248, 226),
	frame = Color3.fromRGB(110, 70, 40),
	ink = Color3.fromRGB(60, 45, 30),
	button = Color3.fromRGB(70, 190, 70),
	buttonOff = Color3.fromRGB(170, 165, 155),
	accent = Color3.fromRGB(250, 196, 40),
	wood = Color3.fromRGB(150, 98, 58),
	bar = Color3.fromRGB(150, 98, 58),
}
local FONT = Enum.Font.FredokaOne

local function make(class: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	for _, c in children or {} do
		c.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(r: number?): UICorner
	return make("UICorner", { CornerRadius = UDim.new(0, r or 8) })
end

local function darker(c: Color3, k: number): Color3
	return Color3.new(c.R * k, c.G * k, c.B * k)
end

-- Толстая тёмная обводка того же цвета, что и кнопка.
local function rim(color: Color3, thickness: number?): UIStroke
	return make("UIStroke", { Color = darker(color, 0.55), Thickness = thickness or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

-- Пупырышки: сетка светлых кружков под надписью.
local function studs(parent: GuiObject, color: Color3)
	local holder = make("Frame", { Name = "Studs", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 1, Parent = parent }, {
		make("UIGridLayout", { CellSize = UDim2.fromOffset(9, 9), CellPadding = UDim2.fromOffset(7, 7), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center }),
	})
	local light = color:Lerp(Color3.new(1, 1, 1), 0.35)
	for _ = 1, 24 do
		make("Frame", { BackgroundColor3 = light, BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 1, Parent = holder }, { make("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	end
end

local function textLabel(props: { [string]: any }): TextLabel
	local base = { BackgroundTransparency = 1, TextColor3 = COLORS.ink, Font = FONT, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true }
	for k, v in props do
		base[k] = v
	end
	return make("TextLabel", base)
end

-- Кнопка: сам TextButton ловит нажатие и хранит текст, а видимая надпись — отдельная
-- подпись Label поверх пупырышек (иначе пупырышки рисуются поверх текста).
local function button(text: string, enabled: boolean, onClick: () -> (), props: { [string]: any }?): TextButton
	local base = {
		Text = text,
		AutoButtonColor = enabled,
		BackgroundColor3 = if enabled then COLORS.button else COLORS.buttonOff,
		TextColor3 = Color3.new(1, 1, 1),
		Font = FONT,
		TextSize = 16,
		Size = UDim2.new(0, 120, 0, 34),
	}
	for k, v in props or {} do
		base[k] = v
	end
	local b = make("TextButton", base, { corner(10) })
	local color = b.BackgroundColor3
	rim(color).Parent = b
	studs(b, color)
	b.TextTransparency = 1
	make("TextLabel", {
		Name = "Label",
		Size = UDim2.new(1, -6, 1, -4),
		Position = UDim2.fromOffset(3, 2),
		BackgroundTransparency = 1,
		Text = b.Text,
		Font = FONT,
		TextSize = b.TextSize,
		TextScaled = b.TextScaled,
		TextWrapped = true,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeColor3 = darker(color, 0.4),
		TextStrokeTransparency = 0,
		ZIndex = 2,
		Parent = b,
	})
	if enabled then
		b.Activated:Connect(onClick)
	end
	return b
end

-- ---------- Каркас экрана ----------

local gui = make("ScreenGui", { Name = "FarmUI", ResetOnSpawn = false, IgnoreGuiInset = false, Parent = player:WaitForChild("PlayerGui") })

-- Верхняя полоса: монеты, уровень, амбар, удобрение, стройка.
local top = make("Frame", { Size = UDim2.new(1, -20, 0, 40), Position = UDim2.new(0, 10, 0, 6), BackgroundColor3 = COLORS.bar, Parent = gui }, { corner(12), rim(COLORS.bar) })
local topText = textLabel({ Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 10, 0, 0), TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, TextStrokeColor3 = darker(COLORS.bar, 0.4), TextSize = 19, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2, Parent = top })

local hint = textLabel({ Size = UDim2.new(0, 420, 0, 34), Position = UDim2.new(0.5, -210, 0, 54), BackgroundTransparency = 0, BackgroundColor3 = COLORS.accent, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0, TextStrokeColor3 = darker(COLORS.accent, 0.4), Visible = false, Parent = gui })
corner(12).Parent = hint
rim(COLORS.accent).Parent = hint
local hintUntil = 0

-- Нижняя полоса: что сажать по клику, удобрить, полить всё, собрать всё.
local tools = make("Frame", { Size = UDim2.new(0, 640, 0, 46), Position = UDim2.new(0.5, -320, 1, -56), BackgroundTransparency = 1, Parent = gui }, {
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
})

-- Вкладки справа и панель под ними.
local TABS = {
	{ id = "shop", title = "🌱 Лавка", color = Color3.fromRGB(70, 190, 70) },
	{ id = "storage", title = "📦 Амбар", color = Color3.fromRGB(235, 140, 40) },
	{ id = "orders", title = "📜 Заказы", color = Color3.fromRGB(60, 140, 225) },
	{ id = "build", title = "🔨 Стройка", color = Color3.fromRGB(240, 186, 30) },
	{ id = "workshop", title = "🏭 Цех", color = Color3.fromRGB(160, 90, 210) },
	{ id = "log", title = "📒", color = Color3.fromRGB(150, 98, 58) },
}
local tabBar = make("Frame", { Size = UDim2.new(0, 330, 0, 44), Position = UDim2.new(1, -340, 0, 54), BackgroundTransparency = 1, Parent = gui }, {
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder }),
})
local panel = make("ScrollingFrame", {
	Size = UDim2.new(0, 330, 0.55, 0),
	Position = UDim2.new(1, -340, 0, 94),
	BackgroundColor3 = COLORS.panel,
	BackgroundTransparency = 0,
	ScrollBarThickness = 6,
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	CanvasSize = UDim2.new(),
	Visible = false,
	Parent = gui,
}, {
	corner(14),
	make("UIStroke", { Color = COLORS.frame, Thickness = 4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
	make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
})

local narrowMode = false -- телефон: на вкладках только значки

-- На узком экране (телефон) панель шире и ниже.
local function fitToScreen()
	local cam = workspace.CurrentCamera
	local w = if cam then cam.ViewportSize.X else 1000
	local narrow = w < 700
	local pw = if narrow then math.floor(w - 20) else 450
	narrowMode = narrow
	panel.Size = UDim2.new(0, pw, if narrow then 0.45 else 0.55, 0)
	panel.Position = UDim2.new(1, -pw - 10, 0, 104)
	tabBar.Size = UDim2.new(0, pw, 0, 44)
	tabBar.Position = UDim2.new(1, -pw - 10, 0, 54)
	tools.Size = UDim2.new(0, math.min(640, w - 20), 0, 46)
	tools.Position = UDim2.new(0.5, -math.min(640, w - 20) / 2, 1, -56)
	hint.Size = UDim2.new(0, math.min(420, w - 20), 0, 34)
	hint.Position = UDim2.new(0.5, -math.min(420, w - 20) / 2, 1, -100)
end
fitToScreen()
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitToScreen)
end

local openTab: string? = nil
local snap: any = nil
local logLines: { string } = {}

-- Кнопки пересоздаются только когда что-то поменялось, иначе нажатие может «потеряться».
-- Таймеры обновляются отдельно: подпись с таймером регистрируется через live().
local liveLabels: { { label: TextLabel, fn: (any) -> string } } = {}
local lastSignature = ""

local function live(label: TextLabel, fn: (any) -> string)
	label.Text = fn(snap)
	table.insert(liveLabels, { label = label, fn = fn })
end

-- Снимок без таймеров и журнала: если он не изменился, кнопки перестраивать не нужно.
local function signature(v: any): string
	if type(v) ~= "table" then
		return tostring(v)
	end
	local keys = {}
	for k in v do
		if k ~= "leftMs" and k ~= "secondsLeft" and k ~= "log" and k ~= "hint" then
			table.insert(keys, tostring(k))
		end
	end
	table.sort(keys)
	local parts = {}
	for _, k in keys do
		local x = v[k]
		if x == nil then
			x = v[tonumber(k)]
		end
		table.insert(parts, k .. "=" .. signature(x))
	end
	return "{" .. table.concat(parts, ",") .. "}"
end

local render: () -> ()

local function setTab(id: string?)
	openTab = if openTab == id then nil else id
	render()
end

local function row(parent: Instance, order: number, height: number?): Frame
	return make("Frame", { Size = UDim2.new(1, 0, 0, height or 36), BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
end

local function itemsText(items): string
	local parts = {}
	for _, it in items do
		table.insert(parts, `{it.icon}{it.n}` .. (if it.have < it.n then `({it.have})` else ""))
	end
	return table.concat(parts, " ")
end

-- ---------- Содержимое вкладок ----------

local TAB_RENDER: { [string]: (any, Instance) -> () } = {}

-- Лавка семян: запас общий для всех серверов и обновляется каждые 5 минут.
TAB_RENDER.shop = function(s, p)
	local shop = s.extra.shop
	live(textLabel({ Size = UDim2.new(1, 0, 0, 22), Font = FONT, LayoutOrder = 0, Parent = p }), function(x)
		return `Новый завоз через {mmss(x.extra.shop.secondsLeft * 1000)}`
	end)
	textLabel({ Text = "🌾 Пшеница всегда бесплатно. Остальные семена — в мешок, сажаются кликом по грядке.", TextSize = 13, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 1, Parent = p })
	for i, c in s.crops do
		if c.id ~= "wheat" then
			local left = shop.left[c.id] or 0
			local r = row(p, 1 + i, 48)
			local text = if c.unlocked then `{c.icon} {c.name}: в мешке {shop.seeds[c.id] or 0}\nв лавке {left}` else `{c.icon} {c.name}: откроется на уровне {c.level}`
			textLabel({ Text = text, TextSize = 14, Size = UDim2.new(1, -110, 1, 0), Parent = r })
			local can = c.unlocked and left > 0 and s.coins >= c.cost
			button(if left > 0 then `Купить {c.cost}💰` else "нет", can, function() send({ type = "buy_seed", crop = c.id }) end, { Size = UDim2.new(0, 104, 0, 44), Position = UDim2.new(1, -104, 0, 2), TextSize = 14, Parent = r })
		end
	end
end

TAB_RENDER.storage = function(s, p)
	textLabel({ Text = `Амбар: {s.used}/{s.cap}. Удобрение: {s.fertilizer}/{s.fertCap}`, Size = UDim2.new(1, 0, 0, 22), Font = FONT, LayoutOrder = 0, Parent = p })
	if #s.stock == 0 then
		textLabel({ Text = "Пусто. Собери урожай с грядок.", Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, Parent = p })
	end
	for i, it in s.stock do
		local r = row(p, i)
		textLabel({ Text = `{it.icon} {it.name} ×{it.n}`, Size = UDim2.new(1, -150, 1, 0), Parent = r })
		button(`1 за {it.sell}💰`, true, function() send({ type = "sell", item = it.id, count = 1 }) end, { Size = UDim2.new(0, 70, 0, 30), Position = UDim2.new(1, -146, 0, 3), TextSize = 13, Parent = r })
		button("все", true, function() send({ type = "sell", item = it.id, count = it.n }) end, { Size = UDim2.new(0, 70, 0, 30), Position = UDim2.new(1, -72, 0, 3), TextSize = 13, BackgroundColor3 = Color3.fromRGB(200, 140, 70), Parent = r })
	end
end

TAB_RENDER.orders = function(s, p)
	textLabel({ Text = "Заказ платит больше лавки и даёт опыт.", Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 0, Parent = p })
	for i, o in s.orders do
		local r = row(p, i, 64)
		textLabel({ Text = `{o.customer}: {itemsText(o.items)}\n+{o.coins}💰 +{o.xp}⭐`, Size = UDim2.new(1, -110, 1, 0), Parent = r })
		button("Отдать", o.can, function() send({ type = "complete_order", orderId = o.id }) end, { Size = UDim2.new(0, 100, 0, 28), Position = UDim2.new(1, -100, 0, 2), TextSize = 14, Parent = r })
		button("Другой", true, function() send({ type = "skip_order", orderId = o.id }) end, { Size = UDim2.new(0, 100, 0, 26), Position = UDim2.new(1, -100, 0, 34), TextSize = 13, BackgroundColor3 = Color3.fromRGB(150, 140, 120), Parent = r })
	end
end

TAB_RENDER.build = function(s, p)
	if s.construction then
		live(textLabel({ Size = UDim2.new(1, 0, 0, 40), Font = FONT, LayoutOrder = 0, Parent = p }), function(x)
			return if x.construction then `Идёт стройка: {x.construction.icon} {x.construction.name}, ещё {mmss(x.construction.leftMs)}` else "Стройка готова"
		end)
	end
	for i, b in s.buildings do
		local r = row(p, i, 62)
		local lvl = if b.maxLevel > 1 then ` ур. {b.level}/{b.maxLevel}` elseif b.level > 0 then " ✓" else ""
		textLabel({ Text = `{b.icon} {b.name}{lvl}\n{b.about}`, TextSize = 13, Size = UDim2.new(1, -110, 1, 0), Parent = r })
		local label = if b.can then `{b.cost}💰` else (b.why or "")
		button(label, b.can, function() send({ type = "build", building = b.id }) end, { Size = UDim2.new(0, 104, 0, 40), Position = UDim2.new(1, -104, 0, 10), TextSize = 12, TextWrapped = true, Parent = r })
	end
end

TAB_RENDER.workshop = function(s, p)
	local n = 0
	-- text: строка или функция от снимка (для таймеров)
	local function line(text: any, btn: string?, enabled: boolean?, cmd: { [string]: any }?)
		n += 1
		local r = row(p, n, 40)
		local l = textLabel({ Size = UDim2.new(1, (if btn then -110 else 0), 1, 0), TextSize = 14, Parent = r })
		if type(text) == "function" then
			live(l, text)
		else
			l.Text = text
		end
		if btn then
			button(btn, enabled == true, function() send(cmd :: any) end, { Size = UDim2.new(0, 104, 0, 32), Position = UDim2.new(1, -104, 0, 4), TextSize = 13, Parent = r })
		end
	end
	if not (s.has.mill or s.has.bakery or s.has.kitchen or s.has.coop) then
		line("Пока нечего: построй курятник, мельницу или кухню во вкладке «Стройка».")
	end
	if s.has.coop then
		line("🐔 Курятник: яйцо раз в 50 с, ест пшеницу из амбара.")
	end
	if s.has.mill then
		line(function(x) return if x.mill then `🌀 Мельница: мука через {mmss(x.mill.leftMs)}` else "🌀 Мельница: 3🌾 → 1🥡" end, "Молоть", s.mill == nil, { type = "start_mill" })
	end
	if s.has.bakery then
		line(function(x) return if x.bakery then `🥖 Пекарня: хлеб через {mmss(x.bakery.leftMs)}` else "🥖 Пекарня: 🥡 + 🥚 → 2🍞" end, "Печь", s.bakery == nil, { type = "start_bakery" })
		if s.tray then
			line(function(x) return if x.tray then `Противень: 🍞×{x.tray.bread}, остынет через {mmss(x.tray.leftMs)}` else "Противень пуст" end, "Забрать", true, { type = "take_tray" })
		end
	end
	if s.has.kitchen then
		line(function(x) return if x.kitchen then `🍳 Кухня: готовится, ещё {mmss(x.kitchen.leftMs)}` else "🍳 Кухня: выбери блюдо" end)
		for _, r in s.recipes do
			line(`{r.icon} {r.name}: {itemsText(r.needs)}`, if r.can then "Готовить" else r.why, r.can, { type = "cook", dish = r.id })
		end
	end
end

TAB_RENDER.log = function(_s, p)
	if #logLines == 0 then
		textLabel({ Text = "Пока ничего не случилось.", Size = UDim2.new(1, 0, 0, 22), Parent = p })
	end
	for i = #logLines, math.max(1, #logLines - 40), -1 do
		textLabel({ Text = logLines[i], TextSize = 13, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = #logLines - i, Parent = p })
	end
end

-- Только в Studio: проверка стыка с внешним миром без зверя (как вкладка «🌍 Внешний мир» в вебе).
TAB_RENDER.world = function(s, p)
	local acts = {
		{ "coins", "+100 💰" }, { "skip", "⏩ +1 мин" }, { "offline", "🌙 Офлайн 1 ч" },
		{ "trample", "Потоптал 30%" }, { "eat_green", "Съел зелёное" }, { "hail", "Град: −30% всем" },
		{ "thief", "Вор: 2 из амбара" }, { "tray", "Стащил хлеб" }, { "manure", "Навоз" },
		{ "stones", "Носит камни" }, { "chickens", "Гонял кур" },
		{ "rain", "🌧 Дождь сейчас" }, { "storm", "⛈ Гроза сейчас" }, { "dry", "🌤 Кончить дождь" },
		{ "night", "🌙 Ночь сейчас" }, { "day", "☀️ День сейчас" },
	}
	local grid = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 0, Parent = p }, {
		make("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 30), CellPadding = UDim2.new(0, 4, 0, 4) }),
	})
	for _, a in acts do
		button(a[2], true, function() send({ type = "debug", action = a[1] }) end, { TextSize = 13, BackgroundColor3 = Color3.fromRGB(120, 140, 200), Parent = grid })
	end
	textLabel({ Text = "Что видно снаружи:", Font = FONT, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, Parent = p })
	for i, line in s.extra.objects do
		textLabel({ Text = line, TextSize = 12, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 + i, Parent = p })
	end
end

-- ---------- Отрисовка ----------

render = function()
	local s = snap
	if not s then
		return
	end
	local xpPart = `{s.xp - s.xpFrom}/{s.xpTo - s.xpFrom}`
	local con = if s.construction then `   🔨 {s.construction.name} {mmss(s.construction.leftMs)}` else ""
	topText.Text = `💰 {s.coins}   ⭐ Ур. {s.level} ({xpPart})   📦 {s.used}/{s.cap}   ✨ {s.fertilizer}{con}`

	local sig = tostring(narrowMode) .. (openTab or "-") .. (if openTab == "log" then tostring(#logLines) else "") .. signature(s)
	if sig == lastSignature then
		for _, l in liveLabels do
			l.label.Text = l.fn(s)
		end
		return
	end
	lastSignature = sig
	liveLabels = {}

	-- Вкладки
	for _, c in tabBar:GetChildren() do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
	local tabs = table.clone(TABS)
	if s.extra.debug then
		table.insert(tabs, { id = "world", title = "🌍", color = Color3.fromRGB(40, 170, 170) })
	end
	-- Все вкладки одной ширины и всегда влезают в ряд (раньше правые уходили за край).
	local cellW = 1 / #tabs
	for i, t in tabs do
		local b = button(if narrowMode or t.id == "world" then string.split(t.title, " ")[1] else t.title, true, function() setTab(t.id) end, {
			Size = UDim2.new(cellW, -4, 1, 0),
			TextScaled = true,
			LayoutOrder = i,
			BackgroundColor3 = t.color,
			Parent = tabBar,
		})
		b.Name = t.id
		if openTab == t.id then
			-- Открытая вкладка: белая рамка вместо тёмной.
			local st = b:FindFirstChildOfClass("UIStroke") :: UIStroke
			st.Color = Color3.new(1, 1, 1)
			st.Thickness = 4
		end
		make("UITextSizeConstraint", { MaxTextSize = 15, Parent = b:FindFirstChild("Label") })
		make("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = b })
	end

	-- Панель
	for _, c in panel:GetChildren() do
		if not (c:IsA("UIListLayout") or c:IsA("UIPadding") or c:IsA("UICorner") or c:IsA("UIStroke")) then
			c:Destroy()
		end
	end
	panel.Visible = openTab ~= nil
	if openTab and TAB_RENDER[openTab] then
		TAB_RENDER[openTab](s, panel)
	end

	-- Инструменты: выбор семян, удобрение, полить всё, собрать всё
	for _, c in tools:GetChildren() do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
	for _, c in s.crops do
		local chosen = s.extra.crop == c.id and s.extra.tool == "auto"
		local seeds = s.extra.shop and s.extra.shop.seeds
		local count = if c.cost == 0 then "∞" elseif seeds then "×" .. (seeds[c.id] or 0) else c.cost .. "💰"
		local text = if c.unlocked then `{c.icon} {count}` else `🔒{c.level}`
		button(text, c.unlocked, function() send({ type = "select_crop", crop = c.id }) end, {
			Size = UDim2.new(0, 78, 0, 42),
			TextSize = 14,
			BackgroundColor3 = if chosen then COLORS.accent elseif c.unlocked then COLORS.wood else COLORS.buttonOff,
			Parent = tools,
		})
	end
	local fertOn = s.extra.tool == "fertilize"
	button(`✨ {s.fertilizer}`, s.fertilizer > 0, function() send({ type = "tool", tool = if fertOn then "auto" else "fertilize" }) end, {
		Size = UDim2.new(0, 64, 0, 42),
		BackgroundColor3 = if fertOn then COLORS.accent elseif s.fertilizer > 0 then Color3.fromRGB(150, 110, 190) else COLORS.buttonOff,
		Parent = tools,
	})
	button("💧 всё", true, function() send({ type = "water_all" }) end, { Size = UDim2.new(0, 70, 0, 42), BackgroundColor3 = Color3.fromRGB(70, 140, 210), Parent = tools })
	button("🧺 всё", true, function() send({ type = "harvest_all" }) end, { Size = UDim2.new(0, 70, 0, 42), Parent = tools })
end

State.OnClientEvent:Connect(function(s)
	snap = s
	for _, line in s.log or {} do
		table.insert(logLines, line)
		if #logLines > 200 then
			table.remove(logLines, 1)
		end
	end
	local msg = s.hint or (if s.log and #s.log > 0 then s.log[#s.log] else nil)
	if msg then
		hint.Text = msg
		hint.Visible = true
		hintUntil = os.clock() + 3
	elseif os.clock() > hintUntil then
		hint.Visible = false
	end
	render()
end)

Open.OnClientEvent:Connect(function(tab: string)
	openTab = tab
	render()
end)

