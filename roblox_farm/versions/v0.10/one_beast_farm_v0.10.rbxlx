        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Таблицы блока зверя: еда, виды, игрушки, описания поступков.
-- Перенос beast_lab: foods.ts, species.ts, toys.ts и таблица BEHAVIORS из behaviors.ts.

local IS_ROBLOX = typeof(script) == "Instance"
local Util = if IS_ROBLOX then require(script.Parent.Util) else require("./Util")

local Data = {}

-- ---------- Еда ----------
-- Ферма говорит только «это морковь, зелёная» (метки crop:carrot + unripe), а что от неё будет зверю — решает эта таблица.

Data.FOODS = {
	feed = { name = "корм", acc = "корм", satiety = 35, joy = 0 },
	carrot = { name = "морковь", acc = "морковку", satiety = 25, joy = 3 },
	strawberry = { name = "клубника", acc = "клубнику", satiety = 10, joy = 15 },
	pumpkin = { name = "тыква", acc = "тыкву", satiety = 50, joy = 5 },
	wheat = { name = "пшеница", acc = "пшеницу", satiety = 6, joy = 0 },
	bread = { name = "хлеб", acc = "хлеб", satiety = 45, joy = 10 },
	egg = { name = "яйцо", acc = "яйцо", satiety = 18, joy = 4 },
	wolfberry = { name = "тёмные ягоды", acc = "тёмные ягоды", satiety = 6, joy = 0, effect = "poison" },
	raspberry = { name = "красные ягоды", acc = "красные ягоды", satiety = 10, joy = 10 },
}

-- Что это за предмет: из меток crop:…, item:…, kind:…, иначе id.
function Data.kindOf(o): string
	for _, t in o.tags do
		local i = string.find(t, ":", 1, true)
		if i and i > 1 and (Util.startsWith(t, "crop:") or Util.startsWith(t, "item:") or Util.startsWith(t, "kind:")) then
			return string.sub(t, i + 1)
		end
	end
	return o.id
end

function Data.nameOf(o): string
	local f = Data.FOODS[Data.kindOf(o)]
	return if f then f.name else o.label
end

-- Что будет зверю, если это съесть. Незрелое — мало сытости и расстройство живота.
function Data.foodOf(o)
	if not table.find(o.tags, "food") then
		return nil
	end
	local base = o.food or Data.FOODS[Data.kindOf(o)] or { satiety = 10, joy = 0 }
	if table.find(o.tags, "unripe") then
		return { satiety = Util.round(base.satiety * 0.3), joy = 0, effect = "upset", acc = base.acc }
	end
	return base
end

-- Ключ вкусовой памяти: зелёная морковь и зрелая — разный опыт.
function Data.tasteKey(o): string
	return if table.find(o.tags, "unripe") then Data.kindOf(o) .. "/unripe" else Data.kindOf(o)
end

-- ---------- Игрушки ----------

Data.TOYS = {
	ball = { id = "ball", name = "мяч", acc = "мяч", with = "любимым мячом", icon = "⚽", skill = "speed", skillPerSec = 0.05, about = "гоняет мяч — растёт Скорость" },
	stick = { id = "stick", name = "палка", acc = "палку", with = "любимой палкой", icon = "🦴", skill = "agility", skillPerSec = 0.04, about = "ловит и грызёт палку — растёт Ловкость" },
	plush = { id = "plush", name = "плюшевый зайка", acc = "плюшевого зайку", with = "плюшевым зайкой", icon = "🧸", skill = "endurance", skillPerSec = 0.01, about = "обнимает зайку — успокаивается, страхи слабеют", calm = 0.15 },
	rope = { id = "rope", name = "канат", acc = "канат", with = "канатом-тянучкой", icon = "🪢", skill = "strength", skillPerSec = 0.02, about = "тянет канат — растёт Сила" },
	cone = { id = "cone", name = "шишка-головоломка", acc = "шишку", with = "шишкой-головоломкой", icon = "🌰", skill = "intelligence", skillPerSec = 0.04, about = "выковыривает орешки из шишки — растёт Сообразительность" },
}
Data.TOY_LIST = { "ball", "stick", "plush", "rope", "cone" }

-- ---------- Виды ----------

Data.SPECIES = {
	bear = {
		id = "bear", title = "Медвежонок", defaultName = "Топа",
		description = "Большой и сильный, вечно голодный. Хорошо носит камни, легко толстеет.",
		colors = { body = "#a0673a", belly = "#e2b48a", spot = "#5c3a1c", outline = "#6b4321" },
		look = { ears = "round", tail = "stub", shell = false },
		stage = { infant = { height = 32, baseMass = 6 }, young = { height = 55, baseMass = 14 }, adult = { height = 80, baseMass = 24 } },
		speedMul = 0.85, satietyDecayMul = 1.25, joyDecayMul = 0.9, fatGainMul = 1.4, toxinResist = 0.1,
		training = { speed = 0, agility = 0, endurance = 12, intelligence = 5 },
		toys = { "rope", "ball" }, fearSpider = 25,
		start = { appetite = 40, bravery = 20, discipline = 10, obedience = 40, strength = 9, hp = 120, muscleMass = 1, fatMass = 0.8 },
	},
	fox = {
		id = "fox", title = "Лисёнок", defaultName = "Рыжик",
		description = "Шустрый и любопытный. Быстро бегает, быстро скучает и быстро отвлекается.",
		colors = { body = "#e07b39", belly = "#fbe3c8", spot = "#fff4e8", outline = "#9c4f1d" },
		look = { ears = "pointy", tail = "bushy", shell = false },
		stage = { infant = { height = 28, baseMass = 3 }, young = { height = 45, baseMass = 7 }, adult = { height = 60, baseMass = 11 } },
		speedMul = 1.3, satietyDecayMul = 1, joyDecayMul = 1.35, fatGainMul = 0.8, toxinResist = 0,
		training = { speed = 10, agility = 12, endurance = 0, intelligence = 8 },
		toys = { "ball", "stick" }, fearSpider = 40,
		start = { appetite = 0, bravery = -10, discipline = 5, obedience = 30, strength = 4, hp = 80, muscleMass = 0.3, fatMass = 0.3 },
	},
	turtle = {
		id = "turtle", title = "Черепашка", defaultName = "Тихоня",
		description = "Медленная, терпеливая и осторожная. Доделывает дела, крепкий желудок.",
		colors = { body = "#7aa864", belly = "#e8e2a8", spot = "#3e5f31", outline = "#3e5f31" },
		look = { ears = "none", tail = "none", shell = true },
		stage = { infant = { height = 20, baseMass = 5 }, young = { height = 35, baseMass = 11 }, adult = { height = 50, baseMass = 18 } },
		speedMul = 0.6, satietyDecayMul = 0.8, joyDecayMul = 0.8, fatGainMul = 1, toxinResist = 0.35,
		training = { speed = 0, agility = 0, endurance = 15, intelligence = 12 },
		toys = { "cone", "plush" }, fearSpider = 55,
		start = { appetite = -30, bravery = -40, discipline = 35, obedience = 55, strength = 6, hp = 110, muscleMass = 0.6, fatMass = 0.5 },
	},
	dragon = {
		id = "dragon", title = "Дракончик", defaultName = "Искра",
		description = "Смелый и упрямый. Рвётся в драку, плохо слушается, быстро скучает.",
		colors = { body = "#c0483f", belly = "#f4c27a", spot = "#7a2620", outline = "#7a2620" },
		look = { ears = "horns", tail = "spiky", shell = false },
		stage = { infant = { height = 30, baseMass = 4 }, young = { height = 52, baseMass = 10 }, adult = { height = 75, baseMass = 17 } },
		speedMul = 1.05, satietyDecayMul = 1.1, joyDecayMul = 1.4, fatGainMul = 1, toxinResist = 0.2,
		training = { speed = 5, agility = 8, endurance = 5, intelligence = 3 },
		toys = { "rope", "stick" }, fearSpider = 5,
		start = { appetite = 20, bravery = 50, discipline = 10, obedience = 20, strength = 7, hp = 95, muscleMass = 0.6, fatMass = 0.4 },
	},
	bunny = {
		id = "bunny", title = "Зайчонок", defaultName = "Пушок",
		description = "Самый быстрый и самый пугливый. Обожает морковку, прячется от любой тени, слабенький.",
		colors = { body = "#cfc6b8", belly = "#fbf7ef", spot = "#a89c8a", outline = "#7d7364" },
		look = { ears = "long", tail = "stub", shell = false },
		stage = { infant = { height = 24, baseMass = 2 }, young = { height = 38, baseMass = 4 }, adult = { height = 52, baseMass = 7 } },
		speedMul = 1.45, satietyDecayMul = 1.05, joyDecayMul = 1.15, fatGainMul = 0.7, toxinResist = 0,
		training = { speed = 15, agility = 15, endurance = 0, intelligence = 6 },
		startHabits = { pick_green = 12 },
		toys = { "plush", "ball" }, fearSpider = 75,
		start = { appetite = 10, bravery = -55, discipline = 15, obedience = 40, strength = 3, hp = 70, muscleMass = 0.2, fatMass = 0.2 },
	},
	boar = {
		id = "boar", title = "Кабанчик", defaultName = "Хрюня",
		description = "Крепкий и напористый. Ест всё подряд, даже незнакомые ягоды. Крепкий желудок, упрямый.",
		colors = { body = "#8a6f5c", belly = "#d9c0a8", spot = "#5a4536", outline = "#4e3b2e" },
		look = { ears = "pointy", tail = "curly", shell = false, face = "snout" },
		stage = { infant = { height = 26, baseMass = 5 }, young = { height = 45, baseMass = 13 }, adult = { height = 65, baseMass = 26 } },
		speedMul = 0.9, satietyDecayMul = 1.2, joyDecayMul = 1, fatGainMul = 1.25, toxinResist = 0.5,
		training = { speed = 0, agility = 0, endurance = 10, intelligence = 4 },
		startHabits = { eat_berry = 10 },
		toys = { "rope", "cone" }, fearSpider = 10,
		start = { appetite = 50, bravery = 35, discipline = 15, obedience = 25, strength = 10, hp = 130, muscleMass = 1, fatMass = 0.7 },
	},
	raccoon = {
		id = "raccoon", title = "Енотик", defaultName = "Шустрик",
		description = "Сообразительный и любопытный воришка. Быстро учит команды, но вечно выпрашивает еду.",
		colors = { body = "#8d8a86", belly = "#dcd8d0", spot = "#3d3a37", outline = "#3d3a37" },
		look = { ears = "round", tail = "ringed", shell = false, face = "mask" },
		stage = { infant = { height = 24, baseMass = 3 }, young = { height = 40, baseMass = 6 }, adult = { height = 55, baseMass = 10 } },
		speedMul = 1.1, satietyDecayMul = 1.1, joyDecayMul = 1.25, fatGainMul = 1, toxinResist = 0.15,
		training = { speed = 5, agility = 10, endurance = 0, intelligence = 20 },
		startHabits = { beg_food = 12 },
		toys = { "cone", "ball" }, fearSpider = 35,
		start = { appetite = 30, bravery = 5, discipline = 5, obedience = 35, strength = 5, hp = 85, muscleMass = 0.3, fatMass = 0.35 },
	},
	wolf = {
		id = "wolf", title = "Волчонок", defaultName = "Серый",
		description = "Смелый и верный, слушается хозяина как вожака. Любит приносить хозяину игрушку.",
		colors = { body = "#7f8794", belly = "#e4e6ea", spot = "#4a505a", outline = "#3f444d" },
		look = { ears = "pointy", tail = "bushy", shell = false },
		stage = { infant = { height = 28, baseMass = 4 }, young = { height = 50, baseMass = 11 }, adult = { height = 72, baseMass = 20 } },
		speedMul = 1.2, satietyDecayMul = 1.1, joyDecayMul = 1.1, fatGainMul = 0.85, toxinResist = 0.1,
		training = { speed = 8, agility = 8, endurance = 8, intelligence = 8 },
		startHabits = { bring_toy = 10 },
		toys = { "stick", "rope" }, fearSpider = 15,
		start = { appetite = 15, bravery = 30, discipline = 25, obedience = 50, strength = 8, hp = 105, muscleMass = 0.7, fatMass = 0.3 },
	},
}
Data.SPECIES_LIST = { "bear", "fox", "turtle", "dragon", "bunny", "boar", "raccoon", "wolf" }

-- ---------- Поступки ----------

local function B(label, icon, verb, did, trait, traitSign, reasons)
	return { label = label, icon = icon, verb = verb, did = did, trait = trait, traitSign = traitSign, reasons = reasons }
end

Data.BEHAVIORS = {
	eat_bowl = B("Поесть из миски", "🥣", "есть из миски", "поел из миски", nil, 0, { need = "голодный", base = "проголодался" }),
	beg_food = B("Просить еду", "🥺", "выпрашивать еду", "пришёл просить еду", nil, 0, { need = "голодный, миска пустая", habit = "раньше давали", base = "миска пустая" }),
	eat_ripe = B("Съесть зрелое с грядки", "🥕", "есть зрелое с грядки", "съел зрелый урожай с грядки", nil, 0, { need = "голодный, урожай созрел", base = "урожай созрел" }),
	pick_green = B("Сорвать незрелое", "🌱", "срывать незрелое", "сорвал незрелый урожай", "appetite", 1, { need = "голодный, грядка рядом", trait = "прожорливый, не может ждать", habit = "уже срывал", base = "грядка рядом" }),
	wait_ripe = B("Ждать урожая", "⏳", "ждать урожая", "дождался, пока урожай созреет", "appetite", -1, { need = "голодный, ждёт урожай", trait = "умеренный, подождёт", habit = "научился ждать", base = "ждёт урожай" }),
	eat_berry = B("Съесть незнакомую ягоду", "🫐", "есть дикие ягоды", "съел дикую ягоду", "appetite", 1, { need = "голодный, ягоды!", trait = "прожорливый, всё в рот", habit = "ягоды уже ел", taste = "вкусные были", base = "ягоды!" }),
	play_toy = B("Играть с игрушкой", "⚽", "играть с любимой игрушкой", "играл с любимой игрушкой", nil, 0, { need = "скучно, хочет играть", habit = "любит свою игрушку", base = "хочет играть" }),
	bring_toy = B("Принести игрушку", "🎁", "приносить тебе игрушку", "принёс тебе свою игрушку", nil, 0, { need = "скучно, поиграй со мной", habit = "любит приносить тебе игрушку", base = "хочет поиграть с тобой" }),
	sleep = B("Спать", "💤", "спать", "лёг спать", nil, 0, { need = "устал", base = "устал" }),
	poop_toilet = B("Сходить в туалет", "🚽", "ходить в туалет", "сходил в туалет как положено", nil, 0, { need = "приспичило", habit = "приучен к туалету", base = "приспичило" }),
	poop_here = B("Сделать кучку где попало", "💩", "делать кучки где попало", "сделал кучку прямо тут", nil, 0, { need = "приспичило, далеко идти", habit = "привык где попало", base = "приспичило" }),
	approach_thorns = B("Полезть в колючки", "🌵", "лезть в колючий куст", "полез в колючий куст", "bravery", 1, { trait = "смелый, интересно что там", habit = "за колючки хвалили", base = "любопытно" }),
	avoid_thorns = B("Обойти колючки", "↩️", "обходить колючий куст", "осторожно обошёл колючий куст", "bravery", -1, { trait = "осторожный, там колючки", habit = "запомнил: колючки", base = "что-то колючее" }),
	chase_butterfly = B("Погнаться за бабочкой", "🦋", "бегать за бабочками", "погнался за бабочкой", nil, 0, { need = "скучно, бабочка!", base = "бабочка!", habit = "любит бабочек" }),
	flee_spider = B("Убежать от паука", "🕷", "убегать от пауков", "испугался паука и убежал", "bravery", -1, { need = "боится пауков", trait = "осторожный, паук!", habit = "привык бегать от пауков", base = "паук!" }),
	sniff_spider = B("Обнюхать паука", "👃", "обнюхивать пауков", "подошёл и обнюхал паука", "bravery", 1, { need = "пауков не боится", trait = "смелый, интересно", habit = "любит разглядывать пауков", base = "кто это там?" }),
	carry_stone = B("Носить камни", "🪨", "носить камни", "носил камни на стройку", nil, 0, { habit = "любит помогать", base = "носит камни" }),
	wander = B("Гулять", "🐾", "гулять", "гулял", nil, 0, { base = "гуляет" }),
	greet_person = B("Подбежать к гостю", "🤗", "бегать к гостям", "подбежал к гостю", "bravery", 1, { need = "скучно, гость!", trait = "смелый, любопытно", habit = "любит гостей", taste = "этот гость добрый", base = "кто-то пришёл" }),
	hide_from_person = B("Спрятаться от гостя", "🫣", "прятаться от гостей", "спрятался от гостя", "bravery", -1, { trait = "осторожный, чужой", taste = "этот гость обижал", base = "чужой!" }),
	come = B("Подбежать к тебе", "❗", "прибегать", "прибежал к тебе", nil, 0, { base = "ты позвал" }),
	-- Только в Roblox (дом зверя на участке): дождь и лужа.
	play_puddle = B("Прыгать по луже", "💦", "прыгать по лужам", "напрыгался в луже и весь испачкался", "bravery", 1, { need = "скучно, лужа!", trait = "смелый, лужа!", habit = "любит лужи", base = "лужа!" }),
	hide_kennel = B("Спрятаться в будку", "🏠", "прятаться в будку от дождя", "спрятался в будку от дождя", "bravery", -1, { need = "гроза, страшно", trait = "осторожный, мокро", habit = "в дождь — в будку", base = "дождь" }),
}
-- Порядок как у Object.keys(BEHAVIORS) в TypeScript (нужен для списка привычек).
Data.BEHAVIOR_ORDER = {
	"eat_bowl", "beg_food", "eat_ripe", "pick_green", "wait_ripe", "eat_berry", "play_toy", "bring_toy", "sleep",
	"poop_toilet", "poop_here", "approach_thorns", "avoid_thorns", "chase_butterfly", "flee_spider", "sniff_spider",
	"carry_stone", "wander", "greet_person", "hide_from_person", "come",
}
-- Поступки дома в Roblox. В вебе и в сверке с ним их нет: привычки к ним заводит Home.create.
Data.HOME_BEHAVIOR_ORDER = { "play_puddle", "hide_kennel" }

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Food</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Еда и живот. Перенос food.ts. Три разных последствия, которые игрок должен различать:
-- расстройство (съел зелёное), понос (резко объелся на полный живот), рвота (яд).
-- После плохого опыта зверь запоминает вкус. Яд медленно закаляет желудок.

local IS_ROBLOX = typeof(script) == "Instance"
local function req(name)
	return if IS_ROBLOX then require(script.Parent[name]) else require("./" .. name)
end
local CONFIG = req("Config")
local Data = req("Data")
local Util = req("Util")
local Body = req("Body")
local Journal = req("Journal")

local clamp = Util.clamp
local Food = {}

function Food.diarrheaActive(sim): boolean
	return sim.beast.states.diarrheaUntilMs > sim.tMs
end

function Food.addSatiety(sim, amount: number, canFatten: boolean)
	local b = sim.beast
	local before = b.needs.satiety
	local after = before + amount
	if canFatten then
		local over = math.max(0, after - math.max(before, CONFIG.food.fatThreshold))
		local gain = over * CONFIG.food.fatPerPoint * Data.SPECIES[b.species].fatGainMul
		b.body.fatMass += gain
		Body.story(b).fatGain += gain
	end
	b.needs.satiety = clamp(after, 0, 100)
	b.needs.bowel = clamp(b.needs.bowel + amount * CONFIG.needs.bowelPerSatiety, 0, 100)
	b.hp = clamp(b.hp + CONFIG.hp.eatHeal, 0, b.maxHp)
end

function Food.startDiarrhea(sim, cause: string)
	local b = sim.beast
	local D = CONFIG.diarrhea
	local was = Food.diarrheaActive(sim)
	b.states.diarrheaUntilMs = sim.tMs + D.durationMs
	b.states.overateUntilMs = 0
	b.needs.energy = clamp(b.needs.energy - D.energyLoss, 0, 100)
	b.needs.joy = clamp(b.needs.joy - D.joyLoss, 0, 100)
	b.needs.bowel = math.max(b.needs.bowel, D.startBowel)
	b.practice.diarrheas += 1
	Journal.setMood(sim, "sick", 3000)
	Journal.addFloat(sim, b.pos.x, b.pos.y - 44, "буль-буль… 💩", "#a60", 1800)
	Journal.logEvent(sim, { kind = "state", note = "diarrhea: " .. cause })
	if not was then
		Journal.addDiary(sim, `💩 {b.name} резко объелся ({cause}) — понос! Ближайшие {Util.round(D.durationMs / 1000)} с будет часто и срочно бегать по делам.`, "event")
	end
end

function Food.afterMeal(sim, before: number, gained: number, what: string): string?
	local b = sim.beast
	local over = before + gained - 100
	if over >= CONFIG.diarrhea.overflow then
		Food.startDiarrhea(sim, what .. " на полный живот")
		return "diarrhea"
	end
	if before >= CONFIG.food.overeatThreshold or over >= CONFIG.overeat.overflow then
		b.states.overateUntilMs = sim.tMs + CONFIG.overeat.durationMs
		b.needs.energy = clamp(b.needs.energy - CONFIG.overeat.energyLoss, 0, 100)
		Journal.setMood(sim, "sleepy", 4000)
		Journal.addDiary(sim, `{b.name} съел {what}, хотя был сыт, и объелся. Живот круглый, хочется спать.`, "event")
		return "overate"
	end
	return nil
end

local function poison(sim, o)
	local b = sim.beast
	local P = CONFIG.poison
	local res = Body.toxinResistance(b)
	local durMs = P.baseMs * (1 - res)
	local prev = b.tastes[Data.tasteKey(o)]
	local first = not (prev ~= nil and prev < 0)
	b.states.poisonedUntilMs = sim.tMs + durMs
	b.needs.energy = clamp(b.needs.energy - P.energyLoss * (1 - res), 0, 100)
	b.needs.joy = clamp(b.needs.joy - P.joyLoss, 0, 100)
	b.toxinExposure += durMs / 1000
	b.practice.poisonings += 1
	Journal.setMood(sim, "sick", durMs)
	Journal.addFloat(sim, b.pos.x, b.pos.y - 44, if res > 0.5 then "фу…" else "буэ! 🤮", "#7a3", 2000)
	Journal.logEvent(sim, { kind = "state", note = "poison:" .. Data.kindOf(o), delta = { durMs = durMs, resist = res } })
	local f = Data.foodOf(o)
	local what = (f and f.acc) or Data.nameOf(o)
	Journal.addDiary(sim, `🤮 {b.name} съел {what} и его стошнило. Сил меньше ещё {Util.round(durMs / 1000)} с.{if first then " Теперь он запомнил этот вкус." else ""}`, "event")
	if Body.toxinResistance(b) - Data.SPECIES[b.species].toxinResist >= 0.25 then
		Journal.addMark(sim, "Крепкий желудок", `Ядовитые ягоды уже почти не действуют на {b.name}.`)
	end
end

function Food.eatObject(sim, o): string?
	local b = sim.beast
	local f = Data.foodOf(o)
	if not f then
		return nil
	end
	local before = b.needs.satiety
	local green = table.find(o.tags, "unripe") ~= nil
	Food.addSatiety(sim, f.satiety, not green and f.effect ~= "poison")
	b.needs.joy = clamp(b.needs.joy + f.joy, 0, 100)
	table.insert(sim.outbox, { type = "ate", objectId = o.id, kind = Data.kindOf(o), tags = table.clone(o.tags), label = o.label })
	local key = Data.tasteKey(o)
	local T = CONFIG.taste
	local function remember(v)
		if b.tastes[key] == nil then
			b.tasteOrder = b.tasteOrder or {}
			table.insert(b.tasteOrder, key)
		end
		b.tastes[key] = clamp((b.tastes[key] or 0) + v, T.min, T.max)
	end

	if f.effect == "poison" then
		poison(sim, o)
		remember(T.poison)
		return "poison"
	end
	if f.effect == "upset" then
		b.states.upsetUntilMs = sim.tMs + CONFIG.upset.durationMs
		b.needs.energy = clamp(b.needs.energy - CONFIG.upset.energyLoss, 0, 100)
		b.practice.greenPicked += 1
		remember(T.upset)
		Journal.setMood(sim, "sick", 4000)
		Journal.addFloat(sim, b.pos.x, b.pos.y - 44, "ой, живот… 🤢", "#7a3")
		Journal.logEvent(sim, { kind = "state", note = "upset:" .. Data.kindOf(o) })
		return "upset"
	end
	remember(T.good)
	local after = Food.afterMeal(sim, before, f.satiety, f.acc or Data.nameOf(o))
	if not after then
		Journal.setMood(sim, "happy", 1500)
	end
	return after
end

-- Каждый шаг: пока понос, живот наполняется сам, а сытость уходит быстрее.
function Food.updateStomach(sim, sec: number)
	local b = sim.beast
	-- Вкусовая память медленно стирается: через несколько минут зверь может попробовать снова.
	local forget = (CONFIG.taste.forgetPerMin * sec) / 60
	for k, v in b.tastes do
		b.tastes[k] = if math.abs(v) <= forget then 0 else v - Util.sign(v) * forget
	end
	if not Food.diarrheaActive(sim) then
		return
	end
	local D = CONFIG.diarrhea
	b.needs.bowel = clamp(b.needs.bowel + D.bowelPerSec * sec, 0, 100)
	b.needs.satiety = clamp(b.needs.satiety - D.satietyLossPerSec * sec, 0, 100)
	local before = b.body.fatMass
	b.body.fatMass = math.max(0.1, b.body.fatMass - D.fatLossPerSec * sec)
	Body.story(b).sickLoss += before - b.body.fatMass
end

return Food
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Home</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Дом зверя на участке фермы: «хозяин мира» для мозга зверя в Roblox.
-- Каждый шаг кладёт в sim.objects объекты фермы (через стык Contract.objects) и вещи зверя
-- (миска, лежанка, туалет, игрушка, колючки, дикие ягоды, бабочка, паук, камни у стройки, гости),
-- а после шага переводит события зверя во входы фермы (claude_interface_farm_beast.md, раздел 2):
--   съел с грядки   → Contract.eatPlot
--   принёс камень   → Contract.helpConstruction(12 с)
--   туалет          → Contract.addFertilizer(1)
-- Координаты — пиксели веб-фермы 760×540 (как у фермы), в мир их переводит Village.toWorld.
-- Модуль без Roblox API: его гоняют тесты в Lune.

local IS_ROBLOX = typeof(script) == "Instance"
local function req(name)
	return if IS_ROBLOX then require(script.Parent[name]) else require("./" .. name)
end
local function reqFarm(name)
	return if IS_ROBLOX then require(script.Parent.Parent.Farm[name]) else require("../Farm/" .. name)
end
local Beast = req("Beast")
local Contract = reqFarm("Contract")

local CONFIG = Beast.CONFIG
local Journal = Beast.Journal
local Rng = Beast.Rng
local Data = Beast.Data
local Util = Beast.Util
local Body = Beast.Body
local Character = Beast.Character
local Relations = Beast.Relations
local Reactions = Beast.Reactions

local Home = {}

local function V(x, y)
	return { x = x, y = y }
end

-- Раскладка вещей зверя вокруг грядок фермы (грядки 296–464 × 100–268, постройки по краям x≈105 и x≈655).
local HOME = {
	width = 760,
	height = 540,
	gate = V(380, 515),
	bowl = V(300, 400),
	bed = V(205, 470),
	toilet = V(565, 490),
	toyStart = V(420, 445),
	thorns = V(560, 335),
	wolfberry = V(730, 505),
	raspberry = V(215, 325),
	stones = V(480, 470),
	puddle = V(500, 375), -- лужа во дворе после дождя
	pen = V(380, 600), -- куда уходит зверь в вольер: за воротами участка
	bowlRefillMs = 70000,
	berryRegrowMs = 60000,
	butterfly = { lifeMs = 15000, spawnMinMs = 30000, spawnMaxMs = 60000, speed = 45, firstAtMs = 20000 },
	spider = { firstAtMs = 70000, everyMinMs = 60000, everyMaxMs = 110000, lifeMs = 45000 },
	perStoneMs = 12000,
	visitorStayMs = 40000,
	-- Хозяин дальше этого от края участка — «нет дома»: зверь его не видит.
	ownerMarginPx = 60,
	-- Дождь и лужа: лужа набирается за 20 с дождя, высыхает за 4 минуты. Грязь сама отпадает через 10 минут.
	puddleFillMs = 20000,
	puddleDryMs = 240000,
	puddleMin = 0.3,
	dirtyMs = 600000,
}

-- Любит ли вид мыться: + рад, − вырывается (обсуждение v0.4, §2: «один любит мыться, другой убегает»).
Home.BATH = { bear = 0.5, fox = -0.4, turtle = 1, dragon = -0.7, bunny = -0.6, boar = -0.2, raccoon = 0.9, wolf = 0.2 }

-- Вольер на площади: что там делает зверь. Знакомится, играет и устаёт; голодный идёт домой сам.
Home.PEN = {
	joyAlonePerSec = 0.3,
	joyFriendPerSec = 2.5,
	energyPerSec = 0.25,
	shyMs = 15000, -- осторожный сначала жмётся к забору
	shyBravery = -20,
	goHomeSatiety = 20,
	goHomeEnergy = 15,
}
Home.LAYOUT = HOME

local BERRIES = { "wolfberry", "raspberry" }

local function totalsExtra(home)
	home.totals.puddles = 0
	home.totals.washes = 0
	home.totals.penVisits = 0
end

-- seed — обычно UserId хозяина, чтобы у каждого был свой зверь.
function Home.create(seed: number, species: string?, name: string?, toy: string?)
	local sim = Beast.create(seed, species or "bear", name, toy)
	sim.bounds = { width = HOME.width, height = HOME.height }
	sim.freeReactions = true -- похвала и ругань без таймера: без повода — сердечко
	sim.beast.pos = V(HOME.bed.x - 50, HOME.bed.y - 20)
	local home = {
		sim = sim,
		bowl = { food = true, refillAtMs = 0 },
		berries = { wolfberry = { ripe = true, regrowAtMs = 0 }, raspberry = { ripe = true, regrowAtMs = 0 } },
		toy = V(HOME.toyStart.x, HOME.toyStart.y),
		butterfly = { active = false, x = 0, y = 0, vx = 0, vy = 0, untilMs = 0, nextAtMs = HOME.butterfly.firstAtMs },
		spider = nil,
		spiderNextAtMs = HOME.spider.firstAtMs,
		piles = {},
		auto = { bowl = true, butterfly = true, spider = true },
		owner = nil, -- {x, y} в пикселях фермы, если хозяин на участке
		visitors = {}, -- [personId] = { name, pos, id }
		visits = 0,
		totals = { greenEaten = 0, ripeEaten = 0, stones = 0, fertilizer = 0, piles = 0, cleaned = 0 },
		farmLog = {}, -- строки для журнала фермы «что сделал зверь»
		nextId = 1,
		stepAccMs = 0,
		weather = { rain = false, storm = false },
		puddle = 0, -- 0..1, сколько воды в луже
		dirty = false,
		dirtyAtMs = 0,
		pen = nil, -- { sinceMs, friends = { [name] = true }, shyUntilMs } пока зверь в вольере
	}
	totalsExtra(home)
	-- Привычки дома в Roblox (в вебе их нет).
	for _, a in Data.HOME_BEHAVIOR_ORDER do
		sim.beast.habits[a] = sim.beast.habits[a] or 0
	end
	return home
end

-- ---------- Объекты ----------

local function farmObjects(farm)
	local out = {}
	for _, o in Contract.objects(farm) do
		table.insert(out, { id = o.id, label = o.label, pos = V(o.x, o.y), tags = o.tags, value = o.value, ripeInMs = o.ripeInMs, owner = "farm" })
	end
	return out
end

function Home.objects(home, farm)
	local out = if farm then farmObjects(farm) else {}
	local function add(o)
		o.owner = "home"
		table.insert(out, o)
	end
	if home.owner then
		add({ id = "player", label = "хозяин", icon = "🧑‍🌾", pos = home.owner, tags = { "player" } })
	end
	add({
		id = "bowl",
		label = if home.bowl.food then "миска, есть корм" else "миска, пустая",
		icon = "🥣",
		pos = HOME.bowl,
		tags = if home.bowl.food then { "bowl", "food", "item:feed" } else { "bowl" },
	})
	add({ id = "bed", label = "лежанка в будке", icon = "🛏", pos = HOME.bed, tags = { "bed" } })
	if home.weather.rain then
		add({ id = "kennel", label = "будка", icon = "🏠", pos = HOME.bed, tags = if home.weather.storm then { "shelter", "storm" } else { "shelter" } })
	end
	if home.puddle >= HOME.puddleMin then
		add({ id = "puddle", label = "лужа", icon = "💦", pos = HOME.puddle, tags = { "puddle", "kind:puddle" } })
	end
	add({ id = "toilet", label = "туалет", icon = "🚽", pos = HOME.toilet, tags = { "toilet" } })
	local toy = Data.TOYS[home.sim.beast.favoriteToy]
	add({ id = "toy", label = `{toy.name}, любимая игрушка`, icon = toy.icon, pos = home.toy, tags = { "toy", "favorite", `kind:{toy.id}` } })
	add({ id = "thorns", label = "куст, колючий", icon = "🌵", pos = HOME.thorns, tags = { "thorny", "kind:thorns" } })
	for _, k in BERRIES do
		if home.berries[k].ripe then
			add({
				id = k,
				label = if k == "wolfberry" then "ягоды, тёмные" else "ягоды, красные",
				icon = if k == "wolfberry" then "🫐" else "🍒",
				pos = HOME[k],
				tags = { "food", "berry", `kind:{k}` },
			})
		end
	end
	local bf = home.butterfly
	if bf.active then
		add({ id = "butterfly", label = "бабочка", icon = "🦋", pos = V(bf.x, bf.y), tags = { "critter", "moving", "kind:butterfly" } })
	end
	if home.spider then
		add({ id = home.spider.id, label = "паук", icon = "🕷", pos = V(home.spider.x, home.spider.y), tags = { "critter", "creepy", "kind:spider" } })
	end
	if farm and farm.construction then
		add({ id = "stones", label = "камни", icon = "🪨", pos = HOME.stones, tags = { "stones" } })
	end
	for pid, v in home.visitors do
		add({ id = v.id, label = v.name, icon = "🧒", pos = v.pos, tags = { "visitor", `person:{pid}` } })
	end
	for _, p in home.piles do
		add({ id = p.id, label = if p.watery then "кучка, жидкая" else "кучка", icon = "💩", pos = V(p.x, p.y), tags = { "mess" } })
	end
	return out
end

-- ---------- Люди на участке ----------

local function inside(p, margin: number): boolean
	return p.x >= -margin and p.x <= HOME.width + margin and p.y >= -margin and p.y <= HOME.height + margin
end

local function clampPos(p)
	return V(math.min(HOME.width - 40, math.max(40, p.x)), math.min(HOME.height - 40, math.max(70, p.y)))
end

-- Где сейчас хозяин (пиксели фермы) или nil, если его нет. Зверь видит хозяина только дома.
function Home.setOwner(home, pos)
	if pos and inside(pos, HOME.ownerMarginPx) then
		home.owner = clampPos(pos)
	else
		home.owner = nil
	end
end

-- Чужие игроки на участке: list = { { id = "123", name = "Маша", pos = {x, y} } }.
-- Каждый новый приход — новый визит (новый id объекта), чтобы зверь решал заново.
function Home.setVisitors(home, list)
	local seen = {}
	for _, p in list do
		if inside(p.pos, 0) then
			seen[p.id] = true
			local v = home.visitors[p.id]
			if not v then
				home.visits += 1
				v = { name = p.name, id = `visitor{home.nextId}` }
				home.nextId += 1
				home.visitors[p.id] = v
			end
			v.pos = clampPos(p.pos)
		end
	end
	for pid in home.visitors do
		if not seen[pid] then
			home.visitors[pid] = nil
		end
	end
end

-- Гость покормил, поиграл или накричал. Привычки не меняет: воспитывает только хозяин.
function Home.visitorAct(home, personId: string, name: string, act: string)
	if not home.visitors[personId] then
		return false
	end
	Relations.personAct(home.sim, personId, name, act)
	return true
end

-- ---------- Цикл ----------

local consumeEvents, updateHome

-- Ровные шаги по CONFIG.stepMs (250 мс), как в вебе.
function Home.tick(home, farm, gameDtMs: number, realNowMs: number)
	home.sim.realNowMs = realNowMs
	if home.pen then
		return -- в вольере шагает Home.penStep
	end
	home.stepAccMs += gameDtMs
	while home.stepAccMs >= CONFIG.stepMs do
		home.stepAccMs -= CONFIG.stepMs
		Home.step(home, farm, CONFIG.stepMs)
	end
	Reactions.updateWindow(home.sim)
end

function Home.step(home, farm, dtMs: number)
	updateHome(home, dtMs)
	home.sim.objects = Home.objects(home, farm)
	Beast.step(home.sim, dtMs)
	consumeEvents(home, farm)
end

function Home.spawnButterfly(home)
	local bf = home.butterfly
	local sim = home.sim
	local a = Rng.next(sim) * math.pi * 2
	bf.active = true
	bf.x = Rng.range(sim, 160, 600)
	bf.y = Rng.range(sim, 120, 460)
	bf.vx = math.cos(a) * HOME.butterfly.speed
	bf.vy = math.sin(a) * HOME.butterfly.speed
	bf.untilMs = sim.tMs + HOME.butterfly.lifeMs
end

local SPIDER_SPOTS = { "bowl", "bed", "toilet", "toy" }

function Home.spawnSpider(home, at)
	local sim = home.sim
	local key = SPIDER_SPOTS[math.floor(Rng.next(sim) * #SPIDER_SPOTS) + 1]
	local p = at
	if not p then
		p = if key == "toy" then V(home.toy.x + 36, home.toy.y - 10) else V(HOME[key].x + 36, HOME[key].y + 12)
	end
	home.spider = { id = `spider{home.nextId}`, x = p.x, y = p.y, untilMs = sim.tMs + HOME.spider.lifeMs }
	home.nextId += 1
end

function updateHome(home, dtMs: number)
	local sim = home.sim
	local t = sim.tMs + dtMs
	if home.weather.rain then
		home.puddle = math.min(1, home.puddle + dtMs / HOME.puddleFillMs)
	elseif home.puddle > 0 then
		home.puddle = math.max(0, home.puddle - dtMs / HOME.puddleDryMs)
	end
	if home.dirty and t - home.dirtyAtMs >= HOME.dirtyMs then
		home.dirty = false
		Journal.addDiary(sim, sim.beast.name .. " обсох, и грязь сама отвалилась.", "event")
	end
	if not home.bowl.food and home.auto.bowl and home.bowl.refillAtMs ~= 0 and t >= home.bowl.refillAtMs then
		home.bowl.food = true
	end
	for _, k in BERRIES do
		if not home.berries[k].ripe and t >= home.berries[k].regrowAtMs then
			home.berries[k].ripe = true
		end
	end
	local bf = home.butterfly
	local B = HOME.butterfly
	if bf.active then
		bf.x += (bf.vx * dtMs) / 1000
		bf.y += (bf.vy * dtMs) / 1000
		if bf.x < 40 or bf.x > HOME.width - 40 then
			bf.vx *= -1
		end
		if bf.y < 60 or bf.y > HOME.height - 40 then
			bf.vy *= -1
		end
		if Rng.next(sim) < 0.05 then
			local a = Rng.next(sim) * math.pi * 2
			bf.vx = math.cos(a) * B.speed
			bf.vy = math.sin(a) * B.speed
		end
		if t >= bf.untilMs then
			bf.active = false
			bf.nextAtMs = t + Rng.range(sim, B.spawnMinMs, B.spawnMaxMs)
		end
	elseif home.auto.butterfly and t >= bf.nextAtMs then
		Home.spawnButterfly(home)
	end
	if home.spider and t >= home.spider.untilMs then
		home.spider = nil
		home.spiderNextAtMs = t + Rng.range(sim, HOME.spider.everyMinMs, HOME.spider.everyMaxMs)
	elseif not home.spider and home.auto.spider and t >= home.spiderNextAtMs then
		Home.spawnSpider(home)
	end
end

local function farmNote(home, text: string)
	table.insert(home.farmLog, text)
	if #home.farmLog > 20 then
		table.remove(home.farmLog, 1)
	end
end

function consumeEvents(home, farm)
	local sim = home.sim
	local name = sim.beast.name
	for _, e in sim.outbox do
		if e.type == "ate" then
			if e.objectId == "bowl" then
				home.bowl.food = false
				home.bowl.refillAtMs = sim.tMs + HOME.bowlRefillMs
			elseif e.objectId == "wolfberry" or e.objectId == "raspberry" then
				home.berries[e.objectId] = { ripe = false, regrowAtMs = sim.tMs + HOME.berryRegrowMs }
			elseif farm then
				local res = Contract.eatPlot(farm, e.objectId, name)
				if res then
					if res.stage == "ripe" then
						home.totals.ripeEaten += 1
					else
						home.totals.greenEaten += 1
						Journal.addFloat(sim, e.pos and e.pos.x or sim.beast.pos.x, sim.beast.pos.y - 30, "−1 урожай", "#b33", 1800)
					end
				end
			end
		elseif e.type == "moved" then
			if e.objectId == "toy" then
				home.toy = clampPos(e.pos)
			end
		elseif e.type == "carried" then
			if farm and farm.construction then
				local ms = Contract.helpConstruction(farm, HOME.perStoneMs, name)
				home.totals.stones += 1
				Journal.addFloat(sim, HOME.stones.x, HOME.stones.y - 40, `🔨 −{Util.round(ms / 1000)} с`, "#a60", 1000)
			end
		elseif e.type == "pooped" then
			if e.where == "here" then
				table.insert(home.piles, { id = `pile{home.nextId}`, x = e.pos.x, y = e.pos.y, watery = e.watery })
				home.nextId += 1
				home.totals.piles += 1
			elseif farm and not e.watery then
				local n = Contract.addFertilizer(farm, 1, name)
				home.totals.fertilizer += n
			end
		elseif e.type == "muddy" then
			if not home.dirty then
				home.dirty = true
				home.dirtyAtMs = sim.tMs
			end
			home.totals.puddles += 1
		elseif e.type == "sniffed" then
			if home.spider and home.spider.id == e.objectId then
				home.spider = nil
				home.spiderNextAtMs = sim.tMs + Rng.range(sim, HOME.spider.everyMinMs, HOME.spider.everyMaxMs)
			end
		end
	end
	table.clear(sim.outbox)
end

-- ---------- Ввод хозяина ----------
-- input: { type = "react", reaction = "praise"|"scold"|"give" } | { type = "call" } | { type = "command_carry" }
--      | { type = "fill_bowl" } | { type = "clean_pile", pileId } | { type = "shoo_spider" } | { type = "rename", name }
function Home.input(home, farm, input, realNowMs: number)
	local sim = home.sim
	sim.realNowMs = realNowMs
	local ty = input.type
	if ty == "fill_bowl" then
		home.bowl.food = true
	elseif ty == "clean_pile" then
		for i = #home.piles, 1, -1 do
			if home.piles[i].id == input.pileId then
				table.remove(home.piles, i)
				home.totals.cleaned += 1
				-- Убранная кучка идёт в компост: удобрение, как из туалета.
				if farm then
					Contract.addFertilizer(farm, 1, "Уборка")
				end
			end
		end
	elseif ty == "shoo_spider" then
		if home.spider then
			Journal.addFloat(sim, home.spider.x, home.spider.y - 20, "кыш!", "#555")
			home.spider = nil
			home.spiderNextAtMs = sim.tMs + Rng.range(sim, HOME.spider.everyMinMs, HOME.spider.everyMaxMs)
		end
	elseif ty == "wash" then
		return Home.wash(home)
	elseif ty == "react" or ty == "call" or ty == "command_carry" or ty == "rename" then
		sim.objects = Home.objects(home, farm)
		local res = Beast.input(sim, input, realNowMs)
		consumeEvents(home, farm)
		return res
	end
	sim.objects = Home.objects(home, farm)
	return nil
end

-- ---------- Погода ----------

-- Дождь на весь сервер: сервер сообщает каждому дому. Гроза пугает осторожных.
function Home.setWeather(home, rain: boolean, storm: boolean)
	local was = home.weather.rain
	home.weather.rain = rain
	home.weather.storm = rain and storm
	if rain and not was then
		Journal.addDiary(home.sim, "Пошёл дождь.", "event")
	end
end

-- Раскат грома: осторожный зверь пугается (видно характер), смелому всё равно.
function Home.thunder(home)
	local sim = home.sim
	local b = sim.beast
	if home.pen then
		return
	end
	if b.traits.bravery < 0 then
		Journal.setMood(sim, "scared", 3000)
		Journal.addFloat(sim, b.pos.x, b.pos.y - 40, "⚡😨", "#447", 2000)
	else
		Journal.addFloat(sim, b.pos.x, b.pos.y - 40, "⚡", "#447", 1500)
	end
end

-- Помыть грязного зверя. Одни виды рады воде, другие вырываются; чистым становится в любом случае.
function Home.wash(home)
	local sim = home.sim
	local b = sim.beast
	if not home.dirty then
		Journal.hint(sim, b.name .. " и так чистый", 2000)
		return nil
	end
	home.dirty = false
	home.totals.washes += 1
	local like = Home.BATH[b.species] or 0
	if like > 0 then
		b.needs.joy = Util.clamp(b.needs.joy + 10 * like, 0, 100)
		Journal.setMood(sim, "happy", 3000)
		Journal.addFloat(sim, b.pos.x, b.pos.y - 40, "🫧 любит мыться!", "#36a", 2200)
		Journal.addDiary(sim, `{b.name} помылся и доволен: любит воду.`, "event")
	else
		b.needs.joy = Util.clamp(b.needs.joy + 12 * like, 0, 100)
		b.relations.owner.trust = Util.clamp(b.relations.owner.trust + 2 * like, -100, 100)
		Journal.setMood(sim, "sad", 3000)
		Journal.addFloat(sim, b.pos.x, b.pos.y - 40, "🫧 не хочу мыться!", "#36a", 2200)
		Journal.addDiary(sim, `{b.name} вырывался, пока его мыли: воду не любит.`, "event")
	end
	return like
end

-- ---------- Вольер ----------
-- Пока зверь в вольере на площади, дом его не видит: поступков на участке нет, нужды идут,
-- радость растёт, если рядом другие звери. Где он в вольере, решает сервер (BeastService).

function Home.goPen(home)
	local sim = home.sim
	local b = sim.beast
	if home.pen then
		return false
	end
	if b.current and b.current.behavior == "sleep" and b.current.phase == "doing" then
		Journal.hint(sim, "спит и не слышит", 2000)
		return false
	end
	b.current = nil
	sim.window = nil
	local P = Home.PEN
	home.pen = { sinceMs = sim.tMs, friends = {}, shyUntilMs = if b.traits.bravery < P.shyBravery then sim.tMs + P.shyMs else 0, played = 0 }
	home.totals.penVisits += 1
	return true
end

-- Вернуть зверя домой (к воротам участка).
function Home.backHome(home, why: string?)
	local sim = home.sim
	local b = sim.beast
	local pen = home.pen
	if not pen then
		return
	end
	home.pen = nil
	b.current = nil
	b.pos = V(HOME.gate.x, HOME.gate.y - 30)
	local n = 0
	local names = {}
	for name in pen.friends do
		n += 1
		table.insert(names, name)
	end
	table.sort(names)
	local mins = Util.round((sim.tMs - pen.sinceMs) / 60000)
	local text = if n > 0 then `Гулял в вольере ({mins} мин), играл: {table.concat(names, ", ")}.` else `Гулял в вольере ({mins} мин), но там никого не было.`
	Journal.addDiary(sim, b.name .. ": " .. text, "event")
	if why then
		Journal.hint(sim, why, 3500)
	end
end

-- Шаг в вольере. friends — имена зверей рядом (в нескольких шагах). Возвращает "home", если пора домой.
function Home.penStep(home, dtMs: number, friends: { string }, realNowMs: number): string?
	local sim = home.sim
	sim.realNowMs = realNowMs
	local b = sim.beast
	local pen = home.pen
	if not pen then
		return nil
	end
	local P = Home.PEN
	local sp = Data.SPECIES[b.species]
	local sec = dtMs / 1000
	sim.tMs += dtMs
	local t = sim.tMs
	b.needs.satiety = Util.clamp(b.needs.satiety - CONFIG.needs.satietyDecay * sp.satietyDecayMul * sec, 0, 100)
	b.needs.energy = Util.clamp(b.needs.energy - P.energyPerSec * sec, 0, 100)
	b.hp = Util.clamp(b.hp + CONFIG.hp.regenPerSec * sec, 0, b.maxHp)
	local shy = pen.shyUntilMs > t
	if #friends > 0 and not shy then
		b.needs.joy = Util.clamp(b.needs.joy + P.joyFriendPerSec * sec, 0, 100)
		pen.played += dtMs
		Journal.setMood(sim, "happy", 600)
		for _, name in friends do
			if not pen.friends[name] then
				pen.friends[name] = true
				b.penFriends = b.penFriends or {}
				local first = not b.penFriends[name]
				b.penFriends[name] = (b.penFriends[name] or 0) + 1
				Journal.addFloat(sim, b.pos.x, b.pos.y - 40, if first then "👋 привет!" else "❤️ старый друг!", "#c60", 2000)
				if first then
					Journal.addDiary(sim, `{b.name} познакомился в вольере: {name}.`, "event")
				end
			end
		end
	else
		b.needs.joy = Util.clamp(b.needs.joy + P.joyAlonePerSec * sec - (if shy then 0.3 * sec else 0), 0, 100)
		if shy then
			Journal.setMood(sim, "scared", 600)
		end
	end
	b.bubble = if shy then "боязно… жмётся к забору" elseif #friends > 0 then "играет с " .. friends[1] else "бегает по вольеру"
	local keep = {}
	for _, f in sim.floats do
		if f.untilMs > t then
			table.insert(keep, f)
		end
	end
	sim.floats = keep
	if b.needs.satiety < P.goHomeSatiety then
		Home.backHome(home, b.name .. " проголодался и ушёл домой")
		return "home"
	end
	if b.needs.energy < P.goHomeEnergy then
		Home.backHome(home, b.name .. " устал и ушёл домой спать")
		return "home"
	end
	return nil
end

-- ---------- Офлайн ----------
-- Пока хозяина нет, зверь спит в лежанке и сыт до безопасного уровня. Время зверя не идёт:
-- без хозяина он не взрослеет и не меняет привычки (так же, как в вебе).
function Home.offline(home, awayMs: number): { string }?
	local O = CONFIG.offline
	if awayMs < O.minMs then
		return nil
	end
	local ms = math.min(awayMs, O.maxMs)
	local b = home.sim.beast
	b.needs.energy = 100
	b.needs.satiety = math.max(b.needs.satiety, O.satietyFloor)
	b.needs.bowel = math.min(b.needs.bowel, 40)
	b.hp = b.maxHp
	b.states = { upsetUntilMs = 0, ouchUntilMs = 0, overateUntilMs = 0, poisonedUntilMs = 0, diarrheaUntilMs = 0, refusedUntilMs = 0 }
	b.current = nil
	b.pos = V(HOME.bed.x - 50, HOME.bed.y - 20)
	home.bowl.food = true
	home.spider = nil
	home.pen = nil
	local lines = { `{b.name} выспался и ждёт тебя.` }
	Journal.addDiary(home.sim, `Пока тебя не было ({Util.round(ms / 60000)} мин): {table.concat(lines, " ")}`, "event")
	return lines
end

-- ---------- Что показать игроку ----------

-- Иконка над головой, как в Sims: самая сильная нужда или состояние.
function Home.statusIcon(home): string?
	local sim = home.sim
	local b = sim.beast
	local t = sim.tMs
	local face = Character.faceMood(sim)
	if b.current and b.current.behavior == "sleep" and b.current.phase == "doing" then
		return "💤"
	end
	if face == "scared" then
		return "😨"
	end
	if face == "sick" then
		return "🤢"
	end
	if face == "hurt" then
		return "🤕"
	end
	if b.needs.satiety < 30 then
		return "🍖"
	end
	if b.needs.energy < 25 then
		return "😴"
	end
	if b.needs.bowel > 80 then
		return "🚽"
	end
	if home.pen and home.pen.shyUntilMs > t then
		return "😰"
	end
	if home.dirty then
		return "🟤"
	end
	if b.needs.joy < 30 then
		return "😢"
	end
	if b.mood.untilMs > t and b.mood.kind == "happy" then
		return "❤️"
	end
	return nil
end

-- Значок последнего поступка рядом с кнопками: понятно, за что хвалишь.
function Home.lastAct(home)
	local w = home.sim.window
	if w then
		local info = Data.BEHAVIORS[w.behavior]
		return { icon = info.icon, text = info.label, open = true }
	end
	return nil
end

-- Снимок для экрана хозяина (портрет сбоку, кнопки, карточка зверя).
function Home.view(home, full: boolean?)
	local sim = home.sim
	local b = sim.beast
	local t = sim.tMs
	local sp = Data.SPECIES[b.species]
	local face = Character.faceMood(sim)
	local v = {
		name = b.name,
		species = sp.title,
		stage = Body.stageWord(b.ageStage),
		face = face,
		mood = Character.MOOD_WORD[face],
		bubble = b.bubble,
		status = Home.statusIcon(home),
		needs = {
			satiety = Util.round(b.needs.satiety),
			energy = Util.round(b.needs.energy),
			joy = Util.round(b.needs.joy),
			bowel = Util.round(b.needs.bowel),
		},
		trust = Util.round(b.relations.owner.trust),
		doing = if b.current then Data.BEHAVIORS[b.current.behavior].label else nil,
		lastAct = Home.lastAct(home),
		hint = if sim.hint and sim.hint.untilRealMs > sim.realNowMs then sim.hint.text else nil,
		bowlFull = home.bowl.food,
		piles = #home.piles,
		spider = home.spider ~= nil,
		dirty = home.dirty,
		rain = home.weather.rain,
		inPen = home.pen ~= nil,
	}
	if full then
		local diary = {}
		for i = 1, math.min(12, #sim.diary) do
			local d = sim.diary[i]
			table.insert(diary, `{Journal.formatTime(d.tMs)} {d.text}`)
		end
		local habits = {}
		for _, r in Character.habitRows(sim) do
			table.insert(habits, { icon = r.icon, label = r.label, word = r.word, value = Util.round(r.value), good = r.good })
		end
		v.diary = diary
		v.character = Character.characterLines(sim)
		v.habits = habits
		v.story = Character.lastStory(sim)
		v.attributes = Body.attributes(b, t)
		v.traits = { appetite = Util.round(b.traits.appetite), bravery = Util.round(b.traits.bravery) }
		v.discipline = Util.round(b.discipline)
		v.obedience = Util.round(b.obedience)
		v.age = Journal.formatTime(b.ageMs or t)
	end
	return v
end

return Home
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Journal</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Дневник (для игрока), журнал (для тестов), всплывающие надписи, отметины и эмоции. Перенос journal.ts.

local IS_ROBLOX = typeof(script) == "Instance"
local CONFIG = if IS_ROBLOX then require(script.Parent.Config) else require("./Config")

local Journal = {}

function Journal.logEvent(sim, ev)
	ev.tMs = sim.tMs
	table.insert(sim.log, ev)
	local extra = #sim.log - CONFIG.logCap
	if extra > 0 then
		table.move(sim.log, extra + 1, #sim.log, 1)
		for i = #sim.log, #sim.log - extra + 1, -1 do
			sim.log[i] = nil
		end
	end
end

function Journal.addDiary(sim, text: string, kind: string)
	local id = sim.nextEventId
	sim.nextEventId += 1
	table.insert(sim.diary, 1, { id = id, tMs = sim.tMs, text = text, kind = kind })
	for i = #sim.diary, CONFIG.diaryCap + 1, -1 do
		sim.diary[i] = nil
	end
end

function Journal.addFloat(sim, x: number, y: number, text: string, color: string, ms: number?)
	local id = sim.nextEventId
	sim.nextEventId += 1
	table.insert(sim.floats, { id = id, x = x, y = y, text = text, color = color, untilMs = sim.tMs + (ms or 1500) })
	while #sim.floats > 20 do
		table.remove(sim.floats, 1)
	end
end

function Journal.hint(sim, text: string, ms: number?)
	sim.hint = { text = text, untilRealMs = sim.realNowMs + (ms or 2200) }
end

-- Отметины (Life Marks): постоянные записи о том, кем стал зверь.
function Journal.addMark(sim, mark: string, text: string)
	if table.find(sim.marks, mark) then
		return
	end
	table.insert(sim.marks, mark)
	Journal.addDiary(sim, `🏅 Новая отметина «{mark}»: {text}`, "mark")
	Journal.logEvent(sim, { kind = "state", note = "mark:" .. mark })
	Journal.hint(sim, "🏅 " .. mark, 3500)
end

-- Короткая эмоция на мордочке. Сильные (испуг, тошнота) не перебиваются слабыми.
local MOOD_RANK = { calm = 0, curious = 1, sleepy = 1, happy = 2, proud = 3, sad = 3, guilty = 3, hurt = 4, scared = 4, sick = 5 }

function Journal.setMood(sim, kind: string, ms: number?)
	local m = sim.beast.mood
	if m.untilMs > sim.tMs and MOOD_RANK[m.kind] > MOOD_RANK[kind] then
		return
	end
	sim.beast.mood = { kind = kind, untilMs = sim.tMs + (ms or CONFIG.reaction.moodMs) }
end

function Journal.formatTime(tMs: number): string
	local s = math.floor(tMs / 1000)
	local m = math.floor(s / 60)
	return string.format("%d:%02d", m, s % 60)
end

return Journal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Reactions</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Реакции хозяина: окно реакции, таблица «поступок × реакция», шанс повторения. Перенос reactions.ts.
-- Плюс новое (Alex, 2 октября): похвалить и отругать можно всегда, без таймера.
-- Если только что был поступок — меняется привычка; если нет — только настроение и доверие.

local IS_ROBLOX = typeof(script) == "Instance"
local function req(name)
	return if IS_ROBLOX then require(script.Parent[name]) else require("./" .. name)
end
local CONFIG = req("Config")
local Data = req("Data")
local Util = req("Util")
local Rng = req("Rng")
local Body = req("Body")
local Journal = req("Journal")
local Relations = req("Relations")
local Behaviors = req("Behaviors")

local clamp = Util.clamp
local BEHAVIORS = Data.BEHAVIORS
local R = CONFIG.reaction
local Reactions = {}

local function closeWindowMissed(sim)
	local w = sim.window
	sim.window = nil
	sim.stats.missed += 1
	Journal.logEvent(sim, { kind = "missed", behavior = w.behavior })
	Journal.addDiary(sim, `{sim.beast.name} {w.text} ({w.reason}). Ты не отреагировал.`, "missed")
end

-- Из чего выбирал зверь, когда решился на этот поступок (без шума).
local function choiceOf(sim, behavior: string)
	local rows = sim.lastScores
	if not rows or #rows < 2 or rows[1].behavior ~= behavior then
		return nil
	end
	local out = {}
	for _, r in rows do
		table.insert(out, { behavior = r.behavior, det = r.total - r.terms.noise })
	end
	return out
end

function Reactions.openWindow(sim, behavior: string, context: string, reason: string, text: string)
	if sim.window then
		closeWindowMissed(sim)
	end
	local id = sim.nextEventId
	sim.nextEventId += 1
	sim.window = {
		eventId = id,
		behavior = behavior,
		context = context,
		reason = reason,
		text = text,
		openedAtRealMs = sim.realNowMs,
		openedAtMs = sim.tMs,
		choice = choiceOf(sim, behavior),
	}
	sim.stats.notable += 1
	sim.stats.lastNotableMs = sim.tMs
	Journal.logEvent(sim, { kind = "notable", behavior = behavior, reason = reason, note = text })
end

-- Шанс, что в той же ситуации зверь снова выберет этот поступок (шум выбора — равномерный ±n).
function Reactions.repeatChance(choice, behavior: string, shift, samples: number?, n: number?): number
	samples = samples or 600
	n = n or CONFIG.utility.noise
	shift = shift or {}
	local rnd = Rng.stream(0x9e3779b9)
	local wins = 0
	for _ = 1, samples do
		local best, top = -math.huge, nil
		for _, c in choice do
			local v = c.det + (shift[c.behavior] or 0) + (rnd() * 2 - 1) * n
			if v > best then
				best = v
				top = c.behavior
			end
		end
		if top == behavior then
			wins += 1
		end
	end
	return wins / samples
end

function Reactions.updateWindow(sim)
	local w = sim.window
	if w and sim.realNowMs - w.openedAtRealMs >= R.windowRealMs then
		closeWindowMissed(sim)
	end
	if sim.hint and sim.realNowMs >= sim.hint.untilRealMs then
		sim.hint = nil
	end
end

local function emptyDelta()
	return { habits = {}, habitOrder = {}, appetite = 0, bravery = 0, obedience = 0, discipline = 0, joy = 0, satiety = 0, fear = 0, energy = 0, toyPlaySec = 0, hint = "", outcome = "" }
end

local function setHabit(d, k: string, v: number)
	if d.habits[k] == nil then
		table.insert(d.habitOrder, k)
	end
	d.habits[k] = v
end

-- Таблица «поступок × реакция». Общее правило + особые случаи.
function Reactions.reactionDelta(behavior: string, context: string, reaction: string, hungry: boolean)
	local d = emptyDelta()
	local info = BEHAVIORS[behavior]

	if reaction == "ignore" then
		d.hint = "ничего не изменилось"
		d.outcome = "Ты промолчал, привычка не изменилась."
		return d
	end

	-- Доделал работу.
	if behavior == "carry_stone" and context == "completed_work" then
		if reaction == "praise" then
			setHabit(d, "carry_stone", R.workPraiseHabit)
			d.obedience = R.workObedience
			d.hint = "запомнил: работать — хорошо"
			d.outcome = "Ты похвалил его. Теперь он охотнее берётся за работу."
		elseif reaction == "scold" then
			setHabit(d, "carry_stone", R.workScoldHabit)
			d.obedience = -R.workObedience
			d.hint = "обиделся, работать не хочет"
			d.outcome = "Ты отругал его за работу. Теперь он неохотно слушается."
		else
			setHabit(d, "carry_stone", R.habitGive)
			d.obedience = 1
			d.satiety = 15
			d.hint = "вкусная награда за работу"
			d.outcome = "Ты дал ему угощение за работу."
		end
		return d
	end

	-- Страх: ругать за страх — пугать сильнее, погладить — успокоить.
	if behavior == "flee_spider" or behavior == "sniff_spider" then
		local S = CONFIG.spider
		local flee = behavior == "flee_spider"
		if reaction == "praise" then
			setHabit(d, behavior, R.habitPraise)
			d.bravery = if flee then -R.traitStep else R.traitStep
			d.fear = if flee then S.reactPraiseFlee else S.reactPraiseSniff
			d.hint = if flee then "понял: пауков надо бояться" else "пауки не страшные!"
			d.outcome = if flee then "Ты похвалил его. Теперь он уверен, что от пауков надо убегать." else "Ты похвалил его. Пауки теперь кажутся ему не такими страшными."
		elseif reaction == "scold" then
			setHabit(d, behavior, R.habitScold)
			d.fear = if flee then S.reactScoldFlee else S.reactScoldSniff
			d.joy = if flee then -10 else 0
			d.hint = if flee then "испугался ещё сильнее" else "больше не подойдёт к паукам"
			d.outcome = if flee then "Ты отругал его за страх. От этого он боится только сильнее." else "Ты отругал его. Теперь он к паукам не подходит и побаивается их."
		else
			setHabit(d, behavior, R.habitGive)
			d.joy = R.giveJoy
			d.fear = if flee then S.reactGiveFlee else S.reactGiveSniff
			d.hint = "погладил — успокоился"
			d.outcome = if flee then "Ты его погладил. Он успокоился, и пауки стали чуть менее страшными." else "Ты его погладил. Он доволен собой."
		end
		return d
	end

	if behavior == "chase_butterfly" and context == "abandoned_work" then
		if reaction == "praise" then
			setHabit(d, "chase_butterfly", R.habitPraise)
			d.hint = "будет чаще бросать дела ради бабочек"
			d.outcome = "Ты похвалил его. Теперь он чаще будет бросать дела ради бабочек."
		elseif reaction == "scold" then
			setHabit(d, "chase_butterfly", R.habitScold)
			d.discipline = R.abandonScoldDiscipline
			d.hint = "реже отвлекается, чуть усидчивее"
			d.outcome = "Ты отругал его. Теперь он реже отвлекается и чуть усидчивее."
		else
			setHabit(d, "chase_butterfly", R.habitGive)
			d.joy = R.giveJoy
			d.hint = "порадовался, но работу бросил"
			d.outcome = "Ты дал ему поиграть. Он рад, но привык, что работу можно бросить."
		end
		return d
	end

	if behavior == "bring_toy" then
		local toy = CONFIG.toy
		if reaction == "give" then
			setHabit(d, "bring_toy", R.habitPraise)
			d.joy = toy.bringGiveJoy
			d.energy = toy.bringGiveEnergy
			d.toyPlaySec = toy.bringGiveSkillSec
			d.hint = "поиграл с ним — счастлив"
			d.outcome = "Ты бросил ему игрушку и поиграл с ним. Он счастлив и будет приносить её снова."
		elseif reaction == "praise" then
			setHabit(d, "bring_toy", R.habitPraise)
			d.joy = R.toyPraiseJoy
			d.hint = "будет чаще приносить игрушку"
			d.outcome = "Ты похвалил его. Он будет чаще приносить тебе игрушку."
		else
			setHabit(d, "bring_toy", R.habitScold)
			d.joy = toy.bringScoldJoy
			d.hint = "за что? грустит"
			d.outcome = "Ты отругал его. Он грустно унёс игрушку и будет реже её приносить."
		end
		return d
	end

	if reaction == "praise" then
		setHabit(d, behavior, R.habitPraise)
		if info.trait then
			d[info.trait] = info.traitSign * R.traitStep
		end
		if behavior == "play_toy" then
			d.joy = R.toyPraiseJoy
		end
		d.hint = if behavior == "hide_kennel" then "понял: в дождь — в будку" else "будет чаще " .. info.verb
		d.outcome = `Ты похвалил его. Теперь он чаще будет {info.verb}.`
	elseif reaction == "scold" then
		setHabit(d, behavior, R.habitScold)
		if info.trait then
			d[info.trait] = -info.traitSign * R.traitStep
		end
		if behavior == "pick_green" then
			setHabit(d, "wait_ripe", R.scoldGreenWaitBonus)
		end
		if behavior == "poop_here" then
			setHabit(d, "poop_toilet", R.scoldPoopToiletBonus)
		end
		if behavior == "play_toy" then
			d.joy = R.toyScoldJoy
		end
		d.hint = if behavior == "play_toy" then "за что? грустит" elseif behavior == "poop_here" then "понял: кучки — в туалет" elseif behavior == "play_puddle" then "понял: в лужу нельзя" else "будет реже " .. info.verb
		d.outcome = `Ты отругал его. Теперь он реже будет {info.verb}.`
	else
		-- «Дать желаемое»: закрывает потребность, привычка растёт слабо.
		setHabit(d, behavior, R.habitGive)
		if hungry or behavior == "beg_food" or behavior == "pick_green" or behavior == "eat_berry" then
			d.satiety = CONFIG.food.giveSatiety
			d.hint = "накормил — немного запомнил"
			d.outcome = "Ты дал ему еды. Голод прошёл, привычка почти не изменилась."
		else
			d.joy = R.giveJoy
			d.hint = "дал игрушку — порадовался"
			d.outcome = "Ты дал ему любимую игрушку. Он порадовался, привычка почти не изменилась."
		end
	end
	return d
end

function Reactions.pct(x: number): number
	return math.min(99, math.max(1, Util.round(x * 100)))
end

function Reactions.changeFear(sim, delta: number): number
	local b = sim.beast
	local before = b.fears.spider
	b.fears.spider = clamp(before + delta, 0, 100)
	if b.fears.spiderStart >= 40 and b.fears.spider < 10 then
		Journal.addMark(sim, "Победил страх", `{b.name} больше не боится пауков, хотя раньше боялся.`)
	end
	return b.fears.spider - before
end

local function shiftTrait(traits, key: string, v: number): number
	local before = traits[key]
	traits[key] = clamp(before + v, R.traitMin, R.traitMax)
	return traits[key] - before
end

-- Хозяин поиграл с принесённой игрушкой: бросил её подальше.
local function playTogether(sim, sec: number)
	local b = sim.beast
	local toy = Data.TOYS[b.favoriteToy]
	if toy.skill == "strength" then
		b.strength += toy.skillPerSec * sec
		Body.addMuscle(b, toy.skillPerSec * 0.15 * sec, "toy")
	else
		Body.practice(b, toy.skill, toy.skillPerSec * sec)
	end
	if toy.calm then
		b.fears.spider = math.max(0, b.fears.spider - toy.calm * sec)
	end
	for _, o in sim.objects do
		if table.find(o.tags, "toy") and table.find(o.tags, "favorite") then
			table.insert(sim.outbox, { type = "moved", objectId = o.id, pos = { x = 200 + ((sim.tMs / 7) % 500), y = 380 + ((sim.tMs / 13) % 120) } })
			break
		end
	end
	if b.current and b.current.behavior == "bring_toy" then
		b.current.phaseUntilMs = sim.tMs
	end
end

local REACTION_WORD = { praise = "👍", scold = "👎", give = "🎁", ignore = "⏭" }

function Reactions.applyReaction(sim, reaction: string)
	local w = sim.window
	if not w then
		return nil
	end
	sim.window = nil
	sim.lastReactedEventId = w.eventId
	local b = sim.beast
	local hungry = b.needs.satiety < 50
	local d = Reactions.reactionDelta(w.behavior, w.context, reaction, hungry)

	local logDelta = {}
	local habitShift = {}
	local shifted = false
	local soft = if sim.learnMode == "soft" then CONFIG.learning.soft else nil
	for _, k in d.habitOrder do
		local v0 = d.habits[k]
		local v = if soft then v0 * (if v0 > 0 then soft.praiseMul else soft.scoldMul) else v0
		local before = b.habits[k]
		b.habits[k] = clamp(before + v, R.habitMin, R.habitMax)
		habitShift[k] = b.habits[k] - before
		shifted = true
		logDelta["habit." .. k] = habitShift[k]
	end
	if d.appetite ~= 0 then
		logDelta.appetite = shiftTrait(b.traits, "appetite", d.appetite)
	end
	if d.bravery ~= 0 then
		logDelta.bravery = shiftTrait(b.traits, "bravery", d.bravery)
	end
	-- Последовательность: тот же ответ на тот же поступок учит слушаться, противоречивый — сбивает с толку.
	if reaction ~= "ignore" then
		local prev = sim.stats.last[w.behavior]
		local differentiates = sim.stats.reactions.scold >= 3
		if prev == reaction and (reaction == "scold" or differentiates) then
			d.obedience += R.consistentObedience
			d.discipline += R.consistentDiscipline
			sim.stats.consistent += 1
		elseif (prev == "praise" and reaction == "scold") or (prev == "scold" and reaction == "praise") then
			d.obedience -= R.contradictObedience
			sim.stats.contradicted += 1
			d.outcome ..= " Он растерялся: в прошлый раз за это было наоборот."
		end
		sim.stats.last[w.behavior] = reaction
	end
	if d.obedience ~= 0 then
		local before = b.obedience
		b.obedience = clamp(b.obedience + d.obedience, 0, 100)
		logDelta.obedience = b.obedience - before
	end
	if d.discipline ~= 0 then
		local before = b.discipline
		b.discipline = clamp(b.discipline + d.discipline, 0, 100)
		logDelta.discipline = b.discipline - before
	end
	if d.fear ~= 0 then
		logDelta.fearSpider = Reactions.changeFear(sim, d.fear)
	end
	if d.joy ~= 0 then
		b.needs.joy = clamp(b.needs.joy + d.joy, 0, 100)
	end
	if d.satiety ~= 0 then
		b.needs.satiety = clamp(b.needs.satiety + d.satiety, 0, 100)
	end
	if d.energy ~= 0 then
		b.needs.energy = clamp(b.needs.energy + d.energy, 0, 100)
	end
	if d.toyPlaySec ~= 0 then
		playTogether(sim, d.toyPlaySec)
	end

	if reaction == "give" and b.current and b.current.behavior == "beg_food" then
		b.current.phaseUntilMs = sim.tMs
	end

	if reaction == "praise" then
		Journal.setMood(sim, if w.behavior == "flee_spider" then "calm" else "proud")
	elseif reaction == "scold" then
		Journal.setMood(sim, if w.behavior == "flee_spider" then "scared" elseif w.behavior == "play_toy" or w.behavior == "bring_toy" then "sad" else "guilty")
	elseif reaction == "give" then
		Journal.setMood(sim, "happy")
	end

	sim.stats.reactions[reaction] += 1
	local RT = CONFIG.relations
	local trustDelta = ({ praise = RT.ownerPraise, give = RT.ownerGive, scold = RT.ownerScold, ignore = 0 })[reaction]
	if trustDelta ~= 0 then
		logDelta.trustOwner = Relations.changeTrust(sim, "owner", "хозяин", trustDelta)
	end
	Journal.logEvent(sim, { kind = "reaction", behavior = w.behavior, reaction = reaction, delta = logDelta })

	local result = { delta = d, habitShift = habitShift }
	if w.choice and reaction ~= "ignore" and shifted then
		local n = Behaviors.choiceNoise(sim)
		local before = Reactions.repeatChance(w.choice, w.behavior, {}, 600, n)
		local after = Reactions.repeatChance(w.choice, w.behavior, habitShift, 600, n)
		result.chance = { before = before, after = after }
		local pb, pa = Reactions.pct(before), Reactions.pct(after)
		if pa ~= pb then
			d.outcome ..= ` Шанс, что в такой же ситуации он снова будет {BEHAVIORS[w.behavior].verb}: был {pb}%, стал {pa}%.`
			d.hint = `{d.hint} · шанс {pb}% → {pa}%`
			sim.lastChance = { behavior = w.behavior, before = before, after = after, tMs = sim.tMs }
		end
	end

	local last = string.sub(w.reason, -1)
	local dot = if last == "!" or last == "?" then "" else "."
	Journal.addDiary(sim, `{REACTION_WORD[reaction]} {b.name} {w.text}, потому что {w.reason}{dot} {d.outcome}`, if reaction == "ignore" then "missed" else "reaction")
	sim.hint = { text = d.hint, untilRealMs = sim.realNowMs + R.hintRealMs }
	return result
end

-- Похвала или ругань без повода: сердечко или грусть, немного радости и доверия.
-- Частые подряд работают всё слабее, чтобы кнопку не жали без конца.
function Reactions.freeReact(sim, reaction: string)
	local b = sim.beast
	local F = CONFIG.free
	local last = sim.freeAtMs or -math.huge
	local mul = math.max(F.minMul, math.min(1, (sim.tMs - last) / F.decayMs))
	sim.freeAtMs = sim.tMs
	if reaction == "praise" then
		b.needs.joy = clamp(b.needs.joy + F.praiseJoy * mul, 0, 100)
		Relations.changeTrust(sim, "owner", "хозяин", F.praiseTrust * mul)
		Journal.setMood(sim, "happy", 1500)
		Journal.addFloat(sim, b.pos.x, b.pos.y - 44, if mul > 0.5 then "❤️" else "♡", "#d33", 1200)
	elseif reaction == "scold" then
		b.needs.joy = clamp(b.needs.joy + F.scoldJoy * mul, 0, 100)
		Relations.changeTrust(sim, "owner", "хозяин", F.scoldTrust * mul)
		Journal.setMood(sim, "sad", 2000)
		Journal.addFloat(sim, b.pos.x, b.pos.y - 44, "?", "#555", 1200)
		Journal.hint(sim, `{b.name} не понял, за что`, 2000)
	end
	Journal.logEvent(sim, { kind = "free", reaction = reaction, delta = { mul = mul } })
end

-- Единая кнопка: если окно поступка открыто — настоящая реакция, иначе — без повода.
function Reactions.react(sim, reaction: string)
	if sim.window then
		return Reactions.applyReaction(sim, reaction)
	end
	if reaction == "praise" or reaction == "scold" then
		Reactions.freeReact(sim, reaction)
	end
	return nil
end

-- ---------- Слова ----------

function Reactions.traitWords(axis: string, v: number): string
	if axis == "appetite" then
		if v >= 50 then
			return "очень прожорливый"
		elseif v >= 15 then
			return "прожорливый"
		elseif v <= -50 then
			return "очень умеренный"
		elseif v <= -15 then
			return "умеренный"
		end
		return "пока не определился с едой"
	end
	if v >= 50 then
		return "очень смелый"
	elseif v >= 15 then
		return "смелый"
	elseif v <= -50 then
		return "очень осторожный"
	elseif v <= -15 then
		return "осторожный"
	end
	return "пока не определился со смелостью"
end

function Reactions.disciplineWords(v: number): string
	if v < 25 then
		return "быстро отвлекается"
	elseif v < 50 then
		return "иногда доделывает"
	elseif v < 75 then
		return "довольно усидчивый"
	end
	return "очень усидчивый"
end

function Reactions.obedienceWords(v: number): string
	if v < 25 then
		return "почти не слушается"
	elseif v < 50 then
		return "слушается через раз"
	elseif v < 75 then
		return "обычно слушается"
	end
	return "очень послушный"
end

function Reactions.fearWord(f: number): string
	if f >= 70 then
		return "очень боится пауков"
	elseif f >= 40 then
		return "боится пауков"
	elseif f >= 15 then
		return "немного побаивается пауков"
	end
	return "пауков не боится"
end

return Reactions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Relations</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Память о людях. Перенос relations.ts. Зверь запоминает каждого по id (в Roblox — UserId):
-- кто кормил, кто играл, кто ругал. Гости не воспитывают привычки: это делает только хозяин.

local IS_ROBLOX = typeof(script) == "Instance"
local function req(name)
	return if IS_ROBLOX then require(script.Parent[name]) else require("./" .. name)
end
local CONFIG = req("Config")
local Util = req("Util")
local Journal = req("Journal")
local Food = req("Food")

local clamp = Util.clamp
local Relations = {}

function Relations.relationOf(sim, personId: string, name: string)
	local r = sim.beast.relations[personId]
	if not r then
		r = { name = name, trust = 0, fed = 0, played = 0, scolded = 0, visits = 0, lastSeenMs = sim.tMs }
		sim.beast.relations[personId] = r
		table.insert(sim.beast.relationOrder, personId)
	end
	return r
end

function Relations.changeTrust(sim, personId: string, name: string, delta: number): number
	local r = Relations.relationOf(sim, personId, name)
	local before = r.trust
	r.trust = clamp(r.trust + delta, -100, 100)
	r.lastSeenMs = sim.tMs
	return r.trust - before
end

-- Гость что-то сделал со зверем: act = feed | play | scold.
function Relations.personAct(sim, personId: string, name: string, act: string)
	local b = sim.beast
	local R = CONFIG.relations
	local r = Relations.relationOf(sim, personId, name)
	if act == "feed" then
		local before = b.needs.satiety
		Food.addSatiety(sim, R.treatSatiety, true)
		b.needs.joy = clamp(b.needs.joy + R.treatJoy, 0, 100)
		r.fed += 1
		Relations.changeTrust(sim, personId, name, R.feed)
		Journal.setMood(sim, "happy", 2500)
		Journal.addFloat(sim, b.pos.x, b.pos.y - 44, "ням! 🍪", "#a60")
		if not Food.afterMeal(sim, before, R.treatSatiety, "угощение от " .. name) then
			Journal.addDiary(sim, `🍪 {name} угостил(а) {b.name}. {b.name} это запомнил.`, "event")
		end
	elseif act == "play" then
		b.needs.joy = clamp(b.needs.joy + R.playJoy, 0, 100)
		b.needs.energy = clamp(b.needs.energy - 4, 0, 100)
		r.played += 1
		Relations.changeTrust(sim, personId, name, R.play)
		Journal.setMood(sim, "happy", 3000)
		Journal.addDiary(sim, `🧸 {name} поиграл(а) с {b.name}.`, "event")
	else
		b.needs.joy = clamp(b.needs.joy - 10, 0, 100)
		r.scolded += 1
		Relations.changeTrust(sim, personId, name, R.scold)
		Journal.setMood(sim, "scared", 3500)
		Journal.addDiary(sim, `😠 {name} накричал(а) на {b.name}. {b.name} это запомнил.`, "event")
	end
	Journal.logEvent(sim, { kind = "state", note = `person:{personId}:{act}`, delta = { trust = r.trust } })
end

function Relations.trustWord(t: number): string
	if t >= 50 then
		return "обожает"
	end
	if t >= 15 then
		return "любит"
	end
	if t > -15 then
		return "просто знакомы"
	end
	if t > -50 then
		return "сторонится"
	end
	return "боится"
end

return Relations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Случайность с сидом (mulberry32): те же числа, что в TypeScript при том же сиде.
-- Состояние лежит в самом зверином состоянии (sim.rng), поэтому сохранение не ломает повтор.

local Rng = {}

local function u32(x: number): number
	return x % 4294967296
end

-- Нижние 32 бита произведения (Math.imul).
local function imul(a: number, b: number): number
	local ah, al = bit32.rshift(a, 16), bit32.band(a, 0xffff)
	local bh, bl = bit32.rshift(b, 16), bit32.band(b, 0xffff)
	local mid = bit32.band(ah * bl + al * bh, 0xffff)
	return u32(al * bl + mid * 65536)
end

-- sim.rng хранится как в JS (знаковое 32-битное); внутри считаем беззнаково.
local function toSigned(x: number): number
	return if x >= 2147483648 then x - 4294967296 else x
end

function Rng.next(state: { rng: number }): number
	local r = u32(u32(state.rng) + 0x6d2b79f5)
	state.rng = toSigned(r)
	local t = r
	t = imul(bit32.bxor(t, bit32.rshift(t, 15)), bit32.bor(t, 1))
	t = bit32.bxor(t, u32(t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(t, 61))))
	return bit32.bxor(t, bit32.rshift(t, 14)) / 4294967296
end

function Rng.range(state: { rng: number }, lo: number, hi: number): number
	return lo + (hi - lo) * Rng.next(state)
end

-- Отдельный генератор для оценки шанса повторения (не трогает sim.rng).
function Rng.stream(seed: number): () -> number
	local s = { rng = seed }
	return function()
		return Rng.next(s)
	end
end

-- seed | 0 из JS
function Rng.toInt32(x: number): number
	return toSigned(u32(math.floor(x)))
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Stand</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Стенд воспитания: маленький «дом» зверя (миска, лежанка, туалет, игрушка, колючки, ягоды, грядки,
-- бабочка, паук, стройка будки, гости). Перенос beast_lab/src/lab/stand.ts один в один.
-- Нужен для сверки с вебом (tests/beast_*) и как основа «дома» на участке в Roblox.

local IS_ROBLOX = typeof(script) == "Instance"
local function req(name)
	return if IS_ROBLOX then require(script.Parent[name]) else require("./" .. name)
end
local Beast = req("Beast")
local CONFIG = Beast.CONFIG
local Journal = Beast.Journal
local Rng = Beast.Rng
local Data = Beast.Data
local Relations = Beast.Relations
local Reactions = Beast.Reactions

local Stand = {}

local function V(x, y)
	return { x = x, y = y }
end

local STAND = {
	width = 900,
	height = 560,
	player = V(80, 290),
	bowl = V(210, 140),
	bed = V(780, 110),
	toilet = V(830, 480),
	toyStart = V(330, 440),
	thorns = V(170, 470),
	wolfberry = V(770, 370),
	raspberry = V(440, 120),
	stones = V(380, 520),
	site = V(580, 480),
	plots = { V(480, 235), V(590, 235), V(700, 235) },
	carrot = { greenAtMs = 12000, growMs = 100000 },
	bowlRefillMs = 70000,
	berryRegrowMs = 60000,
	butterfly = { lifeMs = 15000, spawnMinMs = 30000, spawnMaxMs = 60000, speed = 45, firstAtMs = 20000 },
	spider = { firstAtMs = 70000, everyMinMs = 60000, everyMaxMs = 110000, lifeMs = 45000 },
	build = { totalMs = 90000, perStoneMs = 12000 },
	visitor = { pos = V(120, 420), stayMs = 40000 },
}
Stand.STAND = STAND

Stand.VISITORS = {
	masha = { name = "Маша", icon = "👧" },
	petya = { name = "Петя", icon = "👦" },
}

local BERRIES = { "wolfberry", "raspberry" }

function Stand.create(seed: number, species: string?, name: string?, toy: string?)
	local sim = Beast.create(seed, species or "bear", name, toy)
	local plots = {}
	for i, p in STAND.plots do
		plots[i] = { id = `plot{i}`, pos = V(p.x, p.y), plantedAtMs = if i == 1 then -40000 elseif i == 2 then 0 else nil, ripe = false }
	end
	local stand = {
		plots = plots,
		bowl = { food = true, refillAtMs = 0 },
		berries = { wolfberry = { ripe = true, regrowAtMs = 0 }, raspberry = { ripe = true, regrowAtMs = 0 } },
		toy = V(STAND.toyStart.x, STAND.toyStart.y),
		butterfly = { active = false, x = 0, y = 0, vx = 0, vy = 0, untilMs = 0, nextAtMs = STAND.butterfly.firstAtMs },
		spider = nil,
		spiderNextAtMs = STAND.spider.firstAtMs,
		site = nil,
		built = 0,
		piles = {},
		auto = { bowl = true, butterfly = true, spider = true },
		harvest = { collected = 0, lostGreen = 0, eatenRipe = 0 },
		visitor = nil,
		nextId = 1,
	}
	local lab = { sim = sim, stand = stand, stepAccMs = 0 }
	Stand.syncObjects(lab)
	return lab
end

-- ---------- Объекты с метками ----------

function Stand.objects(lab)
	local s = lab.stand
	local t = lab.sim.tMs
	local out = {}
	local function add(o)
		o.owner = "lab"
		table.insert(out, o)
	end
	add({ id = "player", label = "хозяин", icon = "🧑‍🌾", pos = STAND.player, tags = { "player" } })
	add({
		id = "bowl",
		label = if s.bowl.food then "миска, есть корм" else "миска, пустая",
		icon = "🥣",
		pos = STAND.bowl,
		tags = if s.bowl.food then { "bowl", "food", "item:feed" } else { "bowl" },
	})
	add({ id = "bed", label = "лежанка", icon = "🛏", pos = STAND.bed, tags = { "bed" } })
	add({ id = "toilet", label = "туалет", icon = "🚽", pos = STAND.toilet, tags = { "toilet" } })
	local toy = Data.TOYS[lab.sim.beast.favoriteToy]
	add({ id = "toy", label = `{toy.name}, любимая игрушка`, icon = toy.icon, pos = s.toy, tags = { "toy", "favorite", `kind:{toy.id}` } })
	add({ id = "thorns", label = "куст, колючий", icon = "🌵", pos = STAND.thorns, tags = { "thorny", "kind:thorns" } })
	for _, k in BERRIES do
		if not s.berries[k].ripe then
			continue
		end
		-- Ядовитые от съедобных снаружи не отличить: метки одни и те же.
		add({
			id = k,
			label = if k == "wolfberry" then "ягоды, тёмные" else "ягоды, красные",
			icon = if k == "wolfberry" then "🫐" else "🍒",
			pos = STAND[k],
			tags = { "food", "berry", `kind:{k}` },
		})
	end
	for _, p in s.plots do
		if p.plantedAtMs == nil then
			add({ id = p.id, label = "грядка, пустая", icon = "🟫", pos = p.pos, tags = { "plot" } })
			continue
		end
		local age = t - p.plantedAtMs
		if p.ripe or age >= STAND.carrot.growMs then
			add({ id = p.id, label = "морковь, спелая", icon = "🥕", pos = p.pos, tags = { "plot", "crop:carrot", "food", "ripe" }, value = 4 })
		elseif age >= STAND.carrot.greenAtMs then
			add({
				id = p.id,
				label = "морковь, зелёная",
				icon = "🌿",
				pos = p.pos,
				tags = { "plot", "crop:carrot", "food", "unripe" },
				value = 4,
				ripeInMs = STAND.carrot.growMs - age,
			})
		else
			add({ id = p.id, label = "морковь, росток", icon = "🌱", pos = p.pos, tags = { "plot", "crop:carrot", "seedling" } })
		end
	end
	if s.butterfly.active then
		add({ id = "butterfly", label = "бабочка", icon = "🦋", pos = V(s.butterfly.x, s.butterfly.y), tags = { "critter", "moving", "kind:butterfly" } })
	end
	if s.spider then
		add({ id = s.spider.id, label = "паук", icon = "🕷", pos = V(s.spider.x, s.spider.y), tags = { "critter", "creepy", "kind:spider" } })
	end
	if s.site then
		add({ id = "stones", label = "камни", icon = "🪨", pos = STAND.stones, tags = { "stones" } })
		add({ id = "construction", label = "стройка, будка", icon = "🏗", pos = STAND.site, tags = { "construction", "building:doghouse" } })
	end
	if s.visitor then
		local v = Stand.VISITORS[s.visitor.pid]
		add({ id = s.visitor.id, label = v.name, icon = v.icon, pos = STAND.visitor.pos, tags = { "visitor", `person:{s.visitor.pid}` } })
	end
	for _, p in s.piles do
		add({ id = p.id, label = if p.watery then "кучка, жидкая" else "кучка", icon = "💩", pos = V(p.x, p.y), tags = { "mess" } })
	end
	return out
end

function Stand.syncObjects(lab)
	lab.sim.objects = Stand.objects(lab)
end

-- ---------- Цикл ----------

local consumeEvents, updateStand

function Stand.tick(lab, gameDtMs: number, realNowMs: number)
	lab.sim.realNowMs = realNowMs
	lab.stepAccMs += gameDtMs
	while lab.stepAccMs >= CONFIG.stepMs do
		lab.stepAccMs -= CONFIG.stepMs
		Stand.step(lab, CONFIG.stepMs)
	end
	Reactions.updateWindow(lab.sim)
end

function Stand.step(lab, dtMs: number)
	updateStand(lab, dtMs)
	Stand.syncObjects(lab)
	Beast.step(lab.sim, dtMs)
	consumeEvents(lab)
end

local function finishBuild(lab)
	local s = lab.stand
	s.site = nil
	s.built += 1
	Journal.addDiary(lab.sim, "🏠 Будка построена.", "event")
	Journal.hint(lab.sim, "🏠 Будка построена", 3000)
end

function Stand.spawnButterfly(lab)
	local bf = lab.stand.butterfly
	local sim = lab.sim
	local a = Rng.next(sim) * math.pi * 2
	bf.active = true
	bf.x = Rng.range(sim, 200, 700)
	bf.y = Rng.range(sim, 120, 420)
	bf.vx = math.cos(a) * STAND.butterfly.speed
	bf.vy = math.sin(a) * STAND.butterfly.speed
	bf.untilMs = sim.tMs + STAND.butterfly.lifeMs
end

local SPIDER_SPOTS = { "bowl", "bed", "toilet", "toyStart" }

function Stand.spawnSpider(lab, at)
	local s = lab.stand
	local sim = lab.sim
	local key = SPIDER_SPOTS[math.floor(Rng.next(sim) * #SPIDER_SPOTS) + 1]
	local spot = STAND[key]
	local p = at
	if not p then
		p = if key == "toyStart" then V(s.toy.x + 36, s.toy.y - 10) else V(spot.x + 36, spot.y + 12)
	end
	s.spider = { id = `spider{s.nextId}`, x = p.x, y = p.y, untilMs = sim.tMs + STAND.spider.lifeMs }
	s.nextId += 1
end

function updateStand(lab, dtMs: number)
	local s = lab.stand
	local sim = lab.sim
	local t = sim.tMs + dtMs -- время, в которое зверь сделает этот шаг
	if not s.bowl.food and s.auto.bowl and s.bowl.refillAtMs ~= 0 and t >= s.bowl.refillAtMs then
		s.bowl.food = true
	end
	for _, k in BERRIES do
		if not s.berries[k].ripe and t >= s.berries[k].regrowAtMs then
			s.berries[k].ripe = true
		end
	end
	for _, p in s.plots do
		if p.plantedAtMs ~= nil and not p.ripe and t - p.plantedAtMs >= STAND.carrot.growMs then
			p.ripe = true
		end
	end

	-- Бабочка.
	local bf = s.butterfly
	local B = STAND.butterfly
	if bf.active then
		bf.x += (bf.vx * dtMs) / 1000
		bf.y += (bf.vy * dtMs) / 1000
		if bf.x < 40 or bf.x > STAND.width - 40 then
			bf.vx *= -1
		end
		if bf.y < 60 or bf.y > STAND.height - 40 then
			bf.vy *= -1
		end
		if Rng.next(sim) < 0.05 then
			local a = Rng.next(sim) * math.pi * 2
			bf.vx = math.cos(a) * B.speed
			bf.vy = math.sin(a) * B.speed
		end
		if t >= bf.untilMs then
			bf.active = false
			bf.nextAtMs = t + Rng.range(sim, B.spawnMinMs, B.spawnMaxMs)
		end
	elseif s.auto.butterfly and t >= bf.nextAtMs then
		Stand.spawnButterfly(lab)
	end

	-- Паук.
	if s.spider and t >= s.spider.untilMs then
		s.spider = nil
		s.spiderNextAtMs = t + Rng.range(sim, STAND.spider.everyMinMs, STAND.spider.everyMaxMs)
	elseif not s.spider and s.auto.spider and t >= s.spiderNextAtMs then
		Stand.spawnSpider(lab)
	end

	if s.visitor and t >= s.visitor.untilMs then
		s.visitor = nil
	end

	-- Стройка идёт по таймеру сама; камни зверя её ускоряют.
	if s.site then
		s.site.remainingMs -= dtMs
		if s.site.remainingMs <= 0 then
			finishBuild(lab)
		end
	end
end

local function clampPos(p)
	return V(math.min(STAND.width - 40, math.max(40, p.x)), math.min(STAND.height - 40, math.max(70, p.y)))
end

local function findPlot(s, id)
	for _, p in s.plots do
		if p.id == id then
			return p
		end
	end
	return nil
end

function consumeEvents(lab)
	local s = lab.stand
	local sim = lab.sim
	for _, e in sim.outbox do
		if e.type == "ate" then
			if e.objectId == "bowl" then
				s.bowl.food = false
				s.bowl.refillAtMs = sim.tMs + STAND.bowlRefillMs
			elseif e.objectId == "wolfberry" or e.objectId == "raspberry" then
				s.berries[e.objectId] = { ripe = false, regrowAtMs = sim.tMs + STAND.berryRegrowMs }
			else
				local p = findPlot(s, e.objectId)
				if p then
					if table.find(e.tags, "unripe") then
						s.harvest.lostGreen += 1
						Journal.addFloat(sim, p.pos.x, p.pos.y - 30, "−1 урожай", "#b33", 1800)
					else
						s.harvest.eatenRipe += 1
					end
					p.plantedAtMs = nil
					p.ripe = false
				end
			end
		elseif e.type == "moved" then
			if e.objectId == "toy" then
				s.toy = clampPos(e.pos)
			end
		elseif e.type == "carried" then
			if s.site then
				s.site.remainingMs -= STAND.build.perStoneMs
				Journal.addFloat(sim, STAND.site.x, STAND.site.y - 40, `🔨 −{STAND.build.perStoneMs / 1000} с`, "#a60", 1000)
				if s.site.remainingMs <= 0 then
					finishBuild(lab)
				end
			end
		elseif e.type == "pooped" then
			if e.where == "here" then
				table.insert(s.piles, { id = `pile{s.nextId}`, x = e.pos.x, y = e.pos.y, watery = e.watery })
				s.nextId += 1
			end
		elseif e.type == "sniffed" then
			if s.spider and s.spider.id == e.objectId then
				s.spider = nil
				s.spiderNextAtMs = sim.tMs + Rng.range(sim, STAND.spider.everyMinMs, STAND.spider.everyMaxMs)
			end
		end
	end
	table.clear(sim.outbox)
end

-- ---------- Ввод ----------

function Stand.input(lab, input, realNowMs: number)
	local s = lab.stand
	local sim = lab.sim
	sim.realNowMs = realNowMs
	local t = sim.tMs
	local ty = input.type
	if ty == "fill_bowl" then
		s.bowl.food = true
	elseif ty == "plant" then
		local p = findPlot(s, input.plotId)
		if p and p.plantedAtMs == nil then
			p.plantedAtMs = t
		end
	elseif ty == "harvest" then
		local p = findPlot(s, input.plotId)
		if p and p.plantedAtMs ~= nil and (p.ripe or t - p.plantedAtMs >= STAND.carrot.growMs) then
			p.plantedAtMs = nil
			p.ripe = false
			s.harvest.collected += 1
			Journal.addFloat(sim, p.pos.x, p.pos.y - 30, "+1 🥕", "#2a7", 1200)
		end
	elseif ty == "grow" then
		local p = findPlot(s, input.plotId)
		if p then
			p.plantedAtMs = if input.to == "green" then t - STAND.carrot.growMs + 30000 else t - STAND.carrot.growMs
			p.ripe = input.to == "ripe"
		end
	elseif ty == "spawn_butterfly" then
		Stand.spawnButterfly(lab)
	elseif ty == "spawn_spider" then
		Stand.spawnSpider(lab)
	elseif ty == "shoo_spider" then
		if s.spider then
			Journal.addFloat(sim, s.spider.x, s.spider.y - 20, "кыш!", "#555")
			s.spider = nil
			s.spiderNextAtMs = t + Rng.range(sim, STAND.spider.everyMinMs, STAND.spider.everyMaxMs)
		end
	elseif ty == "start_build" then
		if not s.site then
			s.site = { remainingMs = STAND.build.totalMs, totalMs = STAND.build.totalMs }
		end
	elseif ty == "clean_pile" then
		for i = #s.piles, 1, -1 do
			if s.piles[i].id == input.pileId then
				table.remove(s.piles, i)
			end
		end
	elseif ty == "auto" then
		s.auto[input.key] = input.value
	elseif ty == "visitor_come" then
		-- Каждый приход — новый визит (новый id объекта), чтобы зверь решал заново.
		s.visitor = { pid = input.pid, id = `visitor{s.nextId}`, untilMs = t + STAND.visitor.stayMs }
		s.nextId += 1
	elseif ty == "visitor_act" then
		if s.visitor then
			Relations.personAct(sim, s.visitor.pid, Stand.VISITORS[s.visitor.pid].name, input.act)
			s.visitor.untilMs = math.max(s.visitor.untilMs, t + 10000)
		end
	elseif ty == "visitor_leave" then
		s.visitor = nil
	else
		Stand.syncObjects(lab)
		Beast.input(sim, input, realNowMs)
		consumeEvents(lab)
		return
	end
	Stand.syncObjects(lab)
end

-- ---------- Офлайн ----------

-- Пока хозяина нет: зверь спит в лежанке и сыт до безопасного уровня, морковь подрастает, стройка идёт.
-- Игровое время зверя не идёт: без хозяина он не взрослеет и не меняет привычки.
-- Перенос offlineCatchUp из beast_lab/src/lab/save.ts.
function Stand.offlineCatchUp(lab, awayMs: number)
	local O = CONFIG.offline
	if awayMs < O.minMs then
		return nil
	end
	local ms = math.min(awayMs, O.maxMs)
	local b = lab.sim.beast
	local s = lab.stand
	local lines = {}
	b.needs.energy = 100
	b.needs.satiety = math.max(b.needs.satiety, O.satietyFloor)
	b.needs.bowel = math.min(b.needs.bowel, 40)
	b.hp = b.maxHp
	b.states = { upsetUntilMs = 0, ouchUntilMs = 0, overateUntilMs = 0, poisonedUntilMs = 0, diarrheaUntilMs = 0, refusedUntilMs = 0 }
	b.current = nil
	b.pos = V(STAND.bed.x - 50, STAND.bed.y + 30)
	table.insert(lines, `{b.name} выспался и ждёт тебя.`)
	local ripened = 0
	for _, p in s.plots do
		if p.plantedAtMs == nil or p.ripe then
			continue
		end
		-- Сдвигаем посадку в прошлое: офлайн-время тоже растило морковь.
		p.plantedAtMs -= ms
		if lab.sim.tMs - p.plantedAtMs >= STAND.carrot.growMs then
			p.ripe = true
			ripened += 1
		end
	end
	if ripened ~= 0 then
		table.insert(lines, `Созрело моркови: {ripened}.`)
	end
	if s.site then
		s.site.remainingMs -= ms
		if s.site.remainingMs <= 0 then
			s.site = nil
			s.built += 1
			table.insert(lines, "Будка достроилась.")
		end
	end
	if not s.bowl.food and s.auto.bowl then
		s.bowl.food = true
	end
	s.spider = nil
	Journal.addDiary(lab.sim, `Пока тебя не было ({Beast.Util.round(ms / 60000)} мин): {table.concat(lines, " ")}`, "event")
	Stand.syncObjects(lab)
	return { awayMs = awayMs, lines = lines }
end

return Stand
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Util</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Мелкие помощники, чтобы Luau считал и писал ровно как TypeScript-версия (beast_lab).

local Util = {}

function Util.clamp(v: number, lo: number, hi: number): number
	return math.min(hi, math.max(lo, v))
end

-- Math.round из JS: половинки всегда вверх (−2,5 → −2).
function Util.round(x: number): number
	return math.floor(x + 0.5)
end

-- Math.hypot ровно как в V8 (деление на максимум и сумма с поправкой Кэхэна),
-- чтобы расстояния совпадали с веб-версией до последнего бита.
function Util.hypot(dx: number, dy: number): number
	local a, b = math.abs(dx), math.abs(dy)
	local max = math.max(a, b)
	if max == 0 then
		return 0
	end
	local sum, comp = 0, 0
	for _, v in { a, b } do
		local n = v / max
		local summand = n * n - comp
		local pre = sum + summand
		comp = (pre - sum) - summand
		sum = pre
	end
	return math.sqrt(sum) * max
end

-- Number.prototype.toFixed: при точной половинке (в двоичном значении) выбирается большее по модулю,
-- а printf округлял бы к чётному. Точность проверяем по полной десятичной записи числа.
function Util.fixed(x: number, n: number): string
	local neg = x < 0
	local a = math.abs(x)
	local s = string.format("%." .. n .. "f", a)
	local exact = string.format("%.60f", a)
	local dot = string.find(exact, ".", 1, true)
	local tail = string.sub(exact, dot + n + 1)
	if string.sub(tail, 1, 1) == "5" and not string.find(tail, "[1-9]", 2) then
		s = string.format("%." .. n .. "f", a + 0.5 * 10 ^ -n)
	end
	if neg and tonumber(s) ~= 0 then
		s = "-" .. s
	end
	return s
end

function Util.startsWith(s: string, p: string): boolean
	return string.sub(s, 1, #p) == p
end

function Util.includes(list: { any }, v: any): boolean
	return table.find(list, v) ~= nil
end

function Util.hasAll(tags: { string }, need: { string }): boolean
	for _, t in need do
		if not table.find(tags, t) then
			return false
		end
	end
	return true
end

function Util.hasAny(tags: { string }, any: { string }): boolean
	for _, t in any do
		if table.find(tags, t) then
			return true
		end
	end
	return false
end

-- Устойчивая сортировка (как Array.prototype.sort в JS): равные остаются в прежнем порядке.
function Util.stableSort(list: { any }, less: (any, any) -> boolean)
	local idx = {}
	for i, v in list do
		idx[v] = i
	end
	-- Обёртки, чтобы одинаковые значения (числа, строки) тоже различались.
	local wrapped = {}
	for i, v in list do
		wrapped[i] = { v = v, i = i }
	end
	table.sort(wrapped, function(a, b)
		if less(a.v, b.v) then
			return true
		end
		if less(b.v, a.v) then
			return false
		end
		return a.i < b.i
	end)
	for i, w in wrapped do
		list[i] = w.v
	end
end

-- Первая буква заглавная (кириллица тоже).
function Util.capital(s: string): string
	if s == "" then
		return s
	end
	local first = utf8.codepoint(s, 1)
	local up = first
	if first >= 0x430 and first <= 0x44F then
		up = first - 0x20
	elseif first == 0x451 then
		up = 0x401
	elseif first >= 97 and first <= 122 then
		up = first - 32
	end
	local rest = string.sub(s, utf8.offset(s, 2) or (#s + 1))
	return utf8.char(up) .. rest
end

-- Все буквы строчные (кириллица тоже).
function Util.lower(s: string): string
	local out = {}
	for _, c in utf8.codes(s) do
		if c >= 0x410 and c <= 0x42F then
			c += 0x20
		elseif c == 0x401 then
			c = 0x451
		elseif c >= 65 and c <= 90 then
			c += 32
		end
		table.insert(out, utf8.char(c))
	end
	return table.concat(out)
end

-- «а, б и в»
function Util.list(xs: { string }): string
	if #xs <= 1 then
		return table.concat(xs, "")
	end
	return table.concat(xs, ", ", 1, #xs - 1) .. " и " .. xs[#xs]
end

-- Обрезка по символам, а не по байтам (кличка).
function Util.utf8Sub(s: string, n: number): string
	local out, i = {}, 0
	for _, c in utf8.codes(s) do
		i += 1
		if i > n then
			break
		end
		table.insert(out, utf8.char(c))
	end
	return table.concat(out)
end

function Util.trim(s: string): string
	return (string.gsub(s, "^%s*(.-)%s*$", "%1"))
end

function Util.copy(t: any): any
	if type(t) ~= "table" then
		return t
	end
	local o = {}
	for k, v in t do
		o[k] = Util.copy(v)
	end
	return o
end

function Util.sign(x: number): number
	return if x > 0 then 1 elseif x < 0 then -1 else 0
end

return Util
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="22">
