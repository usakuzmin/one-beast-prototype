        <Properties>
          <string name="Name">Beast</string>
        </Properties>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Beast</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Жизнь зверя по шагам: потребности, выбор поступка, выполнение, рост, команды хозяина.
-- Перенос beast_lab/src/beast/beast.ts один в один (сверка: tests/beast_run.luau).
--
-- Наружу: Beast.create, Beast.step и Beast.input. Мир вокруг (стенд или ферма) перед каждым шагом
-- кладёт объекты в sim.objects, а после шага забирает события из sim.outbox.
-- Модуль не трогает Roblox API: его гоняют тесты в Lune, а на сервере он живёт как ModuleScript.

local IS_ROBLOX = typeof(script) == "Instance"
local function req(name)
	return if IS_ROBLOX then require(script.Parent[name]) else require("./" .. name)
end
local CONFIG = req("Config")
local Data = req("Data")
local Util = req("Util")
local Rng = req("Rng")
local Body = req("Body")
local Journal = req("Journal")
local Behaviors = req("Behaviors")
local Food = req("Food")
local Relations = req("Relations")
local Reactions = req("Reactions")
local Character = req("Character")

local clamp = Util.clamp
local SPECIES = Data.SPECIES
local TOYS = Data.TOYS
local BEHAVIORS = Data.BEHAVIORS
local nearest = Behaviors.nearest
local objectById = Behaviors.objectById
local dist = Behaviors.dist
local addDiary, addFloat, setMood, hint = Journal.addDiary, Journal.addFloat, Journal.setMood, Journal.hint

local Beast = {}

-- Модули наружу, чтобы сервер и тесты брали всё из одного места.
Beast.CONFIG = CONFIG
Beast.Data = Data
Beast.Body = Body
Beast.Journal = Journal
Beast.Behaviors = Behaviors
Beast.Food = Food
Beast.Relations = Relations
Beast.Reactions = Reactions
Beast.Util = Util
Beast.Character = Character
Beast.Rng = Rng

local function takePortrait(sim, title: string, note: string?)
	local b = sim.beast
	table.insert(sim.album, {
		tMs = sim.tMs,
		title = title,
		stage = b.ageStage,
		height = Util.round(b.body.height),
		weight = Util.round(Body.weightOf(b) * 10) / 10,
		fat = Body.fatRatio(b),
		muscle = Body.muscleRatio(b),
		note = note,
	})
	if #sim.album > 30 then
		table.remove(sim.album, 2)
	end
end
Beast.takePortrait = takePortrait

function Beast.create(seed: number, species: string?, name: string?, toy: string?)
	species = species or "bear"
	local sp = SPECIES[species]
	local s = sp.start
	local habits = {}
	for _, a in CONFIG.ALL_BEHAVIORS do
		habits[a] = (sp.startHabits and sp.startHabits[a]) or 0
	end
	local beast = {
		species = species,
		name = name or sp.defaultName,
		ageStage = "infant",
		ageMs = 0,
		pos = { x = 420, y = 300 },
		face = 1,
		needs = { satiety = 70, energy = 80, joy = 60, bowel = 30 },
		hp = s.hp,
		maxHp = s.hp,
		traits = { appetite = s.appetite, bravery = s.bravery },
		habits = habits,
		obedience = s.obedience,
		discipline = s.discipline,
		strength = s.strength,
		body = { height = sp.stage.infant.height, baseMass = sp.stage.infant.baseMass, muscleMass = s.muscleMass, fatMass = s.fatMass },
		bodyStory = Body.emptyStory(),
		favoriteToy = toy or sp.toys[(math.abs(seed) % #sp.toys) + 1],
		current = nil,
		bubble = "",
		mood = { kind = "calm", untilMs = 0 },
		states = { upsetUntilMs = 0, ouchUntilMs = 0, overateUntilMs = 0, poisonedUntilMs = 0, diarrheaUntilMs = 0, refusedUntilMs = 0 },
		timers = { begReadyAtMs = 0, bringReadyAtMs = CONFIG.toy.bringFirstAtMs, thornsReadyAtMs = CONFIG.thorns.firstAtMs },
		metIds = {},
		tastes = {},
		tasteOrder = {},
		relations = { owner = { name = "хозяин", trust = 20, fed = 0, played = 0, scolded = 0, visits = 0, lastSeenMs = 0 } },
		relationOrder = { "owner" },
		toxinExposure = 0,
		fears = { spider = sp.fearSpider, spiderStart = sp.fearSpider },
		training = table.clone(sp.training),
		practice = { stoneCarries = 0, completedTasks = 0, abandonedTasks = 0, toiletUses = 0, poisonings = 0, diarrheas = 0, greenPicked = 0 },
	}
	local sim = {
		saveVersion = CONFIG.saveVersion,
		seed = seed,
		rng = Rng.toInt32(seed),
		tMs = 0,
		realNowMs = 0,
		nextEventId = 1,
		beast = beast,
		objects = {},
		outbox = {},
		window = nil,
		learnMode = "default",
		hint = nil,
		floats = {},
		diary = {},
		log = {},
		marks = {},
		album = {},
		lastScores = {},
		counters = {},
		stats = { notable = 0, missed = 0, reactions = { praise = 0, scold = 0, give = 0, ignore = 0 }, last = {}, consistent = 0, contradicted = 0, commands = { given = 0, obeyed = 0 }, lastNotableMs = 0 },
	}
	takePortrait(sim, "Появился на свет")
	addDiary(sim, `Появился {beast.name} ({Util.lower(sp.title)})! Совсем малыш: {beast.body.height} см, {Util.fixed(Body.weightOf(beast), 1)} кг.`, "event")
	return sim
end

-- ---------- Мелочи ----------

local function endBehavior(sim)
	sim.beast.current = nil
end

local function notable(sim, behavior: string, context: string, reason: string, text: string?)
	Reactions.openWindow(sim, behavior, context, reason, text or BEHAVIORS[behavior].did)
end

local function meet(sim, id: string)
	local m = sim.beast.metIds
	table.insert(m, id)
	while #m > 20 do
		table.remove(m, 1)
	end
end

local function startBehavior(sim, behavior: string, target, objectId: string?, reason: string, byCommand: boolean, context: string?)
	context = context or "normal"
	local t = sim.tMs
	sim.beast.current = {
		behavior = behavior,
		reason = reason,
		startedAtMs = t,
		phase = "moving",
		target = Behaviors.clampToWorld(target, sim.bounds),
		objectId = objectId,
		phaseUntilMs = 0,
		byCommand = byCommand,
		carrying = false,
		stonesDone = 0,
		workStartedAtMs = t,
		nextDistractCheckMs = 0,
		context = context,
	}
	local c = sim.beast.current
	if behavior == "chase_butterfly" then
		c.phaseUntilMs = t + CONFIG.chase.durationMs
	end
	sim.counters[behavior] = (sim.counters[behavior] or 0) + 1
	Journal.logEvent(sim, { kind = "start", behavior = behavior, reason = reason, note = if context ~= "normal" then context else nil })
	if behavior == "chase_butterfly" then
		if context == "abandoned_work" then
			notable(sim, "chase_butterfly", "abandoned_work", reason, "бросил камни и погнался за бабочкой")
		elseif not byCommand then
			notable(sim, "chase_butterfly", "normal", reason)
		end
	end
	if behavior == "flee_spider" then
		setMood(sim, "scared", 3000)
	end
	if behavior == "sniff_spider" or behavior == "approach_thorns" then
		setMood(sim, "curious", 2500)
	end
end

-- ---------- Взросление ----------

local function growUp(sim, stage: string)
	local b = sim.beast
	local h0 = b.body.height
	local w0 = Body.weightOf(b)
	local g = Body.growthFactor(b)
	Body.applyStage(b, stage)
	local typical = SPECIES[b.species].stage[stage].height
	local st = Body.story(b)
	local carry = (st.heightBonus * 0.5) / typical
	b.body.height = math.max(h0, typical * (g.mul + carry))
	st.heightBonus = b.body.height - typical
	Body.resetStage(b)
	local dev = Util.round((b.body.height / typical - 1) * 100)
	local note = if math.abs(dev) < 2
		then "Рост обычный для вида."
		else `{if dev > 0 then "Выше" else "Ниже"} обычного для вида на {math.abs(dev)}%: {Body.growthWhy(g, carry, dev)}.`
	addDiary(sim, `{b.name} подрос! Был {Util.fixed(h0, 0)} см и {Util.fixed(w0, 1)} кг, стал «{Body.stageWord(stage)}»: {Util.fixed(b.body.height, 0)} см и {Util.fixed(Body.weightOf(b), 1)} кг. {note}`, "event")
	Journal.logEvent(sim, { kind = "stage", note = stage, delta = { heightBefore = h0, heightAfter = b.body.height, weightBefore = w0, weightAfter = Body.weightOf(b) } })
	hint(sim, b.name .. " подрос!", 4000)
	takePortrait(sim, if stage == "young" then "Стал подростком" else "Стал взрослым", note)
end

local function checkMarks(sim)
	local b = sim.beast
	local p = b.practice
	if p.toiletUses >= 3 and b.habits.poop_toilet >= 15 then
		Journal.addMark(sim, "Чистюля", b.name .. " сам ходит в туалет.")
	end
	if p.stoneCarries >= 12 then
		Journal.addMark(sim, "Работяга", b.name .. " перенёс много камней.")
	end
	if b.habits.wait_ripe >= 25 then
		Journal.addMark(sim, "Терпеливый", b.name .. " умеет ждать урожая.")
	end
	if b.traits.bravery >= 60 then
		Journal.addMark(sim, "Храбрец", b.name .. " ничего не боится.")
	end
	if b.traits.bravery <= -60 then
		Journal.addMark(sim, "Осторожный нос", b.name .. " обходит любую опасность.")
	end
	if b.traits.appetite >= 60 then
		Journal.addMark(sim, "Обжора", b.name .. " ест всё, что видит.")
	end
	if b.ageStage == "adult" then
		Journal.addMark(sim, "Взрослый", b.name .. " вырос.")
	end
end

-- ---------- Прерывания ----------

-- Заметил паука — бросает мелкие дела и решает: убежать или обнюхать.
local function checkSpiderInterrupt(sim)
	local c = sim.beast.current
	local spider = nearest(sim, { "creepy" })
	if not c or not spider or table.find(sim.beast.metIds, spider.id) or dist(spider.pos, sim.beast.pos) >= CONFIG.spider.noticeRadius then
		return
	end
	if c.byCommand or c.behavior == "flee_spider" or c.behavior == "sniff_spider" or c.behavior == "carry_stone" then
		return
	end
	if c.behavior == "sleep" and c.phase == "doing" then
		return
	end
	local rows, cands = Behaviors.score(sim)
	meet(sim, spider.id)
	local pick = nil
	for _, r in rows do
		if r.behavior == "flee_spider" or r.behavior == "sniff_spider" then
			pick = r
			break
		end
	end
	if not pick then
		return
	end
	local cand = Behaviors.candidateFor(cands, pick.behavior)
	sim.lastScores = rows
	endBehavior(sim)
	startBehavior(sim, pick.behavior, cand.target, cand.objectId, pick.reason, false)
end

-- При поносе терпеть нельзя: бросает игру (и даже просыпается) и бежит по делам.
local function checkUrgentInterrupt(sim)
	local b = sim.beast
	local c = b.current
	if not c or not Food.diarrheaActive(sim) or b.needs.bowel < CONFIG.diarrhea.urgentBowel then
		return
	end
	if c.behavior == "poop_toilet" or c.behavior == "poop_here" or c.behavior == "carry_stone" then
		return
	end
	local rows, cands = Behaviors.score(sim)
	local pick = nil
	for _, r in rows do
		if r.behavior == "poop_toilet" or r.behavior == "poop_here" then
			pick = r
			break
		end
	end
	if not pick then
		return
	end
	local cand = Behaviors.candidateFor(cands, pick.behavior)
	endBehavior(sim)
	startBehavior(sim, pick.behavior, cand.target, cand.objectId, "живот крутит, срочно!", false)
end

-- ---------- Выбор ----------

function Beast.choose(sim): string
	local rows, cands = Behaviors.score(sim)
	sim.lastScores = rows
	local top = rows[1]
	local cand = Behaviors.candidateFor(cands, top.behavior)
	local b = sim.beast
	if top.behavior == "approach_thorns" or top.behavior == "avoid_thorns" then
		b.timers.thornsReadyAtMs = sim.tMs + Rng.range(sim, CONFIG.thorns.cooldownMinMs, CONFIG.thorns.cooldownMaxMs)
	end
	if (top.behavior == "flee_spider" or top.behavior == "sniff_spider") and cand.objectId then
		meet(sim, cand.objectId)
	end
	-- Один визит гостя — одно решение: встретить или спрятаться.
	if (top.behavior == "greet_person" or top.behavior == "hide_from_person") and cand.objectId then
		meet(sim, cand.objectId)
		local o = objectById(sim, cand.objectId)
		if o then
			local pid = Behaviors.personOf(o)
			local r = Relations.relationOf(sim, pid, o.label)
			r.visits += 1
			r.lastSeenMs = sim.tMs
		end
	end
	startBehavior(sim, top.behavior, cand.target, cand.objectId, top.reason, false)
	return top.behavior
end

-- ---------- Выполнение ----------

local function moveToward(sim, target, dtMs: number): boolean
	local b = sim.beast
	local d = dist(b.pos, target)
	local stepLen = math.min(d, (Body.moveSpeed(b, sim.tMs) * dtMs) / 1000)
	if d > 0 then
		b.pos.x += ((target.x - b.pos.x) / d) * stepLen
		b.pos.y += ((target.y - b.pos.y) / d) * stepLen
		if math.abs(target.x - b.pos.x) > 2 then
			b.face = if target.x > b.pos.x then 1 else -1
		end
	end
	b.needs.energy = clamp(b.needs.energy - stepLen * Body.moveEnergyPerUnit(b), 0, 100)
	return d - stepLen < 4
end

local function sniffSpider(sim, id: string): boolean
	local S = CONFIG.spider
	local b = sim.beast
	local bitten = Rng.next(sim) < S.biteChance
	if bitten then
		b.hp = math.max(1, b.hp - S.biteHp)
		b.needs.joy = math.max(0, b.needs.joy - 10)
		Reactions.changeFear(sim, S.biteFear)
		setMood(sim, "hurt", 2500)
		addFloat(sim, b.pos.x, b.pos.y - 40, "кусь! 🕷", "#b33")
		addDiary(sim, `🕷 {b.name} обнюхал паука, а тот укусил. Не больно, но обидно: теперь пауки страшнее.`, "event")
	else
		Reactions.changeFear(sim, -S.sniffCalm)
		addFloat(sim, b.pos.x, b.pos.y - 40, "просто паучок", "#466")
	end
	table.insert(sim.outbox, { type = "sniffed", objectId = id, bitten = bitten })
	return bitten
end

function Beast.patienceMs(b): number
	return (CONFIG.stones.patienceBaseSec + b.discipline * CONFIG.stones.patiencePerDiscipline) * 1000
end

-- Discipline: сколько зверь работает, прежде чем отвлечься. Бабочка — главный соблазн.
local function checkWorkDistraction(sim): boolean
	local b = sim.beast
	local c = b.current
	local t = sim.tMs
	local S = CONFIG.stones
	if b.needs.energy < S.tiredEnergy then
		b.practice.abandonedTasks += 1
		addDiary(sim, b.name .. " устал и бросил носить камни.", "event")
		endBehavior(sim)
		return true
	end
	if t - c.workStartedAtMs < Beast.patienceMs(b) then
		return false
	end
	if t < c.nextDistractCheckMs then
		return false
	end
	c.nextDistractCheckMs = t + S.distractCheckMs
	local bug = nearest(sim, { "critter", "moving" }, { "creepy" })
	if bug then
		b.practice.abandonedTasks += 1
		endBehavior(sim)
		startBehavior(sim, "chase_butterfly", bug.pos, bug.id, "бабочка интереснее камней", false, "abandoned_work")
		return true
	end
	if Rng.next(sim) < S.boredomChance * (1 - b.discipline / 100) then
		b.practice.abandonedTasks += 1
		addDiary(sim, b.name .. " заскучал и бросил носить камни (быстро отвлекается).", "event")
		endBehavior(sim)
		return true
	end
	return false
end

local function deliverStone(sim)
	local b = sim.beast
	local c = b.current
	local S = CONFIG.stones
	local cost = S.energyPerStone * math.max(0.5, 1 - Body.effectiveStrength(b) / 100) * Body.enduranceSave(b)
	Body.practice(b, "endurance", CONFIG.training.endurancePerStone)
	b.needs.energy = clamp(b.needs.energy - cost, 0, 100)
	b.strength += S.strengthPerStone
	Body.addMuscle(b, S.musclePerStone, "stones")
	b.practice.stoneCarries += 1
	c.stonesDone += 1
	local site = nearest(sim, { "construction" })
	if site then
		table.insert(sim.outbox, { type = "carried", objectId = site.id, count = 1 })
	end
	addFloat(sim, b.pos.x, b.pos.y - 40, "🪨 +1", "#a60", 1000)
end

local function finishWork(sim)
	local b = sim.beast
	b.discipline = clamp(b.discipline + CONFIG.stones.disciplineOnComplete, 0, 100)
	b.practice.completedTasks += 1
	notable(sim, "carry_stone", "completed_work", if b.current.byCommand then "ты попросил" else "любит помогать", "закончил носить камни")
end

local function onArrive(sim)
	local b = sim.beast
	local c = b.current
	local t = sim.tMs
	local o = objectById(sim, c.objectId)
	c.phase = "doing"
	local beh = c.behavior
	if beh == "eat_bowl" or beh == "eat_ripe" or beh == "eat_berry" or beh == "pick_green" then
		local need = if beh == "eat_bowl" then "bowl" elseif beh == "eat_ripe" then "ripe" elseif beh == "eat_berry" then "berry" else "unripe"
		if not o or not table.find(o.tags, "food") or not table.find(o.tags, need) then
			return endBehavior(sim)
		end
		c.phaseUntilMs = t + (if beh == "pick_green" then 1500 elseif beh == "eat_berry" then 2000 elseif beh == "eat_bowl" then 3000 else 2500)
	elseif beh == "wait_ripe" then
		if not o or not table.find(o.tags, "unripe") then
			return endBehavior(sim)
		end
		c.phaseUntilMs = math.huge
		c.workStartedAtMs = t
	elseif beh == "beg_food" then
		c.phaseUntilMs = t + 6000
		b.timers.begReadyAtMs = t + CONFIG.beg.cooldownMs
		setMood(sim, "sad", 6000)
		notable(sim, "beg_food", "normal", c.reason)
	elseif beh == "play_toy" then
		c.phaseUntilMs = t + CONFIG.toy.playMs
	elseif beh == "sleep" then
		c.phaseUntilMs = math.huge
	elseif beh == "approach_thorns" then
		b.states.ouchUntilMs = t + CONFIG.ouch.durationMs
		b.needs.energy = clamp(b.needs.energy - CONFIG.ouch.energyLoss, 0, 100)
		b.needs.joy = clamp(b.needs.joy - CONFIG.ouch.joyLoss, 0, 100)
		b.hp = clamp(b.hp - CONFIG.ouch.hpLoss, 1, b.maxHp)
		addFloat(sim, b.pos.x, b.pos.y - 40, "ой!", "#b33")
		setMood(sim, "hurt", 2500)
		c.phaseUntilMs = t + 1500
		notable(sim, "approach_thorns", "normal", c.reason)
	elseif beh == "avoid_thorns" then
		c.phaseUntilMs = t + 2000
		notable(sim, "avoid_thorns", "normal", c.reason)
	elseif beh == "flee_spider" then
		c.phaseUntilMs = t + 2500
		addFloat(sim, b.pos.x, b.pos.y - 40, "😱", "#b33")
		notable(sim, "flee_spider", "normal", c.reason, "испугался паука и убежал")
	elseif beh == "sniff_spider" then
		if not o then
			return endBehavior(sim)
		end
		c.phaseUntilMs = t + 2000
		local bitten = sniffSpider(sim, o.id)
		notable(sim, "sniff_spider", "normal", c.reason, if bitten then "подошёл обнюхать паука, и тот его укусил" else "подошёл и обнюхал паука: просто паучок")
	elseif beh == "carry_stone" then
		c.phaseUntilMs = t + (if c.carrying then CONFIG.stones.dropMs else CONFIG.stones.pickMs)
	elseif beh == "bring_toy" then
		local player = nearest(sim, { "player" })
		if not o or not player then
			return endBehavior(sim)
		end
		if not c.carrying then
			-- Взял игрушку в зубы — несёт хозяину.
			c.carrying = true
			c.phase = "moving"
			c.target = { x = player.pos.x + 34, y = player.pos.y - 10 }
			return
		end
		table.insert(sim.outbox, { type = "moved", objectId = o.id, pos = { x = player.pos.x + 20, y = player.pos.y + 4 } })
		b.timers.bringReadyAtMs = t + CONFIG.toy.bringCooldownMs
		c.carrying = false
		c.phaseUntilMs = t + CONFIG.toy.bringWaitMs
		local toy = TOYS[b.favoriteToy]
		addFloat(sim, b.pos.x, b.pos.y - 44, toy.icon .. " поиграй со мной!", "#c60", 2200)
		setMood(sim, "happy", 5000)
		notable(sim, "bring_toy", "normal", c.reason, `принёс тебе {toy.acc} и ждёт, что ты с ним поиграешь`)
	elseif beh == "poop_toilet" or beh == "poop_here" then
		c.phaseUntilMs = t + 2000
	elseif beh == "wander" then
		c.phaseUntilMs = t + 1200
	elseif beh == "come" then
		c.phaseUntilMs = t + 2000
	elseif beh == "play_puddle" then
		local W = CONFIG.weather.puddle
		if not o then
			return endBehavior(sim)
		end
		c.phaseUntilMs = t + W.playMs
		b.timers.puddleReadyAtMs = t + W.cooldownMs
		b.needs.joy = clamp(b.needs.joy + W.joyGain, 0, 100)
		setMood(sim, "happy", W.playMs)
		addFloat(sim, b.pos.x, b.pos.y - 40, "💦 шлёп!", "#36a", 2000)
		table.insert(sim.outbox, { type = "muddy", objectId = o.id })
		notable(sim, "play_puddle", "normal", c.reason)
	elseif beh == "hide_kennel" then
		local W = CONFIG.weather.kennel
		if not o then
			return endBehavior(sim)
		end
		c.phaseUntilMs = t + W.stayMs
		b.timers.kennelReadyAtMs = t + W.cooldownMs
		local storm = table.find(o.tags, "storm") ~= nil
		setMood(sim, if storm then "scared" else "calm", if storm then 4000 else 0)
		notable(sim, "hide_kennel", "normal", c.reason, if storm then "испугался грозы и спрятался в будку" else nil)
	elseif beh == "greet_person" or beh == "hide_from_person" then
		if not o then
			return endBehavior(sim)
		end
		local greet = beh == "greet_person"
		c.phaseUntilMs = t + (if greet then 3000 else 5000)
		setMood(sim, if greet then "happy" else "scared", if greet then 3000 else 5000)
		notable(sim, beh, "normal", c.reason, if greet then `подбежал к гостю ({o.label}) и виляет хвостом` else `спрятался от гостя ({o.label})`)
	else
		c.phaseUntilMs = t + 1000
	end
end

local function onFinish(sim)
	local b = sim.beast
	local c = b.current
	local o = objectById(sim, c.objectId)
	local beh = c.behavior
	if beh == "eat_bowl" or beh == "eat_ripe" then
		if o and Data.foodOf(o) then
			Food.eatObject(sim, o)
		end
	elseif beh == "eat_berry" then
		if o and Data.foodOf(o) then
			local r = Food.eatObject(sim, o)
			local what = Data.foodOf(o).acc or Data.nameOf(o)
			notable(sim, "eat_berry", "normal", c.reason, if r == "poison" then `съел {what} — и его стошнило` else "съел " .. what)
		end
	elseif beh == "pick_green" then
		if o and Data.foodOf(o) and table.find(o.tags, "unripe") then
			Food.eatObject(sim, o)
			notable(sim, "pick_green", "normal", c.reason, `сорвал и съел незрелое: {Data.nameOf(o)} (живот разболелся, урожая не будет)`)
		end
	elseif beh == "play_toy" then
		notable(sim, "play_toy", "normal", c.reason, "играл с " .. TOYS[b.favoriteToy].with)
		if o then
			table.insert(sim.outbox, { type = "played", objectId = o.id })
		end
	elseif beh == "carry_stone" then
		if not c.carrying then
			local site = nearest(sim, { "construction" })
			if site then
				c.carrying = true
				c.phase = "moving"
				c.target = { x = site.pos.x, y = site.pos.y }
				return
			end
		else
			deliverStone(sim)
			if not nearest(sim, { "construction" }) or c.stonesDone >= CONFIG.stones.seriesLength then
				finishWork(sim)
			else
				c.carrying = false
				c.phase = "moving"
				local st = nearest(sim, { "stones" })
				local p = if st then st.pos else b.pos
				c.target = { x = p.x, y = p.y }
				return
			end
		end
	elseif beh == "poop_toilet" or beh == "poop_here" then
		local watery = Food.diarrheaActive(sim)
		b.needs.bowel = 0
		if beh == "poop_toilet" then
			b.practice.toiletUses += 1
		end
		table.insert(sim.outbox, { type = "pooped", where = if beh == "poop_toilet" then "toilet" else "here", pos = { x = b.pos.x + 6, y = b.pos.y + 14 }, watery = watery })
		notable(sim, beh, "normal", c.reason)
	end
	endBehavior(sim)
end

local function runBehavior(sim, dtMs: number)
	local b = sim.beast
	local c = b.current
	local sec = dtMs / 1000

	if c.behavior == "chase_butterfly" then
		local bug = objectById(sim, c.objectId)
		if not bug or sim.tMs >= c.phaseUntilMs then
			return endBehavior(sim)
		end
		c.target = { x = bug.pos.x, y = bug.pos.y }
		moveToward(sim, c.target, dtMs)
		b.needs.joy = clamp(b.needs.joy + CONFIG.chase.joyPerSec * sec, 0, 100)
		b.needs.energy = clamp(b.needs.energy - CONFIG.chase.energyPerSec * sec, 0, 100)
		Body.practice(b, "speed", CONFIG.training.speedPerRunSec * sec)
		Body.practice(b, "agility", CONFIG.training.agilityPerRunSec * sec)
		setMood(sim, "happy", 600)
		return
	end

	if c.behavior == "carry_stone" and checkWorkDistraction(sim) then
		return
	end

	if c.phase == "moving" then
		if moveToward(sim, c.target, dtMs) then
			onArrive(sim)
		end
		return
	end

	if c.behavior == "play_toy" then
		b.needs.joy = clamp(b.needs.joy + CONFIG.toy.joyPerSec * sec, 0, 100)
		b.needs.energy = clamp(b.needs.energy + CONFIG.toy.energyPerSec * sec, 0, 100)
		setMood(sim, "happy", 600)
		local toy = TOYS[b.favoriteToy]
		if toy.skill == "strength" then
			b.strength += toy.skillPerSec * sec
			Body.addMuscle(b, toy.skillPerSec * 0.15 * sec, "toy")
		else
			Body.practice(b, toy.skill, toy.skillPerSec * sec)
		end
		if toy.calm then
			b.fears.spider = math.max(0, b.fears.spider - toy.calm * sec)
		end
	elseif c.behavior == "sleep" then
		b.needs.energy = clamp(b.needs.energy + CONFIG.needs.sleepEnergyGain * sec, 0, 100)
		if b.needs.energy >= CONFIG.needs.sleepUntilEnergy and b.hp >= b.maxHp * 0.6 then
			return endBehavior(sim)
		end
		return
	elseif c.behavior == "hide_kennel" then
		-- Дождь кончился — вылезает.
		if not objectById(sim, c.objectId) then
			return endBehavior(sim)
		end
	elseif c.behavior == "wait_ripe" then
		local p = objectById(sim, c.objectId)
		if not p or not table.find(p.tags, "food") then
			return endBehavior(sim)
		end
		-- Посреди ожидания: момент соблазна, когда похвала за терпение нагляднее всего.
		local WR = CONFIG.utility.waitRipe
		if table.find(p.tags, "unripe") and c.nudgeEventId == nil and sim.tMs - c.workStartedAtMs >= WR.nudgeAfterMs and b.needs.satiety < WR.nudgeBelowSatiety and not sim.window then
			notable(sim, "wait_ripe", "normal", "голодный, но терпит", `сидит у грядки и терпит, хотя голодный: {Data.nameOf(p)} ещё не созрела`)
			c.nudgeEventId = sim.window.eventId
		end
		if table.find(p.tags, "ripe") then
			if c.nudgeEventId ~= nil and sim.lastReactedEventId == c.nudgeEventId then
				addDiary(sim, `{b.name} дождался, пока {Data.nameOf(p)} созреет.`, "event")
			else
				notable(sim, "wait_ripe", "normal", c.reason, `дождался, пока {Data.nameOf(p)} созреет`)
			end
			startBehavior(sim, "eat_ripe", p.pos, p.id, "дождался, урожай созрел", false)
			b.current.phase = "doing"
			b.current.phaseUntilMs = sim.tMs + 2500
			return
		end
		if b.needs.satiety < 10 or b.needs.energy < 12 then
			addDiary(sim, b.name .. " не дождался урожая: слишком проголодался.", "event")
			return endBehavior(sim)
		end
		return
	end
	if sim.tMs >= c.phaseUntilMs then
		onFinish(sim)
	end
end

local function updateBubble(sim)
	local b = sim.beast
	local t = sim.tMs
	local c = b.current
	if b.states.refusedUntilMs > t then
		b.bubble = "не хочу!"
	elseif b.states.poisonedUntilMs > t then
		b.bubble = if c and c.behavior ~= "wander" then "тошнит… " .. c.reason else "тошнит…"
	elseif Food.diarrheaActive(sim) and c and (c.behavior == "poop_toilet" or c.behavior == "poop_here") then
		b.bubble = "срочно! живот крутит 💩"
	elseif b.states.upsetUntilMs > t and (not c or c.behavior == "wander") then
		b.bubble = "живот болит…"
	elseif c and c.behavior == "approach_thorns" and c.phase == "doing" then
		b.bubble = "ой! колючки!"
	elseif c and c.behavior == "flee_spider" then
		b.bubble = "паук! 😱"
	elseif c and c.behavior == "sleep" and c.phase == "doing" then
		b.bubble = "спит"
	elseif c and c.behavior == "hide_kennel" and c.phase == "doing" then
		b.bubble = "сидит в будке, пережидает дождь"
	elseif c and c.behavior == "play_puddle" and c.phase == "doing" then
		b.bubble = "шлёп-шлёп по луже! 💦"
	elseif c and c.behavior == "carry_stone" then
		b.bubble = `{c.reason} ({c.stonesDone}/{CONFIG.stones.seriesLength})`
	elseif c then
		b.bubble = c.reason
	else
		b.bubble = ""
	end
end

-- Один шаг зверя. Объекты на этот шаг уже лежат в sim.objects.
function Beast.step(sim, dtMs: number)
	sim.tMs += dtMs
	local b = sim.beast
	local sp = SPECIES[b.species]
	b.ageMs += dtMs
	local sec = dtMs / 1000
	local t = sim.tMs
	local sleeping = b.current ~= nil and b.current.behavior == "sleep" and b.current.phase == "doing"

	b.needs.satiety = clamp(b.needs.satiety - CONFIG.needs.satietyDecay * sp.satietyDecayMul * Body.appetiteMul(b) * sec, 0, 100)
	b.needs.joy = clamp(b.needs.joy - CONFIG.needs.joyDecay * sp.joyDecayMul * sec * (if sleeping then 0.3 else 1), 0, 100)
	if not sleeping then
		b.needs.energy = clamp(b.needs.energy - CONFIG.needs.energyDecay * sec, 0, 100)
	end
	Food.updateStomach(sim, sec)
	if b.needs.satiety < 30 then
		local before = b.body.fatMass
		b.body.fatMass = math.max(0.1, b.body.fatMass - CONFIG.food.fatBurnPerSec * sec)
		Body.story(b).fatLoss += before - b.body.fatMass
	end
	Body.trackStage(b, dtMs)
	local regen = if sleeping then CONFIG.hp.sleepRegenPerSec elseif b.states.poisonedUntilMs > t then 0 else CONFIG.hp.regenPerSec
	b.hp = clamp(b.hp + regen * sec, 0, b.maxHp)
	-- Голод без еды медленно отнимает здоровье, но не убивает.
	if b.needs.satiety < 5 then
		b.hp = clamp(b.hp - 0.1 * sec, b.maxHp * 0.3, b.maxHp)
	end

	Body.growBody(b, dtMs)
	local A = sim.ageConfig or CONFIG.age
	if b.ageStage == "infant" and b.ageMs >= A.infantDurationMs then
		growUp(sim, "young")
	elseif b.ageStage == "young" and b.ageMs >= A.infantDurationMs + A.youngDurationMs then
		growUp(sim, "adult")
	end

	checkSpiderInterrupt(sim)
	checkUrgentInterrupt(sim)
	if not b.current then
		Beast.choose(sim)
	end
	if b.current then
		runBehavior(sim, dtMs)
	end

	if math.floor(t / 1000) ~= math.floor((t - dtMs) / 1000) then
		checkMarks(sim)
	end
	local keep = {}
	for _, f in sim.floats do
		if f.untilMs > t then
			table.insert(keep, f)
		end
	end
	sim.floats = keep
	updateBubble(sim)
	Reactions.updateWindow(sim)
end

-- ---------- Команды хозяина ----------

local function obeys(sim, label: string): boolean
	local b = sim.beast
	local accepted = Rng.next(sim) * 100 < b.obedience
	if accepted then
		Body.practice(b, "intelligence", CONFIG.training.intelligencePerCommand)
	end
	sim.stats.commands.given += 1
	if accepted then
		sim.stats.commands.obeyed += 1
	end
	Journal.logEvent(sim, { kind = "command", note = `{label}:{if accepted then "accepted" else "refused"}`, delta = { obedience = b.obedience } })
	if not accepted then
		b.states.refusedUntilMs = sim.tMs + 3000
		setMood(sim, "calm", 0)
		hint(sim, `{b.name} не послушался (шанс был {Util.round(b.obedience)}%)`, 2500)
	end
	return accepted
end

local function isAsleep(sim): boolean
	local c = sim.beast.current
	if c and c.behavior == "sleep" and c.phase == "doing" then
		hint(sim, "спит и не слышит", 2000)
		return true
	end
	return false
end

-- input: { type = "react", reaction } | { type = "call" } | { type = "command_carry" } | { type = "rename", name }
--      | { type = "learn_mode", mode } | { type = "debug_set", key, value }
-- В Roblox реакция идёт через Reactions.react: без открытого окна это похвала «без повода».
function Beast.input(sim, input, realNowMs: number)
	sim.realNowMs = realNowMs
	local b = sim.beast
	local ty = input.type
	if ty == "react" then
		if sim.freeReactions then
			return Reactions.react(sim, input.reaction)
		end
		return Reactions.applyReaction(sim, input.reaction)
	elseif ty == "rename" then
		local n = Util.utf8Sub(Util.trim(tostring(input.name or "")), 16)
		b.name = if n ~= "" then n else SPECIES[b.species].defaultName
	elseif ty == "call" then
		local player = nearest(sim, { "player" })
		if not player or isAsleep(sim) then
			return
		end
		Journal.logEvent(sim, { kind = "command", behavior = "come" })
		endBehavior(sim)
		startBehavior(sim, "come", { x = player.pos.x + 40, y = player.pos.y }, player.id, "ты позвал", true)
	elseif ty == "command_carry" then
		if not nearest(sim, { "construction" }) or not nearest(sim, { "stones" }) then
			return hint(sim, "сейчас ничего не строится — начни стройку")
		end
		if (b.current and b.current.behavior == "carry_stone") or isAsleep(sim) then
			return
		end
		if not obeys(sim, "carry") then
			return
		end
		endBehavior(sim)
		local st = nearest(sim, { "stones" })
		startBehavior(sim, "carry_stone", st.pos, st.id, "ты попросил", true)
	elseif ty == "learn_mode" then
		sim.learnMode = input.mode
	elseif ty == "debug_set" then
		local v = input.value
		local k = input.key
		if k == "appetite" or k == "bravery" then
			b.traits[k] = clamp(v, -100, 100)
		elseif k == "discipline" or k == "obedience" then
			b[k] = clamp(v, 0, 100)
		elseif k == "fear" then
			b.fears.spider = clamp(v, 0, 100)
		elseif k == "ageMin" then
			b.ageMs = v * 60000
		else
			b.needs[k] = clamp(v, 0, 100)
		end
	end
	return nil
end

return Beast
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Behaviors</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Мозг зверя: какие поступки возможны с объектами вокруг и насколько каждого хочется (Utility AI).
-- Перенос behaviors.ts. Зверь не знает, что такое «ферма»: он видит метки «еда, растение, зелёное».

local IS_ROBLOX = typeof(script) == "Instance"
local function req(name)
	return if IS_ROBLOX then require(script.Parent[name]) else require("./" .. name)
end
local CONFIG = req("Config")
local Data = req("Data")
local Rng = req("Rng")
local Util = req("Util")

local BEHAVIORS = Data.BEHAVIORS
local Behaviors = {}

-- ---------- Что зверь видит ----------

function Behaviors.dist(a, b): number
	return Util.hypot(a.x - b.x, a.y - b.y)
end
local dist = Behaviors.dist

-- Ближайший объект со всеми метками и без запрещённых.
function Behaviors.nearest(sim, tags: { string }, without: { string }?)
	local best, bd = nil, math.huge
	for _, o in sim.objects do
		if not Util.hasAll(o.tags, tags) or (without and Util.hasAny(o.tags, without)) then
			continue
		end
		local d = dist(o.pos, sim.beast.pos)
		if d < bd then
			bd = d
			best = o
		end
	end
	return best
end
local nearest = Behaviors.nearest

function Behaviors.bestBy(sim, tags: { string }, score)
	local best, bs = nil, -math.huge
	for _, o in sim.objects do
		if not Util.hasAll(o.tags, tags) then
			continue
		end
		local v = score(o)
		if v > bs then
			bs = v
			best = o
		end
	end
	return best
end

function Behaviors.objectById(sim, id: string?)
	if not id then
		return nil
	end
	for _, o in sim.objects do
		if o.id == id then
			return o
		end
	end
	return nil
end

function Behaviors.tasteOf(sim, o): number
	return sim.beast.tastes[Data.tasteKey(o)] or 0
end
local tasteOf = Behaviors.tasteOf

-- Кто это: метка person:<id>, иначе id объекта.
function Behaviors.personOf(o): string
	for _, t in o.tags do
		if Util.startsWith(t, "person:") then
			return string.sub(t, 8)
		end
	end
	return o.id
end

function Behaviors.spiderNoticed(sim, spider): boolean
	return not table.find(sim.beast.metIds, spider.id) and dist(spider.pos, sim.beast.pos) < CONFIG.spider.noticeRadius
end

function Behaviors.avoidPoint(from, danger)
	local dx, dy = from.x - danger.x, from.y - danger.y
	local d = Util.hypot(dx, dy)
	if d == 0 then
		d = 1
	end
	return { x = danger.x + (dx / d) * 90, y = danger.y + (dy / d) * 90 }
end

function Behaviors.fleePoint(from, danger)
	local dx, dy = from.x - danger.x, from.y - danger.y
	local d = Util.hypot(dx, dy)
	if d == 0 then
		d = 1
	end
	return { x = from.x + (dx / d) * 180, y = from.y + (dy / d) * 180 }
end

-- Границы мира задаёт хозяин (стенд или ферма). По умолчанию — стенд 900×560.
Behaviors.BOUNDS = { width = 900, height = 560 }

function Behaviors.clampToWorld(v, bounds)
	local B = bounds or Behaviors.BOUNDS
	return {
		x = math.min(B.width - 30, math.max(30, v.x)),
		y = math.min(B.height - 30, math.max(50, v.y)),
	}
end

local function wanderPoint(sim)
	local b = sim.beast.pos
	local a = (sim.tMs / 1000) * 1.7
	return Behaviors.clampToWorld({ x = b.x + math.cos(a) * 120, y = b.y + math.sin(a) * 90 }, sim.bounds)
end

-- ---------- Кандидаты ----------

function Behaviors.candidates(sim)
	local b = sim.beast
	local u = CONFIG.utility
	local t = sim.tMs
	local hunger = 100 - b.needs.satiety
	local out = {}
	local function add(behavior, target, objectId, need, trait, base, taste)
		table.insert(out, { behavior = behavior, target = { x = target.x, y = target.y }, objectId = objectId, terms = { need = need, trait = trait, base = base, taste = taste or 0 } })
	end
	local player = nearest(sim, { "player" })

	-- Туалет.
	if b.needs.bowel >= CONFIG.needs.bowelUrgent * 0.85 then
		local need = (b.needs.bowel - 50) * u.poopHere.needK
		add("poop_here", b.pos, nil, need, 0, u.poopHere.base)
		local toilet = nearest(sim, { "toilet" })
		if toilet then
			local distK = u.poopToilet.distK * (if b.states.diarrheaUntilMs > t then CONFIG.diarrhea.toiletDistMul else 1)
			add("poop_toilet", toilet.pos, toilet.id, need, 0, u.poopToilet.base - dist(b.pos, toilet.pos) * distK)
		end
	end

	-- Еда.
	local bowl = nearest(sim, { "bowl", "food" })
	if bowl then
		add("eat_bowl", bowl.pos, bowl.id, hunger * u.eatBowl.needK, 0, u.eatBowl.base)
	end

	local ripe = nearest(sim, { "food", "ripe" }, { "bowl" })
	if ripe and b.needs.satiety < u.eatRipe.maxSatiety + b.traits.appetite * u.eatRipe.appetiteK then
		add("eat_ripe", ripe.pos, ripe.id, hunger * u.eatRipe.needK, 0, u.eatRipe.base, tasteOf(sim, ripe) * u.tasteK)
	end

	local green = nearest(sim, { "food", "unripe" })
	if green and b.needs.satiety < u.pickGreen.maxSatiety then
		-- Ум помогает распознать зрелость: сообразительный зверь видит, что плод ещё зелёный.
		local smart = (b.training.intelligence / 100) * u.pickGreen.smartK
		add("pick_green", green.pos, green.id, hunger * u.pickGreen.needK, b.traits.appetite * u.pickGreen.traitK, u.pickGreen.base - smart, tasteOf(sim, green) * u.tasteK)
		local left = green.ripeInMs or math.huge
		if left < u.waitRipe.nearMs and b.needs.satiety > u.waitRipe.minSatiety then
			add("wait_ripe", green.pos, green.id, hunger * u.waitRipe.needK, -b.traits.appetite * u.waitRipe.traitK, u.waitRipe.base + smart)
		end
	end

	-- Ягоды на вид одинаковые. Зверь идёт к тем, что ближе и что раньше были вкусными.
	local berry = Behaviors.bestBy(sim, { "food", "berry" }, function(o)
		return tasteOf(sim, o) * u.tasteK - dist(o.pos, b.pos) * 0.012
	end)
	if berry and b.needs.satiety < u.eatBerry.maxSatiety then
		add("eat_berry", berry.pos, berry.id, hunger * u.eatBerry.needK, b.traits.appetite * u.eatBerry.appetiteK, u.eatBerry.base, tasteOf(sim, berry) * u.tasteK)
	end

	if not bowl and player and b.needs.satiety < u.beg.maxSatiety and t >= b.timers.begReadyAtMs then
		add("beg_food", player.pos, player.id, hunger * u.beg.needK, 0, u.beg.base)
	end

	-- Игрушка, сон, бабочка.
	local toy = nearest(sim, { "toy", "favorite" })
	if toy and b.needs.energy > u.play.minEnergy and b.needs.joy < u.play.maxJoy then
		add("play_toy", toy.pos, toy.id, (100 - b.needs.joy) * u.play.needK, 0, u.play.base)
	end
	if toy and player and t >= b.timers.bringReadyAtMs and b.needs.energy > u.bringToy.minEnergy and b.needs.joy < u.bringToy.maxJoy then
		add("bring_toy", toy.pos, toy.id, (100 - b.needs.joy) * u.bringToy.needK, 0, u.bringToy.base)
	end
	local bed = nearest(sim, { "bed" })
	if bed and (b.needs.energy < u.sleep.maxEnergy or (b.hp < b.maxHp * 0.4 and b.needs.energy < 70)) then
		add("sleep", bed.pos, bed.id, math.max(100 - b.needs.energy, (1 - b.hp / b.maxHp) * 80) * u.sleep.needK, 0, u.sleep.base)
	end
	local bug = nearest(sim, { "critter", "moving" }, { "creepy" })
	if bug then
		add("chase_butterfly", bug.pos, bug.id, (100 - b.needs.joy) * u.chase.needK, 0, u.chase.base)
	end

	-- Колючки: смелый лезет, осторожный обходит.
	local thorns = nearest(sim, { "thorny" })
	if thorns and t >= b.timers.thornsReadyAtMs and b.states.ouchUntilMs <= t then
		add("approach_thorns", thorns.pos, thorns.id, 0, b.traits.bravery * u.thornsApproach.traitK, u.thornsApproach.base)
		add("avoid_thorns", Behaviors.avoidPoint(b.pos, thorns.pos), thorns.id, 0, -b.traits.bravery * u.thornsAvoid.traitK, u.thornsAvoid.base)
	end

	-- Камни на стройку: сам берётся, только если за это хвалили (привычка > 0). Иначе — по команде.
	local stones = nearest(sim, { "stones" })
	if stones and nearest(sim, { "construction" }) and b.needs.energy > u.carry.minEnergy and b.habits.carry_stone > 0 then
		add("carry_stone", stones.pos, stones.id, 0, 0, u.carry.base + b.habits.carry_stone * (u.carry.habitK - 1))
	end

	-- Дождь и лужа (только дома в Roblox: в вебе таких объектов нет, выбор там не меняется).
	local W = CONFIG.weather
	local puddle = nearest(sim, { "puddle" })
	if puddle and b.needs.energy > W.puddle.minEnergy and t >= (b.timers.puddleReadyAtMs or 0) then
		add("play_puddle", puddle.pos, puddle.id, (100 - b.needs.joy) * W.puddle.joyK, b.traits.bravery * W.puddle.braveK, W.puddle.base)
	end
	local shelter = nearest(sim, { "shelter" })
	if shelter and t >= (b.timers.kennelReadyAtMs or 0) then
		local storm = table.find(shelter.tags, "storm") ~= nil
		add("hide_kennel", shelter.pos, shelter.id, if storm then W.kennel.stormNeed else W.kennel.rainNeed, -b.traits.bravery * W.kennel.braveK, W.kennel.base)
	end

	-- Долго ничего не происходило — гулять надоедает, зверь ищет, чем заняться.
	local quiet = t - sim.stats.lastNotableMs - u.wander.restlessAfterMs
	local restless = math.min(1, math.max(0, quiet / u.wander.restlessFullMs))
	add("wander", wanderPoint(sim), nil, 0, 0, u.wander.base * (1 - u.wander.restlessCut * restless))

	-- Гость: зверь помнит, кто его кормил и играл, а кто ругал. Решение одно на визит.
	for _, v in sim.objects do
		if not table.find(v.tags, "visitor") or table.find(b.metIds, v.id) then
			continue
		end
		local rel = b.relations[Behaviors.personOf(v)]
		local trust = if rel then rel.trust else 0
		local R = CONFIG.relations
		add("greet_person", v.pos, v.id, (100 - b.needs.joy) * R.greetJoyK, b.traits.bravery * R.braveK, R.greetBase, trust * R.trustK)
		add("hide_from_person", Behaviors.avoidPoint(b.pos, v.pos), v.id, 0, -b.traits.bravery * R.braveK, R.hideBase, -trust * R.trustK)
		break
	end

	-- Паук: пугливый не пойдёт туда, где он сидит. А если заметил — убежит или обнюхает.
	local spider = nearest(sim, { "creepy" })
	if spider then
		for _, c in out do
			if dist(spider.pos, c.target) <= CONFIG.spider.blockRadius then
				c.terms.base -= b.fears.spider * CONFIG.spider.blockK
			end
		end
		if Behaviors.spiderNoticed(sim, spider) then
			local fear = b.fears.spider
			add("flee_spider", Behaviors.fleePoint(b.pos, spider.pos), spider.id, fear * u.fleeSpider.fearK, -b.traits.bravery * u.sniffSpider.braveK * 0.5, u.fleeSpider.base)
			add("sniff_spider", spider.pos, spider.id, (100 - fear) * u.sniffSpider.calmK, b.traits.bravery * u.sniffSpider.braveK, u.sniffSpider.base)
		end
	end
	return out
end

-- ---------- Оценка ----------

function Behaviors.choiceNoise(sim): number
	return if sim.learnMode == "soft" then CONFIG.learning.soft.noise else CONFIG.utility.noise
end

-- Пузырёк причины: самое весомое слагаемое из понятных игроку.
function Behaviors.reasonFor(behavior: string, terms): string
	local info = BEHAVIORS[behavior]
	local parts = { { "need", terms.need }, { "trait", terms.trait }, { "habit", terms.habit }, { "taste", terms.taste } }
	Util.stableSort(parts, function(a, b)
		return a[2] > b[2]
	end)
	for _, p in parts do
		if p[2] > 3 and info.reasons[p[1]] then
			return info.reasons[p[1]]
		end
	end
	return info.reasons.base or info.label
end

function Behaviors.score(sim)
	local cands = Behaviors.candidates(sim)
	local noiseAmp = Behaviors.choiceNoise(sim)
	local rows = {}
	for _, c in cands do
		local habit = sim.beast.habits[c.behavior] or 0
		local d = dist(sim.beast.pos, c.target)
		local proximity = CONFIG.utility.proximityMax * math.max(0, 1 - d / CONFIG.utility.proximityRange)
		local noise = (Rng.next(sim) * 2 - 1) * noiseAmp
		local terms = { need = c.terms.need, trait = c.terms.trait, base = c.terms.base, taste = c.terms.taste, habit = habit, proximity = proximity, noise = noise }
		local total = terms.need + terms.trait + terms.habit + terms.taste + terms.proximity + terms.base + terms.noise
		table.insert(rows, { behavior = c.behavior, objectId = c.objectId, total = total, terms = terms, reason = Behaviors.reasonFor(c.behavior, terms) })
	end
	Util.stableSort(rows, function(a, b)
		return a.total > b.total
	end)
	return rows, cands
end

function Behaviors.candidateFor(cands, behavior)
	for _, c in cands do
		if c.behavior == behavior then
			return c
		end
	end
	return nil
end

return Behaviors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Body</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Тело, рост, история тела и производные характеристики. Перенос body.ts и bodyStory.ts.

local IS_ROBLOX = typeof(script) == "Instance"
local CONFIG = if IS_ROBLOX then require(script.Parent.Config) else require("./Config")
local Data = if IS_ROBLOX then require(script.Parent.Data) else require("./Data")
local Util = if IS_ROBLOX then require(script.Parent.Util) else require("./Util")

local SPECIES = Data.SPECIES
local Body = {}

-- ---------- История тела ----------

function Body.emptyStory()
	return { fatGain = 0, fatLoss = 0, sickLoss = 0, muscle = { stones = 0, toy = 0 }, stageMs = 0, hungryMs = 0, activeMs = 0, heightBonus = 0 }
end

function Body.story(b)
	if not b.bodyStory then
		b.bodyStory = Body.emptyStory()
	end
	return b.bodyStory
end

function Body.addMuscle(b, kg: number, src: string)
	b.body.muscleMass += kg
	local s = Body.story(b)
	s.muscle[src] += kg
end

local ACTIVE = { "carry_stone", "play_toy", "chase_butterfly", "bring_toy" }

function Body.trackStage(b, dtMs: number)
	local s = Body.story(b)
	s.stageMs += dtMs
	if b.needs.satiety < CONFIG.growth.hungryBelow then
		s.hungryMs += dtMs
	end
	if b.current and b.current.phase == "doing" and table.find(ACTIVE, b.current.behavior) then
		s.activeMs += dtMs
	end
end

function Body.growthFactor(b)
	local G = CONFIG.growth
	local s = Body.story(b)
	if s.stageMs <= 0 then
		return { mul = 1, hungry = 0, active = 0, hungryShare = 0, activeShare = 0 }
	end
	local hungryShare = s.hungryMs / s.stageMs
	local activeShare = s.activeMs / s.stageMs
	local hungry = -G.hungryPenalty * math.min(1, hungryShare / G.hungryFull)
	local active = G.activeBonus * math.min(1, activeShare / G.activeFull)
	return { mul = 1 + hungry + active, hungry = hungry, active = active, hungryShare = hungryShare, activeShare = activeShare }
end

function Body.growthWhy(g, carry: number, dev: number): string
	local function pct(v)
		return Util.round(v * 100)
	end
	local parts = {}
	if dev < 0 then
		if g.hungry <= -0.01 then
			table.insert(parts, `часто бывал голодным ({pct(g.hungryShare)}% времени)`)
		end
		if carry <= -0.01 then
			table.insert(parts, "и раньше рос мелким")
		end
	else
		if g.active >= 0.01 then
			table.insert(parts, `много двигался, играл и носил камни ({pct(g.activeShare)}% времени)`)
		end
		if carry >= 0.01 then
			table.insert(parts, "и раньше был крупным")
		end
	end
	if #parts == 0 then
		table.insert(parts, if dev < 0 then "мало двигался" else "ел досыта и рос сам собой")
	end
	return table.concat(parts, ", ")
end

function Body.resetStage(b)
	local s = Body.story(b)
	s.stageMs = 0
	s.hungryMs = 0
	s.activeMs = 0
end

-- ---------- Производные ----------

function Body.weightOf(b): number
	return b.body.baseMass + b.body.muscleMass + b.body.fatMass
end

function Body.fatRatio(b): number
	return b.body.fatMass / b.body.baseMass
end

function Body.muscleRatio(b): number
	return b.body.muscleMass / b.body.baseMass
end

-- Практика растит навык с замедлением к 100.
function Body.practice(b, skill: string, amount: number)
	local v = b.training[skill]
	b.training[skill] = math.min(100, v + amount * (1 - v / 100))
end

function Body.speedMultiplier(b, tMs: number): number
	local m = CONFIG.movement
	local mul = SPECIES[b.species].speedMul * m.stageMul[b.ageStage] * (1 + (b.training.speed / 100) * CONFIG.training.speedBonusMax)
	mul *= 1 - Body.fatRatio(b) * m.fatSlow - Body.muscleRatio(b) * m.muscleSlow
	if b.states.upsetUntilMs > tMs then
		mul *= CONFIG.upset.speedMul
	end
	if b.states.ouchUntilMs > tMs then
		mul *= CONFIG.ouch.speedMul
	end
	if b.states.poisonedUntilMs > tMs then
		mul *= CONFIG.poison.speedMul
	end
	if b.states.diarrheaUntilMs > tMs then
		mul *= CONFIG.diarrhea.speedMul
	end
	return math.max(m.minMul, mul)
end

function Body.moveSpeed(b, tMs: number): number
	return CONFIG.movement.baseSpeed * Body.speedMultiplier(b, tMs)
end

-- Выносливый тратит меньше энергии на движение и работу.
function Body.enduranceSave(b): number
	return 1 - (b.training.endurance / 100) * CONFIG.training.enduranceEnergySave
end

function Body.moveEnergyPerUnit(b): number
	local weightK = Body.weightOf(b) / b.body.baseMass
	local fatK = 1 + Body.fatRatio(b) * CONFIG.movement.fatEnergyMul
	return CONFIG.needs.moveEnergyPerUnit * weightK * fatK * Body.enduranceSave(b)
end

function Body.effectiveStrength(b): number
	return b.strength + b.body.muscleMass * 8 + b.body.fatMass * 2
end

function Body.agilityOf(b): number
	return math.max(0, 50 * SPECIES[b.species].speedMul - Body.fatRatio(b) * 80 - Body.muscleRatio(b) * 15 + b.training.agility * 0.4)
end

function Body.toxinResistance(b): number
	local P = CONFIG.poison
	local learned = math.min(1, b.toxinExposure / P.exposureForMax) * P.maxResist
	return math.min(0.85, SPECIES[b.species].toxinResist + learned)
end

local function round1(v: number): number
	return Util.round(v * 10) / 10
end

function Body.attributes(b, tMs: number)
	return {
		strength = round1(Body.effectiveStrength(b)),
		speed = round1(Body.moveSpeed(b, tMs)),
		agility = round1(Body.agilityOf(b)),
		endurance = round1(b.training.endurance),
		intelligence = round1(b.training.intelligence),
		weight = round1(Body.weightOf(b)),
		height = round1(b.body.height),
		toxinResist = Util.round(Body.toxinResistance(b) * 100),
	}
end

function Body.bodyWords(b): string
	local fr = Body.fatRatio(b)
	local mr = Body.muscleRatio(b)
	if fr > 0.35 then
		return "перекормленный"
	end
	if mr > 0.3 and mr > fr then
		return "мускулистый"
	end
	if fr > 0.2 then
		return "пухлый"
	end
	if mr > 0.18 then
		return "крепкий"
	end
	if fr < 0.08 and mr < 0.1 then
		return "худенький"
	end
	return "обычный"
end

function Body.bodyRadius(b): number
	return 9 + math.sqrt(Body.weightOf(b)) * 5.5
end

function Body.growBody(b, dtMs: number)
	b.body.height += (CONFIG.age.heightGrowthPerMin * dtMs) / 60000
end

function Body.applyStage(b, stage: string)
	local s = SPECIES[b.species].stage[stage]
	b.ageStage = stage
	b.body.height = math.max(b.body.height, s.height)
	b.body.baseMass = s.baseMass
	local hpGain = if stage == "young" then 20 else 30
	b.maxHp += hpGain
	b.hp = math.min(b.maxHp, b.hp + hpGain)
end

function Body.stageWord(stage: string): string
	return if stage == "infant" then "малыш" elseif stage == "young" then "подросток" else "взрослый"
end

-- Большому и тяжёлому зверю нужно больше еды.
function Body.appetiteMul(b): number
	local G = CONFIG.growth
	local normal = SPECIES[b.species].stage[b.ageStage].baseMass * G.normalMassK
	local r = (Body.weightOf(b) / normal) ^ G.bigEatPow
	return math.min(G.bigEatMax, math.max(G.bigEatMin, r))
end

return Body
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Character</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Характер словами и лестница привычек: «мой зверь сделал X, потому что Y; теперь он умеет Z».
-- Перенос beast_lab/src/beast/character.ts один в один.

local IS_ROBLOX = typeof(script) == "Instance"
local function req(name)
	return if IS_ROBLOX then require(script.Parent[name]) else require("./" .. name)
end
local Data = req("Data")
local Util = req("Util")
local Body = req("Body")
local Reactions = req("Reactions")
local Relations = req("Relations")

local BEHAVIORS = Data.BEHAVIORS
local capital, list = Util.capital, Util.list

local Character = {}

Character.HABIT_STEP = { trying = 6, knows = 25 }

Character.STAGE_WORD = {
	none = "не знает",
	trying = "пробует",
	knows = "умеет",
	unlearning = "отучается",
	unlearned = "отучен",
}

function Character.habitStage(h: number): string
	local S = Character.HABIT_STEP
	if h >= S.knows then
		return "knows"
	elseif h >= S.trying then
		return "trying"
	elseif h <= -S.knows then
		return "unlearned"
	elseif h <= -S.trying then
		return "unlearning"
	end
	return "none"
end

-- Привычки вертикального среза показываются всегда, остальные — когда появились.
Character.CORE_HABITS = { "eat_bowl", "wait_ripe", "bring_toy", "poop_toilet", "carry_stone" }
local NEVER_SHOWN = { "wander", "sleep", "come" }
-- Поступки, которые хозяин обычно хочет отучить: «умеет» звучит как «привык», а «отучен» — хорошо.
Character.BAD_HABITS = { "pick_green", "poop_here", "approach_thorns", "beg_food", "eat_berry" }

function Character.stageWord(stage: string, bad: boolean): string
	return if bad and stage == "knows" then "привык" else Character.STAGE_WORD[stage]
end

function Character.habitRows(sim)
	local h = sim.beast.habits
	local rows = {}
	local order = table.clone(Data.BEHAVIOR_ORDER)
	for _, a in Data.HOME_BEHAVIOR_ORDER do
		if h[a] ~= nil then
			table.insert(order, a)
		end
	end
	for _, a in order do
		if table.find(NEVER_SHOWN, a) then
			continue
		end
		local core = table.find(Character.CORE_HABITS, a) ~= nil
		local v = h[a] or 0
		if not core and math.abs(v) < Character.HABIT_STEP.trying then
			continue
		end
		local stage = Character.habitStage(v)
		local bad = table.find(Character.BAD_HABITS, a) ~= nil
		local good = nil
		if stage ~= "none" then
			good = (v > 0) ~= bad
		end
		table.insert(rows, {
			behavior = a,
			icon = BEHAVIORS[a].icon,
			label = BEHAVIORS[a].verb,
			value = v,
			stage = stage,
			core = core,
			bad = bad,
			word = Character.stageWord(stage, bad),
			good = good,
		})
	end
	Util.stableSort(rows, function(x, y)
		if x.core ~= y.core then
			return x.core
		end
		return math.abs(x.value) > math.abs(y.value)
	end)
	return rows
end

local function adjectives(sim)
	local t = sim.beast.traits
	local out = {}
	for _, w in { Reactions.traitWords("bravery", t.bravery), Reactions.traitWords("appetite", t.appetite) } do
		if not Util.startsWith(w, "пока") then
			table.insert(out, w)
		end
	end
	return if #out > 0 then out else { "пока непонятный" }
end

local REACTION_PAST = { praise = "ты похвалил", scold = "ты отругал", give = "ты дал, что он хотел", ignore = "ты не отреагировал" }

-- Последняя история воспитания: поступок, причина, реакция и что из этого вышло.
function Character.lastStory(sim): string?
	local log = sim.log
	for i = #log, 1, -1 do
		local e = log[i]
		if e.kind ~= "reaction" or not e.behavior or not e.reaction or e.reaction == "ignore" then
			continue
		end
		local did = BEHAVIORS[e.behavior].did
		local why = ""
		local j = i - 1
		while j >= 1 and j >= i - 400 do
			local n = log[j]
			if n.kind == "notable" and n.behavior == e.behavior then
				if n.note and n.note ~= "" then
					did = n.note
				end
				why = n.reason or ""
				break
			end
			j -= 1
		end
		local stage = Character.habitStage(sim.beast.habits[e.behavior] or 0)
		local now = ""
		if stage ~= "none" then
			now = `; теперь {Character.stageWord(stage, table.find(Character.BAD_HABITS, e.behavior) ~= nil)} {BEHAVIORS[e.behavior].verb}`
		end
		local lc = sim.lastChance
		local chance = ""
		if lc and lc.behavior == e.behavior and math.abs(lc.tMs - e.tMs) < 1000 then
			chance = ` Шанс повторить: {Reactions.pct(lc.before)}% → {Reactions.pct(lc.after)}%.`
		end
		local because = if why ~= "" then `, потому что «{why}»` else ""
		return `{capital(did)}{because} — {REACTION_PAST[e.reaction]}{now}.{chance}`
	end
	return nil
end

-- Родительный падеж для «от … бывает плохо».
Character.TASTE_NAMES = {
	wolfberry = "волчьих ягод",
	["carrot/unripe"] = "зелёной морковки",
	["strawberry/unripe"] = "зелёной клубники",
	["pumpkin/unripe"] = "зелёной тыквы",
	carrot = "морковки",
	-- Ферма в Roblox: остальные культуры и продукты.
	wheat = "пшеницы",
	["wheat/unripe"] = "зелёной пшеницы",
	strawberry = "клубники",
	pumpkin = "тыквы",
	bread = "хлеба",
	egg = "яиц",
	raspberry = "красных ягод",
}

-- Несколько коротких фраз о звере. Первая — главная.
function Character.characterLines(sim): { string }
	local b = sim.beast
	local sp = Data.SPECIES[b.species]
	local lines = {}
	table.insert(
		lines,
		`{b.name} — {list(adjectives(sim))} {Util.lower(sp.title)}. {capital(Reactions.obedienceWords(b.obedience))}, {Reactions.disciplineWords(b.discipline)}.`
	)
	local rows = Character.habitRows(sim)
	local function pick(fn)
		local out = {}
		for _, r in rows do
			if fn(r) then
				table.insert(out, r.label)
			end
		end
		return out
	end
	local knows = pick(function(r)
		return r.stage == "knows" and not r.bad
	end)
	local used = pick(function(r)
		return r.stage == "knows" and r.bad
	end)
	local trying = pick(function(r)
		return r.stage == "trying"
	end)
	local unlearned = pick(function(r)
		return r.stage == "unlearned"
	end)
	local unlearning = pick(function(r)
		return r.stage == "unlearning"
	end)
	if #knows > 0 then
		table.insert(lines, `Умеет {list(knows)}.`)
	end
	if #used > 0 then
		table.insert(lines, `Привык {list(used)}.`)
	end
	if #trying > 0 then
		table.insert(lines, `Пробует {list(trying)}.`)
	end
	if #unlearned > 0 then
		table.insert(lines, `Отучен {list(unlearned)}.`)
	end
	if #unlearning > 0 then
		table.insert(lines, `Отучается {list(unlearning)}.`)
	end
	if #knows + #used + #trying + #unlearned + #unlearning == 0 then
		table.insert(lines, "Привычек пока нет: хвали и ругай за поступки, и они появятся.")
	end
	local bad = {}
	for _, k in b.tasteOrder or {} do
		local v = b.tastes[k]
		if v and v <= -10 then
			table.insert(bad, Character.TASTE_NAMES[k] or k)
		end
	end
	if #bad > 0 then
		table.insert(lines, `Помнит, что от {list(bad)} бывает плохо.`)
	end
	local toy = Data.TOYS[b.favoriteToy]
	table.insert(lines, `{capital(Reactions.fearWord(b.fears.spider))}. Любимая игрушка — {toy.name} {toy.icon}.`)
	table.insert(
		lines,
		`Сейчас {Body.stageWord(b.ageStage)}, {Body.bodyWords(b)}: {Util.fixed(b.body.height, 0)} см, {Util.fixed(Body.weightOf(b), 1)} кг.`
	)
	local people = {}
	for _, id in b.relationOrder do
		if id ~= "owner" then
			local r = b.relations[id]
			table.insert(people, `{r.name} — {Relations.trustWord(r.trust)}`)
		end
	end
	if #people > 0 then
		table.insert(lines, `Гости: {table.concat(people, ", ")}.`)
	end
	if #sim.marks > 0 then
		local ms = {}
		for _, m in sim.marks do
			table.insert(ms, `«{m}»`)
		end
		table.insert(lines, `Отметины: {table.concat(ms, ", ")}.`)
	end
	return lines
end

-- Что сейчас на мордочке: явная эмоция, а если её нет — из состояния.
function Character.faceMood(sim): string
	local b = sim.beast
	local t = sim.tMs
	if b.current and b.current.behavior == "sleep" and b.current.phase == "doing" then
		return "sleepy"
	end
	if b.mood.untilMs > t then
		return b.mood.kind
	end
	local s = b.states
	if s.poisonedUntilMs > t or s.upsetUntilMs > t or s.diarrheaUntilMs > t then
		return "sick"
	end
	if s.ouchUntilMs > t then
		return "hurt"
	end
	if b.needs.energy < 20 then
		return "sleepy"
	end
	if b.needs.joy < 25 or b.needs.satiety < 15 then
		return "sad"
	end
	if b.needs.joy > 75 then
		return "happy"
	end
	return "calm"
end

Character.MOOD_WORD = {
	calm = "спокоен",
	happy = "радуется",
	proud = "гордится собой",
	guilty = "виновато прижал уши",
	sad = "грустит",
	scared = "испугался",
	sick = "плохо себя чувствует",
	sleepy = "хочет спать",
	curious = "любопытно",
	hurt = "больно",
}

return Character
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
